    {
        en = "Hide and Bone Armor"
        ja = "獣皮と骨の鎧"
    }
    {
        en = "Hide and bone are common materials in the northern regions. This armor is using both for decent protection."
        ja = "北方では獣皮も骨もありふれた素材だ。この鎧はその両方を用い、まずまずの防護を備えている。"
    }
    {
        en = "Higher Chance To Hit Head"
        ja = "頭部への命中率上昇"
    }
    {
        en = "Highland Helm"
        ja = "高地の兜"
    }
    {
        en = "His experimental surgery didn't work"
        ja = "実験的な手術が失敗した"
    }
    {
        en = "His shadows traverses with great danger."
        ja = "あの男の影とは、道を交えない方が身のためだ。"
    }
    {
        en = "His war was not ours."
        ja = "あいつの戦争は、俺たちの戦争ではなかった。"
    }
    {
        en = "Historian"
        ja = "歴史家"
    }
    {
        en = "Historians are studious individuals with vast amounts of knowledge, none of it any use on the battlefield."
        ja = "歴史家は膨大な知識を持つ勤勉な研究者だが、戦場で役立つ知識は一つもない。"
    }
    {
        en = "Hits both head and body for additional damage"
        ja = "頭部と胴体の両方に命中し、追加ダメージを与える"
    }
    {
        en = "Hmm, alright."
        ja = "うむ、いいだろう。"
    }
    {
        en = "Hmm."
        ja = "うむ。"
    }
    {
        en = "Hobble along now."
        ja = "さあ、足を引きずって行け。"
    }
    {
        en = "Hoggart's Heirloom"
        ja = "ホッガートの家宝"
    }
    {
        en = "Hold on, let's see what happens next."
        ja = "待て。この先どうなるか見届けよう。"
    }
    {
        en = "Holy smokes!"
        ja = "こいつは驚いた！"
    }
    {
