    {
        mode = "pattern"
        en = "Has <open:tag>-15%<close:tag> chance to hit targets directly adjacent because the weapon is too unwieldy"
        ja = "武器が扱いにくいため、直接隣接する対象への命中率が<open>-15%<close>低下する"
    }
    {
        mode = "pattern"
        en = "Has a <chance:val_tag> chance to succeed, based on Melee Skill, or higher if there's been attempts to free the ally before."
        ja = "近接技能に基づき、成功率は<chance>。それまでにも味方の解放を試みていれば、さらに高くなる。"
    }
    {
        mode = "pattern"
        en = "Has a <chance:val_tag> chance to succeed, based on Melee Skill. Each failed attempt will increase the chance to succeed for subsequent attempts."
        ja = "近接技能に基づき、成功率は<chance>。失敗するたび、次の試行の成功率が上昇する。"
