        ja = "[color=%negative%]近接戦闘中はトランスに入れない。[/color]"
    }
    {
        en = "[color=%negative%]Requires the Vala's staff.[/color]"
        ja = "[color=%negative%]ヴァラの杖が必要。[/color]"
