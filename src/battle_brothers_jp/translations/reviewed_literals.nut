    {
        en = "A decorated deep cervelliere with bolted cheek guards. It bears a gilded trim with decorative leaf plates pinned to the front ridge."
        ja = "頬当てを鋲留めした、装飾入りの深鉢セルヴェリエール。金箔の縁取りが施され、前縁には葉形の飾り板が留められている。"
    }
    {
        en = "A decorated sash and belt previously worn by the Diviner."
        ja = "かつて占術師が身につけていた、装飾入りの肩帯と腰帯。"
    }
    {
        en = "A decorative feather clasped on hats."
        ja = "帽子に留める装飾用の羽根。"
    }
    {
        en = "A decorative plait used to adorn helms."
        ja = "兜を飾るための組み紐。"
    }
    {
        en = "A decorative tail made of desert animal hair."
        ja = "砂漠の獣の毛で作られた飾り尾。"
    }
    {
        en = "A dense wool wrap to protect against blunt hits."
        ja = "鈍器の打撃から身を守る、目の詰まった羊毛の巻き布。"
    }
    {
        en = "A disgusting Hexen brew, will heal and remove fatigue for 8 turns, but poison for 3 turns."
        ja = "おぞましいヘクセンの醸造薬。8ターンにわたり体力を回復して疲労を取り除くが、3ターンのあいだ毒に冒される。"
    }
    {
        en = "A disgusting design made by nailing metal pieces to layers of flesh taken from skin ghouls. It smells awful, is quite heavy, and feels as if it is healing itself on to your body."
        ja = "スキングールから剥いだ何層もの肉に金属片を打ち付けた、おぞましい代物。ひどい悪臭を放ち、かなり重いうえ、まるで自ら着用者の身体へ癒着していくように感じられる。"
    }
    {
        en = "A distinctive, bird-like mask. The beak acts as a ventilator, containing sweet-smelling herbs to ward away sickness and disease."
        ja = "特徴的な鳥のような仮面。嘴は換気口となっており、病や疫病を遠ざける甘い香りの薬草が詰められている。"
    }
    {
        en = "A dome helm with heavy riveted bands that has once been in possession of an ancient household guard."
        ja = "太い鋲留め帯で補強された丸鉢兜。かつて古代の近衛兵が所有していた。"
    }
    {
        en = "A donkey. Smelly, stubborn, drooling and eating your shirt right now."
        ja = "ロバ。臭く、頑固で、よだれを垂らし、今まさにお前の上着をかじっている。"
    }
    {
        en = "A double edged spear with a sleek yet wide profile compared to other spears, it excels at penetrating armour whilst remaining light enough for skirmishing."
        ja = "ほかの槍と比べて流麗でありながら幅広い輪郭を持つ、両刃の槍。軽さを保ったまま装甲を貫くことに長け、小競り合いにも向く。"
    }
    {
        en = "A durable cloth robe designed to shield the wearer from the sun's heat and the sting of minor cuts."
        ja = "陽光の熱と軽い切り傷から着用者を守る、丈夫な布製の長衣。"
    }
    {
        en = "A dyed cloth piece of storied headwear adorning a questing knight on their path of atonement."
        ja = "贖罪の旅を続ける遍歴騎士の頭を飾る、由緒ある染め布の被り物。"
    }
    {
        en = "A fan of large feathers to be displayed behind a helm."
        ja = "兜の後ろに広げて飾る、大羽根の扇飾り。"
    }
    {
        en = "A fancy hat decorated with a pair of vibrant feathers usually worn by minstrels or nobles."
        ja = "吟遊詩人や貴族がよくかぶる、鮮やかな二枚の羽根で飾られた華美な帽子。"
    }
    {
        en = "A farmer's flail that has been bolstered with thicker sections of wood and bound with iron. Sharp spikes protrude from its frame, as if to mockingly imitate it's military counterpart."
        ja = "太い木材で補強し、鉄で縛った農具の殻竿。打ち棒から鋭い棘が突き出し、軍用フレイルを嘲るかのように真似ている。"
    }
    {
        en = "A fashionable fabric hat with a golden band, usually worn by the aristocrats."
        ja = "金の帯をあしらった流行の布帽子。主に貴族が身につける。"
    }
    {
        en = "A fashionable southern headdress made of soft fabrics, effectively mimicking the finery of the high courts."
        ja = "柔らかな布で作られた流行の南方風頭飾り。上流宮廷の華美を巧みに模している。"
    }
    {
        en = "A few bones from a Höllenhund; they still have a faint, eerie glow about them."
        ja = "ヘレンフントの骨が数本。今もかすかな不気味な光を帯びている。"
    }
    {
        en = "A fine cloth hat typically worn by the nobles."
        ja = "貴族がよくかぶる、上質な布帽子。"
    }
    {
        en = "A fine crown made of excellent materials"
        ja = "極上の素材で作られた、上品な冠。"
    }
    {
        en = "A fine crown made of metal."
        ja = "金属で作られた、上品な冠。"
    }
    {
        en = "A fine floppy hat made of excellent materials"
        ja = "極上の素材で作られた、上品な垂れ帽子。"
    }
    {
        en = "A fine hat made of excellent materials"
        ja = "極上の素材で作られた、上品な帽子。"
    }
    {
        en = "A fine hat made of exotic materials."
        ja = "異国の素材で作られた、上品な帽子。"
    }
    {
        en = "A fine hood made of excellent materials"
        ja = "極上の素材で作られた、上品な頭巾。"
    }
    {
        en = "A fine, flowing cloak made of light foreign silk that provides protection while looking exceptionally grand."
        ja = "異国の軽い絹で作られた、上質でたなびく外套。ひときわ豪奢に見せながら、防護ももたらす。"
    }
    {
        en = "A fine, flowing cloth covering for armor that displays noble colors or heraldry. It provides a layer of protection and a sense of belonging."
        ja = "貴族家の色や紋章を示す、上質でたなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A fine, linen tunic of exquisite material, embroidered with pleasing patterns. Light and sturdy."
        ja = "精緻な模様を刺繍した、極上素材の美しい亜麻布チュニック。軽く、丈夫である。"
    }
    {
        en = "A finely wrought golden buckle used to adorn noble headwear."
        ja = "貴族の帽子を飾るため、精巧に作られた金の留め金。"
    }
    {
        en = "A flashy harness commonly worn by pit fighters in arenas of the southern city states."
        ja = "南方都市国家の闘技場で、剣闘士がよく身につける派手な胴具。"
    }
    {
        en = "A flat metal helm with a bolted face plate with a perforated breath."
        ja = "鋲留めした面頬と、穴を開けた呼吸口を備える平らな金属兜。"
    }
    {
        en = "A flat metal helm with a nose guard, popular among the soldiers."
        ja = "鼻当てを備えた平らな金属兜。兵士の間で広く使われている。"
    }
    {
        en = "A floppy cloth hat of a southern vizier."
        ja = "南方の宰相がかぶる、垂れた布帽子。"
    }
    {
        en = "A floppy hat."
        ja = "垂れた帽子。"
    }
    {
        en = "A flowing cloth covering for armor that displays some colors or heraldry cut in the southern style. It provides a layer of protection and a sense of belonging."
        ja = "南方風に裁ち、色や紋章を示す、たなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A flowing cloth covering for armor that displays some colors or heraldry. It provides a layer of protection and a sense of belonging."
        ja = "色や紋章を示す、たなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A flowing cloth covering for armor, to show your allegiance. Offers minimal protection and small boost to morale."
        ja = "忠誠の相手を示す、たなびく防具用の布覆い。防護はごくわずかだが、士気を少し高める。"
    }
    {
        en = "A flowing cloth sash that adds a vibrant splash of color to any attire."
        ja = "どんな装いにも鮮やかな彩りを添える、たなびく布の肩帯。"
    }
    {
        en = "A foul concoction that blends the essences of beasts with that of men. Drink at your own peril."
        ja = "獣と人の精髄を混ぜ合わせた、禍々しい調合薬。飲むなら覚悟せよ。"
    }
    {
        en = "A freshly minted scroll. Could be a masterpiece used to train your mercenaries or gibberish that will be of interest to local scribes."
        ja = "書き上げられたばかりの巻物。傭兵の訓練に使える傑作かもしれないし、地元の書記くらいしか興味を示さない戯言かもしれない。"
    }
    {
        en = "A full cloth head and face wrap that conceals the wearer's features entirely, leaving only a narrow opening for the eyes."
        ja = "頭と顔を布で完全に覆い、着用者の人相をすべて隠す被り物。目元に細い隙間だけが残されている。"
    }
    {
        en = "A full helm crafted from overlapping long metal splints in the shape of a traditional southern head wrap."
        ja = "南方の伝統的な頭巻きを模し、長い金属片を重ねて作られた、頭全体を覆う兜。"
    }
    {
        en = "A full mail hood with an integrated neck guard."
        ja = "首当てと一体になった鎖帷子の頭巾。"
    }
    {
        en = "A full set of solid, plated steel armor."
        ja = "堅牢な鋼板製の全身甲冑一式。"
    }
    {
        en = "A fur covering fashioned from of a dangerous beast. It serves as a grim trophy that unnerves adversaries."
        ja = "危険な獣の毛皮を仕立てた被り物。敵を怯ませる陰惨な戦利品でもある。"
    }
    {
        en = "A gathering of absolutely correct occult readings that give insight into developing new traits. Will teach the relevant [color=%negative%]Trait[/color] perk group to the character that uses it. Can only read one skill book per brother so choose wisely. You can still read Ancient Scrolls if permitted."
        ja = "新たな特性を伸ばす手掛かりを与える、絶対に正しいオカルト文献の寄せ集め。使用した人物に、対応する[color=%negative%]特性[/color]パークグループを習得させる。技能書を読めるのは団員1人につき1冊だけなので、慎重に選ぶこと。許可されている場合は、古代の巻物を読むこともできる。"
    }
    {
        en = "A gilded visor with a pointed snout and plenty of holes to breathe through, providing great protection for a knight of high standing."
        ja = "尖った口先と多数の呼吸孔を備えた金箔の面頬。高位の騎士にふさわしい、優れた防護をもたらす。"
    }
    {
        en = "A gnarled staff no more, the twisted roots reformed into a beautiful pattern that only the Vala can create."
        ja = "もはや節くれだっただけの杖ではない。ねじれた根は、ヴァラにしか作れない美しい模様へと生まれ変わっている。"
    }
    {
        en = "A gnarly staff carved from old and hard wood, decorated with a menacing skull, feathers and small bones. The runes on the head are intricate and tell a story that only the goblins can read."
        ja = "古く硬い木から削り出した節くれだった杖。恐ろしい頭蓋骨、羽根、小骨で飾られている。先端の精緻なルーンは、ゴブリンだけが読める物語を記している。"
    }
    {
        en = "A golden helm and facemask, showing the visage of an emperor from an age long past, imbued with mystical energies. When you hold it into the light, it almost looks as if the face were moving and making expressions of disgust."
        ja = "遥か昔の皇帝の顔をかたどった、神秘的な力を宿す黄金の兜と仮面。光にかざすと、顔が動いて嫌悪の表情を浮かべているようにさえ見える。"
    }
    {
        en = "A gracefully curved iron visor, featuring two eye-slits and a few breaths in the center."
        ja = "優美に湾曲した鉄製の面頬。二つの覗き穴と、中央にいくつかの呼吸孔がある。"
    }
    {
        en = "A great bascinet that is formed of a single encompassing plate, covering the head completely, aswell as the neck and a bit of the shoulders too. Excellent protection."
        ja = "一枚の鋼板で頭部全体を包み、首と肩の一部まで覆うグレート・バシネット。優れた防護をもたらす。"
    }
    {
        en = "A great bascinet that is formed of a single encompassing plate, covering the head completely, aswell as the neck and a bit of the shoulders too. Includes a pig-faced visor for added face-protection."
        ja = "一枚の鋼板で頭部全体を包み、首と肩の一部まで覆うグレート・バシネット。顔をさらに守る豚面型の面頬も備える。"
    }
    {
        en = "A great, curved claw used to pin down or disembowel prey. Many would pay well for such a curiosity."
        ja = "獲物を押さえつけ、はらわたを裂くための大きく湾曲した鉤爪。この珍品なら、高値を払う者も多いだろう。"
    }
    {
        en = "A hardened nasal helm with a cloth band and a tail."
        ja = "布帯と尾飾りを備えた、頑丈な鼻当て付き兜。"
    }
    {
        en = "A haunting, weathered faceplate featuring a hollow, open-mouthed expression typical of the funerary masks of the ancients."
        ja = "古代の葬送仮面に典型的な、口をぽっかり開けた虚ろな表情を刻む、風雨にさらされた不気味な面頬。"
    }
    {
        en = "A head covering made of wrapped cloth layers. Its thick folds help insulate the head against heat and dust."
        ja = "何層もの巻き布で作られた被り物。厚いひだが頭を暑さと埃から守る。"
    }
    {
        en = "A headdress adorned with a idol resembling the sun, looted from a tomb of a long dead civilization."
        ja = "遥か昔に滅びた文明の墓から略奪された、太陽を模した偶像を飾る頭飾り。"
    }
    {
        en = "A headscarf made of breathable silk, offering comfort to a desert traveler."
        ja = "通気性のよい絹で作られた頭巾。砂漠を旅する者に快適さを与える。"
    }
    {
        en = "A heap of human offal; limbs, skin, and gore, all salvaged from your fellow man, the perfect medium for your grim work. Requires constant preservation as the encroaching rot threatens to stall your efforts."
        ja = "人の臓物、手足、皮、血肉の山。同胞から集めた、陰惨な仕事にうってつけの素材だ。迫る腐敗に作業を止められぬよう、絶えず保存処置を施さねばならない。"
    }
    {
        en = "A heavy ancient helm with a once prominent side crest that has since deteriorated into a set of tattered plumes."
        ja = "かつては目立つ側面飾りを備えていた古代の重兜。今では朽ちた羽根飾りが残るだけだ。"
    }
    {
        en = "A heavy body vest of solid, plated steel designed for protecting the vitals."
        ja = "急所を守るよう設計された、堅牢な鋼板製の重い胴鎧。"
    }
    {
        en = "A heavy breastplate made of solid, plated steel, offering formidable protection at the cost of significant weight."
        ja = "堅牢な鋼板製の重い胸甲。相当な重量と引き換えに、強力な防護をもたらす。"
    }
    {
        en = "A heavy cleaver blade on top of a long shaft, used to deliver deep sweeping strikes over some distance. It might be confused for a simple and crude from weapon a layman, but the artisan who crafted this knew how to balance it perfectly."
        ja = "長柄の先に重い切断刃を取り付け、離れたところから深い薙ぎ払いを繰り出す武器。素人には単純で粗末な武器に見えるかもしれないが、これを作った職人は完璧な重量配分を心得ていた。"
    }
    {
        en = "A heavy cloth overcloak cinched with a buckled leather strap."
        ja = "革紐と留め金で締める、厚手布の上掛け。"
    }
    {
        en = "A heavy coat of small, interlocking metal scales that cover most of the body. The style and craftsmanship hint at the armor coming from a far-away region."
        ja = "小さな金属鱗を隙間なく連ね、身体の大半を覆う重い鱗鎧。その様式と出来栄えは、遥か遠方の地で作られたことを物語る。"
    }
    {
        en = "A heavy coat of thick, overlapping metal scales that are worn and missing in places, offering questionable protection for its weight."
        ja = "厚い金属鱗を重ねた重い上着。擦り減って欠けた箇所もあり、その重量に見合う防護かは疑わしい。"
    }
    {
        en = "A heavy coat of thick, overlapping metal scales, which cover most of the body."
        ja = "身体の大半を覆う、厚い金属鱗を重ねた重い上着。"
    }
    {
        en = "A heavy dome helm topped with a tail, on which the time has left its distinctive mark."
        ja = "歳月の跡が色濃く残る、尾飾り付きの重い丸鉢兜。"
    }
    {
        en = "A heavy helm made from overlapping metal plates, featuring an ornate nasal guard."
        ja = "金属板を重ねて作り、華美な鼻当てを備えた重兜。"
    }
    {
        en = "A heavy helm typical of the northern barbarians with a skull-like face mask. This piece is as massive as it is impressive."
        ja = "頭蓋骨を模した仮面を持つ、北方蛮族特有の重兜。その姿は巨大で、見る者を圧倒する。"
    }
    {
        en = "A heavy helm with a tall, bladed crest and a perforated faceplate. A battered echo of past glories of those who once bled for the entertainment of a dead empire."
        ja = "高い刃状の兜飾りと、穴を開けた面頬を備える重兜。滅びた帝国で見世物のため血を流した者たちの、色褪せ傷ついた栄光の残響である。"
    }
    {
        en = "A heavy helm with a tattered horsehair plume and dulled finish, once a symbol of a legion's iron discipline."
        ja = "擦り切れた馬毛の羽根飾りと鈍い表面を持つ重兜。かつては軍団の鉄の規律を象徴していた。"
    }
    {
        en = "A heavy lamellar harness of metal plates that provides good protection, but is very fatiguing to wear."
        ja = "金属板を連ねた重いラメラー胴具。優れた防護を得られるが、着用による疲労が非常に大きい。"
    }
    {
        en = "A heavy leather apron designed to protect the wearer's clothing from stains and fluids. Usually worn by those who tend to the dead."
        ja = "染みや体液から衣服を守るための重い革前掛け。死者の世話をする者がよく身につける。"
    }
    {
        en = "A heavy leather apron of withstanding intense heat and stray sparks. Favored by blacksmiths."
        ja = "強烈な熱と飛び散る火花に耐える重い革前掛け。鍛冶屋に好まれる。"
    }
    {
        en = "A heavy linen jacket worn by fault finders."
        ja = "咎探したちが着る、厚手の亜麻布の上着。"
    }
    {
        en = "A heavy mail hood. It features extra leather layering to help prevent chafing."
        ja = "重い鎖帷子の頭巾。革を重ね、擦れを防ぐ工夫が施されている。"
    }
    {
        en = "A heavy shirt of interlapping metal plates worn over mail."
        ja = "鎖帷子の上に着る、金属板を重ねた重い胴衣。"
    }
    {
        en = "A heavy steel helm with added bolted cheek guards that offers extensive coverage for the jaw and the temples."
        ja = "顎とこめかみを広く覆う、鋲留めの頬当てを追加した重い鋼鉄兜。"
    }
    {
        en = "A heavy tarnished thick breastplate of ancient origin that offers some protection."
        ja = "古代に作られた、分厚く重い変色した胸甲。ある程度の防護は残っている。"
    }
    {
        en = "A heavy tunic lined with a thick wolf pelt that offers decent protection."
        ja = "厚い狼皮を裏地にした重いチュニック。十分な防護を得られる。"
    }
    {
        en = "A heavy winged mace from the south. The smith who forged this weapon certainly knew what he was doing."
        ja = "南方の重いウィングド・メイス。これを鍛えた職人が確かな腕を持っていたことは疑いない。"
    }
    {
        en = "A heavy, cylindrical helm choked with rust and mold, marred by deep corrosion."
        ja = "錆と黴に覆われ、深く腐食した、重い円筒形の兜。"
    }
    {
        en = "A heavy, cylindrical helm reinforced with a cross-plate and a perforated breath, offering near-total head protection at the cost of peripheral vision."
        ja = "十字の補強板と穴を開けた呼吸口を備える、重い円筒形の兜。周辺視野と引き換えに、頭部をほぼ完全に守る。"
    }
    {
        en = "A heavy, cylindrical helm, which once belonged to a decorated knight. Incrusted with gold and precious gems, it betrays a craftsmanship which years of neglect could not diminish."
        ja = "かつて勲功ある騎士が所有していた、重い円筒形の兜。金と宝石を散りばめた造りは、長年放置されてもなお損なわれぬ職人技を示している。"
    }
    {
        en = "A heavy, deep cowl designed to hide the identity of the executioner from the vengeance of those sympathetic to the condemned. Counts as a cultist item."
        ja = "処刑された者へ同情する者の報復から、処刑人の素性を隠すための、深く垂れた重い頭巾。教団員の装備として扱われる。"
    }
    {
        en = "A heavy, dilapidated plate helm with a faceplate and a tail, belonging to a legionary of yore."
        ja = "古の軍団兵が使っていた、面頬と尾飾り付きの朽ちた重い板金兜。"
    }
    {
        en = "A heavy, exquisite metal faceplate in the shape of a face frozen in a mocking smile."
        ja = "嘲るような笑顔のまま凍りついた人面をかたどる、重く精美な金属製面頬。"
    }
    {
        en = "A heavy, padded tunic that offers decent protection."
        ja = "十分な防護を得られる、厚手の詰め物入りチュニック。"
    }
    {
        en = "A heavy, perforated metal faceplate."
        ja = "穴を開けた重い金属製面頬。"
    }
    {
        en = "A heavy, reinforced faceplate raised up to allow the user to breathe freely without obscuring his face."
        ja = "顔を隠さず自由に呼吸できるよう、上方へ持ち上げた重い補強面頬。"
    }
    {
        en = "A heavy, tarnished scale coat of ancient design, which belongs in a collection rather than on the battlefield."
        ja = "古代様式の重く変色した鱗鎧。戦場よりも収集品の棚に置くべき代物だ。"
    }
    {
        en = "A heavy, weathered faceplate depicting a stern, bearded visage from another time."
        ja = "遠い昔の厳めしい髭面を刻んだ、重く風雨にさらされた面頬。"
    }
    {
        en = "A helm with a heavy crest and jutting cheek guards, its glory faded by the passage of time."
        ja = "重い兜飾りと突き出た頬当てを備える兜。その栄華は歳月に色褪せている。"
    }
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, the beast may be dead, but it continues to mend itself even after death"
        ja = "強大な岩のウンホルトの皮と頭蓋骨で作られた兜。獣は死んだが、今なお自らを修復し続ける。"
    }
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, which continues to mend itself even after the beast's death."
        ja = "強大な岩のウンホルトの皮と頭蓋骨で作られた兜。獣が死んだ後も、自らを修復し続けている。"
    }
    {
        en = "A helmet fashioned made from the face and horns of a skin ghoul."
        ja = "スキングールの顔皮と角で作られた兜。"
    }
    {
        en = "A hollowed out reed used to shoot (toxic) darts. "
        ja = "（毒）矢を吹き出すため、中をくり抜いた葦。"
    }
    {
        en = "A holy cloak of thick, layered, warm wool that provides some protection, but is quite hefty."
        ja = "厚く重ねた暖かな羊毛で作られた聖なる外套。ある程度の防護を得られるが、かなり重い。"
    }
    {
        en = "A holy relic shield to be strapped to the shoulder, it protects the wearer both physically and spiritually. Primarily of benefit to the strong of mind."
        ja = "肩に括り付ける聖遺物の盾。肉体と魂の双方を守り、特に精神力の高い者へ恩恵をもたらす。"
    }
    {
        en = "A hood made of chain mail of southern design. Offers good protection and while leaving the face unobstructed."
        ja = "南方様式の鎖帷子で作られた頭巾。顔を遮らず、優れた防護を得られる。"
    }
    {
        en = "A hood made of chain mail with a leather brim and a cloth mask. Keeps the wearer's face obstructed while being surprisingly comfortable to wear."
        ja = "革の縁と布の覆面を備えた鎖帷子の頭巾。顔を隠しながらも、驚くほど快適に着用できる。"
    }
    {
        en = "A hood made of chain mail with a leather brim. Offers good protection and while leaving the face unobstructed."
        ja = "革の縁を備えた鎖帷子の頭巾。顔を遮らず、優れた防護を得られる。"
    }
    {
        en = "A hood made of interlocking bronze rings. Very heavy, but offers excellent protection."
        ja = "青銅の輪を組み合わせた頭巾。非常に重いが、優れた防護をもたらす。"
    }
    {
        en = "A hood of fine cloth decorated with gilded bosses."
        ja = "金箔の鋲飾りをあしらった、上質な布の頭巾。"
    }
    {
        en = "A hood worn by executioners to protect their identity and prevent retaliation. Counts as a cultist item."
        ja = "素性を隠し、報復を防ぐために処刑人がかぶる頭巾。教団員の装備として扱われる。"
    }
    {
        en = "A hooded cowl with decorated, scalloped edges that provides a quite dashing appearance."
        ja = "波形の縁飾りを施した頭巾付き肩掛け。実に洒落た姿を演出する。"
    }
    {
        en = "A hooded cowl with dour, tabbed edges that helps one stay unremarkable and unassuming."
        ja = "陰気な垂れ飾りの縁を持つ頭巾付き肩掛け。目立たず、控えめな姿を保つのに役立つ。"
    }
    {
        en = "A huge and sturdy double headed battleaxe too heavy to be used effectively by the average human."
        ja = "並の人間にはまともに扱えないほど重い、巨大で頑丈な双頭戦斧。"
    }
    {
        en = "A huge club decorated with skulls and horns, woven in patterns that betray strange meaning. For the average mercenary you just need to know that a blow will leave a person reeling and struggling for breath."
        ja = "頭蓋骨と角で飾られ、奇妙な意味を秘めた模様を編み込んだ巨大な棍棒。普通の傭兵が知っておくべきことはただ一つ――これで殴られれば、よろめき、息もできなくなる。"
    }
    {
        en = "A huge crest of colorful feathers arrayed behind a helm."
        ja = "兜の後ろへ大きく広がる、色鮮やかな巨大羽根の兜飾り。"
    }
    {
        en = "A huge quiver of arrows, required to use bows of all kinds. Is automatically refilled after each battle if you have enough ammunition."
        ja = "あらゆる弓を使うために必要な、巨大な矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A huge quiver of bolts, required to use crossbows. Is automatically refilled after each battle if you have enough ammunition."
        ja = "クロスボウを使うために必要な、巨大なボルト用矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A jacket of patched southern leather that is light enough for long journeys through the desert."
        ja = "南方の革を継ぎ合わせた上着。砂漠を長く旅できるほど軽い。"
    }
    {
        en = "A jagged harpoon, that flies true despite it's weight and size. Harder to throw and hit with, but more impactful."
        ja = "重さと大きさにもかかわらず、狙いどおり飛ぶ鋸歯付きの銛。投げにくく命中させづらいが、その一撃はより強烈だ。"
    }
    {
        en = "A jagged, intimidating arrangement of bones, fashioned by orcs into a grisly trophy."
        ja = "オークが陰惨な戦利品として組み上げた、ぎざぎざで威圧的な骨飾り。"
    }
    {
        en = "A knotted pony tail. A sign of prowess in some of the lands."
        ja = "結び目を作った馬の尾。ある土地では武勇の印とされる。"
    }
    {
        en = "A large and heavy crossbow with menacing spikes in front. It's a mystery how goblins could improve upon a miniature ballista, but here we are. It shoots stakes with enough force to knock back a target hit. Very effective against vampires."
        ja = "正面に凶悪な棘を備えた、大きく重いクロスボウ。ゴブリンが小型バリスタをどう改良したのかは謎だが、現物がここにある。杭を撃ち出し、命中した標的をノックバックさせるほどの威力を持つ。吸血鬼に非常に有効。"
    }
    {
        en = "A large bascinet covering the entirety of the head as well as the neck with plates. Offers great protection but makes it quite difficult to turn one's neck."
        ja = "頭部全体と首を板金で覆う大型のバシネット。優れた防護を得られるが、首を回すのがかなり難しくなる。"
    }
    {
        en = "A large branch whittled to a fine point. It's so unbalanced and irregular you need to use two hands just to keep it steady. Liable to snap at any moment. Deals additional damage to vampires"
        ja = "大枝の先端を鋭く削ったもの。あまりに不均衡でいびつなため、安定させるだけでも両手を使わねばならない。今にも折れそうだ。吸血鬼に追加ダメージを与える。"
    }
    {
        en = "A large cart and donkey, excellent for carrying many things, but must be protected in battle."
        ja = "大量の荷物を運べる大型の荷車とロバ。戦闘では守らなければならない。"
    }
    {
        en = "A large linen turban, worn to protect the head from the overbearing sun."
        ja = "容赦ない陽光から頭を守る、大きな亜麻布のターバン。"
    }
    {
        en = "A large patch of mail that can be added to any armor to protect the arms and the shoulders."
        ja = "どの防具にも取り付けられ、腕と肩を守る大きな鎖帷子の継ぎ当て。"
    }
    {
        en = "A large pie made from freshly sourced ingredients. Can be eaten in battle to provide up to 4 healing and fatigue recovery each turn for five turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        ja = "新鮮な材料で作った大きなパイ。戦闘中に食べると、残量に応じて5ターンのあいだ毎ターン最大4の体力と疲労を回復する。傭兵団の保管庫に残しておくと食糧として消費される。"
    }
    {
        en = "A large quiver of arrows with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a bow."
        ja = "肉を裂くための幅広い鏃を付けた大型の矢筒。ただし装甲には阻まれやすい。十分な共通矢弾があれば、戦闘終了後に自動で補充される。弓の使用中はダメージが10%増加する一方、装甲を無視するダメージが10%減少する。"
    }
    {
        en = "A large quiver of arrows with piercing tips, designed for punching through thick armor. Is automatically refilled after each battle if you have enough ammunition. Grants 30% more armor piercing, but 10% less damage while wielding a bow."
        ja = "厚い装甲を撃ち抜くための貫通鏃を付けた大型の矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。弓の使用中は装甲を無視するダメージが30%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a crossbow."
        ja = "肉を裂く幅広い鏃のボルトを収めた大型矢筒。ただし装甲には阻まれやすい。十分な共通矢弾があれば、戦闘終了後に自動で補充される。クロスボウの使用中はダメージが10%増加する一方、装甲を無視するダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage"
        ja = "装甲を貫く細い鏃のボルトを収めた大型矢筒。ただし肉体へのダメージは低い。十分な共通矢弾があれば、戦闘終了後に自動で補充される。装甲を無視するダメージが20%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage, while wielding a crossbow."
        ja = "装甲を貫く細い鏃のボルトを収めた大型矢筒。ただし肉体へのダメージは低い。十分な共通矢弾があれば、戦闘終了後に自動で補充される。クロスボウの使用中は装甲を無視するダメージが20%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large rusty patch of mail that can be added to any armor to protect the arms and the shoulders."
        ja = "どの防具にも取り付けられ、腕と肩を守る大きな錆びた鎖帷子の継ぎ当て。"
    }
    {
        en = "A large square shield that offers excellent protection for yourself and others, very heavy and hard to maneuver"
        ja = "自分と周囲の者へ優れた防護をもたらす大きな方形盾。非常に重く、取り回しにくい。"
    }
    {
        en = "A large square shield that offers excellent protection for yourself and others. It is stout, heavy and broad - offering excellent protection from attacks aimed at the sides."
        ja = "自分と周囲の者へ優れた防護をもたらす大きな方形盾。堅牢で重く幅広く、側面から狙われた攻撃に対しても優れた防護を発揮する。"
    }
    {
        en = "A large stick attached with a short chain to a long pole, the Peasant Flail is an agricultural tool used to strike piles of grain to loosen the husks. As an improvised weapon it's rather unpredictable but useful to strike over or around shield cover."
        ja = "長い柄に短い鎖で大きな打ち棒をつないだ農民用フレイル。本来は穀物の山を打って殻を外す農具である。即席武器としては予測しづらいが、盾越しや盾の回りから打ち込むのに役立つ。"
    }
    {
        en = "A larger, broader ancient spear with a leaf-shaped head. It is much heavier than it's counterparts, but leaves a significantly larger wound at the cost of penetrating power."
        ja = "葉形の穂先を備えた、より大きく幅広い古代の槍。同類よりはるかに重く、貫通力を犠牲にして大きな傷を残す。"
    }
    {
        en = "A lavish crested heraldic ornament of a noble house, leaving no doubt as to the wearer's allegiance."
        ja = "貴族家の紋章をあしらった豪奢な兜飾り。着用者がどの家に属するか、一目で分かる。"
    }
    {
        en = "A leather armor reinforced with metal rivets. Fatiguing to wear."
        ja = "金属鋲で補強した革鎧。着用による疲労が大きい。"
    }
    {
        en = "A leather jacket that offers modest protection against the elements and light physical harm."
        ja = "風雨と軽い怪我からそこそこ身を守る革の上着。"
    }
    {
        en = "A leather tunic caked and crusted with dried remnants of past executions."
        ja = "過去の処刑で飛び散ったものが乾き、こびりついた革のチュニック。"
    }
    {
        en = "A legendary white wolf, tamed to be a loyal companion in battle. Can be unleashed in battle."
        ja = "戦闘で忠実に付き従うよう飼い慣らされた、伝説的な白狼。戦闘中に解き放てる。"
    }
    {
        en = "A length of intertwined metal links. As a weapon it's ungainly and rather unpredictable but useful to spin, strike around shield cover and pull in enemies."
        ja = "金属の輪を絡み合わせた一本の鎖。武器としては扱いづらく予測しにくいが、振り回して盾の回りから打ち込み、敵を引き寄せるのに役立つ。"
    }
    {
        en = "A light and well made checkered tunic of southern origin."
        ja = "南方由来の、軽く仕立てのよい市松模様のチュニック。"
    }
    {
        en = "A light armet without a visor."
        ja = "面頬のない軽いアーメット。"
    }
    {
        en = "A light cap of quilted linen, providing a layer of padding for the head and the neck."
        ja = "キルティングした亜麻布の軽い帽子。頭と首を守る緩衝層となる。"
    }
    {
        en = "A light cap of quilted linen, providing a layer of padding for the head."
        ja = "キルティングした亜麻布の軽い帽子。頭を守る緩衝層となる。"
    }
    {
        en = "A light cloth wrap for the head. A practical choice for shielding oneself from the sun and dust."
        ja = "頭を覆う軽い巻き布。陽光と埃から身を守る実用品。"
    }
    {
        en = "A light helmet made from the carapace of a redback spider."
        ja = "レッドバック蜘蛛の甲殻で作られた軽兜。"
    }
    {
        en = "A light metal helm with a nose guard."
        ja = "鼻当てを備えた軽い金属兜。"
    }
    {
        en = "A light tailed cloth head wrap bound by a gilded band."
        ja = "金箔の帯で留めた、尾のように垂れる軽い布の頭巻き。"
    }
    {
        en = "A light yet durable replacement padding crafted from exotic materials."
        ja = "異国の素材で作られた、軽く丈夫な交換用の詰め物。"
    }
    {
        en = "A light, ceremonial version of a two-handed cleaver with a curved end, adorned with gold inlay and odd motifs."
        ja = "湾曲した先端を持つ両手持ちクリーバーの軽量な儀礼用モデル。金象嵌と奇妙な文様で飾られている。"
    }
    {
        en = "A light, feathered cloth with featuring a thin face mask."
        ja = "薄い覆面を備えた、羽根飾り付きの軽い布製被り物。"
    }
    {
        en = "A lightweight, curved sword good at piercing armor and delivering wicked strikes."
        ja = "軽く湾曲し、装甲を貫いて凶悪な一撃を与えるのに適した剣。"
    }
    {
        en = "A lightweight, flowing cloak of spider silk. It offers excellent protection against poison and ranged attacks."
        ja = "蜘蛛の糸で作られた、軽くたなびく外套。毒と遠隔攻撃に対し、優れた防護をもたらす。"
    }
    {
        en = "A linen sash and belt previously worn by followers of the Diviner."
        ja = "占術師の信奉者がかつて身につけていた、亜麻布の肩帯と腰帯。"
    }
    {
        en = "A lion crested crown belonging to a king of a long dead civilization."
        ja = "遥か昔に滅びた文明の王が所有していた、獅子の意匠を頂く冠。"
    }
    {
        en = "A long and heavy mail shirt of southern design made with slightly thinner and lighter metal rings than those used in the north"
        ja = "北方で使われるものよりやや細く軽い金属環で作られた、南方様式の長く重い鎖帷子。"
    }
    {
        en = "A long and sturdy glaive built for heavy combat, used to thrust, deal sweeping strikes over some distance and slashes in close range."
        ja = "激しい戦闘向けに作られた、長く頑丈なグレイヴ。離れたところからの刺突と薙ぎ払い、近距離での斬撃に用いられる。"
    }
    {
        en = "A long curved blade adorned with gold inlays depicting a variety of subjects from harvests to battles. It is a much lighter weapon than expected and clearly served a ceremonial purpose."
        ja = "収穫から戦争まで、さまざまな題材を描く金象嵌を施した長い湾曲刀。見た目よりはるかに軽く、明らかに儀礼用として作られている。"
    }
    {
        en = "A long leather coat reinforced with large metal rivets offering good protection, but very fatiguing to wear."
        ja = "大きな金属鋲で補強した長い革外套。優れた防護をもたらすが、着用による疲労が非常に大きい。"
    }
    {
        en = "A long nosed iron faceplate assuring great ventilation."
        ja = "通気性に優れた、長い鼻先を持つ鉄製の面頬。"
    }
    {
        en = "A long shard of sharpened rock firmly wedged into a massive bone. Not well suited for human hands. "
        ja = "巨大な骨に、鋭く尖らせた長い岩片をしっかり打ち込んだもの。人間の手には向かない。"
    }
    {
        en = "A long tail of horsehair used to crest helms."
        ja = "兜飾りに使う、長い馬毛の尾。"
    }
    {
        en = "A long, exceptionally well crafted two-handed axe used by footmen in the noble wars"
        ja = "貴族戦争で歩兵が使った、長く並外れて出来のよい両手斧。"
    }
    {
        en = "A long, oversized hood that keeps the rain off the neck."
        ja = "首筋を雨から守る、長く大きすぎる頭巾。"
    }
    {
        en = "A long, sturdy and tunic of southern origin that offers decent protection."
        ja = "南方由来の、長く頑丈で十分な防護を得られるチュニック。"
    }
    {
        en = "A long, sturdy coat reinforced with metal studs that offers good protection."
        ja = "金属鋲で補強した、長く頑丈な上着。優れた防護をもたらす。"
    }
    {
        en = "A long, sturdy tunic of southern origin that is split at the bottom."
        ja = "裾に切れ込みを入れた、南方由来の長く頑丈なチュニック。"
    }
    {
        en = "A long, two-handed axe that doubles as a very heavy fan"
        ja = "極めて重い扇としても使える、長い両手斧。"
    }
    {
        en = "A long, two-handed axe used by footmen in the noble wars"
        ja = "貴族戦争で歩兵が使った、長い両手斧。"
    }
    {
        en = "A low, broad-rimmed metal helm, rusted and dented."
        ja = "低く広い縁を持つ、錆びてへこんだ金属兜。"
    }
    {
        en = "A luxurious pelt of a rare beast, turned by a taxidermist into a regal head covering."
        ja = "希少な獣の豪奢な毛皮を、剥製師が威厳ある被り物へ仕立てたもの。"
    }
    {
        en = "A luxurious striped tabard made of a sturdy material, reinforced at seams with pure gold."
        ja = "丈夫な素材で作り、縫い目を純金で補強した豪奢な縞模様のタバード。"
    }
    {
        en = "A mail aventail that extends from below the eyeline to cover the neck and lower face."
        ja = "目の下から首と顔の下半分まで覆う、鎖帷子のアヴェンテイル。"
    }
    {
        en = "A mail hood covered in a layer of rust. Offers good protection, but leaves horrible stains."
        ja = "錆に覆われた鎖帷子の頭巾。優れた防護をもたらすが、ひどい染みが付く。"
    }
    {
        en = "A mail hood of southern design with a reinforced circular face opening."
        ja = "顔周りの円形開口部を補強した、南方様式の鎖帷子の頭巾。"
    }
    {
        en = "A makeshift weapon fashioned from a rusty metal scrap wrapped in cloth. Fit only for the desperate or deranged."
        ja = "錆びた金属片を布で巻いて作った間に合わせの武器。自暴自棄か正気を失った者にしかふさわしくない。"
    }
    {
        en = "A massive ancient hammer with two ram heads making up both faces of the weapon. It is deceptively heavy and somehow increases in weight between each swing."
        ja = "両方の打面を雄羊の頭が形作る、巨大な古代の鎚。見た目以上に重く、振るたびになぜか重さを増していく。"
    }
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Not well suited for human hands."
        ja = "無垢の鉄塊を頭部にした、巨大で粗末な鎚。人間の手には向かない。"
    }
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Too heavy to be used effectively by the average human."
        ja = "無垢の鉄塊を頭部にした、巨大で粗末な鎚。重すぎて、並の人間にはまともに扱えない。"
    }
    {
        en = "A massive iron chain with a heavy piece at the end. Too heavy to be used effectively by the average human."
        ja = "先端に重い錘を付けた巨大な鉄鎖。重すぎて、並の人間にはまともに扱えない。"
    }
    {
        en = "A massive two-handed blade as good for carving swathes through the enemy as for battering them into submission."
        ja = "敵陣を薙ぎ払うにも、殴り伏せて降伏させるにも適した巨大な両手剣。"
    }
    {
        en = "A massive wooden club with a spiked head. Receiving a blow from this weapon will leave anyone dazed and gasping for air."
        ja = "棘付きの頭部を持つ巨大な木製棍棒。この武器の一撃を受ければ、誰であれ朦朧とし、息を切らすことになる。"
    }
    {
        en = "A massive, crudely sharpened shard of metal that makes up for its stunted length through sheer weight. So heavy no average human can use it effectively."
        ja = "短さを純粋な重量で補う、巨大で粗く研がれた金属片。あまりに重く、並の人間にはまともに扱えない。"
    }
    {
        en = "A mastercrafted heavy padded tunic that offers excellent protection."
        ja = "名匠が仕立てた、優れた防護をもたらす重い詰め物入りチュニック。"
    }
    {
        en = "A mastercrafted two-piece barbute helm, meticulously joined and well-maintained."
        ja = "二枚を丹念につなぎ合わせ、手入れも行き届いた、名匠作のバルビュート兜。"
    }
    {
        en = "A masterfully crafted glaive that feels surprisingly light, yet sturdy."
        ja = "驚くほど軽く、それでいて頑丈な、名匠作のグレイヴ。"
    }
    {
        en = "A masterfully crafted harness of solid, plated steel, finished with a layer of decorative paint."
        ja = "名匠が仕立てた、堅牢な鋼板製の全身甲冑。装飾塗装で仕上げられている。"
    }
    {
        en = "A masterfully crafted harness of solid, plated steel."
        ja = "名匠が仕立てた、堅牢な鋼板製の全身甲冑。"
    }
    {
        en = "A masterwork leather armor made from overlapping lindwurm scales. Not only do the scales deflect blows and hits, but they also remain unscathed by the acidic Lindwurm blood."
        ja = "リントヴルムの鱗を重ねて作られた名匠作の革鎧。鱗は打撃を逸らすだけでなく、リントヴルムの酸性の血を浴びても傷ひとつ付かない。"
    }
    {
        en = "A masterwork metal helm with a spiked conical crown and a reinforced nasal guard, crested by twin feathers. Light yet sturdy."
        ja = "棘のある円錐形の鉢、補強した鼻当て、二枚の羽根飾りを備えた名匠作の金属兜。軽く、しかも頑丈である。"
    }
    {
        en = "A metal armguard that provides additional protection, used by gladiators in fighting pits."
        ja = "闘技場の剣闘士が使う、追加の防護をもたらす金属製の腕当て。"
    }
    {
        en = "A metal cervelliere with a deep, rounded bowl and bolted cheek guards, providing good protection."
        ja = "深く丸い鉢と鋲留めの頬当てを備え、優れた防護をもたらす金属製セルヴェリエール。"
    }
    {
        en = "A metal faceplate in the shape of a human face."
        ja = "人の顔をかたどった金属製の面頬。"
    }
    {
        en = "A metal faceplate with an aggressive profile designed to deflect blows away from the wearer's face."
        ja = "攻撃を着用者の顔から逸らすよう、威圧的な輪郭に作られた金属製面頬。"
    }
    {
        en = "A metal helm with a broad rim, popular among the soldiers."
        ja = "幅広い縁を持つ金属兜。兵士の間で広く使われている。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a faceplate and a neck guard."
        ja = "翼をかたどった金属製の顎当て。面頬と首当ても備える。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a faceplate."
        ja = "翼をかたどった金属製の顎当て。面頬も備える。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a neck guard."
        ja = "翼をかたどった金属製の顎当て。首当ても備える。"
    }
    {
        en = "A metal mask covering the eyes and nose from blows."
        ja = "目と鼻を打撃から守る金属製の仮面。"
    }
    {
        en = "A metal sallet helm with an extended neck guard, a design uncommon in these lands. Well crafted to offer maximum protection with minimum weight, and without impairing vision."
        ja = "この地では珍しい、長い首当てを備えた金属製サレット。視界を妨げず、最小限の重量で最大限の防護を得られるよう、巧みに作られている。"
    }
    {
        en = "A metal skull cap topped with a fashionable spike."
        ja = "流行の棘飾りを頂いた、金属製の鉢金。"
    }
    {
        en = "A metal weight attached with a short chain to a long pole, the War Flail is a brutal weapon. Deadly enough to fell most men with a good hit to the head, and useful to strike over or around shield cover."
        ja = "長い柄に短い鎖で金属錘をつないだ、残忍な軍用フレイル。頭へまともに当たれば大抵の者を倒せるほど致命的で、盾越しや盾の回りから打ち込むのにも役立つ。"
    }
    {
        en = "A military grade metal-reinforced club with a spike at the top. Can be used to thrust at the enemy, or pummel them into submission."
        ja = "軍用に作られた、金属補強と頂部の棘を持つ棍棒。敵を突くことも、殴り伏せて降伏させることもできる。"
    }
    {
        en = "A miniature pull-lever crossbow that can propel bolts over medium distances attached to the wrist. The small size reduces power, but doesn't impede the hands so a melee weapon can be held in both hands. Requires almost a full turn to reload."
        ja = "手首に装着し、中距離までボルトを飛ばせる小型のレバー式クロスボウ。小さいため威力は劣るが、両手を妨げず、近接武器を両手で握れる。再装填にはほぼ1ターンを要する。"
    }
    {
        en = "A modest head covering of the women of the cloth, its white lining symboling purity and innocence."
        ja = "聖職に就く女性の慎ましい被り物。白い裏地は純潔と無垢を象徴する。"
    }
    {
        en = "A musical instrument, can produce inspiring rythms, if you have the skill. The drum sticks make weak maces in a pinch."
        ja = "腕さえあれば、仲間を奮い立たせるリズムを奏でられる楽器。いざというときには、撥を弱いメイスとして使える。"
    }
    {
        en = "A mysterious cat that seems all too intelligent"
        ja = "不自然なほど知性が高そうな、謎めいた猫。"
    }
    {
        en = "A nasal helm with an attached tail fashioned in the way of the steppe folks."
        ja = "草原の民の様式で作られた尾飾り付きの鼻当て兜。"
    }
    {
        en = "A neckguard of cured leather capable of softening a blow that could otherwise prove lethal."
        ja = "本来なら致命傷となる一撃を和らげられる、なめし革の首当て。"
    }
    {
        en = "A net provided by barbarian tribe, used to bind unholds. Tainted with secret poison, it makes [color=%negative%]dazed[/color], [color=%negative%]baffled[/color] or with less than 25% Healthpoints Unholds docile when trapped."
        ja = "蛮族の部族から提供された、ウンホルトを拘束するための網。秘密の毒が塗られており、[color=%negative%]朦朧[/color]、[color=%negative%]困惑[/color]状態、または体力が25%未満のウンホルトを捕らえると従順にする。"
    }
    {
        en = "A noisy spiked mail collar offering a modicum of defense."
        ja = "わずかな防護をもたらす、じゃらじゃらとうるさい棘付き鎖帷子の首輪。"
    }
    {
        en = "A nordic helm guarding face and neck with additional metal plates."
        ja = "顔と首を追加の金属板で守る北方風の兜。"
    }
    {
        en = "A nordic helm with a metal face mask and cheek guards."
        ja = "金属製の仮面と頬当てを備えた北方風の兜。"
    }
    {
        en = "A very disagreeable and cacophonous chant can makes it almost impossible for enemies to focus and concentrate properly."
        ja = "耳障りな不協和音の詠唱により、敵はまともに集中することがほぼ不可能になる。"
    }
    {
        en = "Activating this Perk will grant the following Perk Group:\n"
        ja = "このパークを有効化すると、以下のパークグループを獲得する：\n"
    }
    {
        en = "Activating this Perk will randomly grant one of the following Perk Groups:\n"
        ja = "このパークを有効化すると、以下のパークグループからランダムに1つ獲得する：\n"
    }
    {
        en = "Allows you to use throwing weapons in melee"
        ja = "近接戦闘中でも投擲武器を使用できる"
    }
    {
        en = "An intriguing chant that stimulates the senses."
        ja = "興味をそそり、感覚を刺激する詠唱。"
    }
    {
        en = "Ancient Southern Face Mask"
        ja = "古代南方の仮面"
    }
    {
        en = "Crafting"
        ja = "製作"
    }
    {
        en = "Don't fire until you see the whites of their eyes!"
        ja = "敵の白目が見えるまで撃つな！"
    }
    {
        en = "Fishermen and Ratcatchers can develop powerful net skills."
        ja = "漁師と鼠捕りは、強力な投網の技術を習得できる。"
    }
    {
        en = "Fluid"
        ja = "流麗"
    }
    {
        en = "Fluid like water!\n\nThis character will follow up main hand attacks with an attack from their off hand, if possible."
        ja = "水のように流麗に！\n\n可能なら、主手の攻撃に続けて逆手で追撃する。"
    }
    {
        en = "Follow-up attack: [color=%negative%]Disabled[/color]"
        ja = "追撃：[color=%negative%]無効[/color]"
    }
    {
        en = "Hold your ground!"
        ja = "その場を死守せよ！"
    }
    {
        en = "Hold yourself in a way that makes you seem more trouble than its worth, lean into trees, place objects between you and an enemy, and hide behind allies."
        ja = "襲うには割に合わない相手だと思わせるように振る舞い、木に身を寄せ、敵との間に物を置き、味方の陰に隠れる。"
    }
    {
        en = "If the Vala is successful in her dealings with these harmful spirits, they will haunt and weaken her opponents. Lowers damage, lowers maximum fatigue, increases fatigue cost for skills."
        ja = "ヴァラが害意ある霊との交渉に成功すると、霊は敵に取り憑いて弱体化させる。与ダメージと最大疲労値を低下させ、スキルの疲労コストを増加させる。"
    }
    {
        en = "If this character take damage, they have a chance to rally. The chance is equal to half their resolve."
        ja = "ダメージを受けると、士気を立て直すことがある。その確率は精神力の半分に等しい。"
    }
    {
        en = "If you would get Staggered instead remove a stack of Anchor"
        ja = "よろめき状態になる代わりに、「アンカー」のスタックを1つ消費する"
    }
    {
        en = "Immune to the effects of fresh injuries, and not upset by health losses."
        ja = "新たに負った負傷の影響を受けず、体力が減っても士気が下がらない。"
    }
    {
        en = "Increases the character's action points by [color=%positive%]1[/color]."
        ja = "行動力が[color=%positive%]1[/color]増加する。"
    }
    {
        en = "Leveraging the superior fit of %their% armor, %name% is gaining increased speed and endurance."
        ja = "身体によく合う%their%防具を活かし、%name%は素早さと持久力を高める。"
    }
    {
        en = "Lithe like a lizard! %name% is able to partially deflect attacks at the last moment, turning them into glancing hits."
        ja = "トカゲのようにしなやかに！ %name%は攻撃を寸前で逸らし、かすめるだけの一撃に変える。"
    }
    {
        en = "Makes enemies less likely to attack you instead of an ally."
        ja = "敵が味方ではなくこの人物を攻撃対象に選ぶ可能性が下がる。"
    }
    {
        en = "Melee Damage bonus [color=%negative%]halved[/color] due to not being engaged in melee"
        ja = "近接戦闘中ではないため、近接ダメージボーナスが[color=%negative%]半減[/color]"
    }
    {
        en = "The Melee Damage bonus will be [color=%negative%]halved[/color] when not engaged in melee"
        ja = "近接戦闘中でない場合、近接ダメージボーナスは[color=%negative%]半減[/color]する"
    }
    {
        en = "This character does not have enough resolve to benefit from Mind Over Body."
        ja = "精神力が足りず、「精神は肉体を凌駕する」の恩恵を得られない。"
    }
    {
        en = "This character has mastered the use of a shield. Even when they are hit, they are able to partially deflect the impact and reduce the damage. Their dedicated practice has made forming a shieldwall as natural as breathing for them."
        ja = "この人物は盾の扱いを極めている。攻撃を受けても衝撃をいなし、ダメージを軽減できる。絶え間ない鍛錬により、盾壁を組む動作は呼吸するほど自然なものとなった。"
    }
    {
        en = "This character has too much combined Hitpoints and Armor to make use of this perk."
        ja = "体力と装甲の合計値が高すぎるため、このパークを活用できない。"
    }
    {
        en = "This character is keen to guard the horde of gold the company has accumulated — and intends to protect it with their life."
        ja = "この人物は傭兵団が蓄えた金の山を守ることに執着し、命を懸けてでも守り抜こうとしている。"
    }
    {
        en = "This character is not wearing any body armor and hence receives no bonus damage reduction"
        ja = "胴防具を着用していないため、ダメージ軽減効果を得られない"
    }
    {
        en = "This character is not wearing any body armor and hence receives no bonus from this perk"
        ja = "胴防具を着用していないため、このパークの恩恵を得られない"
    }
    {
        en = "This character is not wearing any body armor and receives no bonus from this perk."
        ja = "胴防具を着用していないため、このパークの恩恵を得られない。"
    }
    {
        en = "True berserkers shed even their clothes in the pursuit of unadaulterated primal slaughter. Gain nimble if you have no clothes or helm. Stacks with nimble"
        ja = "真の狂戦士は、むき出しの本能で殺戮に身を投じるためなら衣服すら脱ぎ捨てる。胴防具も兜も装備していなければ「身軽」の効果を得る。この効果はパーク「身軽」と累積する。"
    }
    {
        en = "Until the start of her next turn all allies within 3 tiles of the Vala receive a bonus to their damage output and a chance to retaliate against attackers that hit them in melee range. Being closer to the Vala increases bonus amount and retaliation chance."
        ja = "ヴァラの次のターン開始時まで、ヴァラから1～3マスの味方は与ダメージが増加し、近接攻撃を命中させた敵へ反撃する可能性を得る。ヴァラに近いほど、ボーナス量と反撃率が高まる。"
    }
    {
        en = "Until the start of her next turn all allies within 3 tiles of the Vala receive a bonus to their melee and ranged defenses. Being closer to the Vala increases the bonus amount"
        ja = "ヴァラの次のターン開始時まで、3マス以内の味方は近接防御と射撃防御が増加する。ヴァラに近いほどボーナス量が高まる。"
    }
    {
        en = "Until the start of her next turn, enemies within 3 tiles of the Vala will receive a reduction to Initiative. Being closer to the Vala increases the strength of the Chant"
        ja = "ヴァラの次のターン開始時まで、ヴァラから2～4マス離れた敵は先制値が低下する。2マスの敵への効果が最も強く、遠ざかるほど弱まる。"
    }
    {
        en = "Use your built up inertia to wreak havoc on the next swing."
        ja = "蓄えた勢いを次の一振りに乗せ、大打撃を与える。"
    }
    {
        en = "Use your physique to minimize your hit profile."
        ja = "体格を活かし、敵にさらす面積を最小限にする。"
    }
    {
        en = "Years of practice lead this character to fall back to %their% instincts and basic training under extreme stress."
        ja = "極度の重圧にさらされると、長年の鍛錬により、この人物は%their%本能と基礎訓練に立ち返る。"
    }
    {
        en = "You can edit what you see on the Tactical Tooltip"
        ja = "戦術ツールチップに表示される内容を変更できます"
    }
    {
        en = "[color=%negative%]Already chanting.[/color]"
        ja = "[color=%negative%]すでに詠唱中。[/color]"
    }
    {
        en = "[color=%negative%]Already chanting[/color]"
        ja = "[color=%negative%]すでに詠唱中[/color]"
    }
    {
