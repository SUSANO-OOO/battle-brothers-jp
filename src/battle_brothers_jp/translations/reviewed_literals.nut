    }
    {
        en = "Welcome aboard, I suppose."
        ja = "ようこそ……でいいのかな。"
    }
    {
        en = "Welcome aboard, assassin."
        ja = "ようこそ、暗殺者。"
    }
    {
        en = "Welcome aboard, you horse whore."
        ja = "ようこそ、この馬狂いのアバズレめ。"
