        ja = "自分たちで片をつけるしかない。"
    }
    {
        en = "We'll hire more guards and then some!"
        ja = "護衛を増やそう。ありったけ雇うぞ！"
    }
    {
        en = "We'll keep an eye out."
        ja = "気に留めておこう。"
    }
    {
        en = "We'll leave you guys to it."
        ja = "あとはお前たちに任せる。"
    }
    {
