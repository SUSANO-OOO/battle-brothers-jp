        en = "Use Bandages"
        ja = "包帯を使う"
    }
    {
        en = "Use everything at your disposal to free a nearby ally from what is holding them in place. Hack, slash, cut or gnaw at it if need be!"
        ja = "手近なものを総動員して、近くの味方を拘束しているものから解放する。必要なら叩き、斬り、切り裂き、噛みちぎれ！"
    }
