        ja = "脚の火傷"
    }
    {
        en = "Burnt hands severly reduce the ability to make swift and precise motions. Also, it stings like hell."
        ja = "両手の火傷により、素早く正確な動きが著しく妨げられている。しかも、地獄のように痛む。"
    }
    {
        en = "Butcher"
        ja = "肉屋"
