    {
        mode = "pattern"
        en = "Always inflicts at least <damage:int_tag> damage to hitpoints, regardless of armor"
        ja = "装甲にかかわらず、必ず体力へ最低<damage>ダメージを与える"
    }
    {
        mode = "pattern"
        en = "Attacks that miss have <open:tag>50%<close:tag> of their Fatigue cost refunded"
        ja = "攻撃を外した場合、消費した疲労の<open>50%<close>が回復する"
    }
    {
        mode = "pattern"
        en = "Grants <open:tag>+40%<close:tag> Damage in Melee"
        ja = "近接ダメージ<open>+40%<close>"
    }
    {
        mode = "pattern"
        en = "Grants <open:tag>-40%<close:tag> Melee Defense"
