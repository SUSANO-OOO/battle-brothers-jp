    }
    {
        mode = "pattern"
        en = "Has a range of <range:int_tag> tiles on even ground, more if shooting downhill"
        ja = "平地では射程<range>マス。低所へ撃ち下ろす場合はさらに長くなる"
    }
    {
        mode = "pattern"
        en = "Inflicts <fatigue:int_tag> extra fatigue"
        ja = "追加で<fatigue>の疲労を与える"
    }
    {
        mode = "pattern"
        en = "Only receive <armor_multiplier:val_tag> of any damage to armor from attacks"
        ja = "攻撃で受ける装甲ダメージは<armor_multiplier>のみ"
    }
    {
        mode = "pattern"
        en = "Specialize in heavy armor! Armor damage taken is reduced by a percentage equal to <open:tag>5%<close:tag> of the current total armor value of both body and head armor. The heavier your armor and helmet, the more you benefit."
        ja = "重装備を極める！ 攻撃で受ける装甲ダメージを、現在の頭部と胴体の装甲値合計の<open>5%<close>に等しい割合だけ軽減する。胴防具と兜の装甲値が高いほど効果は大きい。"
    }
    {
        mode = "pattern"
        en = "This character has been charmed. He no longer has any control over his actions and is a puppet that has no choice but to obey his master. Wears off in <turns:int_tag> turn(s).\n\nThe higher a character's resolve, the higher the chance to resist being charmed."
        ja = "この団員は魅了されている。もはや自分の行動を制御できず、主人の命令に従うほかない操り人形となった。あと<turns>ターンで効果が切れる。\n\n精神力が高いほど、魅了に抵抗できる確率も高くなる。"
    }
    {
        mode = "pattern"
        en = "This character has been chilled to the bone by cold. With their limbs frozen stiff, it takes a great deal of effort to move in a coordinated fashion. The effect will slowly wear off over <turns:int_tag> more turn(s)."
        ja = "この団員は冷気に骨の髄まで凍え、四肢がこわばっているため、思うように体を動かすにも大きな労力を要する。効果はあと<turns>ターンかけて徐々に薄れる。"
    }
    {
        mode = "pattern"
        en = "This character has been temporarily disarmed for <turns:int_tag> more turn(s) and is unable to use any weapon skills. Switching to a different weapon will remove this effect immediately."
        ja = "この団員はあと<turns>ターンの間、一時的に武装解除され、武器スキルを使用できない。別の武器へ持ち替えると、この効果は即座に解除される。"
    }
    {
        mode = "pattern"
        en = "This character has received so heavy a blow that they are dazed, confused and gasping for air. Will wear off in <turns:int_tag> turn(s)."
        ja = "この団員は強烈な一撃を受け、朦朧とし、混乱して息を切らしている。あと<turns>ターンで効果が切れる。"
    }
    {
        mode = "pattern"
        en = "This character has taken antidote and is immune to any kind of poison for another <turns:int_tag> turn(s)."
        ja = "この団員は解毒剤を服用しており、あと<turns>ターンはあらゆる毒に免疫を持つ。"
    }
    {
        mode = "pattern"
        en = "This character is adapting fast to their opponent's moves and gains an additional <hit_bonus:val_tag> chance to hit with any attack."
        ja = "敵の動きに素早く適応しており、あらゆる攻撃の命中率がさらに<hit_bonus>上昇する。"
    }
    {
        mode = "pattern"
        en = "This character is bleeding profusely from a recently received wound and will lose <damage:val_tag> hitpoints each turn for <turns:int_tag> more turn(s)."
        ja = "この団員は負ったばかりの傷から激しく出血しており、毎ターン体力を<damage>失う。この出血はあと<turns>ターン続く。"
    }
    {
        mode = "pattern"
        en = "This character is using the superior reach of their melee weapon to keep opponents at bay, increasing Melee Defense by <defense_bonus:int_tag> until their next turn."
        ja = "近接武器の長い間合いで敵を寄せつけず、次の自分のターンまで近接防御が<defense_bonus>上昇している。"
    }
    {
        mode = "pattern"
        en = "This character was on the receiving end of a dirty trick. Distracted for <turns:int_tag> more turn(s), they are slower to react and have a harder time landing clean strikes."
        ja = "この団員は卑劣な手口を食らった。あと<turns>ターンの間は注意をそらされ、反応が鈍り、正確な一撃を当てにくくなる。"
    }
    {
        mode = "pattern"
        en = "This character's armor has been sprayed with a Lindwurm's acidic blood, which is now slowly eating away at it for another <turns:int_tag> turn(s)."
        ja = "この団員の防具にはリントヴルムの酸性の血が浴びせられ、あと<turns>ターンかけて徐々に侵食される。"
    }
