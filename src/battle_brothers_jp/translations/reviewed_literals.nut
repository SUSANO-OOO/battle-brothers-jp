        ja = "その男を解放しろ！"
    }
    {
        en = "Frightened to death"
        ja = "恐怖で死んだ"
    }
    {
        en = "From dust to finding dust."
        ja = "塵から、塵を探す旅へ。"
    }
    {
        en = "From the brink a broken man must be saved."
        ja = "壊れた男を瀬戸際から救わねばならない。"
