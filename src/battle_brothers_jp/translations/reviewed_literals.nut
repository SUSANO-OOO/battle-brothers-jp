    {
        en = "Helped spread word about the company"
        ja = "傭兵団の評判を広めるのを手伝った"
    }
    {
        en = "Helped their men conscript some peasants"
        ja = "彼らの兵が農民を徴兵するのを手伝った"
    }
    {
        en = "Heraldic Mail"
        ja = "紋章付き鎖帷子"
