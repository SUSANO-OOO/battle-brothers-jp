    }
    {
        en = "Do as you wish, as long as you don't forget what I hired you to do."
        ja = "雇われた仕事を忘れないなら、好きにしろ。"
    }
    {
        en = "Do it, and use whatever means necessary."
        ja = "やれ。必要ならどんな手段でも使え。"
    }
    {
