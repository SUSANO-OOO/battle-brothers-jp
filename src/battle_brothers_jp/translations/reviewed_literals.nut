        ja = "喧嘩屋"
    }
    {
        en = "Brawlers are unmatched in unarmed combat, and physical exercise tends to leave them in good shape."
        ja = "喧嘩屋は素手の戦いでは並ぶ者がなく、日々の鍛錬で体もよく鍛えられている。"
    }
    {
        en = "Break Free"
        ja = "脱出"
    }
    {
        en = "Brigand Hunters"
