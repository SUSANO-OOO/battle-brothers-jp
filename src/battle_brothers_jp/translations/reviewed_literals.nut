    {
        mode = "pattern"
        en = "Always inflicts at least <damage:int_tag> damage to hitpoints, regardless of armor"
        ja = "装甲にかかわらず、必ず体力へ最低<damage>ダメージを与える"
    }
    {
        mode = "pattern"
        en = "Attacks that miss have <open:tag>50%<close:tag> of their Fatigue cost refunded"
        ja = "攻撃を外した場合、消費した疲労の<open>50%<close>が回復する"
    }
    {
        mode = "pattern"
        en = "Grants <open:tag>+40%<close:tag> Damage in Melee"
        ja = "近接ダメージ<open>+40%<close>"
    }
    {
        mode = "pattern"
        en = "Grants <open:tag>-40%<close:tag> Melee Defense"
        ja = "近接防御<open>-40%<close>"
    }
    {
        mode = "pattern"
        en = "Grants <open:tag>-40%<close:tag> Ranged Defense"
        ja = "射撃防御<open>-40%<close>"
    }
    {
        mode = "pattern"
        en = "Has <accuracy:val_tag> chance to hit, and <distance_penalty:val_tag> per tile of distance"
        ja = "命中率に<accuracy>、さらに距離1マスごとに<distance_penalty>の補正"
    }
    {
        mode = "pattern"
        en = "Has <ammo:int_tag> arrows left"
        ja = "矢の残数<ammo>"
    }
    {
        mode = "pattern"
        en = "Has <hit_bonus:val_tag> chance to hit"
        ja = "命中率<hit_bonus>"
    }
    {
        mode = "pattern"
        en = "Has <open:tag>-15%<close:tag> chance to hit targets directly adjacent because the weapon is too unwieldy"
        ja = "武器が扱いにくいため、直接隣接する対象への命中率が<open>-15%<close>低下する"
    }
    {
        mode = "pattern"
        en = "Has a <chance:val_tag> chance to succeed, based on Melee Skill, or higher if there's been attempts to free the ally before."
        ja = "近接技能に基づき、成功率は<chance>。それまでにも味方の解放を試みていれば、さらに高くなる。"
    }
    {
        mode = "pattern"
        en = "Has a <chance:val_tag> chance to succeed, based on Melee Skill. Each failed attempt will increase the chance to succeed for subsequent attempts."
        ja = "近接技能に基づき、成功率は<chance>。失敗するたび、次の試行の成功率が上昇する。"
    }
    {
        mode = "pattern"
        en = "Has a range of <open:tag>2<close:tag> tiles"
        ja = "射程<open>2<close>マス"
    }
    {
        mode = "pattern"
        en = "Has a range of <range:int_tag> tiles on even ground, more if shooting downhill"
        ja = "平地では射程<range>マス。低所へ撃ち下ろす場合はさらに長くなる"
    }
    {
        mode = "pattern"
        en = "Inflicts <fatigue:int_tag> extra fatigue"
        ja = "追加で<fatigue>の疲労を与える"
    }
    {
        mode = "pattern"
        en = "Only receive <armor_multiplier:val_tag> of any damage to armor from attacks"
        ja = "攻撃で受ける装甲ダメージは<armor_multiplier>のみ"
    }
    {
        mode = "pattern"
        en = "Specialize in heavy armor! Armor damage taken is reduced by a percentage equal to <open:tag>5%<close:tag> of the current total armor value of both body and head armor. The heavier your armor and helmet, the more you benefit."
        ja = "重装備を極める！ 攻撃で受ける装甲ダメージを、現在の頭部と胴体の装甲値合計の<open>5%<close>に等しい割合だけ軽減する。胴防具と兜の装甲値が高いほど効果は大きい。"
    }
    {
        mode = "pattern"
        en = "This character has been charmed. He no longer has any control over his actions and is a puppet that has no choice but to obey his master. Wears off in <turns:int_tag> turn(s).\n\nThe higher a character's resolve, the higher the chance to resist being charmed."
        ja = "この団員は魅了されている。もはや自分の行動を制御できず、主人の命令に従うほかない操り人形となった。あと<turns>ターンで効果が切れる。\n\n精神力が高いほど、魅了に抵抗できる確率も高くなる。"
    }
    {
        mode = "pattern"
        en = "This character has been chilled to the bone by cold. With their limbs frozen stiff, it takes a great deal of effort to move in a coordinated fashion. The effect will slowly wear off over <turns:int_tag> more turn(s)."
        ja = "この団員は冷気に骨の髄まで凍え、四肢がこわばっているため、思うように体を動かすにも大きな労力を要する。効果はあと<turns>ターンかけて徐々に薄れる。"
    }
    {
        mode = "pattern"
        en = "This character has been temporarily disarmed for <turns:int_tag> more turn(s) and is unable to use any weapon skills. Switching to a different weapon will remove this effect immediately."
        ja = "この団員はあと<turns>ターンの間、一時的に武装解除され、武器スキルを使用できない。別の武器へ持ち替えると、この効果は即座に解除される。"
    }
    {
