        en = "Only receive <remaining:val_tag> of any damage to Armor from attacks"
        ja = "攻撃による装甲ダメージを本来の<remaining>だけ受ける"
    }
    {
        mode = "pattern"
        en = "Only receive <remaining:val_tag> of any damage to Hitpoints from attacks"
        ja = "攻撃による体力ダメージを本来の<remaining>だけ受ける"
    }
    {
        mode = "pattern"
        en = "Only receive <remaining:val_tag> of any damage to hitpoints from attacks"
        ja = "攻撃による体力ダメージを本来の<remaining>だけ受ける"
    }
    {
        mode = "pattern"
        en = "Pursue the footpads and bring back the missing %s directly to his lordship. No-one else."
        ja = "追いはぎどもを追い、なくなった%sを領主本人のもとへ直接持ち帰れ。ほかの誰にも渡すな。"
    }
    {
        mode = "pattern"
        en = "Pursue the thieves and recover the stolen %s with utmost haste. Their lives matter not."
        ja = "盗賊どもを追い、盗まれた%sを一刻も早く取り戻せ。賊の命など知ったことではない。"
    }
    {
        mode = "pattern"
        en = "Reclaim the stolen %s before it falls into the wrong hands."
        ja = "盗まれた%sが悪しき者の手に渡る前に取り戻せ。"
    }
    {
        mode = "pattern"
        en = "Recover the stolen %s for his lordship and you may earn his gratitude."
        ja = "領主のために盗まれた%sを取り戻せば、感謝も得られるだろう。"
    }
    {
        mode = "pattern"
        en = "Seek out the knaves and restore the stolen %s to the noble lord's estate."
        ja = "悪党どもを探し出し、盗まれた%sを貴族の屋敷へ取り戻せ。"
    }
    {
        mode = "pattern"
        en = "Some dastards have stolen the famed %s!"
        ja = "悪党どもが名高い%sを盗み出した！"
    }
    {
        mode = "pattern"
        en = "Some thieves have stolen the %s from a noble lord, who is frankly astonished at their audacity."
        ja = "盗賊どもがある貴族から%sを盗み出した。その大胆不敵さに、当の貴族は呆気に取られている。"
    }
    {
        mode = "pattern"
        en = "The %s has been stolen from his lordships chambers!"
        ja = "領主の私室から%sが盗まれた！"
    }
    {
        mode = "pattern"
        en = "The %s has been stolen from under the nose of this lordship. Venture forth to reclaim it."
        ja = "領主の目と鼻の先から%sが盗まれた。取り戻すため、出立せよ。"
    }
    {
        mode = "pattern"
        en = "The local ruler has taken the theft of his %s rather badly. Find and kill everyone involved."
        ja = "地元の領主は%sを盗まれ、ひどく腹を立てている。関わった者を全員見つけ出し、殺せ。"
    }
    {
        mode = "pattern"
        en = "The prized %s has been stolen from his lordship by moonlight. Track down the thief for a reward."
        ja = "領主が大切にしていた%sが、月明かりの下で盗み出された。賊を追えば報酬が出る。"
    }
    {
        mode = "pattern"
        en = "The strong bond between the Vala and her Warden makes the Warden absorb <reduction:int>% of the Vala's incoming health damage."
        ja = "ヴァラと守護霊の強い絆により、ヴァラが受ける体力ダメージの<reduction>%を守護霊が肩代わりする。"
    }
    {
        mode = "pattern"
        en = "Thieves have made off with the %s!"
        ja = "盗賊どもが%sを持ち去った！"
    }
    {
        mode = "pattern"
        en = "This character gains <bonus:val_tag> damage reduction because of adjacent opponents."
        ja = "隣接する敵により、受けるダメージが<bonus>軽減される。"
    }
    {
        mode = "pattern"
        en = "Track down the thieves and ensure the stolen %s is returned to its rightful owner."
        ja = "盗賊どもを追跡し、盗まれた%sを正当な持ち主へ確実に返せ。"
    }
    {
        mode = "pattern"
        en = "You are gaining <bonus:val_tag> ranged skill due to wind reading"
        ja = "風を読むことで、射撃技能が<bonus>増加する。"
    }
    {
        mode = "pattern"
        en = "Your melee and ranged defense are increased by <bonus:val_tag>."
        ja = "近接防御と射撃防御が<bonus>増加する。"
    }
    {
        mode = "pattern"
        en = "[i]Costs [b]<ap_open:tag>all (at least 6) AP<ap_close:tag>[/b] to use and builds up [b][color=%negative%]<fatigue:int> Fatigue[/color][/b][/i]\n"
        ja = "[i]使用時に[b]<ap_open>全行動力（最低6 AP）<ap_close>[/b]を消費し、[b][color=%negative%]<fatigue>疲労[/color][/b]が蓄積する[/i]\n"
    }
    {
        mode = "pattern"
        en = "[i]Costs [b]<ap_open:tag>all (at least 6) AP<ap_close:tag>[/b] to use and builds up [b][color=%positive%]<fatigue:int> Fatigue[/color][/b][/i]\n"
        ja = "[i]使用時に[b]<ap_open>全行動力（最低6 AP）<ap_close>[/b]を消費し、[b][color=%positive%]<fatigue>疲労[/color][/b]が蓄積する[/i]\n"
    }
]);

::Rosetta.add({
    mod = {id = "mod_msu", version = "1.9.0"}
    author = ::BattleBrothersJP.Author
    lang = "ja"
}, [
    {
        en = "Add"
        ja = "追加"
    }
    {
        en = "Add another keybind."
        ja = "別のキーバインドを追加します。"
    }
    {
        en = "Apply"
        ja = "適用"
    }
    {
        en = "Delete"
        ja = "削除"
    }
    {
        en = "Delete this keybind."
        ja = "このキーバインドを削除します。"
    }
    {
        en = "Don't save changes."
        ja = "変更を保存しません。"
    }
    {
        en = "Don't use keybinds when writing text"
        ja = "文字入力中はキーバインドを無効化"
    }
    {
        en = "Enable Bold Vanilla Text"
        ja = "ゲーム本体の太字表示を有効化"
    }
    {
        en = "Expanded Item Tooltips"
        ja = "アイテムツールチップを拡張"
    }
    {
        en = "Expanded Skill Tooltips"
        ja = "スキルツールチップを拡張"
    }
    {
        en = "General"
        ja = "一般"
    }
    {
        en = "Modify"
        ja = "変更"
    }
    {
        en = "Modify this keybind."
        ja = "このキーバインドを変更します。"
    }
    {
        en = "Reset"
        ja = "リセット"
    }
    {
        en = "Reset ALL Settings"
        ja = "全MOD設定をリセット"
    }
    {
        en = "Reset all settings for every mod."
        ja = "すべてのMOD設定をリセットします。"
    }
    {
        en = "Resets all settings on this page."
        ja = "このページの全設定をリセットします。"
    }
    {
        en = "Save"
        ja = "保存"
    }
    {
        en = "Save all changes"
        ja = "すべての変更を保存"
    }
    {
        en = "Save all changes from every page and close the screen."
        ja = "全ページの変更を保存して、この画面を閉じます。"
    }
    {
        en = "Save all changes from every page without closing the screen."
        ja = "画面を閉じずに、全ページの変更を保存します。"
    }
    {
        en = "Save changes."
        ja = "変更を保存します。"
    }
    {
        en = "Show MSU-based information in item tooltips e.g. Item Type."
        ja = "アイテム種別など、MSUが提供する情報をアイテムのツールチップに表示します。"
    }
    {
        en = "Show MSU-based information in skill tooltips e.g. Damage Type."
        ja = "ダメージ種別など、MSUが提供する情報をスキルのツールチップに表示します。"
    }
    {
        en = "Suppress base keybinds"
        ja = "ゲーム本体のキーバインドを無効化"
    }
]);

::Rosetta.add({
    mod = {id = "vanilla", version = "1.5.2-3"}
    author = ::BattleBrothersJP.Author
    lang = "ja"
}, [
    {
        en = "%archerfull%, try to knock it down with an arrow?"
        ja = "%archerfull%、矢で撃ち落とせるか？"
    }
    {
        en = "%archerfull%, why don't you take a shot?"
        ja = "%archerfull%、一発射てみたらどうだ？"
    }
    {
        en = "%beastslayer% can handle this puny monster."
        ja = "%beastslayer%なら、このちっぽけな怪物を片づけられる。"
    }
    {
        en = "%beastslayer% the beast slayer should handle this."
        ja = "獣狩りの%beastslayer%に任せよう。"
    }
    {
        en = "%beastslayer%, you're an expert on these things. What say you?"
        ja = "%beastslayer%、こういうものには詳しいだろう。どう思う？"
    }
    {
        en = "%beastslayer%, you're used to deal with beasts. Know what this is?"
        ja = "%beastslayer%、獣の扱いには慣れているな。これが何かわかるか？"
    }
    {
        en = "%bellydancer% the belly dancer, do you know this man?"
        ja = "ベリーダンサーの%bellydancer%、この男を知っているか？"
    }
    {
        en = "%bravebro%, you're the bravest of the lot. Go see what this is about."
        ja = "%bravebro%、お前が一番勇敢だ。何事か見てこい。"
    }
    {
        en = "%chosenbrother%, distract the specter!"
        ja = "%chosenbrother%、亡霊の気を引け！"
    }
    {
        en = "%cultist% the cultist is murmuring again."
        ja = "教団員の%cultist%がまた何かつぶやいている。"
    }
    {
        en = "%cultist%, is this not your cult?"
        ja = "%cultist%、これはお前の教団ではないのか？"
    }
    {
        en = "%entertainerfull%, what say you?"
        ja = "%entertainerfull%、どう思う？"
    }
    {
        en = "%flagellantfull%, you look like you have something on your mind."
        ja = "%flagellantfull%、何か言いたそうだな。"
    }
    {
        en = "%graver%, what are you doing here?"
        ja = "%graver%、ここで何をしている？"
    }
    {
        en = "%historianfull%, what have you to say?"
        ja = "%historianfull%、何か意見は？"
    }
    {
        en = "%houndman%, you've dealt with hounds before, right?"
        ja = "%houndman%、猟犬の扱いには慣れているんだろう？"
    }
    {
        en = "%houndmaster%, you are a houndmaster, handle this!"
        ja = "%houndmaster%、お前は犬の調教師だ。何とかしろ！"
    }
    {
        en = "%houndmaster%, you're trained to handle dogs, right?"
        ja = "%houndmaster%、犬の扱いを心得ているんだろう？"
    }
    {
        en = "%image%{%brother% growls and throws his arms wide like a man overtaken by a primal rage to shed blood.%SPEECH_ON%To hell with those savages! To hell with the greenskins! My life is unfinished so long as they are allowed to walk the same earth as me, my kin, or my children's kin! I will rip their tusks from their mouths, ravage their women, I don't know if they have women, don't know if I'd go near them if they did actually, but I'll ravage something and see to it an annihilation so fierce and thorough the old gods will come to me to borrow a tip!%SPEECH_OFF%}"
        ja = "%image%{%brother%はうなり声を上げ、血を求める原始の怒りに取りつかれたかのように両腕を大きく広げる。%SPEECH_ON%あの蛮族どもめ、地獄へ落ちろ！　グリーンスキンどもも地獄へ落ちろ！　奴らが俺や一族、子孫と同じ大地を歩く限り、俺の人生は終われねえ！　奴らの口から牙を引き抜き、女どもを蹂躙してやる。女がいるのか知らねえし、いたとして近づきたいかもわからねえが、とにかく何かを蹂躙してやる。古き神々がやり方を教わりに俺のもとへ来るほど、激しく徹底的に根絶やしにしてやるぞ！%SPEECH_OFF%}"
    }
    {
        en = "%image%{%brother% spits and runs his hand under his nose. His face scowls and he seems to be talking to himself as others look on.%SPEECH_ON%The old gods will have our arses if we permit the dead to walk again! You fellas can go to the hereafter thinking you did right in this world, but I ain't following the idle road cause by my sum that road goes straight to the hells. I'll see to it that I meet a righteous end, and I'll see to that by felling every godforsaken undead fark I see!%SPEECH_OFF%}"
        ja = "%image%{%brother%は唾を吐き、鼻の下を手でぬぐう。険しい顔で独り言をつぶやき、ほかの者たちがそれを見守っている。%SPEECH_ON%死者が再び歩くのを許せば、古き神々に俺たちの尻を蹴り上げられるぞ！　お前らはこの世で正しいことをしたと思いながら来世へ行けばいい。だが俺は、何もしない道を選ぶつもりはねえ。俺の勘定じゃ、その道は地獄へ一直線だからな。俺は正しく死んでみせる。そのために、目に入った呪われた不死者を一匹残らず叩き伏せてやる！%SPEECH_OFF%}"
    }
    {
        en = "%juggler%, you can juggle, can't you help him?"
        ja = "%juggler%、お前は曲芸師だろう。助けてやれないか？"
    }
    {
        en = "%killer% the killer is always dodging guards, what would he do?"
        ja = "殺し屋の%killer%はいつも衛兵をかわしている。あいつならどうする？"
    }
    {
        en = "%lumberjack%, you know well how to bring down trees. Do it."
        ja = "%lumberjack%、木の倒し方はよく知っているな。やれ。"
    }
    {
        en = "%minstrel% is grinning ear to ear..."
        ja = "%minstrel%が満面の笑みを浮かべている……"
    }
    {
        en = "%monk% the monk! Can you find a peaceful resolution?"
        ja = "修道士の%monk%！　穏便に収められるか？"
    }
    {
        en = "%monk% the monk, can you find a peaceful resolution?"
        ja = "修道士の%monk%、穏便に収められるか？"
    }
    {
        en = "%monk%, can you talk some sense into him?"
        ja = "%monk%、あいつに道理を説けるか？"
    }
    {
        en = "%monk%, you speak for the old gods. What say you?"
        ja = "%monk%、お前は古き神々の代弁者だ。どう思う？"
    }
    {
        en = "%name% departed the %companyname% and continued his adventuring elsewhere. {He headed east, hoping to discover the source of the greenskins, but the nobleman has not been heard from since. | He headed north into the snowy wastes. Word has it he was seen a week ago, marching south this time, looking rather pale and shuffling moreso than walking. | He headed south into brutal marshlands. Word has it that a mysterious flame appeared in the fog and he walked toward it. The men who saw this said he disappeared into the mist and never returned. | He headed west and sailed the open sea. Despite having no experience at sea, he saw fit to make himself captain of the boat. They say pieces of his ship and dead sailors kept washing ashore for weeks.}"
        ja = "%name%は%companyname%を去り、別の土地で冒険を続けた。{彼は東へ向かい、グリーンスキンの起源を探そうとしたが、それきりこの貴族の消息を聞いた者はいない。 | 彼は北の雪原へ向かった。噂では一週間前、今度は南へ行軍する姿を目撃されたという。ひどく青白い顔で、歩くというより足を引きずっていたらしい。 | 彼は南の過酷な沼地へ向かった。霧の中に謎めいた炎が現れ、彼はそれに向かって歩いていったという。それを見た者たちは、彼が霧の中へ消え、そのまま戻らなかったと語っている。 | 彼は西へ向かい、外洋へ船出した。船乗りの経験など皆無だったにもかかわらず、自ら船長を務めることにしたらしい。その後、彼の船の破片と水夫の死体が何週間も浜へ打ち上げられ続けたという。}"
    }
    {
        en = "%name% disappeared not long after your retirement from the %companyname%. The assassin presumably does not want to be found and there's no telling where he is. In moments of honesty, you tell others you wished you never hired him at all. You just can't shake the terror that it is you he is stalking and hunting, and you spend many nights with one eye open, looking for the man in black with the crooked dagger."
        ja = "%name%は、あなたが%companyname%を引退して間もなく姿を消した。暗殺者である彼は、見つからぬよう身を隠しているのだろう。今どこにいるのか知るすべもない。本音がこぼれる時には、あんな男は最初から雇わなければよかったと人に漏らす。彼がつけ狙い、狩っている相手は自分なのではないかという恐怖をどうしても拭えず、曲がった短剣を持つ黒衣の男を警戒して、幾夜も片目を開けたまま過ごしている。"
    }
    {
        en = "%name% doesn't talk much about himself. He just wants to kill orcs and goblins which, given the state of things, makes him a perfect fit for the company. If he's true to his word, he'll leave as soon as the invasion is taken care of."
        ja = "%name%は自分のことをほとんど語らない。ただオークとゴブリンを殺したいだけらしく、このご時世では傭兵団にうってつけの男だ。言葉どおりなら、侵攻が片づき次第ここを去るだろう。"
    }
    {
        en = "%name% is just a regular melon thief - is what you tell people who ask."
        ja = "%name%はごく普通のメロン泥棒だ――尋ねられたときは、そう答えることにしている。"
    }
    {
        en = "%name% is not known to be a big talker, but he has every right to be. {He's saved the lives of both %2h% and %ranged%. | He once spared you from an orc's wicked chain. | An assassin would have killed you in a pub were it not for this man. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | He once pushed two men off a cliff using only his shield and two strong legs. | He learned how to fight from his father, a vanguard at the Battle of Many Names. | Sacrificing his family's heirloom - an old shield of wood and studded iron - he saved your life. | A man of rather consistent heroism, he pulled a drunken %2h% from a pub fire. | Faced with a horde of goblins, he used his shield and strength to push a hole in their lines, opening the way for %2h% and %ranged% to kill them all.} With quick whirls and whips of his shield, the man's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
        ja = "%name%は口数の多い男ではないが、語るに足る武勲ならいくらでもある。{彼は%2h%と%ranged%の命を救ったことがある。 | かつてオークの凶悪な鎖からあなたを救った。 | この男がいなければ、あなたは酒場で暗殺者に殺されていただろう。 | 暴発したクロスボウの矢が危うくあなたの目を奪うところだったが、%name%の盾が受け止めた。 | 盾と二本の頑丈な脚だけで、二人の男を崖から突き落としたことがある。 | 「数多の名の戦い」で前衛を務めた父から、戦い方を教わった。 | 木と鋲打ち鉄で作られた古い盾という家宝を犠牲にして、あなたの命を救った。 | いつも英雄的なこの男は、酔いつぶれた%2h%を酒場の火事から引きずり出したこともある。 | ゴブリンの大群を前に、盾と怪力で敵陣に穴をこじ開け、%2h%と%ranged%が皆殺しにする道を作った。}盾を素早く旋回させ、打ち払うことで、この男はありとあらゆる致命の危機をそらしてきた。寡黙ではあるが、盾壁における%name%の存在は欠かせないものだと、あなたは知っている。"
    }
    {
        en = "%name% is one of the more talented marksman you've encountered in your travels. {After he saved your life with an arrow into the heart of a would-be assassin, you hired the man on the spot. | Learning of the man was easy - you just had to find the winner of a local shooting competition. | He once won an archery contest that had over a hundred participants from all the lands. | It is said that he can split an arrow - mid-flight. | You found the man on a farm where, obviously, you thought his shooting talents were going to waste. | A poacher, a bowyer, an archer, the man's skills have gotten plenty of use. You suspect he readily accepted your offer for mercenary work just to say 'he's done it all'. | You once saw him shoot the moon, but that may have been some sort of trick. | A clever bowman, he once loosed two arrows simultaneously to kill a charging set of brigands.} While he has a fondness for killing from afar, %name%'s no slouch in close-quarters combat."
        ja = "%name%は、旅の中で出会った中でも指折りの射手だ。{暗殺を企てた男の心臓を矢で射抜いてあなたの命を救ったため、その場で雇い入れた。 | 彼を見つけるのは簡単だった。地元の射撃大会の優勝者を探せばよかったのだ。 | 各地から百人を超える参加者が集まった弓術大会で優勝したことがある。 | 飛んでいる矢を別の矢で真っ二つにできるという。 | 彼を見つけたのは農場だった。当然ながら、これほどの射撃の才を腐らせていると思った。 | 密猟者、弓職人、射手と渡り歩き、その腕を存分に生かしてきた男だ。傭兵稼業の誘いをすぐ受けたのも、「何でもやった」と言いたかっただけではないかと思う。 | 月を射抜くところを一度見たが、何かのからくりだったのかもしれない。 | 巧みな弓手で、同時に二本の矢を放ち、突撃してきた二人の盗賊を仕留めたことがある。}遠くから敵を殺すのを好む一方、%name%は接近戦でも侮れない。"
    }
    {
        en = "%name% joined you after being exiled from his tribe in the north for refusing to kill his brother. He'll fight for you as well as for anyone."
        ja = "%name%は、兄弟を殺すことを拒んだため北方の部族から追放され、あなたの一行へ加わった。誰のためであれ同じように戦う男だ。あなたのためにも戦うだろう。"
    }
    {
        en = "%name% joined your party during the undead scourge. Little is known about him and he almost never talks save for the occasional grunt while swinging his sword. His language seems to be codified into one simple structure: killing creatures of evil."
        ja = "%name%は不死者の災厄のさなかに一行へ加わった。素性はほとんど知られておらず、剣を振るう時に時折うなる以外、まず口を開かない。彼の言語は、悪しき怪物を殺すという一つの単純な文法だけで成り立っているようだ。"
    }
    {
        en = "%name% left the %companyname% and started his own competing company. The two companies clashed on opposite sides of a battle between nobles. The sellsword died when a mercenary from the %companyname% stove his head in with a hedge knight's helmet."
        ja = "%name%は%companyname%を離れ、競合する自分の傭兵団を立ち上げた。二つの傭兵団は、貴族同士の戦で敵味方に分かれて衝突した。その男は、%companyname%の傭兵に無主の騎士の兜で頭を叩き潰されて死んだ。"
    }
    {
        en = "%name% retired from fighting and returned to his fishing ventures. A huge storm ran up the shores, destroying every skiff and drifter - except that wily fisherman's! The only boat afloat, %name%'s business boomed. He lives a comfortable life waking up to a nice beachfront view every morning."
        ja = "%name%は戦いを引退し、漁師稼業へ戻った。大嵐が沿岸を襲い、平底舟も小舟もことごとく壊した――あの抜け目ない漁師の船だけを除いて！　唯一残った船を持つ%name%の商売は大繁盛した。毎朝、美しい浜辺の眺めとともに目覚める、何不自由ない暮らしを送っている。"
    }
    {
        en = "%name% retired from fighting while he still had most of his fingers and toes intact. He went back to working for the nobility. Last you heard he was out {south | north | east | west} building a great tower for some nobleman. Sadly, you also heard that tower collapsed halfway through its construction with many workers going down with it."
        ja = "%name%は手足の指がまだほとんど残っているうちに戦いを引退した。そして再び貴族のために働き始めた。最後に聞いた話では、彼は{南 | 北 | 東 | 西}で、とある貴族のために大塔を建てていたという。残念ながら、その塔は工事の半ばで崩れ、多くの労働者が巻き込まれたとも聞いた。"
    }
    {
        en = "%name% retired from the company and bought the deed to an abandoned castle. There he commands a troop of fellow beast slayers who journey the land protecting it from monsters. Last you spoke to him he had a raven-haired lady friend who did not take kindly to your presence, nor the presence of anyone else for that matter. You're sure he's happy."
        ja = "%name%は傭兵団を引退し、廃城の権利書を買った。そこで同業の獣狩りたちを率い、一帯を怪物から守るため各地を巡っている。最後に話した時、彼には黒髪の女友達がいたが、あなたの訪問も、そもそも他人の存在自体も快く思っていなかった。きっと彼は幸せなのだろう。"
    }
    {
        en = "%name% the assassin departed the %companyname% with a large chest of gold and traveled far away. From what rumors you've heard, he built a castle in the mountains east of the southern kingdoms. You're not sure if it's true, but there's been a steady increase in dead viziers and lords alike as of late."
        ja = "暗殺者%name%は、大量の金貨を詰めた箱を手に%companyname%を去り、遠くへ旅立った。聞いた噂では、南方諸国の東にある山中に城を築いたという。真偽はわからないが、近ごろは宰相や領主が相次いで死んでいる。"
    }
    {
        en = "%name% the brawler left the company when it became clear it would soon dissolve and probably end up killing everyone who stayed onboard. He returned to prizefighting, grinding out the following years in brutal, weekly bouts. As he got older, his chin disappeared, as did his speed and power. He was left jobbing, intentionally taking falls and losing badly when he didn't. Eventually, no one would give him a fight. A nobleman offered him a large sum to wrestle a bear and the desperate %name% took him up on it. When the 'fight' was over, the brawler lay dead, mangled beyond recognition, being dragged around the mud by a ferocious beast as drunken highborn cheered and clapped."
        ja = "傭兵団がほどなく瓦解し、残った者まで皆死にそうだと悟ると、喧嘩屋の%name%は去っていった。彼は賞金試合へ戻り、その後の数年間、毎週のように残酷な試合を戦い続けた。年を取るにつれて打たれ強さを失い、速さも力も衰えた。やがて当て馬にされ、わざと倒れ、そうしなければ惨敗するだけになった。ついには誰も試合を組んでくれなくなった。ある貴族が熊と組み合えば大金を払うと持ちかけ、追い詰められた%name%は引き受けた。「試合」が終わると、喧嘩屋は見分けもつかぬほど引き裂かれて死に、酔った貴族たちが喝采する中、荒れ狂う獣に泥の上を引きずり回されていた。"
    }
    {
        en = "%name% the burly lumberjack eventually left the company to return to the woods. He started a woodcutting business and operates every day of the year. Luckily, timing was on his side: the nobility have recently really gotten 'into' cabins and are paying out crowns left and right to anyone who can build them."
        ja = "屈強な木こりの%name%は、ついに傭兵団を去って森へ戻った。材木業を始め、一年中休みなく働いている。幸運にも時機がよかった。近ごろ貴族たちは山小屋にすっかり「夢中」で、建てられる者には惜しげもなくクラウンを払っている。"
    }
    {
        en = "%name% the butcher eventually left the declining company. He joined up with another outfit, but was caught slaughtering one of their war dogs. Apparently, he had been feeding the mercenaries dogmeat from all their mongrels that had gone 'missing'. They did not take this news kindly, stripped the butcher, and fed him to the beasts."
        ja = "傾きかけた傭兵団を、肉屋の%name%はついに去った。別の傭兵団に加わったが、そこの軍用犬を解体しているところを見つかった。どうやら「行方不明」になった駄犬をことごとく犬肉にして、傭兵たちへ食わせていたらしい。この知らせを聞いた仲間たちは激怒し、肉屋を裸にして獣どもの餌にした。"
    }
    {
        en = "%name% the caravan hand retired back into guarding trade wagons. He died when defending against an ambush by brigands. They took his shirt and left his body in a ditch."
        ja = "隊商の従者だった%name%は、引退して再び交易馬車の護衛に就いた。盗賊の待ち伏せから馬車を守って死んだ。連中は彼の上着を奪い、死体を溝へ捨てた。"
    }
    {
        en = "%name% the daytaler retired from fighting and, well, he keeps working with his hands. Now he's back to laying bricks and carrying hay instead of slaying beasts and crushing heads. He took all his mercenary money to purchase a bit of land and settle down. While not the richest man, word has it that there is hardly a happier man in the realm."
        ja = "日雇い人の%name%は戦いを引退し、まあ、再び手仕事で食っている。怪物を斬り、頭を砕く代わりに、今は煉瓦を積み、干し草を運ぶ日々だ。傭兵で稼いだ金をすべて使って小さな土地を買い、腰を落ち着けた。裕福とはいえないが、この国に彼ほど幸せな男はそういないという。"
    }
    {
        en = "%name% the deserter continued fighting for the %companyname%, ever striving to redeem his name. Word has it that during a brutal fight with orcs, he dove headfirst into a crowd of greenskins, surfing across the top of their shocked heads. His heroism rallied the men to an incredible victory and he lives out his days getting toasted in every bar he enters."
        ja = "脱走兵の%name%は%companyname%で戦い続け、名誉を取り戻そうと励んだ。噂によれば、オークとの苛烈な戦いで緑肌の群れへ頭から飛び込み、驚く敵の頭上を波乗りのように駆け抜けたという。その勇猛さに仲間たちは奮い立ち、信じがたい勝利を収めた。今ではどの酒場へ入っても祝杯を上げられる日々を送っている。"
    }
    {
        en = "%name% the juggler retired from fighting. He was performing for a gaudy nobleman in the {south | north | east | west} when an act went horribly wrong. Word has it he was thrown off a tower for his mistake, but you prefer to not believe that."
        ja = "曲芸師の%name%は戦いを引退した。{南 | 北 | 東 | 西}でけばけばしい貴族の前に芸を披露していた時、演目がひどい失敗に終わった。過ちの罰に塔から投げ落とされたという噂だが、あなたは信じたくない。"
    }
    {
        en = "%name% the juggler took all his mercenary money and started a traveling troupe of performers. Last you heard, he started an entire theater and puts on a new play a month!"
        ja = "曲芸師の%name%は傭兵で稼いだ金をすべて投じ、旅芸人の一座を立ち上げた。最後に聞いた話では、ついには劇場まで開き、毎月新作を上演しているそうだ！"
    }
    {
        en = "%name% the lumberjack had enough of the sellsword's life and returned to woodcutting. Last you heard, he was involved in a tree-falling accident and his body could have been rolled up like a rug the bones were so thoroughly squashed."
        ja = "木こりの%name%は売剣の暮らしに嫌気が差し、伐採仕事へ戻った。最後に聞いた話では、倒木事故に巻き込まれ、骨という骨を潰されて、敷物のように丸められるほどの死体になったという。"
    }
    {
        en = "%name% the miner never did return to the mines, thankfully. If there's one life that could be worse than that of fighting for a living, it very well may be digging into mountains for a living! Apparently, the miner built a home by the sea, spending the rest of his days peacefully fishing for dinner and enjoying sunrises or some such sappy shite."
        ja = "幸いにも、鉱夫の%name%は二度と鉱山へ戻らなかった。生きるために戦うより惨めな暮らしがあるとすれば、山を掘って生きる暮らしくらいだろう！　鉱夫は海辺に家を建て、夕食の魚を釣り、朝日だか何だかという甘ったるいものを眺めながら、余生を穏やかに過ごしたらしい。"
    }
    {
        en = "%name% the monk retired back into calmer spiritual duties. He is currently out in a mountain monastery, enjoying the quiet while reflecting on his time in the mercenary company. The other monks hate him for fighting and killing, but he's penning a world-changing tome on the balance between peace and violence."
        ja = "修道士の%name%は引退し、再び穏やかな信仰の務めに就いた。今は山中の修道院で静寂を楽しみつつ、傭兵団で過ごした日々を省みている。他の修道士たちは戦って人を殺した彼を嫌っているが、本人は平和と暴力の均衡を説く、世界を変える大著を執筆中だ。"
    }
    {
        en = "%name% the once-caravan hand retired from fighting. He used his mercenary money to start a trade-guarding business that specializes in transporting goods through dangerous lands."
        ja = "かつて隊商の従者だった%name%は戦いを引退した。傭兵で稼いだ金を元手に、危険な土地を通る荷の護送を専門とする商売を始めた。"
    }
    {
        en = "%name% the once-miller stayed with the %companyname% for a time, collecting enough crowns to start his own bakery. Last you heard, his sword-shaped desserts have been a hit with the nobility and he makes more money selling to them than he ever did with the company."
        ja = "かつて粉挽きだった%name%はしばらく%companyname%に残り、自分のパン屋を開くのに十分なクラウンを貯めた。最後に聞いた話では、剣の形をした菓子が貴族たちに大受けし、傭兵団にいた頃よりもずっと稼いでいるという。"
    }
    {
        en = "%name% the ratcatcher came from stranger stocks, and to stranger stocks he returned. After retiring from the %companyname%, he started a ratcatching company. He was doing wonderful business until it came out that he hadn't been killing any of the rats, but instead stowing thousands of them in a storehouse just outside town. Last you heard, the man was quite content with his new and numerous friends."
        ja = "鼠捕りの%name%はもともと風変わりな男だったが、引退後はさらに奇妙な道へ戻っていった。%companyname%を退いた後、鼠駆除の商売を始めた。繁盛していたものの、実は鼠を一匹も殺さず、町外れの倉庫に何千匹も隠していたことが露見した。最後に聞いた話では、その大勢の新しい友達に囲まれ、本人は大いに満足しているらしい。"
    }
    {
        en = "%name% the sellsword left the %companyname% and started his own mercenary company. As far as you know, it's a very successful venture and he often buddies up with the men of the %companyname% to work together."
        ja = "売剣の%name%は%companyname%を去り、自分の傭兵団を立ち上げた。知る限りでは大成功を収めており、%companyname%の者たちともたびたび手を組んで仕事をしている。"
    }
    {
        en = "%name% the servant grew tired of the sellsword life and left the company. He returned to serving nobility. When raiders attacked his liege's castle, the nobleman pushed the servant out the door with only a kitchen knife to defend himself with. He was found headless in a pile of broken chairs, a few dead raiders littered around him."
        ja = "従僕の%name%は売剣の暮らしに疲れ、傭兵団を去った。再び貴族に仕えたが、略奪者が主君の城を襲った時、その貴族は従僕に台所包丁一本だけ持たせて扉の外へ押し出した。彼は首のない姿で、壊れた椅子の山から見つかった。周囲には数人の略奪者も死んでいた。"
    }
    {
        en = "%name% the squire eventually left the %companyname%. You've heard that he's since been knighted. No doubt he is sitting happy as a plum wherever he is."
        ja = "従騎士の%name%は、やがて%companyname%を去った。その後、騎士に叙されたと聞いている。今頃はどこかで、さぞ満ち足りて暮らしているに違いない。"
    }
    {
        en = "%name% the wildman stayed with the fragmenting %companyname% for a time and then, just like that, he was gone. The company went out looking for him in a forest, eventually finding some sort of crude note: an enormous pile of crowns next to a dirt-drawing of the %companyname% and some of its members, all of them being hugged by a big, literal stick figure with a goofy smile on its face. There was also an offering of a dead, half-eaten rabbit."
        ja = "野人の%name%は、瓦解していく%companyname%にしばらく残った後、ある日忽然と姿を消した。傭兵団が森を捜すと、粗末な置き手紙のようなものが見つかった。大量のクラウンの横に、土へ描かれた%companyname%と何人かの団員、そして間抜けな笑みを浮かべた大きな棒人間が、その全員を抱きしめている絵だった。食いかけの死んだ兎も供えられていた。"
    }
    {
        en = "%name% was 'saved' by you during a confrontation with an animal tamer-turned-enslaver. A sense of gratitude and debt overcomes any language barriers: the once imprisoned wildman serves the company loyally for rescuing him."
        ja = "%name%は、獣使いから奴隷使いへ転じた男との対立の中で、あなたに「救われた」。感謝と恩義が言葉の壁を越え、かつて囚われていた野人は、救ってくれた傭兵団へ忠実に仕えている。"
    }
    {
        en = "%name% was taken as an indebted after barely surviving a battle against your men. His spirit was broken and he was forced to fight for you, so that he may pay his debt to the Gilder."
        ja = "%name%はあなたの部下との戦いを辛うじて生き延び、債務奴隷として捕らえられた。心を折られた彼は、ギルダーへの負債を返すため、あなたのために戦うことを強いられている。"
    }
    {
        en = "%name% was working the seas as a sailor when pirates of the city states boarded his vessel and took him as captives along with his crew. By some happenstance, he made his way into your care to work off his debt to the Gilder."
        ja = "%name%は船乗りとして海で働いていたが、都市国家の海賊に船を乗っ取られ、仲間とともに捕虜となった。何の巡り合わせか、彼は今、あなたのもとでギルダーへの負債を返すため働いている。"
    }
    {
        en = "%name% {hobbles toward you like a mangy dog | greets you with a hand missing numerous fingers | smiles at you with a toothless grin | carries the slouching posture of a man with a broken back | wobbles on two very stiff, possibly even wooden legs | uses a cane to walk toward you | crawls toward you at first, but then rises to his feet with all the grace of a drunk on church steps | has bones that creak and croak with every step | carries an arm in a sling, and has a cane standing in support for one of his legs | has a smashed nose and two blackened eyes | looks like someone tried to scalp and burn him alive | has flesh that smells partly cooked, his eyes wincing with every step he takes toward you | is missing two ears, though the holes still hear | reeks of shit and urine | is missing one eye, and the other wanders severely | has two lazy eyes and a crooked, gap-filled smile}. He explains that {he was once a mason, but that he was attacked by a madman for trying to replicate his work | he once donned armor as a knight, but that cruel fate has taken all of that from him | once upon a time he was a Vizier, but his poor vocabulary suggests this may be a lie | he was a peddler once, but the sale of a lobo-rail ended with him at the mercy of an angry town mob | he dabbled in cultism, but when he bailed they punished him for it | he used to brawl for decadent traders, but a beatdown by other fighters left him crippled | he used to fight in the arena, but a bad match ended with him horribly crippled | he used to rob graves, but when he got caught a parishioner broke more of his bones than he knew a skeleton even had | he dabbled in {the arcane arts | necromancy} but, made obvious by his near-deathly state, that experiment was shortlived | he was once a successful gambler, but as it turns out not paying back your debts is bad for business - and your bones | he used to catch rats for a living, but apparently a giant rat paid him a vengeful visit in the night | he once served a vizier of %randomcitystate%, but after dropping a plate of food he was sent to the dungeons where he was promptly forgotten for years | he once killed a man, sure, but that he deserved a better fate than the irreversible torture he received as punishment | he used to hunt witches, but a cruel mistress tricked him into drinking a concoction which crippled his very bones | he once deserted an army and, obviously, got caught | he used to juggle for the rich until he accidentally fell down some steps in the middle of a stunt. The steps proved rather edgy against his bones, it seems | he was born with a horrific deformity | his father brutally attacked him for not living up to his image | his mother scarred him with endless torture | his siblings tortured him all his life}. {The man looks so weak you can almost see his mortal coil flapping in the wind. | Hiring him would almost certainly be the man's doom. How merciful! | You don't want to be seen as hiring just anybody, but if this guy is a nobody, does that still count as 'anybody'? | You've seen dead people who look better than this man. | This guy is wolf-lunch on two legs. | The good news is that if he comes back from the dead he shouldn't be too hard to put down a second time. | Dreams and inanimate objects are more threatening than this poor git. | To be honest, you'd rather hire a child, but apparently people look down on that so here we are instead. | And you thought %randombrother% smelled bad. | Hiring a man such as this would send anyone's moral compass spinning. | Oh c'mon, look at him! Are the %companyname% really that in need of warm bodies? | Hiring this man just wouldn't be right. Whelp, here goes. | A pair of crutches has more value than this poor man. | This man is in such a sorry state he can play dead standing up.}"
        ja = "%name%は{疥癬だらけの犬のようによろめきながら近づいてくる | 指を何本も失った手で挨拶する | 歯のない口で笑いかける | 背骨を折った男のように背を丸めている | ひどく硬直した、木製かもしれない二本の脚でぐらついている | 杖をついてこちらへ歩いてくる | 最初は這ってくるが、やがて教会の階段にいる酔漢さながらの不格好さで立ち上がる | 一歩ごとに骨が軋み、呻く | 腕を吊り、片脚を支える杖をついている | 鼻は潰れ、両目の周りが黒く腫れている | 頭皮を剥がされ、生きたまま焼かれかけたように見える | 肉から半焼けの臭いがし、こちらへ一歩進むたび苦痛に目を細める | 両耳を失っているが、穴だけでも音は聞こえるらしい | 糞尿の臭いをぷんぷんさせている | 片目を失い、残った目もひどく泳いでいる | 両目ともあらぬ方を向き、隙間だらけの歪んだ笑みを浮かべている}。彼の話では、{かつて石工だったが、自分の仕事を真似ようとしたというだけで狂人に襲われた | かつて騎士として鎧をまとっていたが、残酷な運命がすべてを奪った | 昔は宰相だったというが、貧相な語彙を聞く限り嘘かもしれない | かつて行商人だったが、ロボレールを売ったことで怒れる町の群衆になぶりものにされた | 教団信仰に手を出したが、抜けようとしたため罰を受けた | 退廃した商人たちのために殴り合っていたが、他の闘士に袋叩きにされて不具になった | 闘技場で戦っていたが、ひどい組み合わせに当たり、見るも無惨な不具になった | 墓荒らしをしていたが、捕まった時に教区民から、自分の骨格にこれほど骨があったのかと思うほど何本も折られた | {秘術 | 死霊術}をかじったが、ほとんど死人同然の姿が示すとおり、その実験は長続きしなかった | かつては成功した博徒だったが、借金を返さないのは商売にも――そして骨にも――悪いと身をもって知った | 鼠捕りで生計を立てていたが、どうやら巨大鼠が夜中に復讐へ訪れたらしい | かつて%randomcitystate%の宰相に仕えていたが、料理の皿を落としたため地下牢へ送られ、そのまま何年も忘れ去られた | 人を一人殺したのは事実だが、罰として受けた取り返しのつかない拷問よりはましな運命に値した | 魔女狩りをしていたが、残酷な女主人にだまされて骨まで蝕む調合薬を飲まされた | かつて軍から脱走し、当然ながら捕まった | 富裕層の前で曲芸をしていたが、演技中に誤って階段から転げ落ちた。どうやら段の角は彼の骨にずいぶん鋭かったらしい | 生まれつきひどい奇形だった | 父親に期待どおりでないと散々殴られた | 母親から果てしない拷問を受け、傷だらけにされた | 兄弟姉妹に一生虐げられた}という。{男はあまりに弱々しく、命をつなぐ糸が風にはためく様まで見えそうだ。 | 雇えば、ほぼ間違いなくこの男の命を奪うことになる。何と慈悲深い！ | 誰でも彼でも雇う傭兵団だとは思われたくない。だが、この男が誰でもないなら、「誰でも」に数えるべきなのだろうか？ | この男よりましな見た目の死体を見たことがある。 | こいつは二本脚で歩く狼の昼飯だ。 | 朗報は、死んで蘇っても二度目に倒すのは難しくなさそうなことだ。 | 夢や動かぬ物の方が、この哀れな間抜けよりよほど脅威だ。 | 正直なところ子供を雇う方がましだが、どうも世間はそれを白眼視するらしいので、代わりにこいつがいる。 | %randombrother%の臭いがひどいと思っていたのに。 | こんな男を雇えば、誰の良心もぐるぐる回り出すだろう。 | おいおい、こいつを見ろ！　%companyname%はそれほど頭数に困っているのか？ | この男を雇うなんて、とても正しいとは思えない。まあ、やるか。 | 松葉杖一組の方が、この哀れな男より値打ちがある。 | この男はあまりに惨めな有様で、立ったまま死んだふりができる。}"
    }
    {
        en = "%name%, also known as Wolf of Arena Alley, is a retired gladiator, but an active sellsword. He's been earning crowns by killing for a long time, and it shows both in his experience and his age."
        ja = "%name%は「闘技場裏通りの狼」の異名を持つ、引退した剣闘士にして現役の傭兵だ。長年、殺しでクラウンを稼いできた。その歳にも経験にも、それがありありと表れている。"
    }
    {
        en = "%name%, former poacher, eventually saved enough money to leave the %companyname%. You learned he found a bit of mountain land and works it for a local nobleman. Ironically, his job is to hunt down poachers."
        ja = "元密猟者の%name%は、ついに%companyname%を離れられるだけの金を貯めた。山あいに小さな土地を見つけ、地元貴族のために働いていると聞いた。皮肉にも、その仕事は密猟者を狩ることだ。"
    }
    {
        en = "%oldguard% shows little mercy and has the men running again and again in the days to come. After all, he says, it's for their own damn good."
        ja = "%oldguard%は容赦せず、その後も何日にもわたって団員たちを何度も走らせる。何しろ本人いわく、全部あいつら自身のためなのだ。"
    }
    {
        en = "%peacekeeperfull%, see if you can calm %troublemaker% with your wisdom."
        ja = "%peacekeeperfull%、その知恵で%troublemaker%をなだめられるか試してみろ。"
    }
    {
        en = "%peddler%, you used to be a peddler. Get us a better deal!"
        ja = "%peddler%、お前は行商人だったな。もっと値切ってこい！"
    }
    {
        en = "%ratcatcherfull% has something up his sleeve."
        ja = "%ratcatcherfull%には何か策があるようだ。"
    }
    {
        en = "%refugee_bro%, you used to be a refugee. Talk to them?"
        ja = "%refugee_bro%、お前は元難民だったな。話してみるか？"
    }
    {
        en = "%teamplayer% is the best."
        ja = "%teamplayer%が一番だ。"
    }
    {
        en = "%terrainImage%%butcher% asks if the horse is still around. Its owner nods.%SPEECH_ON%Aye, freshly dead, freshly soiled by that prick. Why?%SPEECH_OFF%The butcher asks if he can take it off his hands. The owner shrugs.%SPEECH_ON%Yours if you want it. Though you'd best be careful cutting around the bits he touched with his own bits.%SPEECH_OFF%Before anymore can be said, %butcher% has the man take him to the horse corpse to, well, butcher it. The company gets some questionable meat to eat."
        ja = "%terrainImage%%butcher%が、馬はまだ残っているのかと尋ねる。持ち主はうなずいた。%SPEECH_ON%ああ、死んだばかりで、あの野郎に汚されたばかりだ。なぜ聞く？%SPEECH_OFF%肉屋は、引き取ってもよいかと尋ねる。持ち主は肩をすくめた。%SPEECH_ON%欲しいならくれてやる。ただし、あいつが自分のナニで触った辺りを切るときは、せいぜい気をつけろ。%SPEECH_OFF%それ以上言葉が交わされる前に、%butcher%は馬の死骸へ案内させ、文字どおり解体し始めた。傭兵団は、いささか疑わしい肉を食糧として手に入れた。"
    }
    {
        en = "%terrainImage%%flagellant% steps forward and takes the horse owner's whip. He bends it and runs the leather through his hands. Nodding, he calls it a 'fine tool' for a good whipping, but that the men were going about it 'all the wrong way.' He points at the wounds on the man's back.%SPEECH_ON%See these streaks? They're thin and barely opened. Don't let the amount of blood fool you, these are superficial. Here, let me show you a good hiding.%SPEECH_OFF%The flagellant drop the whip's strings, twirls them around for a moment, then strikes. The hanging man cries out. A wound opens and gapes from the tip of one rib clear across his back to the tip of another. You can see the muscle and fat bubbling beneath. %flagellant% strikes again, and again, and again. Blood splashes the flagellant as he works and the horse-porker has long since passed out. Eventually, one of the men gets to his feet and takes the whip back.%SPEECH_ON%Th-that's enough. You fellas get on and go, alright? Farkin' hell...%SPEECH_OFF%Another man cuts the filly fiddler down and tends to his new, quite serious wounds. %flagellant% wipes his brow and admires his handiwork.%SPEECH_ON%Mmhmm, that's how it's done.%SPEECH_OFF%"
        ja = "%terrainImage%%flagellant%が前へ出て、馬の持ち主から鞭を受け取る。鞭をしならせ、革紐を手の中で滑らせた。うなずくと、これは上等な鞭打ちに使える「いい道具」だが、連中のやり方は「まるでなっていない」と言う。男の背の傷を指さした。%SPEECH_ON%この筋が見えるか？　細くて、ろくに口も開いていない。血の量に惑わされるな、どれも表面を撫でただけだ。ほら、本物の鞭打ちを見せてやろう。%SPEECH_OFF%苦行者は鞭の革紐を垂らし、しばし振り回してから打ち据えた。吊られた男が悲鳴を上げる。肋骨の端から反対側の端まで、背を横切る傷がぱっくりと開いた。下で筋肉と脂肪が泡立つのが見える。%flagellant%はもう一度、さらにもう一度、何度も打つ。鞭を振るう苦行者に血が飛び散り、馬を犯した男はとうに意識を失っていた。やがて男の一人が立ち上がり、鞭を取り返す。%SPEECH_ON%も、もう十分だ。あんたら、さっさと行ってくれ、いいな？　くそったれ……%SPEECH_OFF%別の男が牝馬いじりを切り下ろし、新しくできた深刻な傷の手当てをする。%flagellant%は額を拭い、自分の仕事ぶりを眺めた。%SPEECH_ON%うむ、こうやるものだ。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%A strange sight: one dead man pinned to the earth with spears. His own blood has been used to circle his corpse and other strange ritualistic rites have been painted by way of his lifeblood. %otherbrother% starts retrieving the spears. You try and tell him to stop, but it's already too late. He holds one of the weapons up.%SPEECH_ON%What? These are of good quality. Why would we leave them here?%SPEECH_OFF%Well, if there was a deific protection here it's already been broken. You collect the spears."
        ja = "%terrainImage%奇妙な光景だ。死んだ男が槍で地面に縫い止められている。その血で遺体の周りに円が描かれ、さらに命の血を絵具にして、得体の知れない儀式のしるしがいくつも描かれていた。%otherbrother%が槍を引き抜き始める。やめろと言いかけたが、もう遅い。彼は武器の一本を掲げる。%SPEECH_ON%何だよ？　上物だぞ。どうして置いていくんだ？%SPEECH_OFF%ここに神の加護があったとしても、すでに破られてしまった。あなたは槍を回収する。"
    }
    {
        en = "%terrainImage%Before you can leave, %cultist% bends low to the sacrificed man and whispers into his ear. A moment later, the dead man's head lurches. His eyes widen and nostrils flare. The cultist looks over to you.%SPEECH_ON%He wasn't dead. His blood was used to satiate Davkul. Had we needed his death, we would have burned him.%SPEECH_OFF%He pauses, turning to the man whose wounds are mysteriously healing before your eyes like mud filling in a footprint. %cultist% pets him on the cheek.%SPEECH_ON%Come, friend, and serve Davkul.%SPEECH_OFF%The un-sacrificed man jumps to his feet and instinctively turns toward you. Somehow, he already knows you're the captain here and bends a knee.%SPEECH_ON%If you allow it, I will fight for you and, in doing so, spread the faith of Davkul.%SPEECH_OFF%His voice is robotic, as if he'd spent the last year practicing the oath."
        ja = "%terrainImage%立ち去るより先に、%cultist%が生贄の男へ身をかがめ、その耳に何かをささやく。しばらくして、死んだ男の頭が跳ねた。目を見開き、鼻孔を膨らませる。教団員はあなたを振り返った。%SPEECH_ON%この者は死んでいなかった。その血はダヴクルを満たすために使われたのだ。死が必要ならば、我らはこの者を焼いていただろう。%SPEECH_OFF%彼はいったん言葉を切り、足跡を泥が埋めるかのように、目の前で傷が不可思議に塞がっていく男へ向き直る。%cultist%はその頬を撫でた。%SPEECH_ON%来るがよい、友よ。ダヴクルに仕えるのだ。%SPEECH_OFF%生贄ではなくなった男は跳ね起き、本能的にあなたへ向き直る。どういうわけか、誰が隊長なのかをすでに悟り、片膝をついた。%SPEECH_ON%お許しいただけるなら、あなたのために戦い、それによってダヴクルの信仰を広めましょう。%SPEECH_OFF%その声は機械じみており、まるで一年かけてこの誓いを練習してきたかのようだった。"
    }
    {
        en = "%terrainImage%It appears that the herbs are not just harmless, but rather even proactive in taking care of some nagging issues with the men. %volunteer%'s cold seems to have lifted, and the stomach pains of %otherguy% have abated. After trying some yourself, you see a splinter wiggle its way out of your thumb. Amazing!"
        ja = "%terrainImage%その薬草は無害なだけではなく、団員たちを悩ませていた症状を積極的に癒やしてくれるらしい。%volunteer%の風邪は治まり、%otherguy%の腹痛も消えた。あなたも試してみると、親指に刺さっていた棘がひとりでに動き、抜け落ちる。驚くべきことだ！"
    }
    {
        en = "%terrainImage%While heading toward your destination, %volunteer% runs up to you with a bundle of herbs in hand. Now you know this fool knows nothing about plants or wildlife, but he seems rather persistent in wanting to try them out. Something about 'hearing' of magical powers to be found in the essence of herbs. This talk gets the attention of a few others in the company. Soon, a number of them are asking to try out the 'medicine' for the good of their brothers."
        ja = "%terrainImage%目的地へ向かう途中、%volunteer%が薬草の束を手に駆け寄ってきた。この愚か者が植物や野生生物について何も知らないことは承知しているが、どうしても試したいらしい。薬草の精髄には魔法の力が宿ると「聞いた」のだという。その話に傭兵団の何人かも興味を引かれた。ほどなく、仲間たちのためにその「薬」を試したいという者が何人も現れた。"
    }
    {
        en = "%terrainImage%While on the path, you come to a man being dangled upside down from a tree branch. A bunch of men are sitting around him sharing a goatskin flask, looking like they're at the end of a day's hard work. When you ask what is going on, one of them looks up and smiles.%SPEECH_ON%Whipping this fella 'til he's raw.%SPEECH_OFF%You ask what for. Another man answers.%SPEECH_ON%Fornicating with this fella's wife.%SPEECH_OFF%A man drinking spurts and chokes on his drink. He wipes his mouth.%SPEECH_ON%Hardy-farkin'-har, very funny. No, this scumbag was caught farkin my dead horse.%SPEECH_OFF%"
        ja = "%terrainImage%道を進んでいると、木の枝から逆さ吊りにされた男に出くわす。何人もの男たちがその周りに座り、山羊革の酒袋を回し飲みしていた。一日の重労働を終えたような顔つきだ。何をしているのか尋ねると、一人が顔を上げて笑う。%SPEECH_ON%こいつの皮が剥けるまで鞭打ってる。%SPEECH_OFF%何をしたのかと問う。別の男が答える。%SPEECH_ON%こいつの女房とやったのさ。%SPEECH_OFF%飲んでいた男が吹き出してむせる。口元を拭った。%SPEECH_ON%ハーッ、そりゃ傑作だ、くそったれ。違う。このクズは、俺の死んだ馬を犯してやがったんだ。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You decide to take the man in. %otherbrother% stands by the wayside, a couple of spears in hand.%SPEECH_ON%We're still taking these, right?%SPEECH_OFF%"
        ja = "%terrainImage%あなたは男を迎え入れることにした。%otherbrother%が槍を二本ほど手に、道端に立っている。%SPEECH_ON%これ、やっぱり持っていくんだよな？%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You deny the born-again cultist. He nods.%SPEECH_ON%Of course. I will find other ways to serve Davkul. Farewell, brother.%SPEECH_OFF%He bows to %cultist% before turning and leaving. %otherbrother% stands there with a couple of spears in hand.%SPEECH_ON%We're still taking these, right?%SPEECH_OFF%"
        ja = "%terrainImage%あなたは蘇った教団員を拒んだ。彼はうなずく。%SPEECH_ON%承知しました。ダヴクルに仕える別の道を探しましょう。さらばだ、兄弟よ。%SPEECH_OFF%彼は%cultist%に頭を下げ、背を向けて去っていく。%otherbrother%が槍を二本ほど手に、その場に立っている。%SPEECH_ON%これ、やっぱり持っていくんだよな？%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You find an abandoned wagon amongst some tall reeds. %randombrother% checks it out and barks back.%SPEECH_ON%It's broke as shit, but I think we can salvage parts of it.%SPEECH_OFF%"
        ja = "%terrainImage%背の高い葦の間に、捨てられた荷馬車を見つけた。%randombrother%が調べ、声を張り上げる。%SPEECH_ON%壊れ方がひでえが、部品はいくつか回収できそうだ。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You take out your blade and cut the man down. He crumples onto his shoulders and splays out, his lashed back in the dirt. The soil may as well have been salt judging by his wailing. One of the whippers stands up.%SPEECH_ON%Hey, just what do you think you're doing? We ain't finished here!%SPEECH_OFF%%randombrother% draws his weapon and the man backs off. The horse owner spits and shakes his head.%SPEECH_ON%Are you really going to defend this piece of work? Ain't that some fucking horseshit. I guess now I can say I've seen it all which is exactly what I said when I caught this bastard porkin' my dead horse!%SPEECH_OFF%The man catches his breath then points at the recently rescued.%SPEECH_ON%I hope you die on your first day out ya filly fiddling bastard.%SPEECH_OFF%"
        ja = "%terrainImage%あなたは刃を抜き、男を切り下ろす。男は肩から地面に崩れ、鞭打たれた背を土の上に投げ出した。叫び声からすれば、その土は塩も同然なのだろう。鞭打っていた男の一人が立ち上がる。%SPEECH_ON%おい、何のつもりだ？　まだ終わってねえぞ！%SPEECH_OFF%%randombrother%が武器を抜くと、その男は後ずさる。馬の持ち主は唾を吐き、首を振った。%SPEECH_ON%本気でこのクズを庇うのか？　とんだ馬鹿げた話だ。これで何でも見たって言えるな。まあ、この野郎が俺の死んだ馬とやってるのを見つけたときにも、まったく同じことを言ったがな！%SPEECH_OFF%男は息を整えると、助けられたばかりの男を指さした。%SPEECH_ON%初陣で死んじまえ、この牝馬いじりのろくでなし。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You take out your blade and cut the man down. He falls right on his head and his neck breaks with a disgusting crack. The rest of his body crumples with his legs awkwardly heaved over his own chest, a position no doubt strange to this sexual deviant. The horse owner springs to his feet.%SPEECH_ON%Well shit, sir, we was just gonna whip him good. Why'd you go and kill him for?%SPEECH_OFF%He pauses then waves a dismissive hand.%SPEECH_ON%Shit. Shit, man. Well, alright. We'll just all depart in our own way and say nothing of what happened here. Ain't that right fellas?%SPEECH_OFF%The rest of the men nod.%SPEECH_ON%'Course. I ain't ruining my life over some filly fiddler. Good going, sellsword, stupid sword swingin' sumbitch.%SPEECH_OFF%"
        ja = "%terrainImage%あなたは刃を抜き、男を切り下ろす。男は頭から落ち、吐き気を催す音を立てて首を折った。残った身体も崩れ落ち、両脚が不格好に自分の胸の上へ折り重なる。もっとも、この倒錯者にとってさえ奇妙な体位だろう。馬の持ち主が跳ね起きる。%SPEECH_ON%おいおい、旦那。俺たちはこいつをたっぷり鞭打つだけだったんだ。なんだって殺した？%SPEECH_OFF%彼はいったん黙り、どうでもよさそうに手を振った。%SPEECH_ON%くそ。くそったれ。まあいい。俺たちはそれぞれ別の方へ行って、ここで起きたことは何も話さない。そうだよな、お前ら？%SPEECH_OFF%ほかの男たちがうなずく。%SPEECH_ON%当たり前だ。牝馬いじりなんぞのために人生を棒に振る気はねえ。よくやったな傭兵、この剣振り回す大馬鹿野郎。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%You walk over to the dangling man. There's blood running down his back, streaking from a dozen slashes. He's got a cloth covering his eyes which you pull down. Blinking, he asks what it is you want as though you're interrupting his own hiding. You ask him if what they say is true. He spits and clears his throat.%SPEECH_ON%I mean, yeah, but the horse was dead, so of what matter was it? Can't a man have his fun?%SPEECH_OFF%The horse owner gets up, brandishing a dripping whip.%SPEECH_ON%Oy, you want us to go back at it? We got all day!%SPEECH_OFF%Sighing, the dangling man asks you a question.%SPEECH_ON%Yer a sellsword, right? Why don't I come and fight for ya? I'm a strong and able bodied man, a little horse, I mean worse, for the wear, but that aside, and the, uh, dead animal thing, I'm a man of upstanding and moral sensibilities.%SPEECH_OFF%"
        ja = "%terrainImage%あなたは吊られた男へ歩み寄る。十数本の裂傷から血が筋を引き、背中を流れている。目隠しの布を引き下ろすと、隠れ場所を邪魔されたとでもいうように、まばたきしながら何の用だと尋ねてきた。奴らの話は本当かと問う。男は唾を吐き、咳払いする。%SPEECH_ON%まあ、そうだ。だが馬は死んでたんだから、何が問題だ？　男が楽しんじゃいけないのか？%SPEECH_OFF%馬の持ち主が立ち上がり、血の滴る鞭を振りかざす。%SPEECH_ON%おい、また始めてほしいのか？　こっちは一日中でもやれるぞ！%SPEECH_OFF%吊られた男はため息をつき、あなたに尋ねる。%SPEECH_ON%あんた傭兵だろ？　俺を雇わないか？　丈夫で働ける男だ。ちょいと馬……いや、まあ、くたびれてはいるがな。だがそれを別にすれば、それと、あー、死んだ動物の件も別にすれば、俺は品行方正で道徳心にあふれた男だ。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%{%athlete% steps forward. His calves bulge from his socks and he shoulder rolls to loosen up.%SPEECH_ON%Yeah I'll race that sorry horse.%SPEECH_OFF%The wager is made and the horse's owner directs you to a path. With the race set up, he holds up a pair of wooden tongs held apart, and backwards, by some tine. When he cuts the rope, the tongs snap clap together and start the race. Despite being looking like a wart left in the rain, the horse instantly gets a step on the nimble sellsword. It's only halfway down the track does the mercenary's stamina seem to put him back in the race, but he ultimately fails at the finish line. The owner claps his hands.%SPEECH_ON%Oh, that was a close one! The closest I've seen!%SPEECH_OFF%You nod and pay the man what he is owed. %athlete% was beaten, but despite that it seems the loss has bettered him in some regard and the company certainly enjoyed the spectacle.}"
        ja = "%terrainImage%{%athlete%が前へ出る。靴下からはみ出すふくらはぎを隆起させ、肩を回して身体をほぐす。%SPEECH_ON%ああ、あの哀れな馬と競走してやる。%SPEECH_OFF%賭けが成立し、馬の持ち主が道へ案内する。競走の準備が整うと、彼は歯を何かで逆向きに広げて留めた木製の挟み具を掲げる。縄を切ると挟み具が勢いよく閉じ、その音を合図に競走が始まった。雨ざらしの疣のような見た目にもかかわらず、馬はすぐに素早い傭兵を一歩引き離す。道半ばでようやく傭兵の持久力が差を詰めたように見えたが、最後にはゴールで敗れた。持ち主が手を叩く。%SPEECH_ON%おお、接戦だった！　今までで一番だ！%SPEECH_OFF%あなたはうなずき、男に支払うべき金を渡す。%athlete%は敗れたものの、その敗北で何かを得たらしい。傭兵団も間違いなく見世物を楽しんだ。}"
    }
    {
        en = "%terrainImage%{%beastslayer% looks down at the snake. He nods as though recollecting an old lesson.%SPEECH_ON%You only see these in the dunes. Highly venomous.%SPEECH_OFF%The serpent hisses at him. The man nods back before shooting a hand out and snatching the snake by its head.%SPEECH_ON%Your venom begin and ends in your mouth, little one, but I can use it everywhere. I trust that you will be understanding of the trade.%SPEECH_OFF%The man cracks the snake's head before cutting it clean off with a small blade and he pinches his finger over the reptile's stringy corpse. He nods again.%SPEECH_ON%I'll make use of the snake, and I trust you captain to make use of the treasure.%SPEECH_OFF%}"
        ja = "%terrainImage%{%beastslayer%は蛇を見下ろす。昔の教えを思い出したかのようにうなずいた。%SPEECH_ON%こいつらは砂丘でしか見ない。猛毒だ。%SPEECH_OFF%大蛇が男へ威嚇音を上げる。男もうなずき返すと、さっと手を伸ばして蛇の頭をつかんだ。%SPEECH_ON%お前の毒は口に始まり、口で終わる。小さき者よ。だが俺なら、どこにでも使える。この取引をわかってくれると信じているぞ。%SPEECH_OFF%男は蛇の頭を砕き、小さな刃物できれいに切り落とすと、紐のような爬虫類の死骸を指でつまむ。もう一度うなずいた。%SPEECH_ON%蛇は俺が使う。隊長、あんたは財宝を役立ててくれ。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%birdbro% nods.%SPEECH_ON%Course. Just ruined m'day that's all.%SPEECH_OFF%}"
        ja = "%terrainImage%{%birdbro%がうなずく。%SPEECH_ON%ああ、そうさ。ただ俺の一日が台無しになった、それだけだ。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%brother% walks forward with his weapon in hand. The snake rears up and the man laughs and stabs down with his weapon. The snake deftly sidewinders around the steel and strikes up the shaft and nicks the man across his knuckles. Screaming, he falls backwards, and the men collect him and drag him off. Soon he is convulsing and frothing and his entire hand bulbs and spews pus.\n\nYou believe he'll survive, but it will be a great deal of time until he is ready to fight again. As for the treasure, it shifts in the sands and you can only watch as it slowly slips into the dune itself like a boat sinking into water. When you lean to see the last of it go, more black snakes emerge as if to warn you just who it belongs to: it's the desert's treasure now and forever.}"
        ja = "%terrainImage%{%brother%が武器を手に前へ出る。蛇が鎌首をもたげると、男は笑い、武器を突き下ろした。蛇は鋼を巧みに横滑りでかわし、柄を伝うように跳ね上がって男の指の関節をかすめる。男は叫びながら仰向けに倒れ、団員たちに抱え上げられ、引きずり出された。ほどなく痙攣して泡を吹き、手全体が膨れ上がって膿を噴き出す。\n\n男は生き延びるだろうが、再び戦えるまでには長い時間がかかる。財宝は砂の中でずれ動き、船が水へ沈むようにゆっくりと砂丘の中へ消えていくのを、あなたはただ見ているしかない。最後のひと欠片を見ようと身を乗り出すと、さらに多くの黒蛇が現れ、これが誰のものか告げるかのようだった。今も、そして永遠に、この財宝は砂漠のものなのだ。}"
    }
    {
        en = "%terrainImage%{%brother% walks forward with his weapon in hand. The snake rears up and the man stabs it clean through, instantly killing the creature. He holds it up at the end of his steel, wriggling its flesh before tossing it aside.%SPEECH_ON%Easiest pay I've ever had.%SPEECH_OFF%He says as the treasure is taken into the company's inventory.}"
        ja = "%terrainImage%{%brother%が武器を手に前へ出る。蛇が鎌首をもたげると、男はその身体を一突きに貫き、即死させた。鋼の先で蠢く肉を掲げ、脇へ放り捨てる。%SPEECH_ON%今までで一番楽な稼ぎだ。%SPEECH_OFF%財宝が傭兵団の所持品へ収められる傍らで、男はそう言った。}"
    }
    {
        en = "%terrainImage%{%chosen% confidently walks up toward the tree and the bees seem shunted away by his very presence. The noise of their fluttering thickens with angry vibrations, but otherwise they take no further offense. He carefully scoops some of the honey into a jar and then eases back and steps away. He returns to the company.%SPEECH_ON%Easy peasy beehive squeezy, lads.%SPEECH_OFF%}"
        ja = "%terrainImage%{%chosen%は自信たっぷりに木へ歩み寄る。蜂はその存在感だけで押しのけられたかのようだ。羽音は怒りの震えを増して厚くなるが、それ以上襲ってはこない。彼は蜂蜜を慎重に瓶へすくい入れると、ゆっくり後ずさりして木から離れ、傭兵団へ戻ってきた。%SPEECH_ON%朝飯前の蜂の巣絞りだ、野郎ども。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%chosen% laces his fingers and cracks the knuckles with a long stretch.%SPEECH_ON%Like stealing candy from a baby.%SPEECH_OFF%He walks up to the tree and stands beneath the hive. He poses and points up at it, laughs, then turns his hands up and - much to the shock of everyone - just grabs the entire beehive. The bees instantly swarm the sellsword and he drops the hive and sprints away, a cloud of angry buzzing chasing him down a sand dune. He rolls and rolls, his screams issuing out whenever he flies out of the sand, and then he lands at the bottom and a wash of sand covers him and spares him from further bee stings. You wait a while before retrieving him, lest the bees know your hand in this attempted thievery.}"
        ja = "%terrainImage%{%chosen%は指を組み、長く伸びをしながら関節を鳴らす。%SPEECH_ON%赤子から飴を奪うようなもんだ。%SPEECH_OFF%木まで歩き、蜂の巣の下に立つ。見栄を切って巣を指さし、笑うと、両手を上げ――皆が驚く中、蜂の巣を丸ごとつかんだ。蜂はたちまち傭兵へ群がる。男は巣を落として駆け出し、怒り狂う羽音の雲に追われながら砂丘を下る。何度も転がり、砂から跳ね上がるたびに悲鳴が漏れる。やがて麓へ落ち、かぶさった砂に救われて、それ以上刺されずに済んだ。今回の盗みにあなたも関わっていると蜂に悟られぬよう、しばらく待ってから男を回収した。}"
    }
    {
        en = "%terrainImage%{%hauntedbrother% spills into your tent yelling that you did terrible things to him while he was sleeping. You stand and draw your sword, for the details of his accusations are certainly worth killing another man over, but as you both pause to breathe, you realize %hauntedbrother% has the Grand Diviner's flail firmly grasped in a whiteknuckled hand. The green mist swirling in its center brims bright, then fades as you both look at it. The sellsword throws it to the ground.%SPEECH_ON%Godsdammit, captain. We should get rid of this farking thing!%SPEECH_OFF%}"
        ja = "%terrainImage%{%hauntedbrother%があなたの天幕へ転がり込み、眠っている間にあなたからひどいことをされたと叫ぶ。告発の内容は、男を一人殺すには十分すぎるものだ。あなたは立ち上がって剣を抜く。だが二人が息をつくため動きを止めると、%hauntedbrother%が白くなるほど強く、大占術師のフレイルを握っていることに気づく。中心で渦巻く緑の霧が眩しく輝き、二人が目を向けると消えていった。傭兵はそれを地面へ投げ捨てる。%SPEECH_ON%くそったれ、隊長。この忌々しい代物は捨てた方がいい！%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%houndman% steps forward.%SPEECH_ON%I know this breed. It is of northern stock, a sturdy creature. There is one thing it shall respect in a man and it is strength.%SPEECH_OFF%The sellsword crouches before the dog and without pause puts its hands around the scuff of its neck and starts to scratch. Despite the sudden movements, the dog responds positively and when the man stops scratching the dog lifts up off the ground and lopes forward and follows the man. %houndman% stares back at you as he roughs the dog up with some heavy petting.%SPEECH_ON%Yeah he'll fight for us. Fightin' is what he's made for. He just needed someone to watch him rip and tear.%SPEECH_OFF%What a lovely creature this is. And the dog is fine, too.}"
        ja = "%terrainImage%{%houndman%が前へ出る。%SPEECH_ON%この犬種は知っている。北方の血筋で、頑健な犬だ。人間に敬意を払うものが一つだけある。それは力だ。%SPEECH_OFF%傭兵は犬の前にしゃがみ込み、ためらいなく首筋へ両手を回して掻き始める。突然の動きにもかかわらず、犬は好意的に応じた。男が掻くのをやめると、犬は立ち上がり、小走りで彼の後をついていく。%houndman%は乱暴なほど力強く犬を撫でながら、あなたを振り返る。%SPEECH_ON%ああ、こいつは俺たちのために戦う。戦うために生まれた犬だ。引き裂くところを見届ける奴が必要だっただけさ。%SPEECH_OFF%実に愛らしい生き物だ。犬の方も悪くない。}"
    }
    {
        en = "%terrainImage%{%lucky% the ever lucky sellsword has managed to find something interesting. You ask how he came across the item. He shrugs.%SPEECH_ON%{I was walking, and then I stepped on it. Simple enough. | I looked up and this bird shat and it just missed me. When I looked at where it landed, well, there it was. The bird shit and that thing you got in your hands. | Felt a tingle in my fingers, and then a tingle in my cock. After that I got to looking around for somethin' boring to absolve myself and saw it just settin' there. | Saw a horseshoe just layin' on the ground there and thought to go and fetch it and, well, that was underneath. | Well, see, I saw this four-leaf clover just setting there and I was gonna add it to my bag, see, I got dozens, anyway when I went to go pick it up I saw that item just settin' there. Pretty nifty, huh?}%SPEECH_OFF%}"
        ja = "%terrainImage%{幸運続きの傭兵%lucky%が、また面白いものを見つけた。どうやって見つけたのか尋ねると、彼は肩をすくめる。%SPEECH_ON%{歩いてたら踏んづけた。それだけだ。 | 上を見たら鳥が糞を落としやがって、ぎりぎり俺には当たらなかった。落ちた先を見たら、ほら、そこにあったんだよ。鳥の糞と、あんたが手に持ってるそれがな。 | 指先がむずむずして、その次は股間がむずむずした。そこで邪念を払うため、何か退屈なものでも探そうと辺りを見たら、そいつが転がってたんだ。 | 地面に蹄鉄が落ちてるのを見つけて拾おうとしたら、まあ、その下にあった。 | 四つ葉のクローバーが生えてるのを見つけて、袋に加えようとしたんだ。ほら、もう何十本も持ってるんだけどよ。それで摘もうとしたら、そいつがそこに転がってるのが見えた。なかなかのもんだろ？}%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%miner% the miner sucks in great gulps of breath and then lets them out in long, albeit a little wheezy exhales. He nods to himself as though satisfied by something everyone does. It seems some folks are easily pleased. But he does explain himself.%SPEECH_ON%You know I spent years in the dank and dark of the mines, breathing in the dust and the metals. I think being surface side this long has been a fortune of its own, a treasure I didn't know was out here for the taking. Thank you, captain, cause I wouldn't be here right now if it weren't for you.%SPEECH_OFF%You nod and thank him for the kind words.}"
        ja = "%terrainImage%{鉱夫の%miner%は大きく息を吸い込み、少しぜいぜいしながらも、長く吐き出す。誰もがしていることに満足したかのように、一人でうなずいている。喜ばせやすい者もいるものだ。だが彼は理由を説明した。%SPEECH_ON%俺は何年もじめじめした暗い坑道で、埃と金属を吸い込んで暮らしてきた。こんなに長く地上で過ごせたこと自体が幸運なんだと思う。ここに出てくるまで、ただで手に入る宝だとは知らなかった。ありがとう、隊長。あんたがいなけりゃ、俺は今ここにいなかった。%SPEECH_OFF%あなたはうなずき、温かい言葉に礼を返した。}"
    }
    {
        en = "%terrainImage%{%monk% the monk steps forward.%SPEECH_ON%That's a lotta work to end yourself, friend.%SPEECH_OFF%The man shrugs.%SPEECH_ON%I'm not really your friend.%SPEECH_OFF%The monk nods.%SPEECH_ON%Turn of phrase, nothing more. In truth I know nothing about you. In truth you likely have a good reason to be doing this. How much time have you spent putting this together?%SPEECH_OFF%The strange man thinks for a time, then says he thinks it's been months. %monk% smiles.%SPEECH_ON%Now that's good, hard work.%SPEECH_OFF%The man says.%SPEECH_ON%You trying to coddle me?%SPEECH_OFF%The monk shakes his head.%SPEECH_ON%No Sir.%SPEECH_OFF%The man slims his eyes and stares incredulously.%SPEECH_ON%Sounds to me like motherly talk. Like you're trying to sweet talk me into not killing myself. Well I won't have it!%SPEECH_OFF%%monk% shrugs.%SPEECH_ON%Again, no sir. You go on and end yourself if that's what you wish. Today or later, the old gods will be waiting.%SPEECH_OFF%The man turns and spits.%SPEECH_ON%No old gods down here. Only the Gilder's gleam and glow.%SPEECH_OFF%%monk% nods then turns to look at you.%SPEECH_ON%To be frank, captain, I really only got one thing left to say. Can I say it? I just wanna tell it to the stranger, tell it to him straight.%SPEECH_OFF%}"
        ja = "%terrainImage%{修道士の%monk%が前へ出る。%SPEECH_ON%自分を終わらせるにしちゃ、ずいぶんな大仕事だな、友よ。%SPEECH_OFF%男は肩をすくめる。%SPEECH_ON%あんたの友じゃない。%SPEECH_OFF%修道士はうなずく。%SPEECH_ON%ただの言い回しだ。それ以上の意味はない。実のところ、私はお前について何も知らん。実のところ、こうしているのも、きっともっともな理由があるのだろう。これを組み上げるのに、どれほどかけた？%SPEECH_OFF%奇妙な男はしばらく考え、何か月もかかったと思う、と答える。%monk%は笑みを浮かべる。%SPEECH_ON%それは見事な骨折りだ。%SPEECH_OFF%男が言う。%SPEECH_ON%俺をなだめる気か？%SPEECH_OFF%修道士は首を振る。%SPEECH_ON%いいえ、旦那。%SPEECH_OFF%男は目を細め、疑わしげににらむ。%SPEECH_ON%母親みたいな口ぶりだ。俺が自殺しないよう、甘い言葉で丸め込もうとしてるんだろう。そうはいかんぞ！%SPEECH_OFF%%monk%は肩をすくめる。%SPEECH_ON%繰り返すが、違う、旦那。望むなら自らを終わらせればいい。今日であれ後日であれ、古き神々は待っている。%SPEECH_OFF%男は顔を背けて唾を吐く。%SPEECH_ON%ここに古き神々はいない。あるのはギルダーの煌めきと輝きだけだ。%SPEECH_OFF%%monk%はうなずき、あなたへ向き直る。%SPEECH_ON%率直に言えば、隊長、あと一つだけ言いたいことがある。言ってもいいか？　このよそ者に、ありのままを伝えたい。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%tailor% the tailor rubs his chin with two fingers. He finally points them forward.%SPEECH_ON%I've got it. Gentlemen, give me every scrap of unused or trashy clothing you have. Every article you got. Hand it over. There you go. Yes, that's absolutely trash, %otherbrother%. Your favorite shirt? By the gods, just give it to me already. Thank you.%SPEECH_OFF%The tailor collects armfuls of discarded clothing and gets to work with his scissors. He slices and dices and pauses. He pauses a lot, always unsure of his work. But finally he presents the results. A pile of fresh socks and enough left over scraps to furnish some extra bandages. He's also wearing a surprisingly flashy new garb that you've no clue how he created.}"
        ja = "%terrainImage%{仕立屋の%tailor%は二本の指で顎をさする。やがて、その指を前へ向けた。%SPEECH_ON%思いついた。諸君、使っていない服やぼろ服の切れ端を全部くれ。服なら何でもだ。さあ渡せ。そう、それだ。確かにまごうことなきぼろだな、%otherbrother%。お気に入りのシャツだと？　神々にかけて、いいから早くよこせ。ありがとう。%SPEECH_OFF%仕立屋は捨てられた服を両腕いっぱいに集め、鋏で作業に取りかかる。切って刻んで、手を止める。何度も手を止め、自分の仕事に確信が持てない様子だった。だがついに成果を披露する。真新しい靴下の山と、予備の包帯を作るに足る残り布だ。さらに、どう作ったのか見当もつかないほど派手な新しい服を自分で着ている。}"
    }
    {
        en = "%terrainImage%{%thief% the thief sidles up to you. Stepping away and putting your hands in your pockets, you ask what he wants. He smirks and answers.%SPEECH_ON%Alright I'll be honest with you, captain. Last time we stopped in town I helped myself to a blind peacemaker's wares. What? I'd a sore tooth. No reason to pay to fix what the old gods gave me. Anyway, I fixed my tooth. See? What a smile, right? But then I thought I felt some aches, man, aches all over the place! So I visited the peacemaker again and...%SPEECH_OFF%You interrupt the man and ask just how much he stole. He produces a sack of medicinal goods. He proudly puts his hands to his hips and stare out at the world with his crooked grin.%SPEECH_ON%Suffice it to say I ain't hurtin' no more.%SPEECH_OFF%} "
        ja = "%terrainImage%{盗人の%thief%がにじり寄ってくる。あなたは距離を取り、両手を懐に入れて、何の用かと尋ねる。彼はにやりと笑って答えた。%SPEECH_ON%わかった、正直に話すよ、隊長。前に町へ寄ったとき、目の見えない治療師の品を少しばかり勝手にもらった。何だよ？　歯が痛かったんだ。古き神々から授かったものを直すのに金を払う理由なんてないだろ。ともかく、歯は治した。見ろよ。いい笑顔だろ？　だが次は、あちこち痛む気がしてきたんだ。まったく、全身がよ！　それでまた治療師のところへ行って……%SPEECH_OFF%あなたは話を遮り、いったいどれだけ盗んだのかと尋ねる。男は医薬品の入った袋を取り出した。両手を誇らしげに腰へ当て、歯並びの悪い笑みを浮かべて世界を見渡す。%SPEECH_ON%早い話が、もうどこも痛くねえ。%SPEECH_OFF%} "
    }
    {
        en = "%terrainImage%{A peasant passes you on the path. He mentions off-hand that he doesn't understand why gods would have their followers fight each other. If it really wanted to be settled, why not do it themselves? You grab him by the shirt and ask what he's blathering about. He pulls away.%SPEECH_ON%Oy! Hands off, or I'll nip ya! And I'm just grousing, thass'all. Lotta talk going around about the Gilded folk and the followers of the old gods butting heads. Again. Now lemme bitch in peace!%SPEECH_OFF%The man walks off, mumbling and, ironically, getting louder in volume the further away he gets from you. | You come across a congress of Gilded and old gods' monks alike. They're discussing the possibility of an upcoming war, and how to protect themselves if such a time comes to pass. It's admirably amicable, all told, but it does seem there's a hint of religious reckoning in the air. | A man fixing a wagon beside the road shakes his head.%SPEECH_ON%You know, I'd just like to go from one spot of the world t'another, and that be that. But no. Farking... something! Always something! Has gotta go wrong. Hey, speaking of wheels, here's one I hear turning: the Gilder and the old gods might be knocking heads again. Seen storm clouds of it. Holy war in the sky. Which means holy war here. I hope to get clear of it before it starts. You seen the last one? Nasty business.%SPEECH_OFF%You're sure it is, but nasty business means good business for the %companyname%. | %SPEECH_ON%Knees bothering me.%SPEECH_OFF%You look over to see an old man wiggling two stumps. He grins.%SPEECH_ON%That is to say, the spirit of my knee is getting ornery. When I had m'legs, the tinge in the knee meant bad weather. Now the twinge in no-knee means something worse.%SPEECH_OFF%A young boy comes and hauls the elder into a wheelbarrow. Before he departs, you ask what he means. He turns aside, elbow cocked and hand planted on his hand, looking dapper and lively for what he is.%SPEECH_ON%A reckoning from above. The Gilder, the old gods, maybe even more than just them. I think they're all toying with us, spurring us folk to kill one another to appease them, so they can have a watch. You look the part of a sellsword, so I imagine business will be kind to you once them clerical colors wanna go red.%SPEECH_OFF%}"
        ja = "%terrainImage%{道ですれ違った農民が、なぜ神々は信徒同士を戦わせるのかわからない、と何気なく口にする。本当に決着をつけたいのなら、自分たちでやればいいではないか、と。あなたは男の襟首をつかみ、何をべらべら話しているのかと問う。男は振りほどいた。%SPEECH_ON%おい！　手を放せ、噛みつくぞ！　ちょっと愚痴ってただけだ。それだけだって。ギルダーの民と古き神々の信徒が、またぶつかり合うって噂で持ちきりなんだ。さあ、静かに愚痴らせてくれ！%SPEECH_OFF%男はぶつぶつ言いながら歩き去る。皮肉にも、遠ざかるほど声は大きくなっていった。 | ギルダーの信徒と古き神々の修道士が集まっている場に出くわした。迫るかもしれない戦争と、その時が来たらどう身を守るかを話し合っている。全体としては感心するほど穏やかな集まりだが、それでも宗教的な審判の気配が空気に漂っている。 | 道端で荷馬車を直す男が首を振る。%SPEECH_ON%俺はただ、世界のある場所から別の場所へ行って、それで終わりにしたいんだ。だが、そうはいかん。くそったれな……何かが！　いつだって何かが！　必ずおかしくなる。車輪の話ついでに、回り始めたって噂の車輪がある。ギルダーと古き神々が、また頭をぶつけ合うかもしれん。嵐の雲が見えたんだ。空で聖戦が起きりゃ、ここでも聖戦になる。始まる前に逃げ出したいね。前の戦を見たか？　ひでえもんだった。%SPEECH_OFF%そうだろう。だが、ひどい出来事は%companyname%にとって実入りのよい仕事でもある。 | %SPEECH_ON%膝が疼く。%SPEECH_OFF%目を向けると、両脚の切断された老人が二つの断端を揺すっている。老人は笑った。%SPEECH_ON%つまり、膝の霊が機嫌を悪くしてるってことだ。脚があった頃は、膝の疼きは悪天候の印だった。今じゃ、ない膝の疼きはもっと悪いものの印だ。%SPEECH_OFF%少年がやって来て、老人を手押し車へ乗せて運んでいく。立ち去る前に、その意味を尋ねる。老人は横を向き、肘を曲げて手を腰へ当てた。今の姿に似合わず、粋で活気に満ちた様子だ。%SPEECH_ON%天上からの審判だ。ギルダー、古き神々、ひょっとするとそれ以外もいるかもしれん。奴らは皆、俺たちを弄んでいるのさ。見物するために、俺たち民をけしかけ、互いを殺させて自分たちを満足させる。あんたは傭兵に見える。宗派の色を血で赤く染めたくなったら、商売はずいぶん繁盛するだろうよ。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{A voice seeps into the darkness: wherever she is... your mother knows she abandoned you... wherever I am... you know I would love you as greatly as her absence has harmed you. I will mother you to power, sellsword, I will feed you the milk of life from...\n\n You snap awake to a bright green hue and slap it out of your face. %hauntedbrother% falls to the ground and beside him the Grand Diviner's flail clangs. The sellsword shakes his head and his eyes widen as he looks around, confused.%SPEECH_ON%Wh-what? How did I get here?%SPEECH_OFF%You stare at the flail, watching as the viridian glow shimmers and then dims, a grotesque chuckling echoing as it fades.}"
        ja = "%terrainImage%{闇の中へ声が染み出す。母親がどこにいようと……あの女はお前を捨てたと知っている……私がどこにいようと……あの女がいないことでお前が傷ついた分だけ、私がお前を深く愛すると知っているだろう。お前を育て、力を授けよう、傭兵よ。命の乳をお前に飲ませよう、私の……\n\n あなたは鮮やかな緑の光の中で跳ね起き、それを顔から払いのける。%hauntedbrother%が地面に倒れ、その傍らで大占術師のフレイルが金属音を立てた。傭兵は首を振り、目を見開いて辺りを見回す。混乱している。%SPEECH_ON%な、何だ？　どうして俺はここに？%SPEECH_OFF%あなたはフレイルを見つめる。青緑の光が揺らめいて弱まり、消えていくにつれて、おぞましい忍び笑いが響いた。}"
    }
    {
        en = "%terrainImage%{An hour or so after sending the men off on a hunt, they return. Except they're dragging a bloodied and shredded %bearbrother% back into camp. They report the group had crossed paths with a momma brown bear. Her fight was tremendous, and she only stopped mauling the wounded poacher because one of the men threatened her babies with a torch. You're happy the men are all alive, albeit %bearbrother% is going to require a long time to recover.}"
        ja = "%terrainImage%{団員たちを狩りへ送り出して一時間ほどすると、彼らが戻ってきた。ただし、血まみれでずたずたにされた%bearbrother%を野営地へ引きずっている。一行は母親のヒグマと鉢合わせたのだという。凄まじい戦いぶりで、負傷した密猟者を襲うのをやめたのは、団員の一人が子熊を松明で脅したからだった。全員が生きているのは喜ばしい。もっとも、%bearbrother%が回復するまでには長い時間がかかるだろう。}"
    }
    {
        en = "%terrainImage%{As you approach the drunkard, a sharp whistle cracks across the path. You and the drunkard both look to see %thief% the thief standing there with a weapon to the back of another man.%SPEECH_ON%That feller's no nobleman, and probably aint no drunk neither. They're working together to either ambush travelers or threaten them with blackmail. They're robbers, sir.%SPEECH_OFF%You look back to see the man smiling nervously. He explains with suddenly sharpened clarity.%SPEECH_ON%We'd no interest in robbing sellswords, sir, I-I-I swear I was about to explain myself soon as I sawr yer swords.%SPEECH_OFF%%thief% yells out, asking where the cache is. You look back at the man and tell him to hand over everything he's stolen. He nods and asks if you'll gut him if he refuses. You nod and tell him the gutting will come last, and by that point it'll be a relief. The man puts a little pep in his step.%SPEECH_ON%Yessir gotcha sir, right this way.%SPEECH_OFF%} "
        ja = "%terrainImage%{酔っ払いへ近づくと、鋭い口笛が道に響く。あなたと酔っ払いが振り向くと、盗人の%thief%が別の男の背へ武器を突きつけて立っていた。%SPEECH_ON%あの野郎は貴族じゃねえし、たぶん酔ってもいねえ。二人で旅人を待ち伏せするか、脅して金を巻き上げるつもりだ。盗賊ですよ、旦那。%SPEECH_OFF%振り返ると、男は引きつった笑みを浮かべている。急にはっきりした口調で釈明した。%SPEECH_ON%傭兵から盗む気なんてなかったんです、旦那。ほ、本当です。剣が見えたらすぐ、事情を話すつもりでした。%SPEECH_OFF%%thief%が、隠し場所はどこだと怒鳴る。あなたは男を振り返り、盗んだものをすべて差し出せと告げる。男はうなずき、断ったら腹を裂くのかと尋ねた。あなたはうなずき、腹を裂くのは最後で、その頃にはむしろ救いになるだろうと答える。男の足取りが少し軽くなった。%SPEECH_ON%はい旦那、わかりました旦那。こちらです。%SPEECH_OFF%} "
    }
    {
        en = "%terrainImage%{Feeling rather courageous, you nominate the fattest man in the company to handle the race. %fat% steps forward with an eyebrow raised, asking if you're sure about taking him as your horseracing champion. You hold your hand on his shoulder and say he's the fattest fark you've ever seen being a sellsword, but that you believe in him. You also believe the horse is a haggard draught animal that's on its last legs, but you keep that part to yourself.\n\n The man and horse are put next to each other. An apple tree stands in the distance and the first to it is the winner. With the rules laid out, the race is started. It's not an especially close one. %fat% falls behind almost instantly and trundles down the track with his face beet red and huffing breath and the men nearly die laughing at the sight. The fat sellsword and dire horse meet back up at the apple tree and there share the fruits of their labors. You pay the horse's owner what he is owed. He smiles as he counts the coin.%SPEECH_ON%Don't usually get a show with the race, sir.%SPEECH_OFF%}"
        ja = "%terrainImage%{妙に勇気が湧いたあなたは、競走に挑む者として傭兵団で一番太った男を指名する。%fat%は片眉を上げて前へ出ると、本当に自分を競馬の代表にするのかと尋ねる。あなたは男の肩に手を置き、今まで見た傭兵で一番のデブ野郎だが、お前を信じている、と告げた。相手の馬が、くたびれて死にかけの荷馬でもあると信じているが、その部分は胸にしまっておく。\n\n 男と馬が並べられる。遠くにリンゴの木が立っており、先に着いた方が勝者だ。規則が示され、競走が始まる。それほど接戦にはならなかった。%fat%はほとんど即座に遅れ、顔を真っ赤にして息を切らしながら道をどたどた走る。その姿に団員たちは笑い死にしそうになった。太った傭兵と哀れな馬はリンゴの木で再会し、そこで互いの労苦の果実を分け合う。あなたは持ち主へ支払うべき金を渡す。男は硬貨を数えながら笑った。%SPEECH_ON%競走に見世物までついてくることは、滅多にないですよ、旦那。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Marching all around the world has put some wear and tear on the men. Whenever a mercenary takes off a boot you can see the blood seeping through his sock. They've accumulated sores and boils. One man peels the flesh off his toe and says he regrets doing that and you nod. All in all, this is the price to pay for being on the road so much.}"
        ja = "%terrainImage%{世界中を歩き回ったせいで、団員たちの身体はすっかり擦り減っている。傭兵が長靴を脱ぐたび、靴下に血が滲むのが見える。靴擦れや腫れ物も増えた。一人が足の指から皮を剥がし、やらなければよかったと言うので、あなたはうなずく。総じて、これが長く旅を続ける代償なのだ。}"
    }
    {
        en = "%terrainImage%{The desert is not home to much of anything beyond the sands. So it is rather particular when you come across a lone tree setting out by itself, and even more stranger that hanging from a branch is a fat beehive with a cloud of workers swarming around its bulbous shape. Even at some distance, you can see the golden ember of their honey glistening...}"
        ja = "%terrainImage%{砂漠には砂以外、ほとんど何もない。だから一本だけぽつんと立つ木に出くわすのは珍しく、しかも枝から丸々と太った蜂の巣が下がり、その膨らんだ形の周りを働き蜂の群れが飛び回っているとなれば、なおさら奇妙だ。少し離れていても、蜂蜜が金色の残り火のようにきらめくのが見える……}"
    }
    {
        en = "%terrainImage%{The desert is so awash in similarity that seeing a bit of greenery immediately draws the eye. Such is the magnetism of an oasis. You spot it at great distance, and upon approach you realize the green is not a tree at all, but a banner flying from the catch of a dead, dried tree. Around it are more dead trees, some having crumpled into the sands which eat at them from every side. And in the midst of this passed oasis sets a skeleton with its face down in a small bowl of earth where, perhaps, water once was. To the skeleton's side is a pile of treasures. All the crowns in the world, but not a single drop of water with which to spend it on.\n\n You move to get the gold, but the coins move with you, sliding apart as a black snake rises up and hisses at you. Green poisons slickly drip from its fangs.}"
        ja = "%terrainImage%{どこまでも似た景色が広がる砂漠では、わずかな緑もたちまち目を引く。オアシスとはそれほど人を惹きつけるものだ。遠くからそれを見つけ、近づいてみると、緑に見えたのは木ではなく、枯れ果てた木の枝に引っかかってはためく旗だった。周囲にも枯れ木が立ち、いくつかは四方から食らいつく砂の中へ崩れ落ちている。とうに死んだこのオアシスの真ん中には、かつて水があったのだろう小さなくぼみに顔を伏せた骸骨が座っていた。その傍らには財宝の山がある。この世のクラウンをすべて積み上げたような富だ。だが、その金で買える水は一滴もない。\n\n 黄金を取ろうと踏み出すと、硬貨もこちらに合わせて動き、左右へ滑り落ちた。その下から黒い蛇が身を起こし、こちらへ威嚇する。牙からは緑色の毒液がぬらりと滴っている。}"
    }
    {
        en = "%terrainImage%{The man grins.%SPEECH_ON%You don't know a damn thing about me, stranger. Maybe I aim to kill myself cause I done a terrible crime. I mean, I haven't, but what're you doing going off about 'don't do it'? You've seen my preparation, were I of the mind to pause wouldn't I have done it at any prior moment? Now you set back there and watch this.%SPEECH_OFF%He turns and leaps into the hole. There's a clatter of his crashing, some murmuring about how there's more debris than he remembers. When you look down he yells at you to clear out and the orange glow zips into a hole. The man bows.%SPEECH_ON%I bid you good stranger, a strange farewe-%SPEECH_OFF% The explosion blows out your ears and puts you on the ground. The earth rolls beneath you in tremble that can be felt through the deafness which you are now submerged. A pluming cloud of fire spears into the sky and growls with the clinking and clanking of metals and the dull plops of leather and other goods, and you roll to your belly and cover your head as it all comes down like the scraps of some god's hellstorm.\n\n Absolutely none of the debris is of any use. As for the man himself, well, he got his wish. He no doubt died in the blink of an eye, all that remains are charred chunks here and there and broiled lungs and seared strips of sinews and more. You check to make sure your eyebrows are still there and, satisfied, prepare to move on.}"
        ja = "%terrainImage%{男はにやりと笑う。%SPEECH_ON%あんたは俺のことを何ひとつ知らねえ、よそ者。俺がひどい罪を犯して自殺しようとしてるのかもしれねえだろ。まあ、犯しちゃいないがな。それなのに「やめろ」なんて何を勝手に騒いでやがる？　ここまで準備したのを見たろ。思い直す気があるなら、とっくにどこかでやめてたはずだ。さあ、そこで座って見てな。%SPEECH_OFF%男は背を向けて穴へ飛び込む。下で何かにぶつかるけたたましい音がし、以前より瓦礫が増えたなどとぶつぶつ言う声が聞こえる。覗き込むと、男は離れろと怒鳴り、橙色の光が穴の奥へ走った。男は一礼する。%SPEECH_ON%では、見知らぬ御仁よ。奇妙なる別れを――%SPEECH_OFF% 爆発が耳を潰し、あなたを地面へ叩き倒す。音の消えた世界に沈む中でも、大地のうねりと震えだけは全身に伝わる。噴き上がる火柱が空を貫き、金属の甲高い音、革や雑貨の鈍い落下音を伴って唸る。あなたは腹ばいになって頭を抱え、神が降らせた地獄の嵐の残骸さながらに降り注ぐ品々をやり過ごす。\n\n 瓦礫は何ひとつ使い物にならない。男自身については、まあ、望みは叶った。瞬きする間に死んだのだろう。残ったのは、あちこちに散った黒焦げの肉片、焼けた肺、炙られた腱の切れ端などだ。あなたは眉毛がまだ付いていることを確かめ、満足して先へ進む支度をする。}"
    }
    {
        en = "%terrainImage%{The man nods.%SPEECH_ON%That ain't no watering hole, that's a cannon. I got a pile of fire powder in the bottom. The chute is armed with buckets, and fishing rods, all manner of cutlery, some soldier's metal boots, a broken sword, couple of scabbards, I think a few animals fell in but they no doubt dead now, if not they're going for a ride.%SPEECH_OFF%}"
        ja = "%terrainImage%{男はうなずく。%SPEECH_ON%ありゃ水汲み穴じゃねえ、大砲だ。底には火薬を山ほど積んである。筒には桶や釣り竿、ありとあらゆる食器、兵士の鉄靴、折れた剣、鞘を何本か詰めた。動物も何匹か落ちたと思うが、もう死んでるだろう。生きてるなら、とんでもねえ旅に出ることになるな。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{The monk nods with your approval then suddenly swings around and cold cocks the stranger. He falls off the well wall and collapses into the dirt, staring up with his eyes wonked.%SPEECH_ON%What'd you go and do that for?%SPEECH_OFF%He asks, touching his lip. %monk% crouches down.%SPEECH_ON%How's that feel?%SPEECH_OFF%The stranger sneers and spits blood. He says it hurts. The monk nods.%SPEECH_ON%Feel alive?%SPEECH_OFF%The stranger gets to his feet and dusts himself off. He nods.%SPEECH_ON%A little, yeah.%SPEECH_OFF%The two talk for a time and when it is over the man is willing to join the company free of charge. He also says that there are a number of goods in the well if they want to be used, though to be mindful to not drop any fire in there cause it'll blow sky high.}"
        ja = "%terrainImage%{あなたの許しにうなずくと、修道士は突然振り向きざまに男の顎を殴り抜いた。男は井戸の縁から落ち、地面に崩れ落ちて、焦点の合わない目で見上げる。%SPEECH_ON%何しやがる！%SPEECH_OFF%唇に触れながら男が問う。%monk%はしゃがみ込む。%SPEECH_ON%どんな感じだ？%SPEECH_OFF%男は顔を歪め、血を吐く。痛い、と答える。修道士はうなずく。%SPEECH_ON%生きてると感じるか？%SPEECH_OFF%男は立ち上がり、土埃を払ってうなずく。%SPEECH_ON%少しはな。%SPEECH_OFF%二人はしばらく話し合い、終わるころには男が無償で傭兵団へ加わる気になっていた。井戸の中には使えそうな品がいくつもあるとも教えてくれたが、火を落とせば井戸ごと空まで吹き飛ぶので注意しろという。}"
    }
    {
        en = "%terrainImage%{The nearly frozen man joins the company. He's a ragged wreck, but if what he said is true maybe he will someday become the fighter he could barely speak of.}"
        ja = "%terrainImage%{凍死寸前だった男が傭兵団に加わった。見るも無惨な有様だが、話が本当なら、いつの日か、かろうじて語ったあの戦士になれるかもしれない。}"
    }
    {
        en = "%terrainImage%{The next stop ain't far. You hope the men can keep it together until they get there. What bandages you have are applied as necessary.}"
        ja = "%terrainImage%{次の立ち寄り先は遠くない。そこまで団員たちが持ちこたえてくれることを願う。手持ちの包帯を必要な者へ巻いてやる。}"
    }
    {
        en = "%terrainImage%{The snowy wastes are home to not much of anything, so to find a man half-naked in its frigid geography is rather unusual. That he is actually alive even more so. You crouch beside him. His eyes are hollow and rime frosts make blinking them a struggle. His lips are jagged and purple. His nose a deep red bordering on black. You ask if he can speak. He nods.%SPEECH_ON%Barbarians. Took. Me.%SPEECH_OFF%You ask where his kidnappers are. He shrugs and continues his cold cadence.%SPEECH_ON%They. Got. Bored. And. Left.%SPEECH_OFF%It does seem in tune with the primitives to up and leave a prisoner in the ice. He explains that he was once a sturdy swordfighter. A smile squeezes  through the pain.%SPEECH_ON%A. King's. Guard. In. The. Kingless. Land. Things. Could. Be. Worse?%SPEECH_OFF%}"
        ja = "%terrainImage%{雪の荒野にはほとんど何も棲まない。そんな凍てつく土地で半裸の男を見つけるだけでも珍しいのに、まだ生きているとなればなおさらだ。あなたは傍らにしゃがみ込む。目は落ちくぼみ、霜がまつ毛を凍らせて瞬きさえ難しい。唇は裂けて紫色に変わり、鼻は黒ずむ寸前の深紅だ。話せるかと問うと、男はうなずく。%SPEECH_ON%蛮族。俺を。さらった。%SPEECH_OFF%さらった者たちはどこだと尋ねる。男は肩をすくめ、凍えた調子で続ける。%SPEECH_ON%奴ら。飽きた。それで。置いてった。%SPEECH_OFF%捕虜を氷の上へ放り出して去るとは、いかにも野蛮人らしい。男はかつて屈強な剣士だったと語る。苦痛の中から、かすかな笑みが絞り出される。%SPEECH_ON%王なき国の。王の護衛。これより。悪くなるか？%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Unlike the south, finding travelers on the northern 'roads' is often a cause for caution. You never know what monstrous man or beastly barbarian you'll come across next. This time it is a large man limping with a dog beside him. You draw your sword halfway out of its sheath and loud enough to gain his ear. The man looks up and his dog rears to the sudden yank of a leash. The northerner can speak a bit of your tongue.%SPEECH_ON%Ahh, fighters. I'm a fighter myself.%SPEECH_OFF%You ask why he is alone. He explains that his clan had a dispute, and that he was to duel another man to decide who would take control. You ask why he did not duel this man, you ask if he is afraid. The traveler shakes his head.%SPEECH_ON%No. The clansman was my brother. And I'd no desire to kill kin. They gave me this bitch here as both insult and reward and threw me from the tribe. I've no land or people to go to, but if you'd have me, I'd surely fight for you just as well as anyone else.%SPEECH_OFF%}"
        ja = "%terrainImage%{南方と違い、北方の「街道」で旅人を見つけたときは警戒が要る。次に出会うのが怪物じみた男か、獣じみた蛮族か、知れたものではない。今回は犬を連れ、足を引きずる大男だった。あなたは剣を鞘から半ば抜き、わざと耳に届く音を立てる。男が顔を上げ、手綱を急に引かれた犬が身を起こす。北方人はあなたたちの言葉を少し話せた。%SPEECH_ON%ああ、戦士か。俺も戦士だ。%SPEECH_OFF%なぜ一人なのかと尋ねる。氏族で争いが起き、誰が支配権を握るか決めるため、別の男と決闘することになったのだという。なぜ戦わなかった、怖気づいたのかと問う。旅人は首を振る。%SPEECH_ON%違う。相手は俺の兄弟だった。血族を殺す気にはなれなかった。奴らは侮辱と褒美を兼ねて、この雌犬を俺に寄越し、氏族から追放した。もう行く土地も、帰る民もない。受け入れてくれるなら、ほかの誰にも劣らずあんたのために戦う。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Upon hearing some sellswords yelling at each other, you reluctantly set aside your quill pen and step outside your tent. There you find %hauntedbrother1% and %hauntedbrother2% in each other's faces - and between them they're pulling at the Grand Diviner's flail. What is being screamed between them are obscenities of a most graphic nature, and just as you're about to step in the flail glows a bright green and both sellswords drop the weapon to lunge at each other. The fight is ended fast, but not without injuries.}"
        ja = "%terrainImage%{傭兵たちが怒鳴り合う声を聞き、あなたは渋々羽根ペンを置いて天幕の外へ出る。そこでは%hauntedbrother1%と%hauntedbrother2%が互いに顔を突き合わせ、その間で大占術師のフレイルを引っ張り合っていた。二人は目を覆いたくなるほど下劣な罵声を浴びせ合っている。あなたが割って入ろうとした瞬間、フレイルが鮮やかな緑に輝き、二人は武器を落として互いへ飛びかかった。喧嘩はすぐ止められたが、無傷では済まなかった。}"
    }
    {
        en = "%terrainImage%{Walking, running, fighting, fucking, all good for a man's heart. The time spent traveling the land has improved the vitality and vigor of the men. You even caught one of the cheekier mercenaries flexing into pondwater, admiring his own reflection like some smirkin' wench. | All this running about the land has increased the stamina of the men. One runs in place, holding a finger to his neck. He remarks that his heart rate isn't going up at all. Another brother remarks that the guy doesn't even know how to count. The running man pauses.%SPEECH_ON%Oh. That's right.%SPEECH_OFF%}"
        ja = "%terrainImage%{歩く、走る、戦う、女を抱く。どれも男の心臓にはいい。各地を旅してきた日々が、団員たちの生命力と活力を鍛え上げた。生意気な傭兵の一人が池の水面に向かって筋肉を誇示し、にやつく娘のように自分の姿へ見とれているところまで目にした。 | 各地を走り回ったおかげで、団員たちの持久力が増した。一人がその場で足踏みしながら首に指を当て、心拍がまるで上がらないと得意げに言う。別の団員が、そいつは数の数え方すら知らないぞと指摘する。走っていた男は動きを止める。%SPEECH_ON%ああ。そうだった。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{When it comes to walking the earth, %travelbro% is longer in the tooth than anyone. He laughs at the plight of his fellow sellswords.%SPEECH_ON%Ah, now this is what I'm talking about! Nevermind the pain, men, embrace the soreness!%SPEECH_OFF%The company collectively tells him to stuff it, but the roadman happily wiggles his toes around. You didn't even realize he had his boots off before that, his feet are so calloused you thought the bony figures but folds of leather!}"
        ja = "%terrainImage%{地上を歩くことなら、%travelbro%ほど年季の入った者はいない。彼は仲間の苦境を笑い飛ばす。%SPEECH_ON%ああ、これだよ、これ！　痛みなんか気にするな。筋肉痛を楽しめ、みんな！%SPEECH_OFF%傭兵団は声を揃えて黙れと言うが、旅慣れた男は楽しげに足の指を動かしている。靴を脱いでいたことにさえ気づかなかった。あまりに足裏が硬く、骨ばった形を革のひだだと思っていたのだ！}"
    }
    {
        en = "%terrainImage%{While on the march, you find a drunken nobleman tottering side to side on the path. Mussy is the name of his hair, leaves and grass and what looks like birdshit swept up in it like someone stirred the ingredients to a prank. But his clothes sweep about with the finest of silks and his fingers glisten with jewelry. He has a bottle in each hand and he swings them around as he sings gibberish pub songs.\n\nHe is in all regards the greatest magnet for a mugging you've ever seen. %randombrother% purses his lips and he looks like a wolf staring at a fat sheep.%SPEECH_ON%I'm not saying nothing, sir, I'm just. I'm just seeing it. That's a lot of juice. A lot of juice limping down the road. But again I ain't saying nothing.%SPEECH_OFF%You know what he's talking about.}"
        ja = "%terrainImage%{行軍中、道の上で左右によろめく酔っ払いの貴族を見つける。髪と呼ぶにはあまりに乱れ、草葉や、鳥の糞らしきものまで、悪戯の材料をかき混ぜたように絡まっている。だが身にまとうのは極上の絹で、指には宝石がきらめく。両手に瓶を一本ずつ持ち、意味不明な酒場歌を歌いながら振り回している。\n\nこれほど追い剥ぎを呼び寄せそうな男を見たことはない。%randombrother%は唇をすぼめ、肥えた羊を見つめる狼のような顔をしている。%SPEECH_ON%何も言ってませんよ、隊長。ただ、その……見えてるだけです。大した獲物が、大した獲物が道をふらついてる。でも、俺は何も言ってませんからね。%SPEECH_OFF%何を言いたいかはわかっている。}"
    }
    {
        en = "%terrainImage%{While traveling the land, %birdbro% gets struck by birdshite. It hits his swordhand and splashes crosswise all over his armor.%SPEECH_ON%Aww, awwww!%SPEECH_OFF%His arms go wide like chicken wings as he looks at the damage.%SPEECH_ON%Bloody hell, just my luck!%SPEECH_OFF%}"
        ja = "%terrainImage%{旅の途中、%birdbro%に鳥の糞が命中する。剣を握る手に当たり、鎧の上へ斜めに飛び散った。%SPEECH_ON%うわっ、うわああ！%SPEECH_OFF%被害を見た彼は、鶏の翼のように両腕を広げる。%SPEECH_ON%くそったれ、ついてねえ！%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You come across a caldera the bottom of which you find a few sheep nuzzling something. As you draw close, you see that there is an enormous hound there, its fur matted with blood, its collar shredded, and its paws wiry where the claws have come apart. It regards you with a growl, but can't maintain it for long as it simply puts its head down with an exhausted huff. The sheep depart and beyond them you find a man leaning against a rock. His chest has been ripped open and whatever killed him did it with such force as to spray his innards all along the rocks. Following the trail, you do find a monstrous Nachzehrer whose throat has been ripped out. %randombrother% nods.%SPEECH_ON%I think that pup might be worth having in the company.%SPEECH_OFF%}"
        ja = "%terrainImage%{窪地に出くわし、底では数頭の羊が何かへ鼻先を寄せている。近づくと、そこには巨大な猟犬がいた。毛皮は血で固まり、首輪は裂け、爪の剥がれた足先はささくれている。唸ってこちらを睨むが、長くは続かず、疲れ切った息を吐いて頭を伏せた。羊が離れ、その先には岩にもたれた男がいる。胸は引き裂かれ、殺した何かの力があまりに強かったのか、内臓が岩一面へ飛び散っている。痕跡を追うと、喉を食い破られた巨大なナハツェーラーが見つかった。%randombrother%がうなずく。%SPEECH_ON%あの犬なら、傭兵団に迎える価値がありそうですね。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You come across a man beside a hole in the ice. He's got a fishing pole next to him and, despite the environment, welcomes you warmly.%SPEECH_ON%Care to have a chat, traveler? You don't seem to be from these parts.%SPEECH_OFF% | A man wearing bear fur is cutting a hole in the ice. He looks at you just as the rim of his cuts drops and he punches it into the water.%SPEECH_ON%Come traveler, take ease beside me for a time. I'm harmless.%SPEECH_OFF%}"
        ja = "%terrainImage%{氷に開いた穴のそばで男に出会う。傍らには釣り竿があり、こんな環境にもかかわらず、男は暖かく迎えてくれる。%SPEECH_ON%旅の人、少し話していかないか？　この辺りの者ではなさそうだ。%SPEECH_OFF% | 熊の毛皮を着た男が氷へ穴を開けている。切り取った縁が落ちると同時にこちらを見て、それを拳で水中へ押し込んだ。%SPEECH_ON%さあ旅人よ、しばしここで休んでいけ。俺は危害など加えない。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You come across a man holding the reins of a lanky horse whose mangy mane has seen better days. The horse has a grey beard forming and its got dry caliche lips smacking desperately for water. Seeing you, its owner waves.%SPEECH_ON%Come, come! I've a bet to make for those brave and fast enough to think they'll win it!%SPEECH_OFF%Curious, you ask what the bet is. The man pats the horse, a plume of dust lifting on the pat and you can see his handprint on the shoulder.%SPEECH_ON%Race m'horse! Not with another horse, mind, but your humanly legs! If you lose, you give me %reward% crowns. If you win, I'll pay you triple. You up for it?%SPEECH_OFF%}"
        ja = "%terrainImage%{ひょろ長い馬の手綱を持つ男に出会う。馬のみすぼらしいたてがみは盛りをとうに過ぎ、灰色の顎鬚まで生え始めている。乾いて石灰のこびりついた唇を鳴らし、必死に水を求めていた。あなたを見ると、飼い主が手を振る。%SPEECH_ON%さあ、さあ！　勝てると思うほど勇敢で足の速い奴に、賭けを持ちかけよう！%SPEECH_OFF%何を賭けるのか尋ねる。男が馬を叩くと埃が舞い、肩には手形がくっきり残った。%SPEECH_ON%俺の馬と競走だ！　馬同士じゃないぞ、人間の脚で走るんだ！　負けたら%reward%クラウンを払え。勝ったら三倍にして返す。どうだ？%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You come across a young traveler on the road. His straw hat is turned inside out as though he meant for it to catch rain. He's got a walking stick with its end shaved to a ball to navigate muddy roads. When you get near, he straightens up and tents his hands on the top of the staff.%SPEECH_ON%Oy', mercenaries are ye? I'd avoid the forests if I were ye. They say trees roam those parts now. They don't do so in menace, but neither does a motha' bear when it chows down on your balls for getting too close. It's a matter of nature, ye know?%SPEECH_OFF%Uh, sure. | A man is found beside the road reading some tomes. He looks up, turning one of the pages for you to see, displaying a drawing of a tree with long branches extended to the ground. The trunk is lit with eyes.%SPEECH_ON%They call 'em schrats. Trees that will claw and kill anything that gets close, but I don't think that's quite right. I don't think they're animals, I think they're calculating and smart monsters with a vengeful attitude toward matters of trespass. So don't trespass upon them, understand? Stay out of the forests.%SPEECH_OFF%Not in the mood for idle tree talk, you wish the man well in his studies and quickly move on. | An elderly woman carrying a basket crosses paths with your company. She gestures toward the goods, a pile of chopped firewood.%SPEECH_ON%If ye want some fyewood, aye, best stay clear of where I got it.%SPEECH_OFF%You ask what she means. She grins all wily like.%SPEECH_ON%A schrat in the forest watched me do it, gave me propuh permission to warm meself with this here tinder. Didn't give my uncle permission. It tore my uncle in half and hung his flesh. Peehaps ornamental value, ye know?%SPEECH_OFF%Er, of course.}"
        ja = "%terrainImage%{街道で若い旅人に出会う。雨を受け止めるつもりなのか、麦藁帽子を裏返しに被っている。ぬかるんだ道を進むため、先端を球状に削った杖を持っていた。あなたたちが近づくと、男は背筋を伸ばし、杖の上で両手を山形に組む。%SPEECH_ON%よう、傭兵か？　俺なら森には近づかねえ。最近は木があの辺りを歩き回るって話だ。悪気があるわけじゃねえんだろうが、近づきすぎたお前の玉を母熊が食いちぎるのだって悪気じゃねえ。自然ってのはそういうもんさ、わかるだろ？%SPEECH_OFF%ああ、そうだな。 | 街道脇で書物を読む男を見つける。男は顔を上げると、一頁をこちらへ向けた。地面まで伸びた長い枝を持つ木が描かれ、その幹には無数の目が光っている。%SPEECH_ON%シュラートと呼ばれている。近づくものを爪で裂き、殺す木だ。だが、それだけではないと思う。獣ではない。計算高く知恵のある怪物で、縄張りを侵す者へ執念深く報復する。だから奴らの領分を侵すな。わかったか？　森には入るな。%SPEECH_OFF%木の話に付き合う気分でもなく、あなたは男の研究の無事を祈ると、足早に立ち去る。 | 籠を抱えた老女が傭兵団とすれ違う。女は中の品、薪の山を指さす。%SPEECH_ON%薪が欲しいならね、ああ、あたしがこれを取ってきた場所には近づかない方がいいよ。%SPEECH_OFF%どういう意味か尋ねる。老女は狡猾そうに笑う。%SPEECH_ON%森のシュラートが見てたんだよ。これで暖を取ることを、ちゃんと許してくれた。でも叔父さんには許さなかった。真っ二つに裂いて、肉を吊るしたんだ。飾りにしたかったのかもねえ、わかるだろ？%SPEECH_OFF%ああ、なるほど。}"
    }
    {
        en = "%terrainImage%{You come to a watering hole. The well's walled exterior is embroidered with animal skulls and similarly stitched with their ribs. As you draw near, there's a faint hiss from the depths. Staring in, you see a tiny orange glow snaking left to right.%SPEECH_ON%You might want to try not looking down there.%SPEECH_OFF%You turn around to see a man dressed in rags. His hair is spiked backwards in black chevrons. Dark splotches pepper his face and he's got bruises on every fingernail and a tarred smile.%SPEECH_ON%It's about to blow.%SPEECH_OFF%}"
        ja = "%terrainImage%{水場へたどり着く。井戸を囲む壁には動物の頭蓋骨が飾られ、肋骨も縫い付けるように並んでいる。近づくと、深みからかすかなシューという音が聞こえる。覗き込むと、小さな橙色の光が左右へ蛇行していた。%SPEECH_ON%そこは覗かない方がいいぞ。%SPEECH_OFF%振り返ると、ぼろをまとった男がいる。髪は黒い山形を描くように後ろへ逆立ち、顔には黒い染みが散り、すべての爪に痣があり、笑う歯は煤けている。%SPEECH_ON%もうすぐ吹き飛ぶ。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You dream of your mother. You had not seen her face in some time, and thought you'd forgotten it, the world having ground down most memories. She is as lovely as you'd expect, and she draws you in, hand about your hair, threading her fingers through it, the soft hiss of her touch met by the gentlest of whispers. And a moment later she offers a breast to you, and you reel back, unsure, and when you look up the Grand Diviner is there, grinning madly.%SPEECH_ON%Wombless, I ascend, sellsword. The grand nurturer...%SPEECH_OFF%A fleshy golem wraps its red appendages over his shoulders, coiling you up in its greasy grip.%SPEECH_ON%Find in my bosom the raw power of this world, sellsword! Let me mother you into the man you should have been!%SPEECH_OFF%With a snarl, you rip out of the dream and flip off your cot and hit the ground, gasping for air and slapping your face as if whatever dreamt of came back with you. The rest of the company is in an equal state of disrepair, every sellsword having been struck by the same nightmare. You glance over to inventory to see the Grand Diviner's flail bristling a bright green, then it fades from your stare, the slightest chuckle following it out...}"
        ja = "%terrainImage%{母の夢を見る。その顔を長らく見ておらず、この世界に多くの記憶を削り取られ、もう忘れたと思っていた。母は思い描いたとおりに美しく、あなたを引き寄せる。髪へ置いた手の指が梳くたびに柔らかな音を立て、穏やかな囁きがそれに重なる。やがて母が乳房を差し出す。戸惑って身を引き、見上げると、そこには狂気の笑みを浮かべた大占術師がいた。%SPEECH_ON%子宮なき身で、我は昇華する、傭兵よ。偉大なる養育者へ……%SPEECH_OFF%肉塊のゴーレムが赤い肢をその肩へ回し、脂ぎった抱擁であなたを締め上げる。%SPEECH_ON%我が胸に、この世の剥き出しの力を見いだせ、傭兵よ！　お前がなるべきだった男へ、我が母として育ててやろう！%SPEECH_OFF%あなたは唸り声を上げて夢を引き裂き、寝台から転げ落ちて地面へ叩きつけられる。息を喘がせ、夢で見た何かが一緒に戻ってきたかのように顔を叩く。傭兵団の全員も同じ有様だ。すべての傭兵が同じ悪夢に襲われていた。荷物へ目をやると、大占術師のフレイルが鮮やかな緑の光を放っている。やがて光は視界から薄れ、かすかな含み笑いだけが後を追う……}"
    }
    {
        en = "%terrainImage%{You elect %dumb%, the company's biggest idiot, to be your horse racing champion. The horse's owner takes one look at the man and raises an eyebrow.%SPEECH_ON%Well. Alright.%SPEECH_OFF%Rules of the race are clear: first to a distant apple tree is the winner. The man and animal line up on the track. Pretending that he knows what he's doing, %dumb% crouches in a tri-pointed stance. The horse owner yells and slaps his beast on the buttocks. %dumb% releases into a nice stride and shockingly gets ahead of the horse, but he's unable to handle his speed and tilts into the second lane and collides with the beast. The horse buckles at the knees and flips head over hind and %dumb% somehow ends up in the curve of its loins and on the flip around is catapulted through the air. It's a damned sight and one you'll surely never see again. The horse gets back to its feet and stares around confused while %dumb%'s unconscious body flies over the finish line. You turn your palms to the horse owner whose hands are gripping his head.%SPEECH_ON%By the old gods, man, are you not concerned for your sellsword?%SPEECH_OFF%}"
        ja = "%terrainImage%{傭兵団きっての大馬鹿者%dumb%を、馬との競走の代表に選ぶ。馬主は男を一目見るなり片眉を上げる。%SPEECH_ON%まあ……いいだろう。%SPEECH_OFF%規則は明快だ。遠くのリンゴの木へ先に着いた方が勝つ。男と馬が走路に並ぶ。何か心得があるふりをして、%dumb%は三点支持の姿勢で身をかがめる。馬主が叫び、獣の尻を叩く。%dumb%は見事に飛び出し、驚いたことに馬の前へ出る。だが自分の速さを制御できず、隣の走路へ傾いて獣と衝突した。馬は膝から崩れ、頭と尻をひっくり返す。どういうわけか%dumb%はその腰のくぼみへ収まり、回転の勢いで宙へ射出された。まったく凄まじい光景で、二度と目にすることはないだろう。馬は立ち上がり、混乱して辺りを見回す。その間にも、意識を失った%dumb%の身体は決勝線の向こうへ飛んでいく。頭を抱える馬主へ、あなたは両掌を向ける。%SPEECH_ON%古き神々にかけて、お前は自分の傭兵が心配ではないのか？%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You eye a traveler in the distance bobbing forth, slouched and crooning like a wingless gargoyle. His walking stick bobs and prods in front of him and even far away you hear the snicker and snacker of stones being tapped. You give an order for your men to hold and wait, letting the stranger come to you.\n\nWhen he finally nears, he looks up. At first, his nose is all that you see, the rest of him hidden in a cloak. He sniffs gingerly like a blind mole come across a bizarre impasse. Just as you begin to ask if the man is alright, he throws the cloak back, revealing himself. That which faces you is a tired figure. Hobbled. Sleepless days pinch creases about his eyes. Reddened cheeks spread as he smiles. He asks if he might stay with your party for a time. | A traveler hails your party from the roadside. He says he's on his way to %randomtown% but that he wouldn't mind a rest. The next question he has is an obvious one: he wonders if it'd be alright to stay with your party for the night. | A traveler carrying a cart of personal goods heads your way. You let him approach, holding your hand up to warn him to go no further. He states that he is a simple wanderer and that he's only looking to get to %randomtown%. First showing that he is completely unarmed, he asks if maybe he can stay the night with your company. | A whistling man ambles down the road, a cheery dog huffing at his side with its tongue aloll. Seeing your troop, he stabs his walking stick into the dirt and tents his hands atop it. Some small talk is made of the weather, notably that rain is in the belly of some oncoming clouds. He asks if mayhaps he could dodge the rain in the company of sellswords. A strange request, not one usually made to men who earn blood money. | A man walks the road with a shovel bobbing over one shoulder and a sack of dirt swinging in the other hand. When you inquire as to what he is doing, he says he's just buried his brother and he's on his way back to %randomtown%. The sack holds some of the dirt where his kin was laid to rest. Respectable. The man looks weary, as weary as a man who has buried his sibling would understandably be. Perhaps sensing your pitying gaze, he asks if maybe he can stay with your company for a time. | You spot a strange man hobbling along the road. He's dressed in a long cloak and he's got a knapsack yoked over one of his shoulders. His eyes stare at the ground until they come to your feet at which point he finally looks up. Seeing your company, the man is surprisingly unalarmed. In fact, he's quite receptive of your presence and asks if maybe he could spend the night with sellswords before continuing his journey to %randomtown%. | A man with a pitchfork is crossing a field where the crops have failed. His feet scuff up the deadened ground and you see tufts of ash being pitched wind-wise. When he gets to the road, you hail him down and ask where he's coming from. The man is a daytaler only trying to get back home. All the work around here is dried up, literally. Licking his cracked lips, the man wonders if maybe he could stay the night with your company. He certainly looks like he could use some rest, anyway. | A man carrying a bucket of tools crosses paths with your company. The roads seem ill-fit to place one man against a company of sellswords, and this stranger appraises the situation correctly by placing his wares down and putting his hands up.\n\nYou tell him to calm and ask where he is going. He explains that he is a mason from %randomtown%, but that his work there is done. He's only on his way back to his family located on a homestead a good day's walk from where you stand. Looking rather thirsty and tired, the man asks if maybe he could spend the night with your company to help him rest for the coming walk. | A figure appears on the horizon, blurred and shimmering in a heat haze. It appears to have paused, no doubt having seen you, too. With little fear, you press the men onward and soon come across a man toting a few bags of this or that. He's sitting down on the ground and doesn't bother getting up when you near. He explains he's been on the road for days and could use a good night's rest. Naturally, he asks if he can spend that rest in the company of your men. | You come across a man who is weak and weary. He explains that he has been searching for his lost dog, but that he's just about given up. Before he heads home, he wonders quite loudly if maybe a night's rest in your company could help him find the energy to seek out his mutt for one more day. | A man tracked by buzzards is found on the side of the road. He's not hurt or wounded, just exhausted. He asks with a cracking voice if maybe he could spend the night in the company of your men.}"
        ja = "%terrainImage%{遠くに旅人の姿を見つける。翼のないガーゴイルのように前屈みで鼻歌を歌い、上下に揺れながら近づいてくる。杖が前方で上下し、地面を突く。はるか遠くからでも、石を叩く小刻みな音が聞こえる。あなたは団員たちへ止まって待てと命じ、見知らぬ者がこちらへ来るのを待つ。\n\nようやくそばまで来ると、男は顔を上げた。最初に見えたのは鼻だけで、残りは外套に隠れている。奇妙な障害物に出くわした盲目のモグラのように、おずおずと匂いを嗅ぐ。大丈夫かと尋ねかけた瞬間、男は外套を払い、姿を現す。こちらを向いたのは疲れ切った男だった。足を引きずり、眠れぬ日々が目の周りへ皺を刻んでいる。赤らんだ頬を緩めて笑うと、しばらく一行に置いてもらえないかと尋ねた。 | 街道脇の旅人が一行へ声をかける。%randomtown%へ向かう途中だが、休息も悪くないという。続く問いは予想どおりだった。今夜、あなたたちと一緒に過ごしてもよいかというのだ。 | 身の回りの品を積んだ荷車を引く旅人がこちらへ来る。近づかせ、片手を上げて、それ以上進むなと警告する。男はただの放浪者で、%randomtown%を目指しているだけだと話す。武器を何ひとつ持っていないところを見せてから、今夜、傭兵団と一緒に過ごせないかと尋ねる。 | 口笛を吹く男が街道をぶらついている。傍らでは、陽気な犬が舌を垂らして息を弾ませていた。部隊を見ると、男は杖を地面へ突き立て、その上で両手を山形に組む。天気について少し世間話をし、特に、迫る雲が雨を孕んでいると話す。そして、もしかしたら傭兵たちと一緒なら雨を避けられないかと尋ねる。血銭を稼ぐ男たちにするには、妙な頼みだ。 | 肩に担いだシャベルを上下させ、もう片方の手で土袋を揺らしながら、男が街道を歩いてくる。何をしているのか尋ねると、兄弟を埋葬したばかりで、%randomtown%へ戻るところだという。袋には、肉親を葬った場所の土が入っている。立派な心がけだ。男は疲れている。兄弟を埋めた者なら当然の疲れようだろう。憐れむ視線を察したのか、しばらく傭兵団と共にいられないかと尋ねる。 | 街道を足を引きずって進む奇妙な男を見つける。長い外套をまとい、片肩に背負い袋を掛けている。地面を見つめていた目があなたの足元へ届き、そこでようやく顔を上げた。傭兵団を見ても、意外なほど動じない。それどころか、こちらの存在をむしろ歓迎し、%randomtown%への旅を続ける前に、傭兵たちと一夜を過ごせないかと尋ねる。 | 作物の枯れた畑を、三叉鍬を持つ男が横切っている。足が死んだ土を擦るたび、灰の房が風に巻き上げられる。街道へ出たところで呼び止め、どこから来たのか尋ねる。男は家へ帰ろうとしているだけの日雇い労働者だった。この辺りの仕事は文字どおり干上がっている。ひび割れた唇を舐め、今夜、傭兵団と一緒に過ごせないかと尋ねる。いずれにせよ、休息が必要な顔をしている。 | 道具を入れた桶を運ぶ男が、傭兵団と行き合う。街道で一人、傭兵団と対峙するには分が悪すぎる。見知らぬ男も正しく状況を見極め、荷物を下ろして両手を上げた。\n\n落ち着けと言い、どこへ行くのか尋ねる。男は%randomtown%の石工だが、そこでの仕事は終わったという。今いる場所から一日ほど歩いた農家に家族がおり、そこへ帰るだけらしい。喉が渇き、疲れた様子の男は、これからの道に備えて休むため、今夜、傭兵団と一緒に過ごせないかと尋ねる。 | 地平線に人影が現れる。陽炎の中でぼやけ、揺らいでいる。向こうもこちらを見つけたのか、立ち止まったようだ。恐れることなく団員たちを進ませると、やがて雑多な袋をいくつか抱えた男と出会う。男は地面に座り込み、近づいても立ち上がろうとしない。何日も街道を歩き続け、ぐっすり一晩眠りたいという。当然のように、その休息を団員たちのもとで取れないかと尋ねる。 | 弱り、疲れ果てた男に出会う。行方不明になった犬を探してきたが、もう諦めかけているという。家へ帰る前に、傭兵団と一緒に一晩休めば、もう一日だけ犬を探す力が戻るだろうかと、やけに大きな声で尋ねる。 | 禿鷹につけ狙われる男を街道脇で見つける。怪我も傷もない。ただ疲れ果てている。ひび割れた声で、今夜、団員たちと一緒に過ごせないかと尋ねる。}"
    }
    {
        en = "%terrainImage%{You find %hauntedbrother% staring into the Grand Diviner's flail. The glassy bulb is filled with mist, and the sellsword is raking his tongue to suck up the condensation. Hand to your sword, you ask what he's doing, and the man freezes, and his eyes open and he jerks back like a man snorting awake knowing he's late for work.%SPEECH_ON%Augh! What the fark? How did... I was sleeping, when... what the fark!%SPEECH_OFF%Some of the men have said the weapon has been murmuring when nobody's looking, and it seems every so often it does capture someone's ear...}"
        ja = "%terrainImage%{%hauntedbrother%が大占術師のフレイルを覗き込んでいる。ガラス質の球は霧で満たされ、傭兵は舌を這わせて結露を舐め取っていた。剣へ手をかけ、何をしているのか尋ねる。男は凍りつき、目を見開くと、仕事に遅れたと悟って飛び起きる者のように身を引く。%SPEECH_ON%うわっ！　何だこりゃ？　どうして……俺は眠ってて、それで……何なんだよ！%SPEECH_OFF%誰も見ていないとき、武器が囁いていると話す者もいる。どうやら、ときおり誰かがその囁きに聞き入ってしまうらしい……}"
    }
    {
        en = "%terrainImage%{You find a man beside the road churning leaves with a mortar and pestle. He's also chewing some of the goods himself and looks up at you with a green grin.%SPEECH_ON%I've dealt with the bugs and insects all m'life, but them webknechts are something else entirely. I ain't ever seen a bug move tha' fass. Scissorin' and zippin' forward, grabbin' dogs and cats and such, stealing them aways. You stay clear of them right bastard spiders, ye hear?%SPEECH_OFF%The stranger hocks a loogie and then gets on with his work as though you'd never come by at all. | A woman in the doorway of a homestead regards the company with a series of nods. With a mug in hand she points at you, sloshing her drink around just as much as her speech.%SPEECH_ON%Ah, spiderfood comin' thew? Eh? Well git, them eight legged farks ain't keen on a game of wait and see, they'll find ye as soon as they hungry, and they always hungry, yessir, always foamin' at the mouth with that poison of theirs, yessir yessir.%SPEECH_OFF%She throws back a mug and falls back into the home's doorway with a clunk and clatter. | You come across a young man up in a poplar tree. He's somehow managed to construct a tiny abode the size and shape of an outhouse up in the heights. Looking down at you, he nods.%SPEECH_ON%Yeah you are incredulous about me and this here tree, well let me tell ya, them webknechts come fast. Spiders the size of dogs! And you know what I say to that? Fuck all of it. You can find me in these here trees from now on and if those damn beasts grow wings I'll just up and off my ownself thank ye very much.%SPEECH_OFF%Webknechts seem to be driving the locals mad, though you can't really blame them.}"
        ja = "%terrainImage%{街道脇で、乳鉢と乳棒を使って葉をすり潰す男を見つける。自分でもその葉を噛んでおり、緑色の歯を見せてこちらを見る。%SPEECH_ON%虫とは生まれてこのかた付き合ってきたが、あのウェブクネヒトどもはまるで別物だ。あんなに速く動く虫は見たことがねえ。鋏を鳴らして飛び出し、犬や猫なんかをひっつかんで、さらっていきやがる。あの忌々しい蜘蛛どもには近づくな。わかったか？%SPEECH_OFF%見知らぬ男は痰を吐くと、あなたなど最初から通らなかったかのように作業へ戻る。 | 農家の戸口に立つ女が、何度もうなずきながら傭兵団を見る。杯を手にあなたを指さし、酒と同じくらい言葉もこぼす。%SPEECH_ON%ああ、蜘蛛の餌が通るのかい？　ああ？　さっさと行きな。八本脚のくそったれどもは待っちゃくれないよ。腹が減りゃ、すぐお前らを見つける。いつだって腹を空かせて、毒で口から泡を吹いてるんだ。そうさ、そうとも。%SPEECH_OFF%女は杯をあおり、物音を立てて家の戸口へ倒れ込む。 | ポプラの木の上にいる若者を見つける。どうやったのか、便所ほどの大きさと形をした小屋を高所に組み上げている。こちらを見下ろし、男はうなずく。%SPEECH_ON%ああ、俺とこの木を見て信じられねえって顔だな。だが教えてやる、あのウェブクネヒトどもは速いぞ。犬ほどもある蜘蛛だ！　そんなものに俺が何と言うかって？　全部くそくらえだ。これから俺はずっと木の上にいる。あの化け物どもに翼が生えたら、自分で飛び降りておさらばするさ。ありがとよ。%SPEECH_OFF%ウェブクネヒトは土地の者たちを狂わせているようだが、責める気にはなれない。}"
    }
    {
        en = "%terrainImage%{You look back at the company, then unsheathe your sword as you turn around. You swing it up and clip the crossbow and the man shoots it just over your shoulder. You drive the blade down the slat of wood and cut the cords of the weapon and stab the steel into the man's chest. He goes down easy and you hear men shout in the distance, but they're scared and scampering away. Thieves like this know not to fight with sellswords. Unfortunately, the crossbow bolt that went over your shoulder struck %hurtbro%. He'll survive, but it is a garish wound.}"
        ja = "%terrainImage%{傭兵団を振り返り、それから向き直りざまに剣を抜く。振り上げた刃が弩へ当たり、男の放った矢はあなたの肩すれすれを飛び越える。木枠に沿って剣を振り下ろし、弦を断ち、そのまま男の胸へ鋼を突き刺す。男はあっけなく倒れ、遠くで何人かが叫ぶ。だが怯えきり、逃げ去っていった。この手の盗賊は、傭兵と戦ってはならないと心得ている。不運にも、肩を越えた弩の矢は%hurtbro%へ当たっていた。命は助かるが、見るも無惨な傷だ。}"
    }
    {
        en = "%terrainImage%{You look back at the company, then unsheathe your sword as you turn around. You swing it up and clip the crossbow and the man shoots it just over your shoulder. You drive the blade down the slat of wood and cut the cords of the weapon and stab the steel into the man's chest. He goes down easy and you hear men shout in the distance, but they're scared and scampering away. Thieves like this know not to fight with sellswords. You collect whatever goods the man had already stolen up to this point.}"
        ja = "%terrainImage%{傭兵団を振り返り、それから向き直りざまに剣を抜く。振り上げた刃が弩へ当たり、男の放った矢はあなたの肩すれすれを飛び越える。木枠に沿って剣を振り下ろし、弦を断ち、そのまま男の胸へ鋼を突き刺す。男はあっけなく倒れ、遠くで何人かが叫ぶ。だが怯えきり、逃げ去っていった。この手の盗賊は、傭兵と戦ってはならないと心得ている。男がそれまでに盗んでいた品を、残らず回収する。}"
    }
    {
        en = "%terrainImage%{You move to take the hound, but as you crouch down one of the sheep bays and charges, knocking you over. The men laugh and by the time you get to your knees another sheep crushes you from behind to many cheers. Drawing out your sword emits a sharp twang that sends the sheep scurrying. When you look back at the hound its nose is to the dirt and its eyes peerless. It has died and the sheep slowly collect around it bleating and crying out. You sheathe your sword and tell the company to move on.}"
        ja = "%terrainImage%{猟犬を引き取ろうと近づくが、しゃがんだところへ一頭の羊が鳴きながら突進し、あなたをなぎ倒す。団員たちが笑う。膝をつくころには別の羊が背後から押し潰し、大歓声が上がった。剣を抜く鋭い音に、羊たちは逃げ散る。猟犬を振り返ると、鼻は土に伏せられ、目から光が失われていた。死んだのだ。羊たちがゆっくり集まり、鳴き声を上げて嘆く。あなたは剣を納め、傭兵団へ先を急げと命じる。}"
    }
    {
        en = "%terrainImage%{You nod.%SPEECH_ON%Quite alright. I'm assuming all that you got is counterfeit, aye?%SPEECH_OFF%The man nods.%SPEECH_ON%Of course. The finest fitting counterfeit this side of %townname% this is! But enough chin wagging shenanigans. Appreciate ya keeping this square, but we got work to do.%SPEECH_OFF%Nodding again, you wish him luck in them doings.}"
        ja = "%terrainImage%{あなたはうなずく。%SPEECH_ON%それでいい。持っている物は全部偽物なんだろう？%SPEECH_OFF%男はうなずく。%SPEECH_ON%もちろんさ。%townname%界隈じゃ、これほど見事な偽物はない！　だが無駄話はここまでだ。筋を通してくれてありがたいが、こっちにも仕事がある。%SPEECH_OFF%もう一度うなずき、あなたは男の仕事の無事を祈る。}"
    }
    {
        en = "%terrainImage%{You nominate %randombrother% to try and see if he can best the beast. The race's rules are first to the apple tree and before you can even begin to root for the sellsword the horse smokes him completely. It gets to the finish line and begins fishing the branches for apples. The company is sitting completely silent, but when %randombrother% crosses the finish line in a distant last place they roar with delight as though he just won the keys to the kingdom's finest whorehouse. The horse's owner laughs.%SPEECH_ON%Don't be hard on yerself, kind sir. The fun is in the chance.%SPEECH_OFF%Indeed it seems the spectacle of the man's efforts entertained the company.} "
        ja = "%terrainImage%{%randombrother%を指名し、獣に勝てるか試させる。競走はリンゴの木へ先に着いた方が勝ちだ。傭兵へ声援を送る暇もなく、馬は男を完全に置き去りにする。決勝線へ着くと、枝を探ってリンゴを食べ始めた。傭兵団は静まり返っている。しかし、はるか後方の最下位で%randombrother%が決勝線を越えると、王国一の娼館の鍵を勝ち取ったかのような歓声を上げる。馬主が笑う。%SPEECH_ON%そう落ち込むな、旦那。勝負ってのは、挑むことが楽しいんだ。%SPEECH_OFF%確かに、男の奮闘ぶりは傭兵団を楽しませたようだ。} "
    }
    {
        en = "%terrainImage%{You pat the man on his head, but tell him it's already over. He nods.%SPEECH_ON%Speak. For. Yourself. Mercenary.%SPEECH_OFF%He smiles again, but this time it does release. It sticks. Literally. And he leans forward and his eyes are open and do not blink and in this state he is gone. You get the men back on the road, or what one can make of a road in these snowed stretches.}"
        ja = "%terrainImage%{男の頭を軽く叩きながら、もう手遅れだと告げる。男はうなずく。%SPEECH_ON%勝手に。決めるな。傭兵。%SPEECH_OFF%男はまた笑う。だが今度、その笑みは解けない。文字どおり凍りついた。前のめりになり、目を見開いたまま瞬きもせず、その姿勢で息絶える。あなたは団員たちを街道へ、少なくとも、この雪原で街道と呼べるものへ戻す。}"
    }
    {
        en = "%terrainImage%{You reach out to the hound and it lifts it head to you as though you were another threat. Its eyes peer blackly from a long-matted mane that still drips with blood. The sheep, having seen what carnage this beast has already wrought, bay nervously as they watch you. But you won't be deterred. You put your hand forth, palm supinated, and the weary dog slowly lowers into it. You nod.%SPEECH_ON%There's more fight in you yet, friend.%SPEECH_OFF%}"
        ja = "%terrainImage%{猟犬へ手を差し伸べると、また敵が現れたかのように頭を上げる。血を滴らせたまま長くもつれた毛の奥から、黒い目がこちらを窺う。この獣がもたらした惨状を見ていた羊たちは、不安げに鳴きながらあなたを見守っている。だが、ひるみはしない。手のひらを上にして差し出すと、疲れ切った犬はゆっくりと頭をそこへ沈める。あなたはうなずく。%SPEECH_ON%まだ戦えるさ、友よ。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You tell %birdbro% that being shit on is a part of life and get the company ready to get back on the road. But a modest %historian% comes up and tells the ill-fated sellsword to hold off on cleaning the shite. The historian takes a good look at the shite and then up at the bird which authored it.%SPEECH_ON%Yes, yes... I know that bird! That magical creature!%SPEECH_OFF%The men look up at the bird as though they were sealeagured sailors finding rarified land. %historian% points at %birdbro%.%SPEECH_ON%You got shat on by a red-and-blue mockingbird! That's all I wanted to say, really. I just hadn't seen one in awhile. You... you can clean it now.%SPEECH_OFF%The mercenaries stand slackjawed before bursting into laughter. %birdbro% grabs the historian and uses his sleeves to clean the shit off which brings more roars from the men.}"
        ja = "%terrainImage%{糞を落とされるのも人生の一部だと%birdbro%へ言い、傭兵団に出発の支度をさせる。だが、控えめな%historian%が近づき、不運な傭兵へ、まだ糞を拭うなと告げる。歴史家は糞をじっくり観察し、それを落とした鳥を見上げる。%SPEECH_ON%そうだ、そうだ……あの鳥を知っているぞ！　あの不思議な生き物を！%SPEECH_OFF%団員たちは、長く海を漂った船乗りが、ようやく陸地を見つけたかのように鳥を見上げる。%historian%は%birdbro%を指さす。%SPEECH_ON%お前に糞を落としたのは、赤と青のマネシツグミだ！　言いたかったのはそれだけだ。しばらく見ていなかったものでな。もう……拭いていいぞ。%SPEECH_OFF%傭兵たちは呆気に取られ、それから一斉に笑い出す。%birdbro%は歴史家をつかみ、その袖で糞を拭う。団員たちの笑い声がさらに大きくなる。}"
    }
    {
        en = "%terrainImage%{You tell the monk to stand down. He shrugs and returns to your side. When you look back at the man you realize he's lit a fire and watch just as he leaps into the well.\n\n The explosion blows out your ears and puts you on the ground. The earth rolls beneath you in tremble that can be felt through the deafness which you are now submerged. A pluming cloud of fire spears into the sky and growls with the clinking and clanking of metals and the dull plops of leather and other goods, and you roll to your belly and cover your head as it all comes down like the scraps of some god's hellstorm.\n\n Absolutely none of the debris is of any use. As for the man himself, well, he got his wish. He no doubt died in the blink of an eye, all that remains are charred chunks here and there and broiled lungs and seared strips of sinews and more. You check to make sure your eyebrows are still there and, satisfied, prepare to move on.}"
        ja = "%terrainImage%{あなたは修道士へ、手を引けと命じる。修道士は肩をすくめ、あなたの側へ戻る。男を振り返ると、すでに火をつけていた。そして見ている前で井戸へ飛び込む。\n\n 爆発が耳を潰し、あなたを地面へ叩き倒す。音の消えた世界に沈む中でも、大地のうねりと震えだけは全身に伝わる。噴き上がる火柱が空を貫き、金属の甲高い音、革や雑貨の鈍い落下音を伴って唸る。あなたは腹ばいになって頭を抱え、神が降らせた地獄の嵐の残骸さながらに降り注ぐ品々をやり過ごす。\n\n 瓦礫は何ひとつ使い物にならない。男自身については、まあ、望みは叶った。瞬きする間に死んだのだろう。残ったのは、あちこちに散った黒焦げの肉片、焼けた肺、炙られた腱の切れ端などだ。あなたは眉毛がまだ付いていることを確かめ、満足して先へ進む支度をする。}"
    }
    {
        en = "%terrainImage%{You walk up to the man and help him sit down. He grins as one of his bottles clanks off the path and rolls away.%SPEECH_ON%Thankiicup, sir, jast, no, well, ya.%SPEECH_OFF%Nodding, you hold his hand out and spit on his fingers, then roll the jewelry off and pocket them. He merely watches as though you were a physician treating a malady. The rest of your mercenaries strip him down and throw a goatskin tarp over him and then leave him there. As you walk away he asks if you know about the drink.%SPEECH_ON%Not, not sayin' away the secret, but, sirs, drinks are good.%SPEECH_OFF%Yes, are they ever. Unfortunately, as you rejoin the company %randombrother% reports that a kid saw everything and scampered off. You ask why he didn't chase after him. He looks at you shrewdly.%SPEECH_ON%I'm not the scampering sort, sir.%SPEECH_OFF%}"
        ja = "%terrainImage%{男へ歩み寄り、座るのを手伝う。瓶の一本が街道へぶつかって転がり去ると、男はにやつく。%SPEECH_ON%ありぐひっく、旦那、ただ、いや、その、な。%SPEECH_OFF%あなたはうなずき、男の手を取ると指へ唾を吐き、宝石を抜き取って懐へ入れる。男は、病を診る医者でも見るように、ただ眺めている。ほかの傭兵たちは服を剥ぎ、山羊皮の覆いを掛けて、その場へ残す。立ち去るあなたたちへ、男は酒について知っているかと尋ねる。%SPEECH_ON%ひ、秘密を、ばらす気はねえが、旦那、酒はうまいぞ。%SPEECH_OFF%まったくだ。ところが傭兵団へ戻ると、子供が一部始終を見て逃げたと%randombrother%が報告する。なぜ追わなかったのか尋ねると、男は抜け目のない顔をする。%SPEECH_ON%俺はちょこまか走る柄じゃありません、隊長。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You walk up to the man and, startled, he reels back with a hiccup.%SPEECH_ON%Oy, who are ye?%SPEECH_OFF%Telling him you're a good friend, you approach to rob him of everything, but as you take another step his eyes clear and he drops both bottles and suddenly reaches into his coat and pulls out a crossbow.%SPEECH_ON%Not another step you lout. I got men yonder who are watching. I don't want no trouble. We ain't keen on getting squirrely with sellswords. We're here to rob travelers, no good travelers at that, choosing to rob a drunk! Now why dontcha just get on down the road and we all leave without impasse upon our purposes.%SPEECH_OFF%The crossbow crickets as its wood shakes in his loose grip.}"
        ja = "%terrainImage%{男へ歩み寄ると、不意を突かれた男はしゃっくりをしながら後ずさる。%SPEECH_ON%おい、お前ら何者だ？%SPEECH_OFF%親しい友人だと答え、身ぐるみを剥ごうと近づく。だが次の一歩を踏み出すと、男の目が澄み、両方の瓶を落とし、突然上着から弩を抜いた。%SPEECH_ON%それ以上近づくな、間抜け。向こうで仲間が見張ってる。面倒はごめんだ。傭兵相手に荒事を起こす気はねえ。俺たちは旅人を襲いに来たんだ。それも、酔っ払いを襲おうとするようなろくでなしの旅人をな！　さあ街道を進め。そうすりゃ、互いの仕事を邪魔せず別れられる。%SPEECH_OFF%緩んだ手の中で木枠が震え、弩が小刻みに鳴る。}"
    }
    {
        en = "%terrainImage%{You're sure %wildman% the Wildman has seen a hive or two in his time estranged to the forests. He grunts and points at the beehive and then at himself. You nod. He grunts again and goes up the sand dune to the tree while you watch from a safe distance. When he stands beneath the hive, he hoots again, cupping his hand over his mouth to make sure you hear him. He points at the beehive. You nod again and point aggressively at the hive. It's the only beehive for miles, what could possibly be so confusing about this? \n\n The Wildman turns toward the beehive. He cocks an arm back. That... that is not what you wanted to see. He sizes up the beehive, tongue out, eyes slimmed. You rush forward, yelling at him, but he's already honed in. He launches a fist and absolutely obliterates the bees. Honeycombs stickily flail around his wrist as though his hairy arm were an impromptu maypole. The Wildman casually walks back down the sand dune. As he nears, you see bees crawling all over his face and stinging away like the pissed off savages that they are, but he doesn't seem to even sense their presence. He holds out the crunchy remains of his honeyed demolition as though he held the heart of a ferocious beast.}"
        ja = "%terrainImage%{森で人里を離れて暮らしてきた野人%wildman%なら、これまで巣を一つや二つ見たことがあるはずだ。男は唸り、蜂の巣を指してから自分を指す。あなたはうなずく。もう一度唸ると、野人は砂丘を上って木へ向かい、あなたは安全な距離から見守る。巣の下に立つと、また声を上げ、聞こえるよう口へ手を添える。そして蜂の巣を指す。あなたはまたうなずき、強く巣を指さす。見渡す限り、蜂の巣はこれ一つしかない。何をそんなに迷うことがある？ \n\n 野人は蜂の巣へ向き直り、腕を後ろへ引く。そ、それは見たくなかった動きだ。舌を出し、目を細めて蜂の巣へ狙いをつける。あなたは前へ駆け出し、叫ぶ。だが、すでに狙いは定まっていた。拳を放ち、蜂の巣を跡形もなく粉砕する。毛深い腕が即席の五月柱にでもなったように、蜂蜜まみれの巣板が手首の周りで粘つきながら揺れている。野人は平然と砂丘を下りてくる。近づくと、顔中を蜂が這い、怒り狂った蛮族さながらに次々と針を刺しているのが見える。だが男は、その存在すら感じていないようだ。凶暴な獣の心臓を掲げるかのように、蜂蜜まみれの破壊の残骸を差し出す。}"
    }
    {
        en = "%terrainImage%{You've heard of such snakes killing men outright. With that threat on the table, you do not feel it worth the trouble and leave the treasure behind.}"
        ja = "%terrainImage%{この手の蛇は、人をたちどころに殺すと聞いたことがある。危険を冒す価値はないと判断し、財宝を残して立ち去る。}"
    }
    {
        en = "%thief%, you used to be a thief. Get us that map!"
        ja = "%thief%、お前は昔、盗賊だったな。あの地図を手に入れろ！"
    }
    {
        en = "%townImage%%doghandler% asks you to enter %wardog% into a local dog fighting circle. That sounds like an awful idea, but the man goes on to explain that a lot of money stands to be made in dogfighting. All the doghandler needs is an ante of two hundred crowns."
        ja = "%townImage%%doghandler%が、%wardog%を地元の闘犬場へ出したいと言い出す。ひどい考えにしか聞こえないが、男は闘犬なら大金を稼げると説明する。犬使いが必要としているのは、掛け金の200クラウンだけだ。"
    }
    {
        en = "%townImage%%peacekeeperfull% places himself between %troublemaker% and the old man. He shakes his head 'no' in a very modest fashion, but you can't help but notice that his swordhand is also on the pommel of his weapon. The troublemaking sellsword briefly seems to consider cutting the man down, but then a smile snaps across his face. He laughs as he sheathes his weapon.%SPEECH_ON%Only having a bit of fun, my brother.%SPEECH_OFF%The peasants slowly start going about their business again, but they are wary and stare side-eyed at your men for the rest of your duration in %townname%."
        ja = "%townImage%%peacekeeperfull%が%troublemaker%と老人の間へ割って入る。控えめに首を横へ振って「駄目だ」と示すが、剣を握る手が柄頭に置かれていることにも気づく。乱暴者の傭兵は、一瞬その男を斬り捨てようか考えたようだ。だが、顔へ不意に笑みを浮かべ、笑いながら武器を鞘へ戻す。%SPEECH_ON%ちょっと楽しんでいただけだ、兄弟。%SPEECH_OFF%農民たちはゆっくりと仕事へ戻る。しかし警戒は解かず、%townname%に滞在する間ずっと、団員たちを横目で睨んでいた。"
    }
    {
        en = "%townImage%%peacekeeperfull% steps in between %troublemaker% and the old man. The troublemaking sellsword laughs and sheathes his weapon. He turns back to the rest of the company, grinning and shaking his head, but you notice that this smile quickly fades. Before you can say anything, %troublemaker% wheels a fist back around and knocks %peacekeeper% out cold.\n\n Well, that's one way to mollify a mercenary."
        ja = "%townImage%%peacekeeperfull%が%troublemaker%と老人の間へ割って入る。乱暴者の傭兵は笑って武器を鞘へ戻す。にやつきながら首を振り、傭兵団へ向き直る。だが、その笑みがすぐ消えたことに気づく。何か言うより早く、%troublemaker%は拳を振り回し、%peacekeeper%を殴って気絶させた。\n\n なるほど、傭兵をなだめる方法としては一つの手だ。"
    }
    {
        en = "%townImage%As %troublemaker% raises his weapon on high, you grab him by the forearm and bring it back down. He swings around, looking at you sternly. The cowering old man backs off, soon collected by caretakers that shuttle him back inside before he gets himself hurt.\n\nA few other peasants linger around, watching with keen interest. You tell the sellsword to back down. He's paid to fight who you deem he should fight, not a bunch of peasants who are minding their own.\n\n As %troublemaker% glances around, you realize you've left him no 'out' that will save face. In his eyes, there is a look that says he's about to kill you. It'd be the end of him, but he'd go out with his suicidal pride intact. But the look fades, and embarrassment and humiliation take its place. He sheathes his weapon, spits, and remarks that he was only having some fun."
        ja = "%townImage%%troublemaker%が武器を高く振り上げたところで、あなたは前腕をつかんで引き下ろす。男は勢いよく振り向き、険しい目であなたを見る。身を縮めていた老人は後ずさりし、世話役たちが引き取り、怪我をする前に屋内へ連れ戻す。\n\nほかにも何人かの農民が残り、強い関心を示して見守っている。あなたは傭兵へ手を引けと命じる。金を払っているのは、あなたが戦うべきと判断した相手と戦わせるためであり、何もせず暮らしている農民を相手にさせるためではない。\n\n %troublemaker%が辺りを見回す。そこであなたは、面目を保って引き下がれる逃げ道を何ひとつ残さなかったことに気づく。その目は、今にもあなたを殺そうとしていると語っている。そうすれば男も終わりだが、自滅的な誇りだけは守って死ねる。だが殺気は消え、代わりに羞恥と屈辱が浮かぶ。男は武器を鞘へ納め、唾を吐き、少し楽しんでいただけだと言う。"
    }
    {
        en = "%townImage%Civilization is no place for a wildman like %wildman% and he quickly proves it.\n\nApparently, the damned man went crazy while in a shop and trashed the whole place. As the story goes, he just walked in and started taking things, not quite understanding the social norms of paying for goods. The shop owner then came after him with a broom, trying to shoo the man out of his store. Believing the broom a monster, the wildman proceeded to go completely crazy. Judging by the reports, it was quite the commotion, up to and including shite throwing.\n\nNow the shop owner is in your face demanding compensation for the damage done. Apparently he's wanting %compensation% crowns. Behind him, a few town militia stand with very watchful eyes."
        ja = "%townImage%文明社会は%wildman%のような野人に向く場所ではない。男はたちまちそれを証明した。\n\nどうやら、あの忌々しい男は店で突然暴れ出し、店内をめちゃくちゃにしたらしい。話によれば、店へ入るなり品物を勝手に取り始め、代金を支払うという社会の決まりを理解していなかった。店主は箒を手に男を追い、店から追い払おうとした。箒を怪物だと思った野人は、完全に我を失った。報告を聞く限り、糞まで投げつける大騒ぎだったようだ。\n\n今や店主は、損害を弁償しろと目の前で迫っている。どうやら%compensation%クラウンを要求しているらしい。その背後では、数人の民兵が厳しい目を向けている。"
    }
    {
        en = "%townImage%Entering %townname%, it isn't long until %troublemaker% is bothering the locals. He's slapping buckets out of their hands and kicking women into the mud. When an old man confronts him, the sellsword draws out his weapon. Other peasants beg that you put a stop to this at once."
        ja = "%townImage%%townname%へ入ると、間もなく%troublemaker%が住民へちょっかいを出し始める。手にした桶を叩き落とし、女たちを泥へ蹴り倒す。老人が立ちはだかると、傭兵は武器を抜いた。ほかの農民たちは、今すぐ止めてくれと懇願する。"
    }
    {
        en = "%townImage%Following the man's torch through the dark, you come to a building with a sliding portal at its door. The stranger gives the door a pattern of knocks and it pops open as if commanded by the final rap. You are ushered in, leering faces watching from the side as you enter. Immediately, you hear the unsettling din of snarling and barking. This is what you are here for, right?\n\n Stairs lead you to the pits where a crowd huddles around a makeshift arena of dirt and wobbly fenceposts. The action can't be seen yet, but off to the side are a pile of dead dogs and beside them sit their killers, eyes wild, blood frothing mouths agape in horrified panting. As two dogs clash in the arena, you glance at %doghandler%."
        ja = "%townImage%男の松明を追って暗闇を進み、戸口に滑り窓のある建物へ着く。見知らぬ男が決まった調子で戸を叩くと、最後の一打を命令としたかのように窓が開く。中へ通される間、脇から下卑た顔がこちらを見つめる。たちまち、不穏な唸り声と吠え声が聞こえてくる。これを見に来たのだろう？\n\n 階段を下りると闘技場があり、人だかりが土とぐらつく柵柱で作った即席の囲いを取り巻いている。試合はまだ見えない。だが脇には死んだ犬が山積みされ、その傍らには殺した犬たちが座る。目を血走らせ、血で泡立つ口を開き、恐ろしい息を荒げている。二頭の犬が囲いの中でぶつかり合う。あなたは%doghandler%へ目をやる。"
    }
    {
        en = "%townImage%Surveying the damage, you agree to compensate the businessman. But this isn't your fault, it's the wildman's. You dock his pay: for some time to come, the mercenary's earnings will be halved. Furthermore, you take what earnings he's made and hand them over to the shop owner. It doesn't even begin to cover the damages, but it's a start. One man is left happy, and another quite disgruntled.\n\nYou tell the wild cretin that now he'll think twice about smearing shit all over someone else's walls. But the wildman doesn't seem to understand you. He just understands that the gold he once owned has been given to someone else, and he eyes its departure with sadness and bottled anger."
        ja = "%townImage%損害を確認し、商人へ弁償することに同意する。だが、これはあなたの責任ではない。野人の責任だ。男の賃金を差し引き、しばらくの間、報酬を半分にする。さらに、これまでの稼ぎを取り上げて店主へ渡す。損害には遠く及ばないが、手始めにはなる。一人は満足し、もう一人は大いに不満を抱いた。\n\n他人の壁へ糞を塗りたくる前に、これからは二度考えることになるぞと、あなたは野蛮な愚か者へ告げる。だが野人には通じていない。かつて自分のものだった黄金が他人へ渡ったことだけは理解し、悲しみと押し殺した怒りを目に浮かべ、その行方を見送る。"
    }
    {
        en = "%townImage%Walking about %townname% with a few sellswords, you turn a corner to find an opulent man surrounded by thieves and bandits. They look over their shoulders and widen their eyes. One nicks the merchant on the cheek.%SPEECH_ON%Alright, we'll get you next time ya bastard!%SPEECH_OFF%The scoundrels quickly make their leave. A moment later and the merchant's heavily-armed guards appear. Nursing his wound, he starts yelling at them.%SPEECH_ON%What am I paying you for you sorry bastards? The second I get into trouble and you're nowhere to be seen? Look at this man here, that's who I should be paying! Hey, take this for your troubles, stranger.%SPEECH_OFF%The merchant throws you a satchel of crowns for your 'trouble,' though all you did was turn a corner and run into a coincidence."
        ja = "%townImage%数人の傭兵を連れて%townname%を歩いていると、角を曲がった先で、着飾った男が盗賊や追い剥ぎに囲まれている。奴らは肩越しにこちらを見て、目を見開く。一人が商人の頬を浅く切る。%SPEECH_ON%わかった、次こそ捕まえてやるからな、くそ野郎！%SPEECH_OFF%悪党どもは急いで立ち去る。その直後、重武装した商人の護衛たちが現れる。傷を押さえながら、商人は怒鳴りつける。%SPEECH_ON%何のために金を払っていると思ってるんだ、この役立たずども！　俺が面倒に巻き込まれた途端、どこにもいやしない！　ここにいる御仁を見ろ。金を払うならこの方だ！　さあ、手間をかけた礼だ。受け取ってくれ。%SPEECH_OFF%商人は「手間」への礼としてクラウンの入った革袋を投げて寄越す。もっとも、あなたは角を曲がり、偶然この場へ出くわしただけだ。"
    }
    {
        en = "%townImage%While walking about %townname%, you run into an old man dragging a youthful man by the ear.%SPEECH_ON%You want to be a master, it takes time! Blood! Sweat! Tears if yer of the cryin' sort and there's no shame in that if ya are. Here, look! A sellsword! If you want to fight so bad, why not go to him?%SPEECH_OFF%You hold your hands out and ask for an explanation before getting offloaded some annoying git. The elderly man calms himself and lets the kid's ear go.%SPEECH_ON%Aye, I suppose you are owed more of an explanation. I'm the fencing master of this town, but I teach discipline and patience before anyone so much can touch a sword! And this damned student of mine has neither! So I told him, if you want to fight so bad, get the hell out!%SPEECH_OFF%You look at the kid. He's got a fresh face, but there is in fact some impatient eagerness in his eyes. You ask him if what the swordmaster says is true. The kid nods.%SPEECH_ON%Yessir. And I'd be more than happy to fight for you, too.%SPEECH_OFF%"
        ja = "%townImage%%townname%を歩いていると、若者の耳を引っ張って歩く老人に出会う。%SPEECH_ON%達人になるには時間が要る！　血も！　汗も！　泣き虫なら涙もだ。泣いたって恥じゃない！　ほら、見ろ！　傭兵だ！　そんなに戦いたいなら、あの男についていけばいいだろう？%SPEECH_OFF%厄介者を押しつけられる前に、説明しろと両手を上げる。老人は気を落ち着け、若者の耳を放す。%SPEECH_ON%ああ、もう少し説明する義理はあるな。俺はこの町の剣術師範だ。だが、誰であろうと剣に触れるより先に、規律と忍耐を教える！　この忌々しい弟子には、どちらもない！　だから言ってやった。そんなに戦いたいなら出ていけ、とな！%SPEECH_OFF%若者を見る。まだ幼さの残る顔だが、その目には確かに抑えきれない焦りがある。師範の話は本当かと尋ねる。若者はうなずく。%SPEECH_ON%はい、旦那。それに、あなたのためなら喜んで戦います。%SPEECH_OFF%"
    }
    {
        en = "%townImage%You push the shop owner away, telling him that you owe nothing. When he jumps forward again, your hand deftly moves to the pommel of your sword, stopping the man in one swift motion. He raises his hands up, nodding as he backs off. A few townspeople see this and skirt by, trying to avoid your gaze. The militiamen notice, but they seem uncertain on whether to take action or not."
        ja = "%townImage%店主を押し返し、何も払う義理はないと告げる。男が再び前へ飛び出すと、あなたの手が素早く剣の柄頭へ移る。その一動作で男は足を止めた。両手を上げ、うなずきながら後ずさる。何人かの町人がそれを見て、視線を避けながら遠巻きに通り過ぎる。民兵たちも気づくが、行動すべきか迷っているようだ。"
    }
    {
        en = "%townImage%You shrug. %troublemaker% doesn't run the old man through, but he does threaten to, raising the weapon on high. When the old man cowers, the sellsword delivers a punch that knocks the elderly right out, his teeth peppering the muck like spits of white rain. This brings a few jeers from the villagers, but they know not to contest your presence any further.\n\nA few men drag the elder away while children boo and women hiss. One child even runs up to the sellsword, pointing at him as he yells 'he's a bad man.' %troublemaker% shrugs as he sheathes his weapon.%SPEECH_ON%And yet the bad man still stands. Would you also like a taste of the mud, little one?%SPEECH_OFF%The kid quickly runs off."
        ja = "%townImage%あなたは肩をすくめる。%troublemaker%は老人を刺し貫きはしないが、武器を高く掲げて脅す。老人が身を縮めると、傭兵は拳を叩き込み、老人を気絶させた。抜けた歯が白い雨粒のように泥へ散る。村人たちから罵声が上がるが、これ以上あなたたちへ逆らうべきではないと知っている。\n\n何人かの男が老人を引きずっていく。子供たちは野次を飛ばし、女たちは声を上げて非難する。一人の子供が傭兵へ駆け寄り、指さしながら「悪い奴だ」と叫ぶ。%troublemaker%は肩をすくめ、武器を鞘へ納める。%SPEECH_ON%それでも悪い奴は立っている。お前も泥の味を知りたいか、坊主？%SPEECH_OFF%子供は急いで逃げ去る。"
    }
    {
        en = "%townImage%You take a purse of crowns and follow %doghandler% through a wind of darker and darker streets. Soon enough, there isn't much to see. Wet cobblestones, licked white by strobes of moonlight, lazily guide you into what depths the city hides from those who prefer the day. Suddenly, a torch flares up and a man's face, afloat and disembodied in the dark, speaks out to you.%SPEECH_ON%That dog here for da'fights?%SPEECH_OFF%%doghandler% nods. The stranger tilts the torch forward.%SPEECH_ON%Alright then. Right this way, gen-teel-men. Watch yer step. All manner of piss goes downhill.%SPEECH_OFF%"
        ja = "%townImage%クラウンの袋を手に、%doghandler%について、次第に暗さを増す街路のうねりを進む。やがて、ほとんど何も見えなくなる。月光の筋に白く舐められた濡れた石畳が、昼を好む者へ町が隠す深みまで、物憂げに導いていく。不意に松明が燃え上がり、暗闇へ顔だけが浮かんだ男が話しかける。%SPEECH_ON%その犬、試合に出すのか？%SPEECH_OFF%%doghandler%がうなずく。見知らぬ男は松明を前へ傾ける。%SPEECH_ON%よし。こっちだ、紳士諸君。足元に気をつけな。あらゆる小便が坂を流れてくる。%SPEECH_OFF%"
    }
    {
        en = "%townImage%{A boy suddenly runs up to the company. He practically gloms onto %oathtaker%'s leg and the Oathtaker's countenance takes on an appearance of confusion. He asks the runt if he is lost. The boy springs back.%SPEECH_ON%Lost? No, I'm not lost! I thought I'd never see your sort again, the vaunted Oathbringers!%SPEECH_OFF%%oathtaker%'s eye twitches, his hands tightens around the handle of his weapon. You're not sure when his screaming started and when the boy ended up on the ground with a blackened eye, but the righteous rage cracked from the Oathtaker like a bolt of holy fury, and you watch as he pushes the boy into the mud screaming and frothing that he is an Oathtaker, not some horrible, ugly, and inglorious Oathbringer, and he smooshes the boy's face into the grass and drags him into a pile of horse dung and sleds him across the road on the rolls of ordure until the boy cries out and runs for his life. Finished, %oathtaker% straightens up, affixing his attire, regirding his disheveled weaponry.%SPEECH_ON%Let us leave this hellhole of filthy degenerates, captain.%SPEECH_OFF%As he struts off, you turn around to see the townspeople staring at you in horror.}"
        ja = "%townImage%{突然、少年が傭兵団へ駆け寄ってくる。%oathtaker%の脚へまとわりつき、誓約者は困惑した表情を浮かべる。迷子かと尋ねると、少年は跳び退く。%SPEECH_ON%迷子？　違うよ！　もう二度と会えないと思ってたんだ。名高きオースブリンガーに！%SPEECH_OFF%%oathtaker%の目元が引きつり、武器の柄を握る手へ力がこもる。いつ怒鳴り始め、いつ少年が目の周りを黒く腫らして地面へ倒れたのか、あなたにはわからなかった。正義の怒りが、聖なる憤怒の雷のように誓約者から炸裂する。俺は誓約者であり、あの醜く、不名誉で、おぞましいオースブリンガーではないと泡を飛ばして叫びながら、少年を泥へ突き倒す。その顔を草へ押しつけ、馬糞の山へ引きずり込み、糞塊の上へ乗せて街道を滑らせる。少年は悲鳴を上げ、命からがら逃げ去った。気が済むと、%oathtaker%は背筋を伸ばし、服装を整え、乱れた武具を締め直す。%SPEECH_ON%隊長、この汚らわしい堕落者どもの地獄から立ち去りましょう。%SPEECH_OFF%男が大股で立ち去る。振り向くと、町人たちが恐怖に満ちた目であなたを見つめている。}"
    }
    {
        en = "%walker%, you've travelled up there. Say something."
        ja = "%walker%、お前はあそこまで旅したことがあるな。何か言ってやれ。"
    }
    {
        en = "%witchhunter%, do you know this man?"
        ja = "%witchhunter%、この男を知っているか？"
    }
    {
        en = "1 day"
        ja = "1日"
    }
    {
        en = "A Band of Poachers"
        ja = "密猟者の一団"
    }
    {
        en = "A Direwolf's frenzy and bloodlust can be attributed to substances produced by this gland. Someone, somewhere will probably have a use for it."
        ja = "この腺で作られる物質が、ダイアウルフの狂乱と血への渇望を引き起こしているらしい。どこかの誰かなら、おそらく使い道を見いだすだろう。"
    }
    {
        en = "A Lindwurm - a wingless bipedal dragon resembling a giant snake."
        ja = "リントヴルム――巨大な蛇を思わせる、翼を持たない二足歩行の竜。"
    }
    {
        en = "A Shamshir already is an exquisite and exotic weapon in these parts, but this piece is of extraordinary quality. It will cut through flesh and bone just as easily as through a ripe melon."
        ja = "シャムシールはこの地ではそれだけでも精巧かつ異国情緒あふれる武器だが、これは並外れた逸品だ。熟れたメロンを切るのと変わらぬほど容易く、肉も骨も断ち切る。"
    }
    {
        en = "A bag of black powder, used for arming exotic firearms. Is automatically refilled after each battle if you have enough ammunition."
        ja = "異国の火器へ装填する黒色火薬の袋。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A band of menacing orcs, greenskinned and towering any man."
        ja = "緑の肌を持ち、どんな人間よりも大柄な、獰猛なオークの一団。"
    }
    {
        en = "A band of mischievous goblins, small but cunning and not to be underestimated."
        ja = "小柄ながら狡猾で、決して侮れない厄介なゴブリンの一団。"
    }
    {
        en = "A barbarian armor of crude making that has been adjusted to protect without being too cumbersome. It wears the typical markings of the northern barbarian tribes."
        ja = "粗雑な作りの蛮族鎧だが、動きを妨げすぎず防護できるよう調整されている。北方蛮族の部族に典型的な印があしらわれている。"
    }
    {
        en = "A basic and simple mail shirt. Offers decent and affordable protection against slashing and piercing attacks."
        ja = "簡素なメイルシャツ。斬撃と刺突に対し、手頃な価格で十分な防護を得られる。"
    }
    {
        en = "A better bargain!"
        ja = "もっと有利な取引だ！"
    }
    {
        en = "A big harbor city relying on trade and fishing, and an important hub for travellers arriving or leaving by ship."
        ja = "交易と漁業で成り立つ大きな港湾都市で、船で訪れる者や旅立つ者にとって重要な中継地でもある。"
    }
    {
        en = "A bit messier than expected..."
        ja = "予想より少し面倒なことになった……"
    }
    {
        en = "A blow to the neck injured the windpipe, making it very hard and painful to draw breath, let alone to keep fighting."
        ja = "首への一撃で気管を潰され、戦い続けるどころか、息を吸うことさえひどく困難で痛みを伴う。"
    }
    {
        en = "A body armor made of thick overlapping metal plates that cover most of the upper body."
        ja = "上半身の大部分を覆うよう、厚い金属板を重ね合わせて作られた胴防具。"
    }
    {
        en = "A brawler like %name% is dangerous with just his fists, and proved himself similarly savage with weapons. Before you left the %companyname%, you talked to the fighter about whether or not he'd stay in the band. He said he had no desire to return to prizefighting, shook your hand, and thanked you for giving him the opportunity. Last you heard, the company chose him for a one-on-one, winner take all fight to settle compensation differences with a competing mercenary band. He won in the first round."
        ja = "%name%のような喧嘩屋は拳だけでも危険で、武器を持っても同じように獰猛だと証明した。あなたが%companyname%を去る前、この闘士に傭兵団へ残るつもりか尋ねた。賞金試合へ戻る気はないと言い、あなたと握手して、機会を与えてくれたことに礼を述べた。最後に聞いた話では、報酬をめぐる競合傭兵団との争いを、一対一の勝者総取り試合で決着させる代表に選ばれたという。彼は第一ラウンドで勝った。"
    }
    {
        en = "A broken arm makes it almost impossible to use any weapon effectively."
        ja = "腕を骨折しているため、どの武器もまともに扱うことはほぼ不可能だ。"
    }
    {
        en = "A broken leg severely limits mobility and can take a long time to heal."
        ja = "脚を骨折しているため動きが著しく制限され、治癒にも長い時間を要する。"
    }
    {
        en = "A brute force attack that inflicts additional fatigue with every hit."
        ja = "力任せの攻撃。命中するたび、対象へ追加の疲労を与える。"
    }
    {
        en = "A caravan with armed escorts transporting provisions, supplies and equipment between settlements."
        ja = "集落間で食糧や補給物資、装備を運ぶ、武装護衛付きの隊商。"
    }
    {
        en = "A caravan with armed escorts transporting something worth protecting between settlements."
        ja = "集落間で、守るだけの価値がある何かを運ぶ武装護衛付きの隊商。"
    }
    {
        en = "A citadel towering high over the surrounding woods"
        ja = "周囲の森林を見下ろすように高くそびえる城塞"
    }
    {
        en = "A cloak made out of the scales of a Lindwurm. Not only is it a rare and impressive trophy, it also offers additional protection and is untouchable by corroding Lindwurm blood."
        ja = "リントヴルムの鱗で作られた外套。希少で目を引く戦利品というだけでなく、防御力も高め、腐食性のリントヴルムの血にも侵されない。"
    }
    {
        en = "A close call."
        ja = "危ないところだった。"
    }
    {
        en = "A closed metal helm with breathing holes. Great in the way of protection but hard to breathe in and limiting the field of view."
        ja = "通気孔を備えた密閉式の金属兜。防護には優れるが、息苦しく、視野も狭まる。"
    }
    {
        en = "A collection of many smaller settlements spread out over dry spots in the swampy area to form one modestly sized city."
        ja = "沼地の乾いた場所に小さな集落がいくつも点在し、全体で中規模の都市を形作っている。"
    }
    {
        en = "A creature of bark and wood, blending between trees and shambling slowly, its roots digging through the soil."
        ja = "樹皮と木から成る怪物。木々に紛れ、地中へ根を食い込ませながら、ゆっくりと歩き回る。"
    }
    {
        en = "A damn shame."
        ja = "まったく残念だ。"
    }
    {
        en = "A death in battle for %hedgeknight1%, at least."
        ja = "少なくとも、%hedgeknight1%は戦いの中で死ねた。"
    }
    {
        en = "A death in battle for %hedgeknight2%, at least."
        ja = "少なくとも、%hedgeknight2%は戦いの中で死ねた。"
    }
    {
        en = "A decent hunt."
        ja = "まずまずの狩りだった。"
    }
    {
        en = "A deep cut at the arm makes it difficult to use."
        ja = "腕の深い裂傷により、その腕を動かすことが難しい。"
    }
    {
        en = "A developed village thriving on lumber and game"
        ja = "木材と森の獲物で栄える発展した村"
    }
    {
        en = "A fearsome armor to behold."
        ja = "恐るべき威容の鎧だ。"
    }
    {
        en = "A flock of scavenging nachzehrers."
        ja = "餌を漁るナハツェーラーの群れ。"
    }
    {
        en = "A focused and carefully aimed shot with a good outlook of hitting its intended target even at a distance. Can not be used while engaged in melee."
        ja = "遠距離でも狙った標的に当てやすい、集中して慎重に狙う射撃。近接戦闘中は使用できない。"
    }
    {
        en = "A frightening prospect."
        ja = "恐ろしい話だ。"
    }
    {
        en = "A golden helmet and facemask, showing the visage of an emperor from an age long past, imbued with mystical energies. When you hold it into the light, it almost looks as if the face were moving and making expressions of disgust."
        ja = "遥か昔の皇帝の顔をかたどった黄金の兜と仮面。神秘の力を宿している。光にかざすと、その顔が動き、嫌悪の表情を浮かべているようにさえ見える。"
    }
    {
        en = "A good deed was done here this day."
        ja = "今日はここで善行をなした。"
    }
    {
        en = "A good hunt."
        ja = "いい狩りだった。"
    }
    {
        en = "A good man doesn't come cheap."
        ja = "腕の立つ男は安くはない。"
    }
    {
        en = "A good mason is used to physical labor and studying to improve his craft."
        ja = "優れた石工は肉体労働に慣れ、腕を磨くために学び続けている。"
    }
    {
        en = "A good minstrel will sing a saga to inspire the men, play the flute to calm them, or entertain them with poetry around the camp fire. A lute is not a weapon, however, and minstrels are often not used to physical labor or bloodshed."
        ja = "優れた吟遊詩人は、サガを歌って男たちを鼓舞し、笛を吹いて心を鎮め、焚き火の周りで詩を披露して楽しませる。だがリュートは武器ではなく、吟遊詩人は肉体労働にも流血にも慣れていないことが多い。"
    }
    {
        en = "A good thief will have quick reflexes and the ability to evade any captors."
        ja = "優れた盗人は反射神経に優れ、捕縛者から逃れる術を心得ている。"
    }
    {
        en = "A group of indebted that turned to banditry."
        ja = "盗賊に身を落とした債務奴隷の一団。"
    }
    {
        en = "A group of indebted."
        ja = "債務奴隷の一団。"
    }
    {
        en = "A harbor that allows you to book passage by ship to other parts of the continent"
        ja = "大陸各地へ向かう船便を手配できる港"
    }
    {
        en = "A heavily bruised leg severely limits mobility, but won't take long to recover from."
        ja = "脚のひどい打撲によって動きが著しく制限されているが、回復にはさほど時間を要しない。"
    }
    {
        en = "A heavy armor that is made from mostly metal. Only one chosen by the ancestors will own a set like this."
        ja = "大部分が金属で作られた重装鎧。祖霊に選ばれた者だけが、このような鎧を持つことを許される。"
    }
    {
        en = "A heavy body armor made from thick iron scales."
        ja = "厚い鉄製の鱗札で作られた重い胴防具。"
    }
    {
        en = "A heavy coat of scales, partly reinforced with a layer of plated metal on top. It's a massive armor of ancient origin that didn't age well."
        ja = "厚い鱗札を重ね、一部をその上から金属板で補強した重装鎧。古代に作られた重厚な鎧だが、長い歳月でひどく傷んでいる。"
    }
    {
        en = "A heavy lamellar armor that covers most parts of the body with thick, overlapping metal plates for maximum protection."
        ja = "厚い金属板を重ね合わせ、全身の大部分を覆う重厚なラメラーアーマー。最大限の防護をもたらす。"
    }
    {
        en = "A hidden talent."
        ja = "隠れた才能だ。"
    }
    {
        en = "A horde of greenskins marching to war."
        ja = "戦へ進軍するグリーンスキンの大軍。"
    }
    {
        en = "A humble village that managed to survive in the sparse tundra"
        ja = "草木もまばらなツンドラで生き延びてきた慎ましい村"
    }
    {
        en = "A humble village that managed to survive in the sparse tundra."
        ja = "草木もまばらなツンドラで生き延びてきた慎ましい村。"
    }
    {
        en = "A killer on the run may kill again, and he knows where to aim."
        ja = "逃亡中の殺人者は再び人を殺しかねず、急所の狙い方も心得ている。"
    }
    {
        en = "A large citadel towering high over the surrounding tundra"
        ja = "周囲のツンドラを見下ろして高くそびえる大城塞"
    }
    {
        en = "A large citadel towering high over the surrounding tundra and securing the large and open region. Many come here to resupply, make repairs and rest until venturing on."
        ja = "周囲のツンドラを見下ろして高くそびえ、広大で開けた一帯を守る大城塞。多くの者がここで物資を補給し、装備を修理し、次の旅へ出るまで休息する。"
    }
    {
        en = "A large city and trading hub surrounded by barren tundra"
        ja = "荒涼としたツンドラに囲まれた大都市にして交易の要衝"
    }
    {
        en = "A large city far up north. Traders, travelers and adventurers come here for shelter from snow and storms."
        ja = "はるか北方にある大都市。商人、旅人、冒険者が雪や嵐を避けてここへ集まる。"
    }
    {
        en = "A large city sheltering travelers and traders from snow and cold"
        ja = "旅人や商人を雪と寒さから守る大都市"
    }
    {
        en = "A large city surrounded by lush green meadows, orchards and fields. Food stocks are usually filled to the brim."
        ja = "青々とした牧草地、果樹園、畑に囲まれた大都市。食料の備蓄はたいてい満杯だ。"
    }
    {
        en = "A large city thriving in the southern steppe by trading and producing valuable goods and fine arts."
        ja = "南方のステップで、交易と高価な品々や美術品の生産により栄える大都市。"
    }
    {
        en = "A large city thriving on trade and agriculture"
        ja = "交易と農業で栄える大都市"
    }
    {
