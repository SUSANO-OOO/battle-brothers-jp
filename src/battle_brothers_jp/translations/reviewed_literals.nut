    }
    {
        en = "Unleash your warhound and send him charging into the enemy. Needs a free tile adjacent."
        ja = "軍用猟犬を放ち、敵へ突撃させる。隣接するマスが1つ空いている必要がある。"
    }
    {
        en = "Usable in Combat"
