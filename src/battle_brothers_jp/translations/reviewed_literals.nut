        ja = "北方の侵略者をギルダーの裁きに委ねる決断を支持した"
    }
    {
        en = "Approved of your decision to leave southern invaders to die"
        ja = "南方の侵略者を見殺しにする決断を支持した"
    }
    {
        en = "Are those vultures circling above?"
        ja = "上で禿鷹が旋回していないか？"
