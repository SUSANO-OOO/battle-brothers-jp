        ja = "襲撃前……"
    }
    {
        en = "Beggar"
        ja = "物乞い"
    }
    {
        en = "Beggars aren't the most determined persons, and living on the street tends to be detrimental to their health."
        ja = "物乞いはさほど意志が強くなく、路上暮らしは健康にも悪い。"
