    }
    {
        en = "A broken ceremonial sword with few sharp edges outside of the breakpoint. It is, however, still more than a lethal weapon in the hands of a cunning fighter."
        ja = "折れ口以外には鋭い部分がほとんど残っていない、壊れた儀礼剣。それでも狡猾な戦士の手にかかれば、なお致命的な武器となる。"
    }
    {
        en = "A broken net that may be repaired if you have the knowledge, or sold for scrap"
        ja = "修理の知識があれば直せるか、くずとして売れる破れた投網。"
    }
    {
        en = "A bucket of black paint. Highly sought after by artisans. It's dull appearance is a base for any fresco or artwork but alone is not interesting enough to be much much coin."
        ja = "黒い塗料の入った桶。職人たちの需要は高い。くすんだ色はフレスコ画や美術品の下地になるが、これだけでは大した値はつかない。"
    }
    {
        en = "A bucket of paint remover. Everyone makes mistakes, and this is a good way for those with shakey hands to cover up their mistakes without looking like a charlatan."
        ja = "塗料剥がしの入った桶。誰にでも失敗はある。手元の震える者でも、いかさま師に見られずに失敗を消し去れる便利な品だ。"
    }
    {
        en = "A bucket of red paint. This is a common but much needed colour that is used from shields to the finest artwork. It is colourful but easy to make."
        ja = "赤い塗料の入った桶。盾から上等な美術品まで幅広く使われる、ごく一般的ながら欠かせない色である。鮮やかだが、作るのは容易い。"
