    {
        en = "This character has a debilitating attack prepared. Hitting a target will temporarily reduce their ability to inflict damage for one turn. Missing the attack will waste the effect."
        ja = "この団員は、敵を衰弱させる攻撃を繰り出す準備ができている。命中した対象は、1ターンの間、与えるダメージが一時的に低下する。攻撃を外すと効果は失われる。"
    }
    {
        en = "This character has consumed a particularly powerful stimulant. While the delivery mechanism itself is revolutionary, the drug itself is not as powerful as the grandeur of its name suggests."
        ja = "この団員は非常に強力な刺激薬を服用した。投与法そのものは革新的だが、薬効は大仰な名前から想像するほど強くない。"
    }
    {
        en = "This character is guaranteed to land a hit to the head on the next attack that connects."
        ja = "次に命中した攻撃は、必ず頭部に当たる。"
    }
    {
        en = "This character's body has mutated in such a way that their fight-or-flight response is altered. In high stress situations, their limbic system is simply refused resources for flight, making them effectively unbreakable in the battle line."
        ja = "この団員の身体は、闘争・逃走反応そのものが変わるよう変異している。強い緊張下では、辺縁系へ逃走に必要な資源が回されなくなり、戦列で事実上決して逃げ出さない。"
    }
    {
        en = "This character's eyes have mutated to respond faster and more drastically to low light environments. As a result, they have night vision nearly on par with their sight during the day."
        ja = "この団員の眼は、暗い環境へより速く、より強く反応するよう変異している。その結果、夜間でも昼間に近い視界を得られる。"
    }
    {
