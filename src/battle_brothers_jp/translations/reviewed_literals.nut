    {
        en = "Adventurous Noble"
        ja = "冒険好きの貴族"
    }
    {
        en = "Adventurous Nobles tend to have high resolve and melee skills, but often neglect ranged defense."
        ja = "冒険好きの貴族は精神力と近接技能に優れる傾向があるが、射撃防御をおろそかにしがちだ。"
    }
    {
        en = "Afraid"
        ja = "怯え"
    }
    {
        en = "Afraid to be dismissed on account of his injury"
        ja = "負傷を理由に解雇されるのではないかと恐れている"
    }
    {
        en = "After a long talk with a monk, %name% was converted to a more peaceful means of expressing his faith. Now when he picks up a weapon you can be assured it will only be pointed at someone other than himself."
        ja = "修道士とじっくり話した後、%name%は信仰をより穏やかに表す道へ改宗した。今では彼が武器を手にしても、少なくとも自分自身へ向けることはないと安心できる。"
    }
    {
        en = "After battle..."
        ja = "戦いの後……"
    }
    {
        en = "After having a spiritual breakdown, %name% retired from fighting and found home in a monastery. All his fellow brothers and abbots ostracized him for taking part in such a violent venture. Word has it he was eventually exiled when a sexton caught him stealing an offertory."
        ja = "信仰上の挫折を味わった後、%name%は戦いを引退し、修道院に居場所を見つけた。暴力に満ちた仕事へ加わっていたことで、修道士仲間も修道院長も彼を遠ざけた。やがて聖具保管係に献金箱を盗むところを見つかり、追放されたという。"
    }
    {
        en = "After leaving the %companyname%, %name% retired from beast slaying altogether and last you heard he fathered an albino daughter. Unfortunately, rumors spread quickly about the girl having supernatural powers and her mother was executed by fire. The father and child were never caught nor seen again."
        ja = "%companyname%を去った後、%name%は獣狩りを完全に引退し、最後に聞いた話では白皮症の娘をもうけた。だが娘に超自然の力があるという噂が瞬く間に広まり、母親は火刑に処された。父と娘は捕まらず、その後二度と目撃されていない。"
    }
    {
        en = "After the battle"
        ja = "戦いの後"
    }
    {
        en = "After the battle..."
        ja = "戦いの後……"
    }
    {
        en = "After you left the %companyname%, you sent a letter inquiring about the status of %name% the bowyer. You got word that he had discovered a way to craft the finest bow possible and, instead of giving this secret to the company, he departed to start his own business. He did not get far: whatever he had learned about his trade died with him on a muddy road out {north | south | west | east} of here, his body ironically skewered with what is said to have been a dozen arrows."
        ja = "あなたが%companyname%を去った後、弓職人の%name%の様子を尋ねる手紙を送った。彼は最高の弓を作る方法を発見したが、その秘法を傭兵団へ伝えず、自分の商売を始めるため出ていったと知らされた。しかし遠くへは行けなかった。彼が身につけた技は、ここから{北 | 南 | 西 | 東}へ向かう泥道で本人とともに失われた。その死体は皮肉にも、十数本の矢で串刺しにされていたという。"
    }
    {
        en = "Agersted"
        ja = "アーガーステッド"
    }
    {
        en = "Ah well."
        ja = "まあ、仕方ない。"
    }
    {
        en = "Ah well. Two of the vials are ours."
        ja = "まあいい。小瓶を二本手に入れた。"
    }
    {
        en = "Ah, %name%. What an addition to the %companyname%! The minstrel not only became an excellent fighter, but was crucial in keeping the men's spirits high in the toughest of times. A poet and actor at heart, he eventually retired from the company and started up a theater company. He current performs plays for both the nobility and laymen. The minstrel does not yet realize it, but his playful wit and sharp commentary are slowly bringing the classes together."
        ja = "ああ、%name%か。%companyname%にとって、何と見事な拾い物だったことか！　吟遊詩人は優れた戦士になったばかりか、最も苦しい時にも男たちの士気を高く保つうえで欠かせなかった。根っからの詩人で役者だった彼は、やがて傭兵団を引退して劇団を立ち上げた。今では貴族にも庶民にも芝居を披露している。本人はまだ気づいていないが、その軽妙な機知と鋭い風刺は、少しずつ身分の垣根を取り払いつつある。"
    }
    {
        en = "Ah, he'll fit in with the rest of the misfits."
        ja = "ああ、ほかのはみ出し者たちとうまく馴染むだろう。"
    }
    {
        en = "Ah, the always safe measurement of manliness."
        ja = "ああ、いつだって安全な男らしさの測り方だな。"
    }
    {
        en = "Ah, we'll be fine."
        ja = "ああ、何とかなるさ。"
    }
    {
        en = "Ahh..."
        ja = "ああ……"
    }
    {
        en = "Ahlen"
        ja = "アーレン"
    }
    {
        en = "Ahlenstadt"
        ja = "アーレンシュタット"
    }
    {
        en = "Ailing"
        ja = "病弱"
    }
    {
        en = "Aim for an opponent's head. Somewhat unpredictable in damage, but able to strike over or around shield cover with a bit of luck."
        ja = "敵の頭を狙う。ダメージはいくぶん不安定だが、運がよければ盾の防御越し、あるいはその脇を抜いて命中させられる。"
    }
    {
        en = "Aimed Shot"
        ja = "狙い撃ち"
    }
    {
        en = "Aketon Cap"
        ja = "アクトン帽"
    }
    {
        en = "Albstadt"
        ja = "アルプシュタット"
    }
    {
        en = "Alchemist"
        ja = "錬金術師"
    }
    {
        en = "All for naught."
        ja = "すべて無駄だった。"
    }
    {
        en = "All in a day's work."
        ja = "これも一日の仕事のうちだ。"
    }
    {
        en = "All sorts of strange in these wastes."
        ja = "この荒野には妙なものが何でもいやがる。"
    }
    {
        en = "All worked out in the end."
        ja = "結局、すべて丸く収まった。"
    }
    {
        en = "Allersdorf"
        ja = "アラースドルフ"
    }
    {
        en = "Allows the wearer to see at night and negates any penalties due to nighttime."
        ja = "夜間でも視界を保ち、夜間によるあらゆるペナルティを無効化する。"
    }
    {
        en = "Alloy Plate Armor"
        ja = "合金製プレートアーマー"
    }
    {
        en = "Almost consumed alive by webknechts"
        ja = "ウェブクネヒトに生きたまま食われかけた"
    }
    {
        en = "Almost got executed by a technological marvel in spectacular fashion"
        ja = "技術の驚異によって、壮絶に処刑されかけた"
    }
    {
        en = "Almost got tarred and feathered"
        ja = "危うくタールを塗られ、羽根をまぶされるところだった"
    }
    {
        en = "Along the road..."
        ja = "街道にて……"
    }
    {
        en = "Along the way..."
        ja = "道中にて……"
    }
    {
        en = "Alp"
        ja = "アルプ"
    }
    {
        en = "Alps"
        ja = "アルプ"
    }
    {
        en = "Alright I'll pay a bit to have a look."
        ja = "いいだろう。少し払って見せてもらう。"
    }
    {
        en = "Alright that's enough. We've got actual work to do."
        ja = "よし、もう十分だ。本来の仕事に戻るぞ。"
    }
    {
        en = "Alright, I can spare a man or few."
        ja = "いいだろう。一人や二人なら出せる。"
    }
    {
        en = "Alright, I'll go and find them."
        ja = "いいだろう。探しに行く。"
    }
    {
        en = "Alright, I'll send a man in."
        ja = "わかった。ひとり中へ送ろう。"
    }
    {
        en = "Alright, alright, let's go."
        ja = "わかった、わかった。行くぞ。"
    }
    {
        en = "Alright, but I'm going with you."
        ja = "わかった。だが俺も一緒に行く。"
    }
    {
        en = "Alright, deal."
        ja = "よし、取引成立だ。"
    }
    {
        en = "Alright, fine."
        ja = "わかった、いいだろう。"
    }
    {
        en = "Alright, go on ahead and read."
        ja = "いいだろう。さあ、読んでみろ。"
    }
    {
        en = "Alright, let's give those poor folks some food."
        ja = "よし、あの哀れな者たちへ食料を分けよう。"
    }
    {
        en = "Alright, let's go dig it up."
        ja = "よし、掘り返しに行こう。"
    }
    {
        en = "Alright, show me what's been found."
        ja = "いいだろう。見つけた物を見せてくれ。"
    }
    {
        en = "Alright, show the way."
        ja = "いいだろう。案内しろ。"
    }
    {
        en = "Alright, take it."
        ja = "いいだろう。持っていけ。"
    }
    {
        en = "Alright, talk."
        ja = "いいだろう。話せ。"
    }
    {
        en = "Alright, uh, good luck then."
        ja = "わかった。それじゃあ、幸運を。"
    }
    {
        en = "Alright, we'll pay the 'fine.'"
        ja = "わかった。その「罰金」を払おう。"
    }
    {
        en = "Alright, we'll step off."
        ja = "わかった。こちらが退こう。"
    }
    {
        en = "Alright, we'll take him."
        ja = "いいだろう。そいつを引き取る。"
    }
    {
        en = "Alright, we'll take you."
        ja = "わかった。お前を迎えよう。"
    }
    {
        en = "Alright, you little mutt..."
        ja = "よし、このちび犬め……"
    }
    {
        en = "Alright."
        ja = "いいだろう。"
    }
    {
        en = "Alright. Here goes nothing"
        ja = "よし。やるしかない"
    }
    {
        en = "Alright..."
        ja = "わかった……"
    }
    {
        en = "Alsliv"
        ja = "アルスリーヴ"
    }
    {
        en = "Altenfurth"
        ja = "アルテンフルト"
    }
    {
        en = "Altenhof"
        ja = "アルテンホーフ"
    }
    {
        en = "Altenstadt"
        ja = "アルテンシュタット"
    }
    {
        en = "Always a risk taker, you accepted %name% into the %companyname%'s ranks despite him being a killer on the run. It worked in your favor as he proved himself an able and brave sellsword. As far as you know, he is still with the company, thoroughly enjoying every 'business' opportunity it affords him."
        ja = "いつも危険を好むあなたは、逃亡中の殺人者だった%name%を承知のうえで%companyname%へ迎え入れた。その判断は吉と出て、彼は有能かつ勇敢な売剣だと証明した。知る限りでは今も傭兵団に残り、そこで得られるあらゆる「仕事」の機会を存分に楽しんでいる。"
    }
    {
        en = "Always acts first in the very first round of combat"
        ja = "戦闘の第1ラウンドでは必ず最初に行動する"
    }
    {
        en = "Always nice to be in %townname%."
        ja = "%townname%はいつ来てもいい所だ。"
    }
    {
        en = "Amazing!"
        ja = "見事だ！"
    }
    {
        en = "Ambushed some of their men"
        ja = "相手方の兵を何人か待ち伏せした"
    }
    {
        en = "Ammunition"
        ja = "矢弾"
    }
    {
        en = "An Ambition Fulfilled"
        ja = "野望の達成"
    }
    {
        en = "An artery has been cut, leading to massive hemorrhaging and ultimately death if not treated out of combat. If survived, it is followed by severely lowered constitution due to loss of blood."
        ja = "動脈が切断され、大量出血している。戦闘外で手当てを受けなければ、やがて死に至る。生き延びても、失血によって体力が大幅に低下する。"
    }
    {
        en = "An assassin has to be quick on his feet and skilled with the use of weapons."
        ja = "暗殺者には身のこなしの速さと、武器を扱う腕が必要だ。"
    }
    {
        en = "An assassin tired of the killing life, %name% offered to join your company at a large price which you were quick to match. He is extremely skilled with a short-blade, twirling daggers around with more dexterity and control than some men have over their own fingers."
        ja = "殺しに明け暮れる暮らしに倦んだ暗殺者%name%は、高額の報酬で傭兵団へ加わると申し出た。あなたはすぐにその額を用意した。短い刃の扱いに並外れて熟達し、並の男が自分の指を操る以上の器用さと正確さで短剣を舞わせる。"
    }
    {
        en = "An enemy such as this shouldn't be taken lightly."
        ja = "このような敵を侮ってはならない。"
    }
    {
        en = "An epic for all the wrong reasons!"
        ja = "悪い意味で語り草になる大叙事詩だ！"
    }
    {
        en = "An established and thriving settlement in the steppe"
        ja = "ステップに根づき栄える集落"
    }
    {
        en = "An established settlement surrounded by the dry and flat lands of the steppe."
        ja = "乾燥した平坦なステップに囲まれた、古くから続く集落。"
    }
    {
        en = "An established village close to the forest living mainly from lumber cutting and game."
        ja = "森林近くにある古くから続く村で、主に伐採と狩猟で暮らしている。"
    }
    {
        en = "An established village in the rough tundra"
        ja = "厳しいツンドラに根づいた村"
    }
    {
        en = "An established village in the rough tundra that is a meeting point for the area."
        ja = "厳しいツンドラに根づき、一帯の人々が集う場所となっている村。"
    }
    {
        en = "An honorable man if there ever was one."
        ja = "名誉ある男とは、まさに彼のことだ。"
    }
    {
        en = "An impatient student of a fencing and swordmaster, %name% didn't have the mental aptitude to stick with the trials and tribulations of becoming a master of the blade himself. But what he lacks in mental fortitude he more than makes up for in effort. You 'hired' him simply by taking him off the old man's hands."
        ja = "剣術師範に学ぶせっかちな弟子だった%name%には、自ら剣の達人となるまでの試練と苦難を耐え抜く精神的な資質がなかった。だが、精神的な粘り強さに欠ける分を、努力で補って余りある。あなたは老人の手から引き取るだけで、彼を「雇った」。"
    }
    {
        en = "An injury like this makes even the quickest man hobble across the battlefield."
        ja = "この負傷では、どれほど足の速い者でも戦場を足を引きずって進むほかない。"
    }
    {
        en = "An old patient thanked him for his medical help"
        ja = "治療した昔の患者に感謝された"
    }
    {
        en = "An uneasy thought."
        ja = "不安を呼ぶ考えだ。"
    }
    {
