    }
    {
        en = "Heightened Reflexes"
        ja = "反射神経の強化"
    }
    {
        en = "Hell of a haul, I suppose."
        ja = "大した獲物ではあるな。"
    }
    {
        en = "Helmet of the Ijirok"
        ja = "イジロクの兜"
    }
    {
        en = "Help me kick in that gate, %volunteer%!"
        ja = "あの門を蹴破るのを手伝え、%volunteer%！"
    }
    {
        en = "Helped a little boy"
        ja = "少年を助けた"
