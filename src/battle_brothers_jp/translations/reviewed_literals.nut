::Rosetta.add({
    mod = {id = "vanilla", version = "1.5.2-3"}
    author = ::BattleBrothersJP.Author
    lang = "ja"
}, [
    {
        en = "A Direwolf's frenzy and bloodlust can be attributed to substances produced by this gland. Someone, somewhere will probably have a use for it."
        ja = "この腺で作られる物質が、ダイアウルフの狂乱と血への渇望を引き起こしているらしい。どこかの誰かなら、おそらく使い道を見いだすだろう。"
    }
    {
        en = "A Shamshir already is an exquisite and exotic weapon in these parts, but this piece is of extraordinary quality. It will cut through flesh and bone just as easily as through a ripe melon."
        ja = "シャムシールはこの地ではそれだけでも精巧かつ異国情緒あふれる武器だが、これは並外れた逸品だ。熟れたメロンを切るのと変わらぬほど容易く、肉も骨も断ち切る。"
    }
    {
        en = "A bag of black powder, used for arming exotic firearms. Is automatically refilled after each battle if you have enough ammunition."
        ja = "異国の火器へ装填する黒色火薬の袋。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A barbarian armor of crude making that has been adjusted to protect without being too cumbersome. It wears the typical markings of the northern barbarian tribes."
        ja = "粗雑な作りの蛮族鎧だが、動きを妨げすぎず防護できるよう調整されている。北方蛮族の部族に典型的な印があしらわれている。"
    }
    {
        en = "A basic and simple mail shirt. Offers decent and affordable protection against slashing and piercing attacks."
        ja = "簡素なメイルシャツ。斬撃と刺突に対し、手頃な価格で十分な防護を得られる。"
    }
    {
        en = "A blow to the neck injured the windpipe, making it very hard and painful to draw breath, let alone to keep fighting."
        ja = "首への一撃で気管を潰され、戦い続けるどころか、息を吸うことさえひどく困難で痛みを伴う。"
    }
    {
        en = "A body armor made of thick overlapping metal plates that cover most of the upper body."
        ja = "上半身の大部分を覆うよう、厚い金属板を重ね合わせて作られた胴防具。"
    }
    {
        en = "A broken arm makes it almost impossible to use any weapon effectively."
        ja = "腕を骨折しているため、どの武器もまともに扱うことはほぼ不可能だ。"
    }
    {
        en = "A broken leg severely limits mobility and can take a long time to heal."
        ja = "脚を骨折しているため動きが著しく制限され、治癒にも長い時間を要する。"
    }
    {
        en = "A brute force attack that inflicts additional fatigue with every hit."
        ja = "力任せの攻撃。命中するたび、対象へ追加の疲労を与える。"
    }
    {
        en = "A cloak made out of the scales of a Lindwurm. Not only is it a rare and impressive trophy, it also offers additional protection and is untouchable by corroding Lindwurm blood."
        ja = "リントヴルムの鱗で作られた外套。希少で目を引く戦利品というだけでなく、防御力も高め、腐食性のリントヴルムの血にも侵されない。"
    }
    {
        en = "A closed metal helm with breathing holes. Great in the way of protection but hard to breathe in and limiting the field of view."
        ja = "通気孔を備えた密閉式の金属兜。防護には優れるが、息苦しく、視野も狭まる。"
    }
    {
        en = "A deep cut at the arm makes it difficult to use."
        ja = "腕の深い裂傷により、その腕を動かすことが難しい。"
    }
    {
        en = "A focused and carefully aimed shot with a good outlook of hitting its intended target even at a distance. Can not be used while engaged in melee."
        ja = "遠距離でも狙った標的に当てやすい、集中して慎重に狙う射撃。近接戦闘中は使用できない。"
    }
    {
        en = "A golden helmet and facemask, showing the visage of an emperor from an age long past, imbued with mystical energies. When you hold it into the light, it almost looks as if the face were moving and making expressions of disgust."
        ja = "遥か昔の皇帝の顔をかたどった黄金の兜と仮面。神秘の力を宿している。光にかざすと、その顔が動き、嫌悪の表情を浮かべているようにさえ見える。"
    }
    {
        en = "A heavily bruised leg severely limits mobility, but won't take long to recover from."
        ja = "脚のひどい打撲によって動きが著しく制限されているが、回復にはさほど時間を要しない。"
    }
    {
        en = "A heavy armor that is made from mostly metal. Only one chosen by the ancestors will own a set like this."
        ja = "大部分が金属で作られた重装鎧。祖霊に選ばれた者だけが、このような鎧を持つことを許される。"
    }
    {
        en = "A heavy body armor made from thick iron scales."
        ja = "厚い鉄製の鱗札で作られた重い胴防具。"
    }
    {
        en = "A heavy coat of scales, partly reinforced with a layer of plated metal on top. It's a massive armor of ancient origin that didn't age well."
        ja = "厚い鱗札を重ね、一部をその上から金属板で補強した重装鎧。古代に作られた重厚な鎧だが、長い歳月でひどく傷んでいる。"
    }
    {
        en = "A heavy lamellar armor that covers most parts of the body with thick, overlapping metal plates for maximum protection."
        ja = "厚い金属板を重ね合わせ、全身の大部分を覆う重厚なラメラーアーマー。最大限の防護をもたらす。"
    }
    {
        en = "A leather nomad armor stitched together from various hides and scraps."
        ja = "さまざまな獣皮や端切れを縫い合わせて作られた、遊牧民の革鎧。"
    }
    {
        en = "A mantle crafted from the thin and shimmering scales of desert serpents, especially resistant to heat and flames."
        ja = "砂漠の大蛇が持つ薄くきらめく鱗から作られた肩掛け。熱と炎にとりわけ強い。"
    }
    {
        en = "A massive cleaver that can cut through flesh and armor alike. This piece is in good condition despite its old age."
        ja = "肉も装甲も等しく断ち切る巨大なクリーバー。古い品だが、保存状態は良好だ。"
    }
    {
        en = "A partially cut arm sinew makes it difficult to put force into any strike."
        ja = "腕の腱が一部切れており、どのような一撃にも力を込めることが難しい。"
    }
    {
        en = "A pointy hat with a broad rim."
        ja = "広いつばの付いた、とんがり帽子。"
    }
    {
        en = "A powerful chopping attack that bears full force on any target."
        ja = "全力を叩きつける強烈な斬撃。"
    }
    {
        en = "A reinforced animal hide armor fashioned from thick leather pieces with added mail and metal scales."
        ja = "厚い革片に鎖帷子と金属鱗を加えて補強した獣皮鎧。"
    }
    {
        en = "A reinforced mail shirt that lost some parts over the years."
        ja = "長い年月のうちに一部が失われた、補強されたメイルシャツ。"
    }
    {
        en = "A rugged apron worn by butchers to protect against accidental cuts."
        ja = "肉屋が不意の切り傷を防ぐために着ける、丈夫な前掛け。"
    }
    {
        en = "A rugged, large robe made of simple cloth usually worn by monks and similar individuals who don't care for fashion."
        ja = "簡素な布で作られた、粗く大ぶりなローブ。たいていは修道士など、身なりを気にしない者が着ている。"
    }
    {
        en = "A shining armor once worn by the emperor of an age long past, made from the most wondrous of materials, imbued with mystical energies. Light reflects easily off the polished armor, turning the wearer into a shimmering figure of light during the day."
        ja = "遥か昔の皇帝が身に着けていた、まばゆい鎧。世にも稀な素材で作られ、神秘の力を宿している。磨き上げられた表面は光をよく反射し、日中は着用者をきらめく光の人影へと変える。"
    }
    {
        en = "A shining armor once worn by the emperor of an age long past, made from the most woundrous of materials, imbued with mystical energies. Light reflects easily off the polished armor, turning the wearer into a shimmering figure of light during the day."
        ja = "遥か昔の皇帝が身に着けていた、まばゆい鎧。世にも稀な素材で作られ、神秘の力を宿している。磨き上げられた表面は光をよく反射し、日中は着用者をきらめく光の人影へと変える。"
    }
    {
        en = "A strike that can cover the distance of 2 tiles. Its effect can be felt through the thickest of armor."
        ja = "2マス先まで届く一撃。最も厚い装甲越しにも衝撃を与える。"
    }
    {
        en = "A strong and loyal dog bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies."
        ja = "戦闘用に育てられた、強く忠実な犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。"
    }
    {
        en = "A strong and loyal dog bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies. This one wears a heavy hide coat for protection."
        ja = "戦闘用に育てられた、強く忠実な犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。この犬は身を守るため、厚い獣皮の覆いを着けている。"
    }
    {
        en = "A strong and loyal dog bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies. This one wears a leather coat for protection against cutting wounds."
        ja = "戦闘用に育てられた、強く忠実な犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。この犬は斬り傷から身を守るため、革の覆いを着けている。"
    }
    {
        en = "A strong and loyal northern hound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies."
        ja = "戦闘用に育てられた、強く忠実な北方の猟犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。"
    }
    {
        en = "A strong and loyal northern hound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies. This one wears a heavy hide coat for protection."
        ja = "戦闘用に育てられた、強く忠実な北方の猟犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。この猟犬は身を守るため、厚い獣皮の覆いを着けている。"
    }
    {
        en = "A strong and loyal northern hound bred for war. Can be unleashed in battle for scouting, tracking or running down routing enemies. This one wears a leather coat for protection against cutting wounds."
        ja = "戦闘用に育てられた、強く忠実な北方の猟犬。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。この猟犬は斬り傷から身を守るため、革の覆いを着けている。"
    }
    {
        en = "A strong and wild wolf, tamed to be a loyal companion in battle. Can be unleashed in battle for scouting, tracking or running down routing enemies."
        ja = "強く野性的な狼を飼い慣らし、戦場で忠実に付き従う相棒としたもの。戦場で放てば、偵察や追跡、敗走する敵への追撃に使える。"
    }
    {
        en = "A sturdy, but heavy and partly decayed ancient scale harness."
        ja = "頑丈ではあるが重く、一部が朽ちた古代のスケイルハーネス。"
    }
    {
        en = "A sweeping strike in a wide arc that hits three adjacent tiles in counter-clockwise order over some distance that leaves a harmful miasma in its wake. Be careful around your own men unless you want to relieve your payroll!"
        ja = "広い弧を描き、一定の距離にある連続3マスを反時計回りに薙ぎ払って、その跡に有害な瘴気を残す。給金を減らしたいのでなければ、味方の近くでは注意すること！"
    }
    {
        en = "A thick cloak made out of a Frost Unhold's majestic white fur. Can be worn atop any armor to make the wearer more resilient against ranged weapons."
        ja = "フロスト・ウンホルトの堂々たる白毛から作られた厚い外套。どんな胴防具の上からでも着用でき、遠隔武器への耐性を高める。"
    }
    {
        en = "A thick cloth vest padded with dense wool to protect against blunt hits."
        ja = "目の詰まった羊毛を詰め、打撃から身を守る厚布のベスト。"
    }
    {
        en = "A thrusting attack that is difficult to defend against. Followed up by a strike with the axehead if the target is staggered."
        ja = "防ぎにくい刺突攻撃。対象がよろめいている場合は、斧頭による一撃を続けて放つ。"
    }
    {
        en = "AColorfulBand"
        ja = "AColorfulBand"
    }
    {
        en = "Acid Flask"
        ja = "酸入りフラスコ"
    }
    {
        en = "Additional Fur Padding"
        ja = "毛皮の追加裏打ち"
    }
    {
        en = "Adrenaline"
        ja = "アドレナリン"
    }
    {
        en = "Aimed Shot"
        ja = "狙い撃ち"
    }
    {
        en = "Aketon Cap"
        ja = "アクトン帽"
    }
    {
        en = "Allows the wearer to see at night and negates any penalties due to nighttime."
        ja = "夜間でも視界を保ち、夜間によるあらゆるペナルティを無効化する。"
    }
    {
        en = "Alloy Plate Armor"
        ja = "合金製プレートアーマー"
    }
    {
        en = "Alp"
        ja = "アルプ"
    }
    {
        en = "Ammunition"
        ja = "矢弾"
    }
    {
        en = "An artery has been cut, leading to massive hemorrhaging and ultimately death if not treated out of combat. If survived, it is followed by severely lowered constitution due to loss of blood."
        ja = "動脈が切断され、大量出血している。戦闘外で手当てを受けなければ、やがて死に至る。生き延びても、失血によって体力が大幅に低下する。"
    }
    {
        en = "An injury like this makes even the quickest man hobble across the battlefield."
        ja = "この負傷では、どれほど足の速い者でも戦場を足を引きずって進むほかない。"
    }
    {
        en = "An unlucky hit crushed a finger, making it painful to maintain a firm grip."
        ja = "不運な一撃で指を潰され、強く握り込むと痛みが走る。"
    }
    {
        en = "Ancient Breastplate"
        ja = "古代のブレストプレート"
    }
    {
        en = "Ancient Double Layer Mail"
        ja = "古代の二重鎖帷子"
    }
    {
        en = "Ancient Mail"
        ja = "古代の鎖帷子"
    }
    {
        en = "Ancient Plate Harness"
        ja = "古代のプレートハーネス"
    }
    {
        en = "Ancient Scale Coat"
        ja = "古代のスケイルコート"
    }
    {
        en = "Ancient Scale Harness"
        ja = "古代のスケイルハーネス"
    }
    {
        en = "Animal Hide Armor"
        ja = "獣皮鎧"
    }
    {
