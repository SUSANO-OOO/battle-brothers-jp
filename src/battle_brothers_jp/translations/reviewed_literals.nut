// Generated by tools/generate_runtime_translations.py. Do not edit by hand.
// Only independently REVIEWED literal units are present.

::Rosetta.add({
    mod = {id = "mod_legends", version = "19.4.20"}
    author = ::BattleBrothersJP.Author
    lang = "ja"
}, [
    {
        en = "\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%"
        ja = "\n\n\n\n\n\n\n\n次の団員が闘技場に入る：\n\n%bro1name%\n%bro2name%\n%bro3name%"
    }
    {
        en = "\n\n\n\n\n\n\n\nThe following characters will enter the arena:\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
        ja = "\n\n\n\n\n\n\n\n次の団員が闘技場に入る：\n\n%bro1name%\n%bro2name%\n%bro3name%\n%bro4name%\n%bro5name%"
    }
    {
        en = "\n\nBut for now, you keep running."
        ja = "\n\nだが今は、ただ走り続ける。"
    }
    {
        en = "\n\nIronically, it was those same creatures that brought you freedom. You and your fellow slaves were forced into the service of a domineering southern officer tasked with clearing a nomad camp. He sent you indebted into the camp first to soften the raiders for his conscripts. That was when the Ifrit came. 'Chaos' is the only word you possess to describe what ensued. A pure madness of sand and rock, of men crushed into bloody pulp by boulders lofted through the air, screaming and yelling and sand-filled lungs and a desert come to horrific life. When the battle began to rage into the officer's ranks, you saw your chance. You and your companions pilfered what you could from the battlefield, then ran. You ran like you've never run before, straight through the night."
        ja = "\n\n皮肉にも、自由をもたらしたのは同じ怪物たちだった。あなたと奴隷仲間は、遊牧民の野営地掃討を任された傲慢な南方の将校に無理やり従軍させられた。彼は徴募兵のために略奪者を弱らせようと、まず「債務奴隷」であるあなたたちを野営地へ送り込んだ。そのときイフリートが現れた。その後を表せる言葉は「混沌」しかない。砂と岩の狂乱。宙を飛ぶ巨岩に潰され、血肉の泥となる男たち。叫び声、怒号、砂に詰まる肺、恐るべき命を得た砂漠。戦いが将校の隊列へ燃え広がったとき、好機を見た。あなたと仲間たちは戦場から持てるだけの物を盗み、走った。かつてないほど必死に、一晩中走り続けた。"
    }
    {
        en = "\n\nIt's been half a year since Hoggart the Weasel ambushed you and the rest of the old company. Desperate for money, he first tried to ransom you and the other survivors, but finding no luck in the North, he turned to the South. You were sold to %vizierfullname%, proclaimed 'Indebted' to the Gilder, and worked to the bone. Unperson in the eyes of the vizier, you got to experience firsthand the many wonders of the South: backbreaking labor under the cruel desert sun, mortal combat in the arena, and forced hunts for the terrifying creatures of the sands."
        ja = "\n\nイタチのホッガートが、あなたと以前の傭兵団を待ち伏せしてから半年が過ぎた。金に困った彼は、まずあなたたち生存者を身代金と引き換えにしようとした。北方で買い手がつかず、南方へ目を向けた。あなたは%vizierfullname%に売られ、ギルダーへの「債務奴隷」と宣告され、骨身を削るまで働かされた。宰相の目には人ですらないあなたは、南方の数々の驚異を身をもって味わった。残酷な砂漠の太陽の下での重労働、闘技場での死闘、そして砂漠の恐るべき怪物狩りを強いられる日々だ。"
    }
    {
        en = "\n\nYou go over the man, noting his newfound vigor, and ask him how he's doing. He looks to the horizon at something you can't quite make out."
        ja = "\n\n新たな活力を得た男のもとへ行き、様子を尋ねる。彼は、あなたには見分けられない何かを地平線の彼方に見つめている。"
    }
    {
        en = "\n\nYou know you can't keep running forever, though. You'll be caught eventually, and if you don't turn this group of miserable, downtrodden slaves into warriors soon, all of you will surely perish. You won't let that happen. You've suffered with these men, shed sweat, blood, and tears together, and formed a bond of brotherhood stronger than any blood tie. Whether through mercenary work or common brigandry, you'll see them shaped into soldiers the likes of which %viziershortname% has never seen, and damn anyone who gets in your way."
        ja = "\n\nだが永遠に逃げ続けられないことは分かっている。いずれ捕まり、この惨めで虐げられた奴隷たちを早く戦士に変えなければ、全員が死ぬ。そんなことはさせない。彼らと共に苦しみ、汗と血と涙を流し、血縁よりも強い兄弟の絆を結んだ。傭兵稼業であれ、ありふれた盗賊稼業であれ、%viziershortname%が見たこともない兵士へ鍛え上げる。邪魔をする者は誰であろうと知ったことか。"
    }
    {
        en = "\n\n{%employer% lets out a sigh.%SPEECH_ON%Fine, I shall pay half of the agreed payment for at least having destroyed the nest.%SPEECH_OFF%}"
        ja = "\n\n{%employer%はため息をつく。%SPEECH_ON%いいだろう。少なくとも巣は破壊したのだから、取り決めた報酬の半分は払おう。%SPEECH_OFF%}"
    }
    {
        en = "\n\n{After a brief moment of consideration, %employer% hands you a paltry sum of crowns.%SPEECH_ON%I don't think you deserve this at all, but having risked your lives for this, perhaps you should get something for the trouble%SPEECH_OFF%}"
        ja = "\n\n{しばし考えた後、%employer%はわずかなクラウンを手渡す。%SPEECH_ON%本来なら一枚たりとも受け取る資格はない。だが命を懸けたのだ、この苦労に何もなしというわけにもいくまい。%SPEECH_OFF%}"
    }
    {
        en = "\nHaving struggled and bled for their life between two worlds, %muladi% has reaffirmed who they are, spitting in the faces of those who would decry and denounce %them_muladi%. Assured in the path they walk, this muladi promises a most fierce retribution that fuses the calculated cunning of the south, and raw strength of the north."
        ja = "\n二つの世界の狭間で命を懸け、血を流した%muladi%は、自分が何者かを改めて確信した。%them_muladi%を罵り、否定する者たちの顔へ唾を吐いたのだ。歩む道を定めたこのムラディは、南方の計算された狡知と北方の膂力を融合させ、苛烈な報復を果たすと誓う。"
    }
    {
        en = " As you look at %recovered%, however, you see a face carrying no such signs. "
        ja = " だが%recovered%を見ると、その顔に同じ兆しは一つもない。 "
    }
    {
        en = " The arena master"
        ja = " 闘技場の支配人"
    }
    {
        en = " { Time to get paid. | Our employer awaits. | Onwards, we have a 'package' to deliver. }"
        ja = " { 報酬を受け取る時だ。 | 依頼主が待っている。 | 行くぞ。届けるべき「荷物」がある。 }"
    }
    {
        en = " {Without a father around, %name%'s mother taught how to shoot a bow, and how to feed the rest of the family. | Born in the hinterlands of %randomtown%, %name% has spent life stalking the beasts amongst the trees. | %name% once took a bet to shoot an apple off a pig's head. The shot missed. A belly full of bacon, determined to never miss again - unless it meant more bacon, of course. | Early in life, %name% liked to traipse about the forests. When a rabid fox attacked, %name% learned to take a bow. When a devilish eagle clawed %name%'s face, the pain taught how to shoot it.} {Once employed by local royalty, a disastrous boar hunt ended with a gored baron and all the blame - and blood - on %name%'s hands. | The hunter hid the thought well, but for the longest time wondered what it would be like to hunt the ultimate game: man. | Sadly, a bad game of peasant-roulette forced the deer hunter into seeking other means of income. | Unfortunately, the ranger is not nearly as good at cooking deer as shooting them. A dinner consisting of undercooked meats poisoned %name%'s entire family. Desperation for a new life is understandable. | After an arduous trip to town to sell meats and leathers, %name% followed the call of mercenary work. | War drove the game out of the forests, and the hunt out of %name%. Now it has driven %name% to seek another line of work. | When %name%'s partner fell ill, the wounds could not be healed with hunted meat. Needing to earn crowns to pay for treatment, %name% took up the vocation of sellswords - or sellbows, as it were.} {Any outfit could use a deadeye such as this ranger. | Not entirely without faults, %name% is a professional archer nonetheless. | A quick demonstration is offered: %name% shoots one arrow high into the sky, and with another knocks it out. Impressive. | %name% has the look of someone with something to prove - just make sure it is proved at range. When first given a sword, %name% grabbed it at the wrong end. Yes, that end. | The hunter wields a bow like another limb, and shoots arrows like a preacher does words.}"
        ja = " {父親がいなかったため、%name%は母から弓の射ち方と、残された家族を養う術を教わった。 | %randomtown%の辺境に生まれた%name%は、木々の間に潜む獣を追って生涯を過ごしてきた。 | %name%はかつて、豚の頭に載せたリンゴを射抜けるか賭けをした。矢は外れた。腹いっぱいベーコンを食べ、二度と外すまいと決意した――もちろん、またベーコンにありつけるなら話は別だ。 | 幼い頃の%name%は森をぶらつくのが好きだった。狂犬病の狐に襲われた時、%name%は弓を手にすることを覚えた。凶暴な鷲に%name%の顔を爪で裂かれた時、その痛みから仕留め方を学んだ。} {かつて地元の貴族に仕えていたが、悲惨な猪狩りで男爵が牙にかけられ、責任も血もすべて%name%の手に残った。 | 狩人は胸の内をうまく隠していたが、究極の獲物――人間――を狩るとはどんなものか、長らく思いを巡らせていた。 | 不幸にも、農民ルーレットの勝負でしくじり、鹿狩りは別の稼ぎ口を探す羽目になった。 | あいにく、この野伏は鹿を射るほどには鹿を料理する腕がなかった。生焼け肉の夕食で%name%の家族は全員食中毒になった。新しい人生を切望するのも無理はない。 | 肉と皮を売るため町まで苦難の旅を終えた後、%name%は傭兵稼業の呼び声に従った。 | 戦争が森から獲物を追い払い、%name%から狩りを奪った。今度は%name%を別の稼業へと追いやったのだ。 | %name%の伴侶が病に倒れた時、狩った肉では傷を癒せなかった。治療費のクラウンを稼ぐため、%name%は剣売り――いや、弓売り――の稼業に就いた。} {この野伏ほどの神射手なら、どんな一団でも欲しがるだろう。 | 欠点がないわけではないが、それでも%name%は一流の弓手だ。 | ちょっとした実演として、%name%は一本の矢を空高く放ち、もう一本でそれを射落とした。見事なものだ。 | %name%には何かを証明したがっている者の目つきがある――ただし、遠くから証明させた方がいい。初めて剣を渡された時、%name%は刃の方を握った。そう、そちら側だ。 | この狩人は弓を手足のように操り、説教師が言葉を放つように矢を放つ。}"
    }
    {
        en = "%Company% stands a little stronger with %muladi% in the ranks"
        ja = "%Company%は%muladi%を隊列に迎え、少し強くなった"
    }
    {
        en = "%bearTamer%, you're trained to handle bears, right?"
        ja = "%bearTamer%、熊の扱いには慣れているんだろう？"
    }
    {
        en = "%doubter%, you've travelled up there. Say something."
        ja = "%doubter%、北方へ旅したことがあるだろう。何か言ってやれ。"
    }
    {
        en = "%militia% is eager to take action."
        ja = "%militia%は行動を起こしたがっている。"
    }
    {
        en = "%name% 's been a part of the company since."
        ja = "%name%はそれ以来、傭兵団の一員だ。"
    }
    {
        en = "%name% began %their% journey with you as a victim of circumstance, at odds with the rest of the world in %their% newfound predicament. Although they were not paid much %name% continued to spread your teachings to all who would listen. Seasons from then %they% would join the same holy order after it's monastery was burned down, setting out with like minded companions as a crusader."
        ja = "%name%は成り行きの犠牲者として、あなたとともに%their%の旅を始め、%their%の新たな境遇の中で世のすべてと対立していた。報酬はわずかだったが、%name%は耳を傾ける者すべてにあなたの教えを説き続けた。幾季か後、%they%は修道院を焼かれた同じ聖騎士団に加わり、志を同じくする仲間とともに十字軍戦士として旅立った。"
    }
    {
        en = "%name% continued their bizaare adventure after you left %companyname%, soon after they made their way back to the swamps in search of new 'pets'. They happened to bump into a {wildwoman | wildman} who was almost derranged as they were. They quickly formed a bond and it is said they adopted children and now leave peacefully in the swamp. However you suspect said children are really just more leeches."
        ja = "%name%は%companyname%を去った後も奇妙な冒険を続け、ほどなく新しい「ペット」を探して沼地へ戻った。そこで、自分と同じくらい頭の箍が外れた{野生の女 | 野生の男}と偶然出会った。二人はたちまち意気投合し、子供を引き取って今は沼で穏やかに暮らしているという。もっとも、その「子供」は実のところ、また別の蛭なのではないかとあなたは疑っている。"
    }
    {
        en = "%name% continued to look for a cure to their ailments after you left the company. A few years later they would wander into the woods and meet a witch who was more than happy to help at the cost of some protection. %name% and the witch lived out most of their lives away from prying eyes, surrounded by ever shifting rings of undead patrolling the perimiter."
        ja = "%name%は傭兵団を去った後も病を治す方法を探し続けた。数年後、森へ迷い込み、護衛と引き換えなら喜んで力を貸すという魔女に出会った。%name%と魔女は人目を避けて余生の大半を過ごし、その周囲では絶えず隊列を変える不死者の輪が巡回していた。"
    }
    {
        en = "%name% continued to move with the company for some time. As time went on their interest in the sciences around the dead shifted more from the living and further towards the dead. Living in a graveyard with a few puppets for company, %name% was eventually subdued and burnt at the stake by a mercenary company sent to clear the graveyard."
        ja = "%name%はしばらく傭兵団と行動をともにした。時が経つにつれ、死をめぐる学問への関心は生者から離れ、ますます死者へと傾いていった。墓地に住み着き、数体の人形を話し相手にしていた%name%は、やがて墓地の掃討に送られた傭兵団に制圧され、火刑に処された。"
    }
    {
        en = "%name% continued to practice their control over immortal objects for some time after mastering the basics from their time with the company. Given time they slowly strayed further and further from mortal company and surrounded themselves with marionettes of their own making — it didn't take long for them to muster a court of silent friends and comrades that agreed with their every word and whim. %name% had found a place where they could belong, even if the road to get here was paved with darker intentions."
        ja = "%name%は傭兵団で基礎を身につけた後もしばらく、命なき物体を操る術を磨き続けた。時とともに生者との交わりから遠ざかり、自作の操り人形に囲まれるようになった――やがて、どんな言葉にも気まぐれにも賛同してくれる、無言の友と仲間の宮廷ができあがった。そこへ至る道が暗い意図で敷き詰められていたとしても、%name%はついに自分の居場所を見つけたのだ。"
    }
    {
        en = "%name% departed the %companyname% and continued his adventuring elsewhere. {She headed east, hoping to discover the source of the greenskins, but the noblewoman has not been heard from since. | She headed north into the snowy wastes. Word has it she was seen a week ago, marching south this time, looking rather pale and shuffling moreso than walking. | She headed south into brutal marshlands. Word has it that a mysterious flame appeared in the fog and she walked toward it. The men who saw this said she disappeared into the mist and never returned. | She headed west and sailed the open sea. Despite having no experience at sea, she saw fit to make herself captain of the boat. They say pieces of her ship and dead sailors kept washing ashore for weeks.}"
        ja = "%name%は%companyname%を去り、別の土地で冒険を続けた。{彼女は東へ向かい、緑の肌を持つ者どもの源を探そうとしたが、それきりこの貴族の女の消息を聞いた者はいない。 | 彼女は北の雪原へ向かった。噂では一週間前、今度は南へ行軍する姿を目撃されたという。ひどく青白い顔で、歩くというより足を引きずっていたらしい。 | 彼女は南の過酷な沼地へ向かった。霧の中に謎めいた炎が現れ、彼女はそれに向かって歩いていったという。それを見た者たちは、彼女が霧の中へ消え、そのまま戻らなかったと語っている。 | 彼女は西へ向かい、外洋へ船出した。船乗りの経験など皆無だったにもかかわらず、自ら船長を務めることにしたらしい。その後、彼女の船の破片と水夫の死体が何週間も浜へ打ち上げられ続けたという。}"
    }
    {
        en = "%name% eventually became disillusioned with the world you brought %them% into - seeking home shortly after your departure from %companyname%, they found themselves terrified by what met them. Something had swept through the forest in their absence and stripped the resources from the land. Animals were burnt in piles and trees had been burnt, destroyed or smashed down. %name% never did find home, or another place like it."
        ja = "やがて%name%は、あなたが%them%を連れ込んだ世界に幻滅した。あなたが%companyname%を去ってほどなく故郷を目指したが、そこで目にしたものに恐怖した。留守の間に何かが森を通り過ぎ、大地の恵みを根こそぎ奪っていた。動物は山と積まれて焼かれ、木々も焼かれ、壊され、なぎ倒されていた。%name%は故郷にも、同じような場所にも二度と辿り着けなかった。"
    }
    {
        en = "%name% found themselves in the possession of more crowns they their family had accumulated across six generations. Despite this, the bladedancer returned to the desert and used their wealth to train the next generation of bladedancers as their tutor did before them."
        ja = "%name%は、一族が六代かけて蓄えた以上のクラウンを手にした。それでも剣舞師は砂漠へ戻り、師がかつてそうしたように、その財を次代の剣舞師を育てるために使った。"
    }
    {
        en = "%name% found themselves quite comfortable within the darkness, mingling with the company and learning many valuable skills. After they retired from service, they joined with a group of beast hunters that sought to hunt down the horrors of the night. Last you heard, they have been doing quite well for themselves. Able to spot and expell an alp from a village without breaking a sweat."
        ja = "%name%は闇の中を居心地よく感じ、傭兵団の仲間と交わりながら多くの有用な技を身につけた。引退後は、夜の恐怖を狩る獣狩りの一団に加わった。最後に聞いたところでは、ずいぶんうまくやっているらしい。汗ひとつかかず、村に潜むアルプを見つけて追い払えるほどだ。"
    }
    {
        en = "%name% gains increased Melee and Ranged defense by balancing %their% armor weight."
        ja = "%name%は%their%防具の重量配分を整え、近接防御と射撃防御を高める。"
    }
    {
        en = "%name% gradually detached from reality as their powers grew, forming their own as the world around them fell apart. Living or dead — it no longer mattered to him. %name% left quietly one night with a small group of his puppets, only to realise that when you are cold and alone, a brutal overseer has few friends when he needs them most."
        ja = "力を増すにつれて%name%は次第に現実から離れ、周囲の世界が崩れる中で自分だけの世界を築いた。生者か死者か――もはや彼にはどうでもよかった。ある夜、%name%は少数の人形を連れてひっそり去ったが、寒さの中で孤独になれば、残忍な監督者には肝心な時に助けてくれる友などほとんどいないと思い知った。"
    }
    {
        en = "%name% has been hardened by an experience few of %their% ilk live through — a roadside ambush. While they are unlikely to survive, a little help from %companyname% changed that."
        ja = "%name%は、%their%同類のほとんどが生き延びられない経験――街道での待ち伏せ――によって鍛えられた。本来なら助からなかっただろうが、%companyname%がわずかに手を貸したことで運命は変わった。"
    }
    {
        en = "%name% ignores all Zones of Control and will ignore the first attack done against %them%."
        ja = "%name%はあらゆる支配領域を無視し、%them%に対して行われる最初の攻撃を回避する。"
    }
    {
        en = "%name% initially did not fit in well with %companyname%, but given time everyone saw their value in setting both weapons and joints back together. They took their small fortune and set up a workshop to call their own, accidently creating a mortar that did not fire up in the air, but rather directly at the enemy."
        ja = "当初、%name%は%companyname%になじめなかったが、時が経つにつれ、武器も関節も元通りにする価値を皆が認めるようになった。小さな財産を元手に自分の工房を構え、上空へではなく敵へ真っ直ぐ弾を撃ち出す臼砲を偶然発明した。"
    }
    {
        en = "%name% is not known to be a big talker, but he has every right to be. {He's saved the lives of many of the company. | He once spared you from an orc's wicked chain. | An assassin would have killed the local noble in a pub were it not for this man. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | He once pushed two men off a cliff using only his shield and two strong legs. | He learned how to fight from his father, a vanguard at the Battle of Many Names. | Sacrificing his family's heirloom - an old shield of wood and studded iron - he saved the local noble's life. | A man of rather consistent heroism, he pulled a drunken captain from a pub fire. | Faced with a horde of goblins, he used his shield and strength to push a hole in their lines, opening the way for the rest of her company to kill them all.} With quick whirls and whips of his shield, the man's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
        ja = "%name%は自慢話をする男ではないが、その資格は十分にある。{彼は傭兵団の多くの命を救ってきた。 | かつて、オークの凶悪な鎖からあなたを救った。 | この男がいなければ、酒場で暗殺者が地元の貴族を殺していただろう。 | 暴発したクロスボウの矢があなたの目を射抜くところだった――%name%の盾が止めていなければ。 | 彼は盾と二本の頑丈な脚だけで、二人の男を崖から突き落としたことがある。 | 数多の名を持つ戦いで前衛を務めた父から、戦い方を学んだ。 | 木と鋲打ち鉄でできた古い盾という家宝を犠牲にして、地元の貴族の命を救った。 | まるで癖のように英雄的な男で、酒場の火事から酔いどれ隊長を引きずり出した。 | ゴブリンの大群を前に、盾と膂力で敵陣に穴をこじ開け、傭兵団の仲間が残らず仕留める道を作った。}盾を素早く旋回させ、振るうことで、この男は命を奪うあらゆる危険をそらしてきた。物静かではあるが、盾壁における%name%の存在は、あなたにとって欠かせないものとなっている。"
    }
    {
        en = "%name% is not known to be a big talker, but she has every right to be. {She's saved the lives of many of the company. | She once spared you from an orc's wicked chain. | An assassin would have killed the local noble in a pub were it not for this woman. | A misfired crossbow nearly took out your eye - hadn't %name%'s shield been there to stop it. | She once pushed two men off a cliff using only her shield and two strong legs. | She learned how to fight from her father, a vanguard at the Battle of Many Names. | Sacrificing her family's heirloom - an old shield of wood and studded iron - she saved the local noble's life. | A woman of rather consistent heroism, she pulled a drunken captain from a pub fire. | Faced with a horde of goblins, she used her shield and strength to push a hole in their lines, opening the way for the rest of her company to kill them all.} With quick whirls and whips of her shield, the woman's deflected all manner of mortal danger. Although rather quiet, you've found %name%'s place in a shield-wall to be rather indispensable."
        ja = "%name%は自慢話をする女ではないが、その資格は十分にある。{彼女は傭兵団の多くの命を救ってきた。 | かつて、オークの凶悪な鎖からあなたを救った。 | この女がいなければ、酒場で暗殺者が地元の貴族を殺していただろう。 | 暴発したクロスボウの矢があなたの目を射抜くところだった――%name%の盾が止めていなければ。 | 彼女は盾と二本の頑丈な脚だけで、二人の男を崖から突き落としたことがある。 | 数多の名を持つ戦いで前衛を務めた父から、戦い方を学んだ。 | 木と鋲打ち鉄でできた古い盾という家宝を犠牲にして、地元の貴族の命を救った。 | まるで癖のように英雄的な女で、酒場の火事から酔いどれ隊長を引きずり出した。 | ゴブリンの大群を前に、盾と膂力で敵陣に穴をこじ開け、傭兵団の仲間が残らず仕留める道を作った。}盾を素早く旋回させ、振るうことで、この女は命を奪うあらゆる危険をそらしてきた。物静かではあるが、盾壁における%name%の存在は、あなたにとって欠かせないものとなっている。"
    }
    {
        en = "%name% is one of the more talented markswoman you've encountered in your travels. {After she saved your life with an arrow into the heart of a would-be assassin, you hired the woman on the spot. | Learning of the woman was easy - you just had to find the winner of a local shooting competition. | She once won an archery contest that had over a hundred participants from all the lands. | It is said that she can split an arrow - mid-flight. | You found the woman on a farm where, obviously, you thought her shooting talents were going to waste. | A poacher, a bowyer, an archer, the woman's skills have gotten plenty of use. You suspect she readily accepted your offer for mercenary work just to say 'she's done it all'. | You once saw her shoot the moon, but that may have been some sort of trick. | A clever bowman, she once loosed two arrows simultaneously to kill a charging set of brigands.} While she has a fondness for killing from afar, %name%'s no slouch in close-quarters combat."
        ja = "%name%は、旅の中で出会った中でも指折りの射手だ。{暗殺を企てた者の心臓を矢で射抜いて命を救われ、あなたはその場で彼女を雇った。 | 彼女のことを知るのは簡単だった――地元の射撃大会の優勝者を探せばよかった。 | 各地から百人を超える参加者が集まった弓術大会で優勝したことがある。 | 飛んでいる矢を真っ二つにできるという。 | あなたは農場で彼女を見つけた。言うまでもなく、射撃の才を無駄にしていると思ったのだ。 | 密猟者、弓師、弓手と、彼女の腕はさまざまな形で使われてきた。「これで何もかも経験した」と言いたいがために、傭兵稼業への誘いを即座に受けたのではないかとあなたは疑っている。 | 彼女が月を射たのを見たことがあるが、何かの仕掛けだったのかもしれない。 | 巧みな弓手で、二本の矢を同時に放ち、突進してきた盗賊二人を仕留めたことがある。}遠くから殺すことを好むが、%name%は接近戦でも侮れない。"
    }
    {
        en = "%name% joined you after being exiled from %their% tribe in the north for refusing to kill %their% brother. They'll fight for you as well as for anyone."
        ja = "%name%は、%their%兄弟を殺すことを拒んだため、北方の%their%部族から追放されてあなたに加わった。誰のためであろうと戦うのと同じように、あなたのためにも戦うだろう。"
    }
    {
        en = "%name% left the collapsing company and returned to the village. Back in the militia, it wasn't long until {greenskins | raiders} attacked and the militia was called to action. It's said that %name% stood tall, rallying the defense while slaying through countless enemies before succumbing to mortal wounds. When you visited the village, you found children playfighting beneath a statue made in the %name%'s image."
        ja = "%name%は崩れゆく傭兵団を離れ、村へ戻った。民兵に復帰して間もなく{緑の肌を持つ者ども | 略奪者}が襲来し、民兵に招集がかかった。%name%は揺るがず立ち、数え切れない敵を斬り伏せながら守備隊を奮い立たせ、ついには致命傷に倒れたという。あなたが村を訪れると、%name%をかたどった像の下で子供たちが戦ごっこをしていた。"
    }
    {
        en = "%name% lives to fight the undead scourge. Little is known about %them% and %they% almost never talks save for the occasional grunt while swinging %their% sword. %Their% language seems to be codified into one simple structure: killing creatures of evil."
        ja = "%name%は不死者の災厄と戦うために生きている。%them%について知られていることはほとんどなく、%they%は%their%の剣を振るう時に時折うなるほか、まず口を開かない。%Their%の言葉は、ただ一つの単純な構文へと凝縮されているようだ。邪悪な怪物を殺すこと。"
    }
    {
        en = "%name% retired from the company and bought the deed to an abandoned castle. There she commands a troop of fellow beast slayers who journey the land protecting it from monsters. Last you spoke to her she had a raven-haired lady friend who did not take kindly to your presence, nor the presence of anyone else for that matter. You're sure she's happy."
        ja = "%name%は傭兵団を引退し、廃城の権利証を買い取った。そこで彼女は、各地を旅して怪物から人々を守る獣狩りの一隊を率いている。最後に話した時、彼女の傍らには黒髪の女友達がいた。あなたがいることも、他の誰かがいることも快く思っていなかったようだ。きっと彼女は幸せなのだろう。"
    }
    {
        en = "%name% specialized in forging exotic weapons for nobility — however their fighting style and skill tells you there is more to them than initially meets the eye, even if they don't want to talk about it."
        ja = "%name%は貴族向けの風変わりな武器を鍛えることを専門としていた。だが戦い方と腕前を見る限り、本人が話したがらなくとも、第一印象以上の何かを秘めている。"
    }
    {
        en = "%name% stayed for a little while longer with the company after your departure, then without notice they simply vanished from the company records entirely. Some say they were tired of what the company had become - obsessed with gold and trinkets and straying too far from what it was founded on."
        ja = "あなたが去った後も%name%はしばらく傭兵団に残ったが、ある日何の前触れもなく、団の記録から完全に姿を消した。傭兵団が金貨や装飾品に取り憑かれ、創設時の理念からあまりに遠く外れたことに嫌気が差したのだ、と言う者もいる。"
    }
    {
        en = "%name% stayed with the company a while longer after you left, eventually retiring to a quieter life. %They% settled in the mountains and discovered a hidden talent for raising wolves. %They% lived a long life separated from those %they% once hunted, surrounded by a new family of %their% own."
        ja = "あなたが去った後も%name%はしばらく傭兵団に残り、やがて静かな暮らしへ退いた。%They%は山中に住み着き、狼を育てる思わぬ才に気づいた。%They%は、かつて%they%が狩った者たちから離れ、自ら築いた新しい%their%家族に囲まれて、長い生涯を送った。"
    }
    {
        en = "%name% the Courser didn't wear its warwounds with as much pride and dignity one could have hoped, and one time when the horse encountered a knight in the city, it went wild and started bucking. When the knight himself was unhorsed in the commotion, there was no mercy. %name% was put down."
        ja = "軍馬の%name%は、期待されたほど誇り高く堂々と戦傷を受け止めなかった。ある時、町で騎士に出くわすと暴れ出し、跳ね回った。騒ぎで騎士本人まで落馬したとなれば、情けはかけられなかった。%name%は殺処分された。"
    }
    {
        en = "%name% the Courser was sold to a Lady of a Noble House as her coming-of-age present. Though its fighting skill dulled with age, it was well-loved and enjoyed the luxurious life of a Noble's steed."
        ja = "軍馬の%name%は、貴族家の令嬢への成人祝いとして売られた。年とともに戦いの技は鈍ったが、よく可愛がられ、貴族の乗騎として贅沢な暮らしを楽しんだ。"
    }
    {
        en = "%name% the blacksmith was a strong and capable sellsword in the %companyname%. He held out until the bitter end, sticking with the company as it lurched from one disaster to the next. Perhaps, had he been born in a different time he would have gone on to do great things, making legendary weapons for regal kings. Instead, many wars, invasions, and plagues spreading across the land ultimately ensured %name% and many other talented men went to total waste."
        ja = "鍛冶屋の%name%は、%companyname%で屈強かつ有能な傭兵だった。彼は最後の最後まで踏みとどまり、傭兵団が災難から次の災難へとよろめく間も離れなかった。別の時代に生まれていれば、偉大な王のために伝説の武器を作るほどの人物になったかもしれない。しかし実際には、各地に広がる幾多の戦争、侵略、疫病によって、%name%をはじめ多くの才ある男たちは何も成さぬまま失われた。"
    }
    {
        en = "%name% the blacksmith was a strong and capable sellsword in the %companyname%. She held out until the bitter end, sticking with the company as it lurched from one disaster to the next. Perhaps, had she been born in a different time she would have gone on to do great things, making legendary weapons for regal kings. Instead, many wars, invasions, and plagues spreading across the land ultimately ensured %name% and many other talented women went to total waste."
        ja = "鍛冶屋の%name%は、%companyname%で屈強かつ有能な傭兵だった。彼女は最後の最後まで踏みとどまり、傭兵団が災難から次の災難へとよろめく間も離れなかった。別の時代に生まれていれば、偉大な王のために伝説の武器を作るほどの人物になったかもしれない。しかし実際には、各地に広がる幾多の戦争、侵略、疫病によって、%name%をはじめ多くの才ある女たちは何も成さぬまま失われた。"
    }
    {
        en = "%name% the donkey retired to a lovely green paddock. They spend their days loafing about and eating carrots fed to them by local children."
        ja = "ロバの%name%は、青々とした心地よい放牧地へ引退した。地元の子供たちにもらったニンジンを食べ、のんびりと日々を過ごしている。"
    }
    {
        en = "%name% the donkey was sold to a foul-tempered trader who did not spare the rod. Their caravan was attacked by orcs and the remains of %name% were never found."
        ja = "ロバの%name%は、鞭を惜しまない気難しい商人に売られた。その隊商はオークに襲われ、%name%の亡骸はついに見つからなかった。"
    }
    {
        en = "%name% the herbalist left to start an Apothecary in the wetlands, business is good and remedies abound. Last you heard %name% had discovered a cure for bunions and people traveled from far and wide to try the soup"
        ja = "薬草師の%name%は湿地で薬舗を開くために去った。商売は繁盛し、治療薬にも事欠かない。最後に聞いた話では、%name%は外反母趾の治療法を発見し、そのスープを試すため各地から人が訪れているという。"
    }
    {
        en = "%name% the horse was retired to a lovely paddock and spent the days eating and carousing with other horses."
        ja = "馬の%name%は心地よい放牧地へ引退し、ほかの馬たちと食べ、戯れながら日々を過ごした。"
    }
    {
        en = "%name% the horse was sold to a trader, their caravan was attacked by orcs and the remains of %name% were never found"
        ja = "馬の%name%は商人に売られた。その隊商はオークに襲われ、%name%の亡骸はついに見つからなかった。"
    }
    {
        en = "%name% the ironmonger stayed with the %companyname% for some time after your departure, but after a particularly nasty stretch of bad luck %they% saw the rot for what it was and jumped ship. Bad luck seemed to follow %them%, however, and %they% never managed to settle down. He burned through his leftover crowns in a few years. He died in poverty one winter, freezing overnight."
        ja = "あなたが去った後も、金物商の%name%はしばらく%companyname%に残った。だが、ひときわひどい不運が続くと、%they%は腐敗の正体を見抜いて団を見限った。それでも不運は%them%につきまとい、%they%はついに身を落ち着けられなかった。残ったクラウンも数年で使い果たし、ある冬、貧困のうちに凍死した。"
    }
    {
        en = "%name% took what they had learned from their time in the company and headed north with the intention of getting as far away from the south as possible. They found good work and few questions awaiting them at a northern settlement in the tundra where they quickly rose the ranks of the local militia to become captain."
        ja = "%name%は傭兵団で学んだことを携え、南からできるだけ遠ざかるため北へ向かった。ツンドラの北方集落では、余計な詮索をされずに済むよい仕事が待っていた。地元民兵の階級をたちまち駆け上がり、隊長となった。"
    }
    {
        en = "%name% utilizes %their% armor's blend of protection and mobility to deal increased damage and gain increased accuracy when foes miss attacks against %them%."
        ja = "%name%は%their%防具がもたらす防護と機動性を活かす。敵が%them%への攻撃を外すたび、近接ダメージと近接技能が高まる。"
    }
    {
        en = "%name% was 'hired' by you from an old man in a tall tower"
        ja = "あなたは高い塔に住む老人から、%name%を「雇った」"
    }
    {
        en = "%name% was 'saved' by you during a confrontation with an animal tamer-turned-enslaver. A sense of gratitude and debt overcomes any language barriers: the once imprisoned wildling serves the company loyally for the rescue."
        ja = "%name%は、獣使いから奴隷商へ転じた者との対決で、あなたに「救われた」。感謝と恩義は言葉の壁を越え、かつて囚われていた野人は救出の恩に報いるため傭兵団へ忠実に仕えている。"
    }
    {
        en = "%name% was 'saved' by you from a death sentence. Recruiting this savage barbarian has put you in bad terms with the nobles of the north."
        ja = "%name%は、あなたによって死刑から「救われた」。この獰猛な蛮族を雇ったことで、北方の貴族たちとの関係は悪化した。"
    }
    {
        en = "%name% was 'saved' by you from execution. You decided that this killing machine is a worthy acquisition, ignoring the fact it is also the most wanted criminal in the north."
        ja = "%name%は、あなたによって処刑から「救われた」。北方一のお尋ね者でもあるという事実には目をつぶり、この殺戮機械を有用な戦力として迎え入れた。"
    }
    {
        en = "%name% was a misfit from the start, their lack of skill on the battlefield held them back compared to their stronger mercenary counterparts. Their journey ironically ended not on the battlefield but instead in their workshop, which stands only as a charred ruin."
        ja = "%name%は初めからはみ出し者だった。戦場での技量不足により、より屈強な傭兵たちに後れを取った。皮肉にもその旅は戦場ではなく、焼け落ちた廃墟だけが残る自らの工房で終わった。"
    }
    {
        en = "%name% was a quick learner, but not qucker than the arrows, bolts, shrapnel and other assortment of dangers on the battlefield. After you left, %they% steadily accumulated injury after injury. Interrupted by expermintation on themselves to restore their mind and body. After one injury too many, they drank every mixture they could prepare to numb the pain. It worked, but not as %they% intended..."
        ja = "%name%は物覚えが早かったが、矢やボルト、榴散弾をはじめ戦場に満ちる危険ほど速くはなかった。あなたが去った後、%they%は次々と負傷を重ねた。その合間に、心身を元へ戻そうと自分自身で実験を続けた。ひとつ負傷が多すぎた時、痛みを消すため、調合できる薬をすべて飲み干した。効き目はあった。ただし、%they%が意図した形ではなかった……。"
    }
    {
        en = "%name% was a quick learner, but the divergence from theroy to practice posed great difficulty. Although they did not now it, %they% struggled keeping pace with %companyname% and left shortly after you did. On their first night they found shelter from the elements in what they thought was an old cave - only to find out too late that it was a safe haven for hemovores."
        ja = "%name%は物覚えが早かったが、理論と実践の隔たりにひどく苦しんだ。自覚はなかったものの、%they%は%companyname%についていけず、あなたの後を追うように団を去った。最初の夜、風雨を避けて古い洞窟らしき場所へ入ったが、そこが吸血種の隠れ家だと気づいた時には遅すぎた。"
    }
    {
        en = "%name% went off to become a herbalist again, but the cures didn't work and they soon got a reputation as a quack. Looking for more potent cures, %name% poisoned %themselves% and never recovered."
        ja = "%name%は再び薬草師になるため去ったが、治療薬は効かず、ほどなく藪医者の評判が立った。もっと強い薬を求めた%name%は%themselves%を毒し、二度と回復しなかった。"
    }
    {
        en = "%name% went off to join another mercanry company in a large city somewhere. They travelled with what is said to be a witch hunter and a small boy. What became of %name% is unknown at that point - some say they were killed... or worse."
        ja = "%name%はどこかの大都市で別の傭兵団に加わった。魔女狩りと幼い少年と旅をしていたという。その後%name%がどうなったかは分からない――殺されたとも……それよりひどい目に遭ったとも言われる。"
    }
    {
        en = "%name% will move safely through any Zone of Control without incurring any free attacks and the first attack done against you will be automatically evaded. Can only be used if your total armor weight is 30 or less."
        ja = "%name%は、機会攻撃を受けることなく、あらゆる支配領域を安全に通過する。また、自分に対して行われる最初の攻撃を自動的に回避する。防具の総重量が30以下の場合にのみ使用できる。"
    }
    {
        en = "%nemesisviziername% has a long memory for grudges. You knew this, having dealt with his manhunters before, but somehow you never expected him to go so far as to hire assassins to hunt you down! You order the company to defend themselves as cloaked figures menacingly advance upon you from all directions..."
        ja = "%nemesisviziername%は恨みを長く忘れない。以前に人狩りどもとやり合ったのだから分かっていた。だが暗殺者まで雇って追わせるとは思わなかった！　外套姿の者たちが四方から不気味に迫り、あなたは傭兵団に迎撃を命じる……。"
    }
    {
        en = "%oldguard% shows little mercy and has the mercenaries running again and again in the days to come. After all, %oldguard% says, it's for their own damn good."
        ja = "%oldguard%は容赦せず、それから何日も傭兵たちを何度も走らせた。結局のところ、%oldguard%が言うには、全部あいつら自身のためなのだ。"
    }
    {
        en = "%peddler% has a business proposal"
        ja = "%peddler%から商談がある"
    }
    {
        en = "%recovered% turns to you.%SPEECH_ON%It feels good, cap'n.%SPEECH_OFF%"
        ja = "%recovered%があなたを振り返る。%SPEECH_ON%気分がいいぜ、隊長。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%As you approach the drunkard, a sharp whistle cracks across the path. You and the drunkard both look to see %thief% the thief standing there with a weapon to the back of another man.%SPEECH_ON%That feller's no nobleman, and probably ain't no drunk neither. They're working together to either ambush travelers or threaten them with blackmail. They're robbers, sir.%SPEECH_OFF%You look back to see the man smiling nervously. He explains with suddenly sharpened clarity.%SPEECH_ON%We'd no interest in robbing sellswords, sir, I-I-I swear I was about to explain myself soon as I saw yer swords.%SPEECH_OFF%%thief% yells out, asking where the cache is. You look back at the man and tell him to hand over everything he's stolen. He nods and asks if you'll gut him if he refuses. You nod and tell him the gutting will come last, and by that point it'll be a relief. The man puts a little pep in his step.%SPEECH_ON%Yessir gotcha sir, right this way.%SPEECH_OFF%"
        ja = "%terrainImage%酔漢へ近づくと、鋭い口笛が道に響く。あなたと酔漢が振り向くと、盗賊の%thief%が、別の男の背に武器を突きつけて立っている。%SPEECH_ON%あいつは貴族でもなけりゃ、たぶん酔ってもいない。二人で旅人を待ち伏せするか、脅して金を取ってる強盗だ、隊長。%SPEECH_OFF%男を見ると、引きつった笑みを浮かべ、急に明瞭な口調で弁明する。%SPEECH_ON%売剣から奪う気はなかったんです、旦那。ほ、本当です。剣を見たらすぐ説明しようと思ってました。%SPEECH_OFF%%thief%は隠し場所を問いただす。あなたは男に、盗んだ物をすべて渡せと言う。拒めば腹を裂くのかと尋ねるので頷き、腹裂きは最後だから、その頃にはむしろ楽になると答える。男の足取りがきびきびし始める。%SPEECH_ON%へい旦那、分かりました。こっちです。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%As you approach the drunkard, he immediately recognizes %noble% and runs up sobbing. %SPEECH_ON%Cousin! Oh my gentile and cultured cousin, my favorite second cousin, you would not believe the outrageous injustice perpetrated against one's self!%SPEECH_OFF%You look on skeptically as the obviously drunken and slightly bedraggled nobleman continues.%SPEECH_ON%I was due to be wed you see, to the love of my life. It was to the richest, wealthiest, prosperous, bountiful, most affluent, most.. well endowed..%SPEECH_OFF% The noble's mind wanders off, as if in fantasy. You prompt again and the speech continues somewhat more deflated.%SPEECH_ON%Alas it was not to be, they discovered that {I am not a marquess from the border lands but only a viscount heir | My winnings at the table were not as grand as perhaps I had let on | my horrible father disowned me for having too much fun with wine and women}. They turned me out on the road, perhaps I could come on a travelling adventure with you? %SPEECH_OFF%"
        ja = "%terrainImage%酔漢へ近づくと、男はすぐに%noble%を見つけ、泣きながら駆け寄る。%SPEECH_ON%従兄殿！　おお、優雅で教養ある従兄殿、私の最愛の又従兄よ！　この身に降りかかった常軌を逸した不正を信じられまい！%SPEECH_OFF%明らかに酔い、少しくたびれた貴族の話を疑わしげに聞く。%SPEECH_ON%私は生涯の恋人と結婚するはずだった。最も金持ちで、裕福で、栄え、実り豊かで、富み……その、豊満な……%SPEECH_OFF%貴族の思考は妄想へ漂っていく。先を促すと、少し萎れた声で続ける。%SPEECH_ON%だが叶わなかった。連中は{私が辺境伯ではなく、子爵の跡取りにすぎないことを知った | 賭場での勝ち分が、私の語ったほど大きくないと知った | ひどい父が、酒と女を楽しみすぎた私を勘当したことを知った}のだ。道へ追い出された。君たちと旅の冒険へ出てもよいだろうか？%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%While heading toward your destination, %volunteer% runs up to you with a bundle of herbs in hand. Now you know this fool knows nothing about plants or wildlife, but %they_volunteer% seems rather persistent in wanting to try them out. Something about 'hearing' of magical powers to be found in the essence of herbs. This talk gets the attention of a few others in the company. Soon, a number of them are asking to try out the 'medicine' for the good of their brothers."
        ja = "%terrainImage%目的地へ向かう途中、%volunteer%が薬草の束を手に駆け寄ってくる。この愚か者が植物や野生生物を何も知らないことは承知しているが、%they_volunteer%はどうしても試したがっている。薬草の精髄には魔法の力があると「聞いた」らしい。その話に傭兵団の何人かも興味を示す。やがて多くの者が、団員のために「薬」を試したいと言い始める。"
    }
    {
        en = "%terrainImage%You take out your blade and cut the man down. He crumples onto his shoulders and splays out, his lashed back in the dirt. The soil may as well have been salt judging by his wailing. One of the whippers stands up.%SPEECH_ON%Hey, just what do you think you're doing? We ain't finished here!%SPEECH_OFF%%randombrother% draws %their_randombrother% weapon and the man backs off. The horse owner spits and shakes his head.%SPEECH_ON%Are you really going to defend this piece of work? Ain't that some fucking horseshit. I guess now I can say I've seen it all which is exactly what I said when I caught this bastard porkin' my dead horse!%SPEECH_OFF%The man catches his breath then points at the recently rescued.%SPEECH_ON%I hope you die on your first day out ya filly fiddling bastard.%SPEECH_OFF%"
        ja = "%terrainImage%刃を抜き、男を斬り倒す。男は肩から崩れ、鞭打たれた背を土へ広げた。苦鳴を聞く限り、土が塩でも撒かれているようだ。鞭を持つ一人が立ち上がる。%SPEECH_ON%おい、何のつもりだ？　まだ終わってねえぞ！%SPEECH_OFF%%randombrother%が%their_randombrother%武器を抜くと、男は退く。馬の持ち主は唾を吐き、首を振る。%SPEECH_ON%本気でこのろくでなしを庇うのか？　とんだ馬糞だ。死んだ俺の馬とヤッてるこいつを捕まえたときにも、もう何でも見たと思ったがな！%SPEECH_OFF%男は息を整え、救われたばかりの者を指す。%SPEECH_ON%雌馬いじりのクソ野郎、初日に死んじまえ。%SPEECH_OFF%"
    }
    {
        en = "%terrainImage%{%athlete% steps forward. %Their_athletic% calves bulge from %their_athletic% socks and %they_athletic% shoulder rolls to loosen up.%SPEECH_ON%Yeah I'll race that sorry horse.%SPEECH_OFF%The wager is made and the horse's owner directs you to a path. With the race set up, he holds up a pair of wooden tongs held apart, and backwards, by some tine. When he cuts the rope, the tongs snap clap together and start the race. Despite being looking like a wart left in the rain, the horse instantly gets a step on the nimble sellsword. It's only halfway down the track does the mercenary's stamina seem to put %them_athletic% back in the race, but %they_athletic% ultimately fails at the finish line. The owner claps his hands.%SPEECH_ON%Oh, that was a close one! The closest I've seen!%SPEECH_OFF%You nod and pay the man what he is owed. %athlete% was beaten, but despite that it seems the loss has bettered %them_athletic% in some regard and the company certainly enjoyed the spectacle.}"
        ja = "%terrainImage%{%athlete%が進み出る。%Their_athletic%ふくらはぎは%their_athletic%靴下の上から盛り上がり、%they_athletic%は肩を回してほぐす。%SPEECH_ON%あの哀れな馬と競走してやる。%SPEECH_OFF%賭けが成立し、馬主が道を示す。準備が整うと、男は二本の木製の鋏を歯の部分で逆向きに開き、持ち上げる。縄を切ると鋏がぱちんと閉じ、競走が始まった。雨ざらしの疣のような馬だが、機敏な売剣より即座に一歩先へ出る。道程の半ばになってようやく、傭兵の持久力で%them_athletic%が追いつき始めるが、%they_athletic%は最後に決勝線で競り負ける。馬主が手を叩く。%SPEECH_ON%おお、惜しかった！　これまでで一番の接戦だ！%SPEECH_OFF%あなたは頷き、男へ支払う。%athlete%は負けたが、この敗北は%them_athletic%をいくらか成長させ、傭兵団も見世物を大いに楽しんだようだ。}"
    }
    {
        en = "%terrainImage%{%chosen% confidently walks up toward the tree and the bees seem shunted away by %their_dude% very presence. The noise of their fluttering thickens with angry vibrations, but otherwise they take no further offense. %They_dude% carefully scoops some of the honey into a jar and then eases back and steps away. %They_dude% returns to the company.%SPEECH_ON%Easy peasy beehive squeezy, lads.%SPEECH_OFF%}"
        ja = "%terrainImage%{%chosen%が自信満々に木へ近づくと、%their_dude%存在そのものに押し退けられるかのように蜂が離れていく。羽音は怒りを帯びて濃くなるが、それ以上は襲ってこない。%They_dude%は慎重に蜂蜜を壺へ掬い、ゆっくり後退して離れる。%They_dude%が傭兵団へ戻る。%SPEECH_ON%朝飯前の蜂蜜取りだ、みんな。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%chosen% laces %their_dude% fingers and cracks the knuckles with a long stretch.%SPEECH_ON%Like stealing candy from a baby.%SPEECH_OFF%%They_dude% walks up to the tree and stands beneath the hive. %They_dude% poses and points up at it, laughs, then turns %their_dude% hands up and - much to the shock of everyone - just grabs the entire beehive. The bees instantly swarm the sellsword and %they_dude% drops the hive and sprints away, a cloud of angry buzzing chasing %them_dude% down a sand dune. %They_dude% rolls and rolls, %their_dude% screams issuing out whenever %they_dude% flies out of the sand, and then %they_dude% lands at the bottom and a wash of sand covers %them_dude% and spares %them_dude% from further bee stings. You wait a while before retrieving %them_dude%, lest the bees know your hand in this attempted thievery.}"
        ja = "%terrainImage%{%chosen%は%their_dude%指を組み、長く伸びをしながら関節を鳴らす。%SPEECH_ON%赤ん坊から菓子を取り上げるようなもんだ。%SPEECH_OFF%%They_dude%は木へ歩き、巣の真下に立つ。%They_dude%は格好をつけて巣を指し、笑い、それから%their_dude%両手を上に向け――皆が驚く中――蜂の巣を丸ごと掴んだ。蜂は即座に売剣へ群がり、%they_dude%は巣を落として駆け出す。怒った羽音の雲が砂丘を下る%them_dude%を追う。%They_dude%は転がり続け、砂から跳ね上がるたび%their_dude%悲鳴が響く。%they_dude%が麓へ落ちると、%they_dude%は砂を浴びて埋もれ、%them_dude%はそれ以上刺されずに済んだ。盗みを企んだ仲間だと蜂に悟られぬよう、しばらく待ってから%them_dude%のもとへ行き、%them_dude%を回収する。}"
    }
    {
        en = "%terrainImage%{%houndman% steps forward.%SPEECH_ON%I know this breed. It is of northern stock, a sturdy creature. There is one thing it shall respect in a pack leader and it is strength.%SPEECH_OFF%The sellsword crouches before the dog and without pause puts its hands around the scuff of its neck and starts to scratch. Despite the sudden movements, the dog responds positively and when the mercenary stops scratching the dog lifts up off the ground and lopes forward and follows the dog whisperer. %houndman% stares back at you and roughs the dog up with some heavy petting.%SPEECH_ON%Yeah he'll fight for us. Fightin' is what he's made for. He just needed someone to watch him rip and tear.%SPEECH_OFF%What a lovely creature this is. And the dog is fine, too.}"
        ja = "%terrainImage%{%houndman%が進み出る。%SPEECH_ON%この犬種は知っている。北方の血を引く頑丈な犬だ。群れの長に求めるものは一つ、力だ。%SPEECH_OFF%売剣は犬の前にしゃがみ、ためらわず首の皮を掴んで掻き始める。突然の動きにも犬は喜び、傭兵が手を止めると立ち上がって前へ走り、犬使いについていく。%houndman%は振り返り、荒っぽく撫で回す。%SPEECH_ON%ああ、こいつは俺たちのために戦う。戦うために生まれたんだ。引き裂くところを見てくれる奴が必要だっただけさ。%SPEECH_OFF%何と愛らしい生き物だろう。犬のほうも悪くない。}"
    }
    {
        en = "%terrainImage%{%lucky% the ever lucky sellsword has managed to find something interesting. You ask how %they_lucky% came across the item. %They_lucky% shrugs.%SPEECH_ON%{I was walking, and then I stepped on it. Simple enough. | I looked up and this bird shat and it just missed me. When I looked at where it landed, well, there it was. The bird shit and that thing you got in your hands. | Felt a tingle in my fingers, and then a tingle in my crotch. After that I got to looking around for somethin' boring to absolve myself and saw it just settin' there. | Saw a horseshoe just layin' on the ground there and thought to go and fetch it and, well, that was underneath. | Well, see, I saw this four-leaf clover just setting there and I was gonna add it to my bag, see, I got dozens, anyway when I went to go pick it up I saw that item just settin' there. Pretty nifty, huh?}%SPEECH_OFF%}"
        ja = "%terrainImage%{いつも運のよい売剣%lucky%が、面白い物を見つけた。どうやって見つけたのか尋ねると、%they_lucky%は肩をすくめる。%They_lucky%が答える。%SPEECH_ON%{歩いてたら踏んだ。それだけだ。 | 上を見たら鳥が糞をして、俺には当たらなかった。落ちた所を見たら、まあ、そこにあった。鳥の糞と、あんたが手にしてるそれがな。 | 指先がむずむずして、それから股間もむずむずした。気を紛らわせる退屈な何かを探してたら、そこに置いてあった。 | 地面に蹄鉄が落ちてたから拾おうと思ったら、まあ、その下にあった。 | 四つ葉のクローバーが生えてたから袋に足そうと思ったんだ。ほら、何十本も持ってる。で、摘もうとしたら、その品がそこにあった。いいだろ？}%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{%tailor% the tailor rubs their chin with two fingers before finally pointing them forward.%SPEECH_ON%I've got it. Comrades, give me every scrap of unused or trashy clothing you have. Every article you got. Hand it over. There you go. Yes, that's absolutely trash, %otherbrother%. Your favorite shirt? By the gods, just give it to me already. Thank you.%SPEECH_OFF%The tailor collects armfuls of discarded clothing and gets to work with scissors. %tailor% slices and dices and pauses. %tailor% pauses a lot, always unsure of the work. But finally the results are presented. A pile of fresh socks and enough left over scraps to furnish some extra bandages. %tailor%'s also wearing a surprisingly flashy new garb, and you've no idea how it was created.}"
        ja = "%terrainImage%{仕立屋の%tailor%は二本の指で顎を撫で、ついに前へ突き出す。%SPEECH_ON%思いついた。仲間たち、使っていない服やぼろ服を一切合切よこせ。全部だ。そう、それだ。よし。ああ、それは完全なぼろだ、%otherbrother%。お気に入りのシャツ？　神々にかけて、さっさとよこせ。ありがとう。%SPEECH_OFF%仕立屋は捨てられた衣服を両腕いっぱい集め、鋏で作業を始める。%tailor%は切り刻み、手を止める。%tailor%は自信がないのか何度も止まる。だがついに成果が示された。新品の靴下の山と、追加の包帯を作れるだけの端切れだ。%tailor%自身も驚くほど派手な新しい服を着ているが、どう作ったのか皆目分からない。}"
    }
    {
        en = "%terrainImage%{%thief% the thief sidles up to you. Stepping away and putting your hands in your pockets, you ask what they want. The shady character smirks and answers.%SPEECH_ON%Alright I'll be honest with you captain. Last time we stopped in town I helped myself to a blind peacemaker's wares. What? I'd a sore tooth. No reason to pay to fix what the old gods gave me. Anyway, I fixed my tooth. See? What a smile, right? But then I thought I felt some aches, man, aches all over the place! So I visited the peacemaker again and...%SPEECH_OFF%You interrupt the man and ask just how much was stolen. The answer comes in the form of a sack of medicinal goods. The thief proudly puts hands on hips and stares out at the world with a crooked grin.%SPEECH_ON%Suffice it to say I ain't hurtin' no more.%SPEECH_OFF%} "
        ja = "%terrainImage%{盗賊の%thief%がすり寄ってくる。距離を取り、両手を懐に入れ、何の用か尋ねる。胡散臭い人物は薄笑いして答える。%SPEECH_ON%正直に言うぜ、隊長。前に町へ寄ったとき、目の見えない治療師の品をちょいと頂いた。何だよ？　歯が痛かったんだ。古き神々から授かったものを治すのに金を払う理由はねえ。ともかく歯は治した。見ろ、この笑顔だ。だが今度はあちこち痛む気がしてきた！　だからまた治療師の所へ行って……%SPEECH_OFF%遮って、いったいどれだけ盗んだのか尋ねる。答えは薬品の詰まった袋だった。盗賊は得意げに腰へ手を当て、歪んだ笑みで世を眺める。%SPEECH_ON%もうどこも痛くねえ、とだけ言っとく。%SPEECH_OFF%} "
    }
    {
        en = "%terrainImage%{Feeling rather courageous, you nominate the fattest %person_fat% in the company to handle the race. %fat% steps forward with an eyebrow raised, asking if you're sure about taking %them_fat% as your horseracing champion. You hold your hand on %their_fat% shoulder and say %they're_fat% the fattest fark you've ever seen being a sellsword, but that you believe in %them_fat%. You also believe the horse is a haggard draught animal that's on its last legs, but you keep that part to yourself.\n\n The %person_fat% and horse are put next to each other. An apple tree stands in the distance and the first to it is the winner. With the rules laid out, the race is started. It's not an especially close one. %fat% falls behind almost instantly and trundles down the track with %their_fat% face beet red and huffing breath and the men nearly die laughing at the sight. The fat sellsword and dire horse meet back up at the apple tree and there share the fruits of their labors. You pay the horse's owner what he is owed. He smiles as he counts the coin.%SPEECH_ON%Don't usually get a show with the race, sir.%SPEECH_OFF%}"
        ja = "%terrainImage%{妙に勇気が湧き、傭兵団で最も太った%person_fat%を競走へ出す。%fat%は眉を上げ、%them_fat%を競走の代表に選んで本気かと尋ねる。%their_fat%肩に手を置き、%they're_fat%売剣として生きてきた中で最も太ったクソ野郎だが、%them_fat%を信じていると言う。馬も老いぼれた駄馬で死にかけていると信じているが、それは胸にしまう。\n\n %person_fat%と馬が並ぶ。遠くに林檎の木があり、先に着けば勝ちだ。規則を説明し、競走が始まる。接戦ではない。%fat%はすぐ遅れ、%their_fat%顔を真っ赤にして喘ぎながら道をどたどた進む。男たちは見て笑い死にしそうだ。太った売剣と見るも恐ろしい馬は林檎の木で合流し、労働の果実を分け合う。馬主へ支払うと、男は硬貨を数えながら笑う。%SPEECH_ON%競走で見世物まで見られることは滅多にない、旦那。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Marching all around the world has put some wear and tear on your sellswords. Whenever a mercenary takes off a boot you can see the blood seeping through the sock. They've accumulated sores and boils. One peels the flesh off a toe and instantly barks their regret, and you nod. All in all, this is the price to pay for being on the road so much.}"
        ja = "%terrainImage%{世界中を行軍したせいで、売剣たちの身体はすっかり傷んでいる。傭兵が長靴を脱ぐたび、靴下から血が滲む。擦り傷と腫れ物だらけだ。ある者が足指の皮を剥き、即座に後悔を叫ぶので、あなたは頷く。結局、これが長く街道を歩く代償なのだ。}"
    }
    {
        en = "%terrainImage%{The nearly frozen %person_dude% joins the company. %They're_dude% a ragged wreck, but if what %they_dude% said is true maybe %they_dude% will someday become the fighter %they_dude% could barely speak of.}"
        ja = "%terrainImage%{凍えかけた%person_dude%が傭兵団へ加わる。%They're_dude%見るも哀れな有様だが、%they_dude%の話が本当なら、いつか%they_dude%が口にするのもやっとだった戦士へ%they_dude%はなれるかもしれない。}"
    }
    {
        en = "%terrainImage%{The next stop ain't far. You hope the mercenaries can keep it together until they get there. What bandages you have are applied as necessary.}"
        ja = "%terrainImage%{次の休息地は遠くない。そこまで傭兵たちが持ちこたえることを願う。手持ちの包帯を必要に応じて巻く。}"
    }
    {
        en = "%terrainImage%{The snowy wastes are home to not much of anything, so to find someone half-naked in its frigid geography is rather unusual. That the frozen figure is actually alive even more so. You crouch beside the frigid body, their eyes are hollow and rime frosts make blinking them a struggle, lips are jagged and purple and nose a deep red bordering on black. You ask if the pitiful wretch can speak, and are greeted with nods.%SPEECH_ON%Barbarians. Took. Me.%SPEECH_OFF%You ask where the kidnappers are, the figure shrugs and continues the cold cadence.%SPEECH_ON%They. Got. Bored. And. Left.%SPEECH_OFF%It does seem in tune with the primitives to up and leave a prisoner in the ice. The shivering prisoner explains they were once a sturdy swordfighter. A smile squeezes through the pain.%SPEECH_ON%A. King's. Guard. In. The. Kingless. Land. Things. Could. Be. Worse?%SPEECH_OFF%}"
        ja = "%terrainImage%{雪の荒野にはほとんど何もいない。そんな凍てつく土地で半裸の者を見つけるだけでも珍しい。凍りついた人影がまだ生きているなら、なおさらだ。冷え切った身体の横にしゃがむ。目は虚ろで、霜に覆われ瞬きすら難しい。唇は裂けて紫色、鼻は黒くなりかけた深紅だ。話せるかと尋ねると、頷きが返る。%SPEECH_ON%蛮族。俺を。捕えた。%SPEECH_OFF%誘拐者はどこかと尋ねると、人影は肩をすくめ、凍えた調子で続ける。%SPEECH_ON%飽きた。置いて。いった。%SPEECH_OFF%未開人が囚人を氷上に放り出すのはいかにもありそうだ。震える囚人は、かつて腕利きの剣士だったと説明する。苦痛の中から笑みを絞り出す。%SPEECH_ON%王なき国の。王の護衛。これより。悪いことが。あるか？%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Unlike the south, finding travelers on the northern 'roads' is often a cause for caution. You never know what monstrous man or beastly barbarian you'll come across next. This time it is a large %person_dude% limping with a dog beside %them_dude%. You draw your sword halfway out of its sheath and loud enough to gain %their_dude% ear. The %person_dude% looks up and %their_dude% dog rears to the sudden yank of a leash. The northerner can speak a bit of your tongue.%SPEECH_ON%Ahh, fighters. I'm a fighter myself.%SPEECH_OFF%You ask why %they_dude% is alone. %They_dude% explains that %their_dude% clan had a dispute, and that %they_dude% was to duel another man to decide who would take control. You ask why %they_dude% did not duel this man, you ask if %they_dude% is afraid. The traveler shakes %their_dude% head.%SPEECH_ON%No. The clansman was my brother. And I'd no desire to kill kin. They gave me this bitch here as both insult and reward and threw me from the tribe. I've no land or people to go to, but if you'd have me, I'd surely fight for you just as well as anyone else.%SPEECH_OFF%}"
        ja = "%terrainImage%{南方と違い、北方の「街道」で旅人を見つけたら警戒すべきことが多い。次にどんな怪人や獣のような蛮族に出会うか分からない。今回は足を引きずる大柄な%person_dude%で、%them_dude%の傍らには犬がいる。剣を鞘から半ば抜き、%their_dude%耳に届くほど大きな音を立てる。%person_dude%が顔を上げ、%their_dude%犬は急に引かれた綱へ身を起こす。北方人はあなたの言葉を少し話せる。%SPEECH_ON%ああ、戦士か。俺も戦士だ。%SPEECH_OFF%なぜ独りなのか%they_dude%へ尋ねる。%They_dude%によれば、%their_dude%氏族で争いがあり、誰が支配するか決めるため、%they_dude%は別の男と決闘することになったという。なぜ%they_dude%は戦わなかったのか、%they_dude%は怖かったのかと問う。旅人は%their_dude%首を振る。%SPEECH_ON%違う。相手は兄弟だった。血族を殺す気はなかった。この雌犬を侮辱と褒美を兼ねて渡され、部族から追われた。行く土地も民もない。受け入れてくれるなら、誰にも劣らずあんたのために戦う。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{Walking, running, fighting, fucking, all good for a man's heart. The time spent traveling the land has improved the vitality and vigor of the mercenaries. You even caught one of the cheekier mercenaries flexing into pondwater, admiring %their_dude% own reflection like some a vain noble. | All this running about the land has increased the stamina of the mercenaries. One runs in place, holding a finger to %their_dude% neck. %They_dude% remarks that %their_dude% heart rate isn't going up at all. Another brother remarks that the sellsword doesn't even know how to count. The running %person_dude% pauses.%SPEECH_ON%Oh. That's right.%SPEECH_OFF%}"
        ja = "%terrainImage%{歩く、走る、戦う、女とやる。どれも男の心臓にはよい。各地を旅した歳月が傭兵たちの活力と精力を高めた。生意気な一人が池の水に向かって力こぶを作り、気取った貴族のように%their_dude%姿を眺めているところまで見た。 | 各地を走り回ったおかげで、傭兵たちの持久力が増した。一人がその場で走り、指を%their_dude%首に当てる。%They_dude%は%their_dude%心拍がまるで上がっていないと言う。別の団員が、その売剣は数え方すら知らないと指摘する。走る%person_dude%が止まる。%SPEECH_ON%ああ、そうだった。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{When it comes to walking the earth, %travelbro% is longer in the tooth than anyone and laughs at the plight of fellow sellswords.%SPEECH_ON%Ah, now this is what I'm talking about! Nevermind the pain, folks, embrace the soreness!%SPEECH_OFF%The company collectively tells %travelbro% to stuff it, but the traveller happily wiggles toes around. You didn't even realize %travelbro%'s boots were off before that, those feet are so calloused you thought the bony figures but folds of leather!}"
        ja = "%terrainImage%{大地を歩くことなら、%travelbro%は誰より年季が入り、仲間の売剣たちの苦境を笑う。%SPEECH_ON%ああ、これだ！　痛みは気にするな、みんな。身体の痛みを受け入れろ！%SPEECH_OFF%傭兵団は声を揃えて%travelbro%に黙れと言うが、旅人は嬉しそうに足指を動かす。%travelbro%が長靴を脱いでいたことにさえ気づかなかった。足はあまりに硬く、骨張った形を革の襞だと思っていたのだ！}"
    }
    {
        en = "%terrainImage%{While on the march, you find a drunken nobleman tottering side to side on the path. Mussy is the name of his hair, leaves and grass and what looks like birdshit swept up in it like someone stirred the ingredients to a prank. But his clothes sweep about with the finest of silks and his fingers glisten with jewelry. He has a bottle in each hand and he swings them around as he sings gibberish pub songs.\n\nHe is in all regards the greatest magnet for a mugging you've ever seen. %randombrother% purses lips and looks like a wolf staring at a fat sheep.%SPEECH_ON%I'm not saying nothing, sir, I'm just. I'm just seeing it. That's a lot of juice. A lot of juice limping down the road. But again I ain't saying nothing.%SPEECH_OFF%You know what the sellsword's talking about.}"
        ja = "%terrainImage%{行軍中、道で酔った貴族が左右にふらついているのを見つける。髪は「乱雑」と呼ぶほかなく、葉や草、鳥の糞らしきものまで、悪戯の材料を混ぜたように絡まっている。だが服は上等な絹で揺れ、指は宝石で輝く。両手に瓶を持ち、意味不明な酒場歌を歌いながら振り回している。\n\nあらゆる意味で、あなたが見た中で最も追い剥ぎを引き寄せそうな男だ。%randombrother%は唇をすぼめ、太った羊を見る狼のような目をする。%SPEECH_ON%何も言ってませんぜ、隊長。ただ見てるだけです。うま味がたっぷり。道をよろよろ歩くうま味が。でも何も言ってません。%SPEECH_OFF%売剣が言いたいことは分かる。}"
    }
    {
        en = "%terrainImage%{While traveling the land, %birdbro% gets struck by birdshite. It hits %their_victim% swordhand and splashes crosswise all over %their_victim% armor.%SPEECH_ON%Aww, awwww!%SPEECH_OFF%%Their_victim% arms go wide like chicken wings as %they_victim% looks at the damage.%SPEECH_ON%Bloody hell, just my luck!%SPEECH_OFF%}"
        ja = "%terrainImage%{旅の途中、%birdbro%に鳥の糞が命中する。%their_victim%剣腕に当たり、%their_victim%鎧へ斜めに飛び散った。%SPEECH_ON%ああ、あああ！%SPEECH_OFF%%Their_victim%両腕は鶏の翼のように広がり、%they_victim%は被害を見る。%SPEECH_ON%クソッ、ついてねえ！%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You elect %dumb%, the company's biggest idiot, to be your horse racing champion. The horse's owner takes one look at the %person_dumb% and raises an eyebrow.%SPEECH_ON%Well. Alright.%SPEECH_OFF%Rules of the race are clear: first to a distant apple tree is the winner. The %person_dumb% and animal line up on the track. Pretending that %they_dumb% knows what %they're_dumb% doing, %dumb% crouches in a tri-pointed stance. The horse owner yells and slaps his beast on the buttocks. %dumb% releases into a nice stride and shockingly gets ahead of the horse, but %they're_dumb% unable to handle %their% speed and tilts into the second lane and collides with the beast. The horse buckles at the knees and flips head over hind and %dumb% somehow ends up in the curve of its loins and on the flip around is catapulted through the air. It's a damned sight and one you'll surely never see again. The horse gets back to its feet and stares around confused while %dumb%'s unconscious body flies over the finish line. You turn your palms to the horse owner whose hands are gripping his head.%SPEECH_ON%By the old gods, man, are you not concerned for your sellsword?%SPEECH_OFF%}"
        ja = "%terrainImage%{傭兵団一の大馬鹿%dumb%を競走の代表に選ぶ。馬主は%person_dumb%を一目見て眉を上げる。%SPEECH_ON%まあ……いいだろう。%SPEECH_OFF%規則は明快だ。遠くの林檎の木へ先に着けば勝ち。%person_dumb%と馬が道に並ぶ。%they_dumb%が自信ありげに振る舞う。その様子は「%they're_dumb%何をしているか分かっている」と言わんばかりで、%dumb%は三点姿勢にしゃがむ。馬主が叫び、獣の尻を叩く。%dumb%は見事な走り出しで、驚くことに馬を追い越す。だが%they're_dumb%自分の速度を制御できず、%their%勢いのまま第二走路へ傾いて獣と衝突した。馬は膝から崩れ、頭と尻をひっくり返す。%dumb%はどういうわけか腰の曲線へ収まり、回転の勢いで空へ射出された。二度と見られないほど途方もない光景だ。馬は立ち上がって困惑し、%dumb%の気絶した身体は決勝線を越えて飛んでいく。あなたが両手を馬主へ向けると、男は頭を抱えている。%SPEECH_ON%古き神々よ、あんたの売剣を心配しないのか？%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You look back at the company, then unsheathe your sword as you turn around. You swing it up and clip the crossbow and the man shoots it just over your shoulder. You drive the blade down the slat of wood and cut the cords of the weapon and stab the steel into the man's chest. He goes down easy and you hear men shout in the distance, but they're scared and scampering away. Thieves like this know not to fight with sellswords. Unfortunately, the crossbow bolt that went over your shoulder struck %hurtbro%. Who'll survive, but it is a garish wound.}"
        ja = "%terrainImage%{傭兵団を振り返り、向き直りながら剣を抜く。振り上げて弩を弾くと、男はあなたの肩越しに発射した。刃を木の台へ振り下ろし、弦を断ち、鋼を男の胸へ突き立てる。男はあっけなく倒れ、遠くで叫び声がするが、怯えて逃げていく。こうした盗賊は売剣と戦うべきでないと知っている。不運にも、肩越しに飛んだ弩の矢が%hurtbro%へ当たった。命は助かるが、ひどい傷だ。}"
    }
    {
        en = "%terrainImage%{You move to take the hound, but as you crouch down one of the sheep bays and charges, knocking you over. The company laughs and by the time you get to your knees another sheep crushes you from behind to many cheers. Drawing out your sword emits a sharp twang that sends the sheep scurrying. When you look back at the hound its nose is to the dirt and its eyes peerless. It has died and the sheep slowly collect around it bleating and crying out. You sheathe your sword and tell the company to move on.}"
        ja = "%terrainImage%{猟犬を連れていこうとしゃがむと、羊の一頭が鳴いて突進し、あなたを倒す。傭兵団が笑い、膝をつく頃には別の羊が背後から押し潰し、大歓声が上がる。剣を抜く鋭い音で羊は逃げ散った。猟犬を見ると、鼻は地につき、目に光がない。死んでいる。羊たちはゆっくり周囲へ集まり、鳴き声を上げる。剣を鞘へ戻し、傭兵団へ先を急ぐよう命じる。}"
    }
    {
        en = "%terrainImage%{You nominate %randombrother% to try and see if %they_other% can best the beast. The race's rules are first to the apple tree and before you can even begin to root for the sellsword the horse smokes %them_other% completely. It gets to the finish line and begins fishing the branches for apples. The company is sitting completely silent, but when %randombrother% crosses the finish line in a distant last place they roar with delight as though %they_other% just won the keys to the kingdom's finest whorehouse. The horse's owner laughs.%SPEECH_ON%Don't be hard on yerself, kind sir. The fun is in the chance.%SPEECH_OFF%Indeed it seems the spectacle of the %person_other%'s efforts entertained the company.} "
        ja = "%terrainImage%{%randombrother%を選び、%they_other%が獣に勝てるか試させる。規則は林檎の木へ先に着くこと。応援を始める前に、馬は%them_other%を完全に置き去りにした。決勝線へ着き、枝から林檎を探り始める。傭兵団は静まり返っていたが、%randombrother%が遥か後方で決勝線を越えると、%they_other%が王国一の娼館の鍵でも勝ち取ったかのように歓声を上げる。馬主が笑う。%SPEECH_ON%気を落とすな、旦那。挑むことが面白いんだ。%SPEECH_OFF%どうやら%person_other%の奮闘は傭兵団を楽しませた。} "
    }
    {
        en = "%terrainImage%{You pat the %person_dude% on the head, but tell %them_dude% it's already over. %They_dude% nods.%SPEECH_ON%Speak. For. Yourself. Mercenary.%SPEECH_OFF%%They_dude% smiles again, but this time it does release. It sticks. Literally. And %they_dude% leans forward and %their_dude% eyes are open and do not blink and in this state %they_dude% is gone. You get the men back on the road, or what one can make of a road in these snowed stretches.}"
        ja = "%terrainImage%{%person_dude%の頭を叩き、%them_dude%へもう終わりだと告げる。%They_dude%は頷く。%SPEECH_ON%勝手に。決めるな。傭兵。%SPEECH_OFF%%They_dude%は再び笑うが、今度は戻らない。笑みは文字どおり凍りつく。%they_dude%は前へ傾き、%their_dude%目は開いたまま瞬かず、%they_dude%は逝く。男たちを道へ戻す。もっとも、雪に埋もれたこの土地で道と呼べるものがあればの話だ。}"
    }
    {
        en = "%terrainImage%{You tell %birdbro% that being shit on is a part of life and get the company ready to get back on the road. But a modest %historian% comes up and tells the ill-fated sellsword to hold off on cleaning the shite. The historian takes a good look at the shite and then up at the bird which authored it.%SPEECH_ON%Yes, yes... I know that bird! That magical creature!%SPEECH_OFF%The mercenaries look up at the bird as though they were sealeagured sailors finding rarified land. %historian% points at %birdbro%.%SPEECH_ON%You got shat on by a red-and-blue mockingbird! That's all I wanted to say, really. I just hadn't seen one in awhile. You... you can clean it now.%SPEECH_OFF%The mercenaries stand slackjawed before bursting into laughter. %birdbro% grabs the historian and uses %their_historian% sleeves to clean the shit off which brings more roars from the company.}"
        ja = "%terrainImage%{%birdbro%に、糞をかけられるのも人生の一部だと言い、傭兵団を旅へ戻す。だが控えめな%historian%が近づき、不運な売剣へ糞を拭うなと言う。歴史家は糞をじっくり見て、それを生み出した鳥を見上げる。%SPEECH_ON%そうだ、そうだ……あの鳥は知っている！　魔法の生き物だ！%SPEECH_OFF%傭兵たちは、難破した船乗りが希少な陸地を見つけたように鳥を見上げる。%historian%は%birdbro%を指す。%SPEECH_ON%赤青マネシツグミに糞をかけられたんだ！　言いたかったのはそれだけだ。しばらく見ていなかった。もう……拭いていいぞ。%SPEECH_OFF%傭兵たちは呆然とし、やがて爆笑する。%birdbro%は歴史家を掴み、%their_historian%袖で糞を拭う。傭兵団はさらに沸く。}"
    }
    {
        en = "%terrainImage%{You walk up to the man and help him sit down. He grins as one of his bottles clanks off the path and rolls away.%SPEECH_ON%Thankiicup, sir, jast, no, well, ya.%SPEECH_OFF%Nodding, you hold his hand out and spit on his fingers, then roll the jewelry off and pocket them. He merely watches as though you were a physician treating a malady. The rest of your mercenaries strip him down and throw a goatskin tarp over him and then leave him there. As you walk away he asks if you know about the drink.%SPEECH_ON%Not, not sayin' away the secret, but, sirs, drinks are good.%SPEECH_OFF%Yes, are they ever. Unfortunately, as you rejoin the company %randombrother% reports that a kid saw everything and scampered off. You ask why the mercenary didn't chase after him, the bemused sellsword looks at you shrewdly.%SPEECH_ON%I'm not the scampering sort, sir.%SPEECH_OFF%}"
        ja = "%terrainImage%{男に歩み寄り、座るのを手伝う。瓶の一つが道へぶつかり、転がっていくと男は笑う。%SPEECH_ON%あんがっぷ、旦那、ま、いや、そうだ。%SPEECH_OFF%頷き、男の手を伸ばさせ、指へ唾を吐き、宝石を滑らせて外し懐へ入れる。男は病を治す医者でも見るように眺めている。残りの傭兵たちも服を剥ぎ、山羊皮の覆いをかけ、その場に置き去りにする。歩き去ると、酒を知っているかと尋ねてくる。%SPEECH_ON%秘密を、漏らすわけじゃねえが、旦那方、酒はいいぞ。%SPEECH_OFF%実にその通りだ。不運にも傭兵団へ戻ると、%randombrother%が、子供がすべて見て逃げたと報告する。なぜ追わなかったと尋ねると、面白がる売剣は鋭い目を向ける。%SPEECH_ON%俺はちょこまか走る柄じゃない、隊長。%SPEECH_OFF%}"
    }
    {
        en = "%terrainImage%{You're sure %wildman% the Wildman has seen a hive or two in %their_wildman% time estranged to the forests. %They_wildman% grunts and points at the beehive and then at %themselves_wildman%. You nod. %They_wildman% grunts again and goes up the sand dune to the tree while you watch from a safe distance. When %they_wildman% stands beneath the hive, %they_wildman% hoots again, cupping %their_wildman% hand over %their_wildman% mouth to make sure you hear %them_wildman%. %They_wildman% points at the beehive. You nod again and point aggressively at the hive. It's the only beehive for miles, what could possibly be so confusing about this? \n\n The Wildman turns toward the beehive. %They_wildman% cocks an arm back. That... that is not what you wanted to see. %They_wildman% sizes up the beehive, tongue out, eyes slimmed. You rush forward, yelling at %them_wildman%, but %they_wildman%'s already honed in. %They_wildman% launches a fist and absolutely obliterates the bees. Honeycombs stickily flail around %their_wildman% wrist as though %their_wildman% hairy arm were an impromptu maypole. The Wildman casually walks back down the sand dune. As %they_wildman% nears, you see bees crawling all over %their_wildman% face and stinging away like the pissed off savages that they are, but %they_wildman% doesn't seem to even sense their presence. %They_wildman% holds out the crunchy remains of %their_wildman% honeyed demolition as though %they_wildman% held the heart of a ferocious beast.}"
        ja = "%terrainImage%{野人の%wildman%なら、%their_wildman%森暮らしの間に蜂の巣を一つや二つ見たはずだ。%They_wildman%は唸り、蜂の巣を指し、それから%themselves_wildman%を指す。あなたは頷く。%They_wildman%はまた唸り、砂丘を上って木へ向かう。あなたは安全な距離から見守る。%they_wildman%が巣の下に立つと、%they_wildman%はまた叫び、%their_wildman%手を%their_wildman%口へ添えて、%them_wildman%の声があなたにも届くようにする。%They_wildman%が蜂の巣を指す。再び頷き、強く巣を指す。何マイルも周囲に巣は一つしかない。何がそんなに分かりにくいのだ？ \n\n %They_wildman%は蜂の巣へ向き直る。%They_wildman%が腕を引く。そ、それは見たくなかった。野人は舌を出し、目を細めて巣へ狙いをつける。あなたは駆け寄って%them_wildman%へ叫ぶが、%they_wildman%はもう狙いを定めている。%They_wildman%は拳を放って蜂の巣を完全に粉砕した。蜂の巣が%their_wildman%手首に粘つき、%their_wildman%毛むくじゃらの腕を急造の五月柱にして踊る。%they_wildman%は平然と砂丘を下って戻る。近づくにつれ、%their_wildman%顔中を蜂が這い、怒り狂った野蛮人のように刺しているのが見えるが、%they_wildman%は存在すら感じていないようだ。%They_wildman%は、%their_wildman%手に獰猛な獣の心臓でも持つように、%they_wildman%が蜂蜜まみれに破壊した残骸を差し出す。}"
    }
    {
        en = "%townImage% While walking about %townname%, you run into an old man dragging a youthful %person_dude% by the ear.%SPEECH_ON%You want to be a master, it takes time! Blood! Sweat! Tears if yer of the cryin' sort and there's no shame in that if ya are. Here, look! A sellsword! If you want to fight so bad, why not go to him?%SPEECH_OFF%You hold your hands out and ask for an explanation before getting offloaded some annoying git. The elderly man calms himself and lets the kid's ear go.%SPEECH_ON%Aye, I suppose you are owed more of an explanation. I'm the fencing master of this town, but I teach discipline and patience before anyone so much can touch a sword! And this damned student of mine has neither! So I told %them_dude%, if you want to fight so bad, get the hell out!%SPEECH_OFF%You look at the kid. %They're_dude% got a fresh face, but there is in fact some impatient eagerness in %their_dude% eyes. You ask %them_dude% if what the swordmaster says is true. The kid nods.%SPEECH_ON%Yessir. And I'd be more than happy to fight for you, too.%SPEECH_OFF%"
        ja = "%townImage% %townname%を歩いていると、老人が若い%person_dude%の耳を引っ張っている。%SPEECH_ON%達人になるには時間が要る！　血！　汗！　泣く性分なら涙もだ。そうでも恥じゃない。ほら見ろ、売剣だ！　そんなに戦いたいなら、あいつの所へ行け！%SPEECH_OFF%説明を求めて両手を広げるが、厄介な小僧を押しつけられる。老人は落ち着き、耳を離す。%SPEECH_ON%ああ、もっと説明すべきだな。私はこの町の剣術師範だ。だが剣に触れる前に規律と忍耐を教える！　この馬鹿な弟子には両方ない！　そんなに戦いたいなら出ていけ、と%them_dude%に言ったのだ！%SPEECH_OFF%若者を見る。%They're_dude%若々しい顔立ちだが、%their_dude%目には確かに性急な意欲がある。師範の話は本当かと%them_dude%に尋ねる。若者は頷く。%SPEECH_ON%はい、旦那。それに、喜んであなたのために戦います。%SPEECH_OFF%"
    }
    {
        en = "%townImage%%falconhandler% sets down the cage on a nearby bench, much to the curiosity of the onlookers. %falconhandler% lays down the rest of %their_falconhandler% gear and begins to unbolt the cage, much to the delight of the prisoner inside who is now trying to help lift the bolt with its beak. %falconhandler% pinches the bolt between %their_falconhandler% fingers and turns back to you. %SPEECH_ON%Look, if I pull this door open, she might not be comin' back. I ain't learnt to fly yet so unless you can we'd be missin' a bird. %SPEECH_OFF%The bird jostles in agreement. Or protest? You don't speak bird."
        ja = "%townImage%%falconhandler%が近くの長椅子へ籠を置き、見物人が興味深げに集まる。%falconhandler%は残りの%their_falconhandler%道具を置き、閂を外し始める。中の囚人は大喜びし、嘴で閂を持ち上げるのを手伝おうとしている。%falconhandler%は%their_falconhandler%指で閂を挟み、振り返る。%SPEECH_ON%なあ、この扉を開けたら、戻ってこないかもしれない。俺はまだ飛び方を習ってないから、あんたが飛べなきゃ鳥を失う。%SPEECH_OFF%鳥が同意するように籠を揺らす。抗議だろうか？　鳥語は分からない。"
    }
    {
        en = "%townImage%%peacekeeperfull% places %themselves_peacekeeper% between %troublemaker% and the old man. %They_peacekeeper% shakes %their_peacekeeper% head 'no' in a very modest fashion, but you can't help but notice that %their_peacekeeper% swordhand is also on the pommel of %their_peacekeeper% weapon. The troublemaking sellsword briefly seems to consider cutting the %person_peacekeeper% down, but then a smile snaps across %their_troublemaker% face. %They_troublemaker% laughs as %they_troublemaker% sheathes %their_troublemaker% weapon.%SPEECH_ON%Only having a bit of fun, my friend.%SPEECH_OFF%The peasants slowly start going about their business again, but they are wary and stare side-eyed at your men for the rest of your duration in %townname%."
        ja = "%townImage%%peacekeeperfull%が%themselves_peacekeeper%を%troublemaker%と老人の間へ割り込ませる。%They_peacekeeper%は%their_peacekeeper%首を控えめに横へ振るが、%their_peacekeeper%剣を握る手も%their_peacekeeper%武器の柄頭に掛かっている。揉め事を起こす売剣は、一瞬%person_peacekeeper%を斬り倒そうか考えたようだが、すぐ%their_troublemaker%顔に笑みが弾ける。%They_troublemaker%は笑い、%they_troublemaker%が%their_troublemaker%武器を鞘へ戻す。%SPEECH_ON%ちょっと遊んでいただけだ、友よ。%SPEECH_OFF%農民たちはゆっくり仕事へ戻るが、%townname%にいる間ずっと警戒し、あなたの男たちを横目で見ている。"
    }
    {
        en = "%townImage%%peacekeeperfull% steps in between %troublemaker% and the old man. The troublemaking sellsword laughs and sheathes %their_troublemaker% weapon. %They_troublemaker% turns back to the rest of the company, grinning and shaking %their_troublemaker% head, but you notice that this smile quickly fades. Before you can say anything, %troublemaker% wheels a fist back around and knocks %peacekeeper% out cold.\n\n Well, that's one way to mollify a mercenary."
        ja = "%townImage%%peacekeeperfull%が%troublemaker%と老人の間へ入る。揉め事を起こす売剣は笑い、%their_troublemaker%武器を鞘へ戻す。%They_troublemaker%は傭兵団へ振り返り、%their_troublemaker%顔に笑みを浮かべて首を振るが、その笑みはすぐ消える。何か言う前に、%troublemaker%は突然振り向きざまに拳を放ち、%peacekeeper%を殴って気絶させる。\n\n なるほど、傭兵を宥める方法の一つではある。"
    }
    {
        en = "%townImage%As %troublemaker% raises %their_troublemaker% weapon on high, you grab %them_troublemaker% by the forearm and bring it back down. %They_troublemaker% swings around, looking at you sternly. The cowering old man backs off, soon collected by caretakers that shuttle %them_troublemaker% back inside before %they_troublemaker% gets himself hurt.\n\nA few other peasants linger around, watching with keen interest. You tell the sellsword to back down. %They_troublemaker%'s paid to fight who you deem %they_troublemaker% should fight, not a bunch of peasants who are minding their own.\n\n As %troublemaker% glances around, you realize you've left %them_troublemaker% no 'out' that will save face. In %their_troublemaker% eyes, there is a look that says %they_troublemaker%'s about to kill you. It'd be the end of %them_troublemaker%, but %they_troublemaker%'d go out with %their_troublemaker% suicidal pride intact. But the look fades, and embarrassment and humiliation take its place. %They_troublemaker% sheathes %their_troublemaker% weapon, spits, and remarks that %they_troublemaker% was only having some fun."
        ja = "%townImage%%troublemaker%が%their_troublemaker%武器を振り上げると、%them_troublemaker%の前腕を掴み、下ろさせる。%They_troublemaker%は振り向き、厳しい目を向ける。怯える老人は後ずさりし、やがて世話役たちに保護される。世話役たちは老人を%them_troublemaker%から引き離して屋内へ運び、%they_troublemaker%に傷つけられる前に避難させる。\n\nほかの農民たちは興味深そうに残っている。売剣へ退けと命じる。%They_troublemaker%は、あなたが%they_troublemaker%に戦えと判断した者と戦うため雇われているのであって、何もしていない農民と戦うためではない。\n\n %troublemaker%が周囲を見回すと、%them_troublemaker%の面目を保つ逃げ道を奪ったことに気づく。%their_troublemaker%目は、%they_troublemaker%があなたを殺そうとしていると告げる。それは%them_troublemaker%の破滅になるが、%they_troublemaker%は%their_troublemaker%自殺的な誇りを守ったまま死ねる。だが眼差しは消え、代わりに困惑と屈辱が浮かぶ。%They_troublemaker%は%their_troublemaker%武器を鞘へ戻し、唾を吐いて、%they_troublemaker%は少し遊んでいただけだと言う。"
    }
    {
        en = "%townImage%Civilization is no place for a %person_berserker% like %berserker% and %they_berserker% quickly proves it.\n\nApparently, the damned %person_berserker% went crazy while in a shop and trashed the whole place. As the story goes, %they_berserker% just walked in and started taking things, not quite understanding the social norms of paying for goods. The shop owner then came after %them_berserker% with a broom, trying to shoo the %person_berserker% out of his store. Believing the broom a monster, the %person_berserker% proceeded to go completely crazy. Judging by the reports, it was quite the commotion, up to and including shite throwing.\n\nNow the shop owner is in your face demanding compensation for the damage done. Apparently he's wanting %compensation% crowns. Behind him, a few town militia stand with very watchful eyes."
        ja = "%townImage%野蛮な%person_berserker%である%berserker%に、文明社会は居場所ではない。%they_berserker%はすぐそれを証明する。\n\nどうやら忌々しい%person_berserker%は店で暴れ、すべてを壊したらしい。話では、%they_berserker%は店へ入り、品物には金を払うという社会の作法を理解せず、勝手に取り始めた。店主が箒を持って%them_berserker%を追い、%person_berserker%を店外へ出そうとした。箒を怪物だと思い込んだ%person_berserker%は完全に狂乱した。報告によれば大騒ぎで、糞まで投げたという。\n\n今、店主が目の前で損害賠償を要求している。%compensation%クラウンを望んでいるらしい。背後には町の民兵が数人、厳しい目で立っている。"
    }
    {
        en = "%townImage%Civilization is no place for a %person_wildman% like %wildman% and %they_wildman% quickly proves it.\n\nApparently, the damned %person_wildman% went crazy while in a shop and trashed the whole place. As the story goes, %they_wildman% just walked in and started taking things, not quite understanding the social norms of paying for goods. The shop owner then came after %them_wildman% with a broom, trying to shoo the %person_wildman% out of his store. Believing the broom a monster, the %person_wildman% proceeded to go completely crazy. Judging by the reports, it was quite the commotion, up to and including shite throwing.\n\nNow the shop owner is in your face demanding compensation for the damage done. Apparently he's wanting %compensation% crowns. Behind him, a few town militia stand with very watchful eyes."
        ja = "%townImage%野蛮な%person_wildman%である%wildman%に、文明社会は居場所ではない。%they_wildman%はすぐそれを証明する。\n\nどうやら忌々しい%person_wildman%は店で暴れ、すべてを壊したらしい。話では、%they_wildman%は店へ入り、品物には金を払うという社会の作法を理解せず、勝手に取り始めた。店主が箒を持って%them_wildman%を追い、%person_wildman%を店外へ出そうとした。箒を怪物だと思い込んだ%person_wildman%は完全に狂乱した。報告によれば大騒ぎで、糞まで投げたという。\n\n今、店主が目の前で損害賠償を要求している。%compensation%クラウンを望んでいるらしい。背後には町の民兵が数人、厳しい目で立っている。"
    }
    {
        en = "%townImage%Entering %townname%, it isn't long until %troublemaker% is bothering the locals. %They_troublemaker%'s slapping buckets out of their hands and kicking women into the mud. When an old man confronts %them_troublemaker%, the sellsword draws out %their_troublemaker% weapon. Other peasants beg that you put a stop to this at once."
        ja = "%townImage%%townname%へ入ると、ほどなく%troublemaker%が住民に絡み始める。%They_troublemaker%は手から桶を叩き落とし、女たちを泥へ蹴り込む。老人が%them_troublemaker%へ立ち向かうと、売剣は%their_troublemaker%武器を抜く。ほかの農民たちは、すぐ止めてくれと懇願する。"
    }
    {
        en = "%townImage%Killing things seems easy when it comes to describing them. You start by giving a play-by-play of each part of a fight before you realise you may be here all day to describe what few battles you've had so far. You eventually settle for just describing the men and beasts you have fought and slain and the dangers of the open road away from the towns and cities.\n\n The bard struggles to string something out of it but you eventually come to an agreement and hand over the crowns."
        ja = "%townImage%物を殺すのは、言葉で説明すると簡単に聞こえる。戦いの一部始終を逐一語り始めるが、これまでのわずかな戦いを説明するだけで一日かかると気づく。結局、戦い殺した人間と獣、町や都市を離れた街道の危険だけを語ることにする。\n\n 吟遊詩人はそこから話を紡ぐのに苦労するが、やがて合意し、クラウンを渡す。"
    }
    {
        en = "%townImage%Surveying the damage, you agree to compensate the businessman. But this isn't your fault, it's the wild%person_wildman%'s. You dock %their_wildman% pay: for some time to come, the mercenary's earnings will be halved. Furthermore, you take what earnings %they_wildman%'s made and hand them over to the shop owner. It doesn't even begin to cover the damages, but it's a start. One man is left happy, and another quite disgruntled.\n\nYou tell the wild cretin that now %they_wildman%'ll think twice about smearing shit all over someone else's walls. But the wild%person_wildman% doesn't seem to understand you. %They_wildman% just understands that the gold %they_wildman% once owned has been given to someone else, and %they_wildman% eyes its departure with sadness and bottled anger."
        ja = "%townImage%損害を調べ、商人へ賠償することに同意する。だがあなたのせいではなく、野生の%person_wildman%のせいだ。%their_wildman%給金から差し引く。当面、傭兵の稼ぎは半分だ。さらに%they_wildman%がこれまで稼いだ金も没収し、%they_wildman%の分として店主へ渡す。損害には遠く及ばないが、手始めにはなる。一人は満足し、もう一人は大いに不満だ。\n\n野蛮な愚か者へ、他人の壁に糞を塗れば今度から考え直すだろうと言う。だが野生の%person_wildman%は理解していない。%They_wildman%は、かつて%they_wildman%が持っていた金が別人へ渡されたことだけを理解し、%they_wildman%は悲しみと押し殺した怒りでその行方を見つめる。"
    }
    {
        en = "%townImage%While in %townname%, you take the time to provision and make ready for the next part of your journey. %falconhandler% starts to wrestle with their birdcage, trying to keep it under control as the angry avian is desperate to get out. %They_falconhandler% mounts %their_falconhandler% bodyweight onto the cage and instead ends up having %their_falconhandler% fingers clipped and clawed by the animal inside for the effort. %SPEECH_ON%I think she wants out 'fer a bit.%SPEECH_OFF% The bird begins to calm down a little and chirps like a songbird in agreement — as if it knew exactly what was going on."
        ja = "%townImage%%townname%にいる間、次の旅に備えて物資を整える。%falconhandler%は鳥籠と格闘し、出ようと必死の怒った鳥を抑えようとしている。%They_falconhandler%は%their_falconhandler%体重を籠へ乗せるが、中の動物に%their_falconhandler%指を嘴と爪で挟まれる。%SPEECH_ON%少し外へ出たいらしい。%SPEECH_OFF%鳥は少し落ち着き、まるですべて分かっているかのように、鳴禽の声で同意する。"
    }
    {
        en = "%townImage%While walking about %townname%, you run into a man dressed more elegantly than you would expect — their actions do not convey they are a noble, but their speech and clothing would do if it wasn't for lute hanging over their shoulder. %SPEECH_ON%Welcome to %townname%! I'm Theodore — and I am looking for some tall tales and brave deeds for my poems and songs. I'm told you are the traveling and dangerous type and may have some stories to share? If so, your deeds will fall on the ears of many nobles in these lands, that I am sure of! All I need is a little money and as many tales as you can give me...%SPEECH_OFF%"
        ja = "%townImage%%townname%を歩いていると、予想以上に上品な服の男に出会う。振る舞いは貴族ではないが、肩のリュートさえなければ口調と服装は貴族そのものだ。%SPEECH_ON%%townname%へようこそ！　私はセオドア。詩と歌のため、大法螺と勇敢な行いを探している。あなたは旅をし、危険に身を置く者で、話せる物語があると聞いた。ならば、その偉業はこの地の多くの貴族の耳へ届く。間違いない！　必要なのは少しの金と、話せる限り多くの物語だけだ……。%SPEECH_OFF%"
    }
    {
        en = "%townImage%You shrug. %troublemaker% doesn't run the old man through, but %they_troublemaker% does threaten to, raising the weapon on high. When the old man cowers, the sellsword delivers a punch that knocks the elderly right out, his teeth peppering the muck like spits of white rain. This brings a few jeers from the villagers, but they know not to contest your presence any further.\n\nA few men drag the elder away while children boo and women hiss. One child even runs up to the sellsword, pointing at him as he yells '%they_troublemaker%'s a bad %person_troublemaker%.' %troublemaker% shrugs as %they_troublemaker% sheathes %their_troublemaker% weapon.%SPEECH_ON%And yet the bad %person_troublemaker% still stands. Would you also like a taste of the mud, little one?%SPEECH_OFF%The kid quickly runs off."
        ja = "%townImage%肩をすくめる。%troublemaker%は老人を刺し殺さないが、%they_troublemaker%は武器を振り上げて脅す。老人が怯えると、売剣は拳を浴びせ、歯を白い雨粒のように泥へ散らし、気絶させる。村人たちは野次を飛ばすが、それ以上あなたたちに逆らうことはない。\n\n男たちが老人を運び去り、子供は罵声を上げ、女たちは軽蔑の声を漏らす。子供の一人が売剣へ駆け寄り、指差して「%they_troublemaker%は悪い%person_troublemaker%だ」と叫ぶ。%troublemaker%は肩をすくめ、%they_troublemaker%は%their_troublemaker%武器を鞘へ戻す。%SPEECH_ON%だが悪い%person_troublemaker%はまだ立っている。坊主、お前も泥を味わいたいか？%SPEECH_OFF%子供はすぐ逃げる。"
    }
    {
        en = "%townImage%You sit down with the bard and describe your adventures at length, albeit with some embellishment on your part — it's doubtful the bard has ever set foot off the roads, much less know what a ghoul is nor how large it is.\n\n Or how many limbs it has.\n\n Or what it smells like.\n\n The bard seems happy with what you have described and you hand over the crowns. Hopefully stories like this should prick the ears of the nobles."
        ja = "%townImage%吟遊詩人と座り、冒険を詳しく語る。ただし、いくらか話を盛る。吟遊詩人が街道から外れたことすらあるか疑わしい。ましてグールが何か、どれほど大きいかなど知るまい。\n\n 手足が何本あるかも。\n\n どんな臭いがするかも。\n\n 吟遊詩人は話に満足し、クラウンを渡す。こうした物語なら貴族たちも耳をそばだてるだろう。"
    }
    {
        en = "%townImage%You start to describe why you started becoming a mercenary but quickly realise you don't have all that much to share. The bard has a dozen questions to help you along but you realise you have some way to go before you can share more.\n\n The bard nods a few times and writes down some rough notes before you hand over your crowns."
        ja = "%townImage%なぜ傭兵になったかを語り始めるが、話せることが大してないとすぐ気づく。吟遊詩人は話を助けるためいくつも質問するが、もっと語れるようになるにはまだ先が長い。\n\n 吟遊詩人は何度か頷き、簡単な覚書を書き留める。それから、あなたはクラウンを渡す。"
    }
    {
        en = "'Big as an 'orse! Wit sharp teef! Five eyez! Sp'licky as a jabber!' - The peasant reports are nonsense, but something is clearly out there."
        ja = "「馬みてえにでけえ！　歯は尖ってる！　目玉が五つ！　ジャバーみてえにヌメヌメだ！」――農民の報告はでたらめだが、何かがいることだけは確かだ。"
    }
    {
        en = "'Deliver with maximum security.' You have to wonder what kind of item demands such lengths."
        ja = "「最大限の警備で届けよ」。そこまでする必要がある品とは、いったい何なのだろう。"
    }
    {
        en = "'I'm not out yet'. Fully refresh your Fatigue, and grant [color=%positive%]+5[/color] Fatigue Recovery for 3 turns. Additionally, remove any [color=#731f39]Stun[/color], [color=#731f39]Daze[/color], [color=#731f39]Stagger[/color], [color=#731f39]Baffle[/color], [color=#731f39]Charmed[/color] or [color=#731f39]Sleeping[/color] status. Can only be used once per combat and is only usable if accumulated fatigue is more than 50% of the maximum."
        ja = "「まだ終わっちゃいない」。疲労を完全に回復し、3ターンの間、ターンごとの疲労回復量を[color=%positive%]+5[/color]する。さらに、[color=#731f39]気絶[/color]、[color=#731f39]朦朧[/color]、[color=#731f39]よろめき[/color]、[color=#731f39]困惑[/color]、[color=#731f39]魅了[/color]、[color=#731f39]睡眠[/color]の状態をすべて解除する。戦闘中に一度しか使えず、蓄積疲労が最大疲労値の50%を超えている場合にのみ使用できる。"
    }
    {
        en = "'Steal from the rich, give to the poor.' An interesting idea for sure, until the rich inevitably hire a sellsword company to kill you."
        ja = "「金持ちから奪い、貧しい者に与える」。なるほど面白い考えだ――金持ちが傭兵団を雇ってお前を殺しに来るまでは。"
    }
    {
        en = "(Cosmetic only)"
        ja = "（外見のみ）"
    }
    {
        en = "+5 Resolve"
        ja = "+5 精神力"
    }
    {
        en = ", +5 Melee Defense"
        ja = ", +5 近接防御"
    }
    {
        en = ", +5 Ranged Defense"
        ja = ", +5 射撃防御"
    }
    {
        en = ", -5 Melee Defense"
        ja = ", -5 近接防御"
    }
    {
        en = ", -5 Ranged Defense"
        ja = ", -5 射撃防御"
    }
    {
        en = "-3 Action Points. Recovers hitpoints at only 10% of the normal rate. Requires 3 provisions a day."
        ja = "行動力-3。体力の回復速度は通常の10%。1日に食糧を3必要とする。"
    }
    {
        en = "-5 Resolve"
        ja = "-5 精神力"
    }
    {
        en = "...and half pay if any of them touch me!"
        ja = "……それに、あいつらの誰かが俺に触れたら給金は半分だ！"
    }
    {
        en = "10% chance to transform per turn during battle in daylight."
        ja = "日中の戦闘では、ターンごとに10%の確率で変異する。"
    }
    {
        en = "101: How to fight x"
        ja = "入門101：xとの戦い方"
    }
    {
        en = "125 crowns? I'll take that gamble."
        ja = "125クラウン？　その賭けに乗ろう。"
    }
    {
        en = "20% chance to transform per turn during battle at night."
        ja = "夜間の戦闘では、ターンごとに20%の確率で変異する。"
    }
    {
        en = "A %Person_muladi% Remade"
        ja = "生まれ変わった%Person_muladi%"
    }
    {
        en = "A Bandit Gang"
        ja = "盗賊団"
    }
    {
        en = "A Barbarian Tribe"
        ja = "蛮族の部族"
    }
    {
        en = "A Cavort with the Coven (Legendary)"
        ja = "魔女の集会との狂宴（伝説級）"
    }
    {
        en = "A City State"
        ja = "都市国家"
    }
    {
        en = "A Coven is a cesspit of dark magic and corruption. Burn them all, and quickly! Lest they claim your soul."
        ja = "魔女の集会は闇の魔術と堕落の肥溜めだ。魂を奪われる前に、一人残らず、今すぐ焼き払え！"
    }
    {
        en = "A Diplomatic Mission"
        ja = "外交任務"
    }
    {
        en = "A Holy Site has been conquered by southern heathens. Honor and fear of the Old Gods demands that it be retaken."
        ja = "聖地が南方の異教徒に奪われた。名誉と古き神々への畏れが、その奪還を求めている。"
    }
    {
        en = "A Holy Site is being trespassed by northern rats. Flush them out."
        ja = "北方の鼠どもが聖地を踏みにじっている。叩き出せ。"
    }
    {
        en = "A Missed Opportunity"
        ja = "逃した好機"
    }
    {
        en = "A Noble House"
        ja = "貴族の家門"
    }
    {
        en = "A Noble house patrol is too close to discovering a nearby camp of ours."
        ja = "貴族家の巡回隊が、近くにある我らの野営地を発見しかねないほど迫っている。"
    }
    {
        en = "A Nomad Tribe"
        ja = "遊牧民の部族"
    }
    {
        en = "A Stollwurm - a burrowing bipedal dragon resembling a giant snake."
        ja = "シュトルヴルム――地中を掘り進む二足の竜で、巨大な蛇に似ている。"
    }
    {
        en = "A Treatise on Armor:"
        ja = "防具論："
    }
    {
        en = "A Vala is a travelling seer, shaman and sorceress."
        ja = "ヴァラは各地を旅する予見者、巫女、そして女魔術師だ。"
    }
    {
        en = "A Vizier can find many uses for a Crownling company it would seem. Such as holding a crumbling ruin in the arse-end of nowhere."
        ja = "宰相というものはクラウンリングの傭兵団にいろいろな使い道を見つけるらしい。たとえば、辺境の果てにある崩れかけた廃墟を守らせる、とか。"
    }
    {
        en = "A backpack worn by merchants to carry many more supplies"
        ja = "商人がより多くの物資を運ぶために背負う大きな背嚢。"
    }
    {
        en = "A bag of darts, required to use blow guns of all kinds. Is automatically refilled after each battle if you have enough ammunition."
        ja = "あらゆる吹き矢を使うために必要な矢玉の袋。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A band of men suddenly materialize all around you, stepping out of brush, climbing down from perches, even popping out of holes in the ground.%SPEECH_ON%I see you've main a bit of a name for yourself, Indebted. %nemesisviziername% will pay well for your heads, but you lot clearly know how to handle yourselves in a fight. You make it worth my while, and we can forget we ever saw each other, yeah?%SPEECH_OFF%The manhunter who spoke jeers at you, but the group keeps their distance awaiting your response."
        ja = "男たちの一団が突然四方に現れる。茂みから出て、高みから降り、地面の穴からさえ飛び出した。%SPEECH_ON%少し名を上げたようだな、債務奴隷。%nemesisviziername%はお前らの首に大金を払う。だが戦える連中らしい。俺に見合う金を出せば、互いに見なかったことにできる。どうだ？%SPEECH_OFF%話した人狩りは嘲るが、一団は距離を保ち、返答を待つ。"
    }
    {
        en = "A barbarian prisoner, shackled and guarded, awaits transport to face judgment. His kin will not this make this easy."
        ja = "鎖につながれ、見張られた蛮族の囚人が、裁きを受けるための護送を待っている。同族が容易には進ませてくれないだろう。"
    }
    {
        en = "A basic leather helm made of odd scraps stitched together."
        ja = "不揃いな革の端切れを縫い合わせた、粗末な革兜。"
    }
    {
        en = "A basic leather jacket offering modest protection."
        ja = "そこそこの防護を得られる、簡素な革の上着。"
    }
    {
        en = "A basic mail shirt. Offers decent and affordable protection against slashing and piercing attacks."
        ja = "基本的なメイルシャツ。斬撃と刺突に対し、手頃な価格で十分な防護を得られる。"
    }
    {
        en = "A basic wimple of plain grey cloth that signifies a life of devotion and poverty."
        ja = "清貧と信仰に身を捧げる暮らしを示す、飾り気のない灰色布のウィンプル。"
    }
    {
        en = "A beautiful cloth headband from southern lands where dyes are plentiful."
        ja = "染料が豊富な南方の地で作られた、美しい布の鉢巻き。"
    }
    {
        en = "A beautiful hat adorned with a set of richly hued feathers, held fast by a decorative band."
        ja = "色鮮やかな羽根を飾り帯で留めた、美しい帽子。"
    }
    {
        en = "A beautiful lute with a ornate body and strong neck. The artisan who made this instrument certainly knew what they were doing."
        ja = "華麗な胴と頑丈な棹を備えた美しいリュート。この楽器を作った職人が確かな腕を持っていたことは疑いない。"
    }
    {
        en = "A beautiful staff with the distinctive twisted design of a vala."
        ja = "ヴァラ特有のねじれた意匠が施された、美しい杖。"
    }
    {
        en = "A beautifully designed metal sallet helm with an extended neck guard, a design uncommon in these lands. Expertly crafted to offer maximum protection with minimum weight, and without impairing vision."
        ja = "この地では珍しい、長い首当てを備えた美しい金属製サレット。視界を妨げず、最小限の重量で最大限の防護を得られるよう、見事に作られている。"
    }
    {
        en = "A beautifully painted visor bearing an exquisite caricature of a beast's visage upon the front, striking terror - and perhaps a touch of bewilderment - into any who gaze upon it."
        ja = "獣の顔を精緻な戯画として正面に描いた、美しい面頬。目にした者へ恐怖――そしておそらく、わずかな困惑――を植え付ける。"
    }
    {
        en = "A blade to the face. Scarred and battle hardened"
        ja = "顔を刃で斬られた。傷痕が残り、戦場で鍛えられた。"
    }
    {
        en = "A blessed local item which went missing years ago has reportedly been sighted in the wilds."
        ja = "何年も前に失われた、地元で祝福された品が荒野で目撃されたという。"
    }
    {
        en = "A boiled and hardened brigandine studded with steel rivets and reinforced with steel padded shoulders for added protection."
        ja = "煮固めた革に鋼の鋲を打ち、さらに鋼で補強した肩当てを加えて防護を高めたブリガンダイン。"
    }
    {
        en = "A boiled and hardened leather brigandine studded with steel rivets for added protection."
        ja = "煮固めた革に鋼の鋲を打ち、防護を高めたブリガンダイン。"
    }
    {
        en = "A bolt of double-quilted fabric with a mysterious, stamped mark. The material is light, thick and still flexible enough to be combined with other rare materials to make something stronger."
        ja = "謎めいた刻印が押された、二重にキルティングした一巻きの布地。軽く、厚く、それでいてしなやかさを保っており、ほかの希少素材と組み合わせてより強いものを作れる。"
    }
    {
        en = "A brand new arm for a sword to be swung with. Of course, the user loses most control in their arm, all feeling, and must manually change the position of their fingers with their other hand. But still, at least it's something."
        ja = "剣を振るうための真新しい腕。もちろん、使用者は腕の制御も感覚もほとんど失い、もう片方の手で指の位置を一つずつ変えねばならない。それでも、ないよりはましだ。"
    }
    {
        en = "A breastplate made of several layers of linen that provides basic protection."
        ja = "何層もの亜麻布で作られた、基礎的な防護をもたらす胸当て。"
    }
    {
        en = "A brigand stronghold is nearby, attracting all manner of thieves, vagrants and murderers."
        ja = "近くに盗賊の砦があり、ありとあらゆる盗人、浮浪者、人殺しを呼び寄せている。"
    }
    {
        en = "A bright, decorated coat that offers decent protection."
        ja = "十分な防護を得られる、鮮やかな装飾入りの上着。"
    }
    {
        en = "A broad and heavy warscythe, characterised by a much longer blade. This weapon demands much room to use and is difficult to wield, but the havoc it can cause against attackers on both two legs or four is unparalleled."
        ja = "はるかに長い刃を持つ、幅広く重い戦鎌。振るうには広い空間を要し、扱いも難しいが、二本足であれ四本足であれ、襲い来る者に及ぼす破壊は比類ない。"
    }
    {
        en = "A broadly tailored hood that drapes over the shoulders, keeping the wearer protected from foul weather."
        ja = "肩まで垂れる幅広仕立ての頭巾。悪天候から着用者を守る。"
    }
    {
        en = "A broken and heavy sword that has snapped despite it's durability. The damage of this blade has only converted it into a killing tool of a different form."
        ja = "頑丈さにもかかわらず折れてしまった、壊れた重い剣。刃が損なわれたことで、別の姿の殺傷具へと変わっただけともいえる。"
    }
    {
        en = "A broken ceremonial sword with few sharp edges outside of the breakpoint. It is, however, still more than a lethal weapon in the hands of a cunning fighter."
        ja = "折れ口以外には鋭い部分がほとんど残っていない、壊れた儀礼剣。それでも狡猾な戦士の手にかかれば、なお致命的な武器となる。"
    }
    {
        en = "A broken net that may be repaired if you have the knowledge, or sold for scrap"
        ja = "修理の知識があれば直せるか、くずとして売れる破れた投網。"
    }
    {
        en = "A brute force attack with the end of your slingstaff."
        ja = "投石杖の端を使って力任せに殴りつける。"
    }
    {
        en = "A bucket of black paint. Highly sought after by artisans. It's dull appearance is a base for any fresco or artwork but alone is not interesting enough to be much much coin."
        ja = "黒い塗料の入った桶。職人たちの需要は高い。くすんだ色はフレスコ画や美術品の下地になるが、これだけでは大した値はつかない。"
    }
    {
        en = "A bucket of paint remover. Everyone makes mistakes, and this is a good way for those with shakey hands to cover up their mistakes without looking like a charlatan."
        ja = "塗料剥がしの入った桶。誰にでも失敗はある。手元の震える者でも、いかさま師に見られずに失敗を消し去れる便利な品だ。"
    }
    {
        en = "A bucket of red paint. This is a common but much needed colour that is used from shields to the finest artwork. It is colourful but easy to make."
        ja = "赤い塗料の入った桶。盾から上等な美術品まで幅広く使われる、ごく一般的ながら欠かせない色である。鮮やかだが、作るのは容易い。"
    }
    {
        en = "A burst of force, leaping forward into a foe."
        ja = "力の奔流を放ち、敵へ向かって飛ばす。"
    }
    {
        en = "A business proposal"
        ja = "商談"
    }
    {
        en = "A ceremonial crown that has endured the passage of time. It still carries the authority of ancient Lich Priests."
        ja = "長い歳月を耐え抜いた儀礼用の冠。今なお古代のリッチ司祭の権威を帯びている。"
    }
    {
        en = "A chance meeting"
        ja = "偶然の出会い"
    }
    {
        en = "A chant that gets the blood boiling, making your allies eager to fight."
        ja = "血を沸き立たせ、味方の闘志をかき立てる詠唱。"
    }
    {
        en = "A characteristic head covering of the convent"
        ja = "修道院に特有の頭巾。"
    }
    {
        en = "A charismatic new crime lord had united all the brigand gangs, marking a dark turning point for the realm."
        ja = "人を惹きつける新たな犯罪王が盗賊団をことごとく束ね、領内は暗い転機を迎えている。"
    }
    {
        en = "A cloak made from the feathers of a basilisk. The weave offers additional padding and protects the wearer from poison."
        ja = "バシリスクの羽根で作られた外套。編み地がさらなる緩衝材となり、着用者を毒から守る。"
    }
    {
        en = "A cloak made from the skin of dead men and dark magic. This wretched garment pulses with a cold, malevolent life of its own, serving as both a horrific trophy and a conduit for the forbidden arts."
        ja = "死人の皮と黒魔術で作られた外套。この忌まわしい衣は冷たく邪悪な命を宿して脈打ち、おぞましい戦利品であると同時に禁じられた術の導管ともなる。"
    }
    {
        en = "A cloak made of rough chain and the thick fur of a beast."
        ja = "粗い鎖と獣の厚い毛皮で作られた外套。"
    }
    {
        en = "A cloak made out of the scales of a Stollwurm. Not only is it a rare and impressive trophy, it also offers excellent protection against any kind of crowd control effects on top of the immunity against acid."
        ja = "シュトルヴルムの鱗で作られた外套。希少で目を引く戦利品であるだけでなく、酸への完全耐性に加え、あらゆる行動阻害効果に対して優れた防護をもたらす。"
    }
    {
        en = "A cloak of dark wool that wraps around the shoulders."
        ja = "肩を包む、暗色の羊毛製外套。"
    }
    {
        en = "A cloak of the feathers of a strange creature of the abyss. "
        ja = "深淵に棲む奇怪な生物の羽根で作られた外套。"
    }
    {
        en = "A cloak of the finest material that was rumored to have been worn by the last emperor."
        ja = "最後の皇帝がまとったと噂される、最上の素材で作られた外套。"
    }
    {
        en = "A cloak sewn from the cured furs taken from ferocious hyenas, worn as a beast hunter's trophy. It bolsters the wearer's drive to action when donned."
        ja = "獰猛なハイエナのなめし毛皮を縫い合わせた外套。獣狩りの戦利品として身につけられ、着用者を行動へ駆り立てる。"
    }
    {
        en = "A cloak sewn from the cured pelts taken from ferocious direwolves, worn as a beast hunter's trophy. It looks imposing when donned."
        ja = "獰猛なダイアウルフのなめし毛皮を縫い合わせた外套。獣狩りの戦利品として身につけられ、まとえば威圧的に見える。"
    }
    {
        en = "A cloak swen from the cured pelts taken from white wolves, worn as a beast hunter's trophy. It looks terrifying when donned."
        ja = "白狼のなめし毛皮を縫い合わせた外套。獣狩りの戦利品として身につけられ、まとえば恐ろしげに見える。"
    }
    {
        en = "A closed helm covering the entirety of the head, with a visor attached to protect the face. It also has a small aventail of mail attached."
        ja = "頭部全体を覆う閉鎖兜。顔を守る面頬と、小さな鎖帷子のアヴェンテイルが付いている。"
    }
    {
        en = "A closed helm covering the entirety of the head. It also has a small aventail of mail attached."
        ja = "頭部全体を覆う閉鎖兜。小さな鎖帷子のアヴェンテイルも付いている。"
    }
    {
        en = "A closed metal helm with a breathing hole in the shape of a frog mouth. Great in the way of protection but hard to breathe in and limiting the field of view."
        ja = "蛙の口を模した呼吸孔を持つ金属製の閉鎖兜。防護には優れるが、息苦しく視野も狭まる。"
    }
    {
        en = "A closed metal helm with a metal crest and a breathing hole in the shape of a frog mouth. Great in the way of protection but hard to breathe in and limiting the field of view."
        ja = "金属製の兜飾りと、蛙の口を模した呼吸孔を持つ閉鎖兜。防護には優れるが、息苦しく視野も狭まる。"
    }
    {
        en = "A closed metal helm with a smooth surface. Great protection at the expense of breathing and sight."
        ja = "滑らかな表面を持つ金属製の閉鎖兜。優れた防護と引き換えに、呼吸と視界が妨げられる。"
    }
    {
        en = "A closed metal helm with a snub nose. Provides more breathing than full helms"
        ja = "短い鼻当てを持つ金属製の閉鎖兜。完全に閉じた兜よりも呼吸しやすい。"
    }
    {
        en = "A closed metal helm with beard. Great in the way of protection and beauty but hard to breathe in and limiting the field of view."
        ja = "髭をかたどった金属製の閉鎖兜。防護と美観には優れるが、息苦しく視野も狭まる。"
    }
    {
        en = "A closed metal helm with many breaths. Sacrifices a small amount of protection for increased breathing and sight, and cost."
        ja = "多数の呼吸孔を持つ金属製の閉鎖兜。防護をわずかに犠牲にして呼吸と視界を改善するが、そのぶん値も張る。"
    }
    {
        en = "A closed metal helm with neckplate. Provides more protection at the cost of breathing"
        ja = "首当てを備えた金属製の閉鎖兜。呼吸しにくくなる代わりに防護が増す。"
    }
    {
        en = "A closed metal helm with pointed snout. Good defense against lances"
        ja = "尖った口先を持つ金属製の閉鎖兜。騎槍に対して優れた防御を発揮する。"
    }
    {
        en = "A closed metal helm with reinforced face plates. Outstanding protection at the expense of breathing and sight."
        ja = "顔面を補強板で覆った金属製の閉鎖兜。呼吸と視界を犠牲に、並外れた防護をもたらす。"
    }
    {
        en = "A closed metal helm with winged neckplate. Provides more protection at the cost of breathing"
        ja = "翼状の首当てを備えた金属製の閉鎖兜。呼吸しにくくなる代わりに防護が増す。"
    }
    {
        en = "A cloth scarf designed to shield the face from the elements and the cloying stench of the dead."
        ja = "風雨と死者のまとわりつく悪臭から顔を守るための布製スカーフ。"
    }
    {
        en = "A cluster of rich, decorative feathers worn by nobles in their headwear."
        ja = "貴族が帽子に飾る、豪奢な装飾用の羽根束。"
    }
    {
        en = "A coarse hood held together by crude, heavy stitching. The garments of a man with little to his name but the will to keep moving forward."
        ja = "粗く太い縫い目でどうにか形を保つ、ごわついた頭巾。持てるものはほとんどなくとも、前へ進む意志だけはある男の衣だ。"
    }
    {
        en = "A coat well suited to wandering the lands."
        ja = "各地を渡り歩くのに適した上着。"
    }
    {
        en = "A collar worn by combatants in the Grand Tournament."
        ja = "大闘技大会の出場者が身につける首輪。"
    }
    {
        en = "A collection of equipment for training mercenaries, comes with a training dummy, wooden weapons and ring pegs. Having this in your stash upgrades your camp."
        ja = "訓練用の人形、木製武器、輪投げ杭を含む傭兵訓練用具一式。保管庫に置いておくと野営地が強化される。"
    }
    {
        en = "A collection of notes of soldiers, craftsmen and armorers, that will explain everything about wearing armor.  Will teach the relevant [color=%negative%]Armor[/color] perk group to the character that uses it."
        ja = "兵士、職人、防具鍛冶の覚え書きを集めた、防具の着こなしを余すところなく解説する書。使用した人物に、対応する[color=%negative%]防具[/color]パークグループを習得させる。"
    }
    {
        en = "A collection of tools and equipment for hunting and cooking. Having this in your stash upgrades your camp, allowing skilled backgrounds to produce food, alcohol and treats"
        ja = "狩猟と調理のための道具一式。保管庫に置いておくと野営地が強化され、適切な経歴を持つ者が食料、酒、嗜好品を作れるようになる。"
    }
    {
        en = "A collection of tools for gathering plants, comes with shelves, woven baskets, sickles, drying racks and bags. Having this in your stash upgrades your camp."
        ja = "棚、編み籠、鎌、乾燥棚、袋を含む採集道具一式。保管庫に置いておくと野営地が強化される。"
    }
    {
        en = "A colossal cleaving weapon made of several overlapping crude blades wedged into a tree limb. Too heavy to be used effectively by the average human."
        ja = "木の太枝に何枚もの粗末な刃を重ねて挟み込んだ、巨大な斬断武器。重すぎて、並の人間にはまともに扱えない。"
    }
    {
        en = "A common turban with dyed pattern. Common among travelers looking to keep the sun off their necks."
        ja = "染め模様の入った一般的なターバン。首筋を日差しから守りたい旅人がよく身につける。"
    }
    {
        en = "A compact iron jaw guard that doesn't obstruct the user's field of vision."
        ja = "視野を遮らない、小ぶりな鉄製の顎当て。"
    }
    {
        en = "A complete harness of solid, plated steel that provides complete protection for the torso and limbs."
        ja = "堅牢な鋼板で作られ、胴体と四肢を余すところなく守る全身甲冑。"
    }
    {
        en = "A conical helm fluted to redirect the force of the incoming blows."
        ja = "受けた打撃の力を逸らすため、筋状の溝を刻んだ円錐兜。"
    }
    {
        en = "A conical helm of ancient design, topped with a tail long stiff and matted with rot."
        ja = "古代様式の円錐兜。頂には、腐敗で長く硬く絡まった尾飾りが付いている。"
    }
    {
        en = "A conical helm of excellent quality with polished, golden elements that catch the light with a sharp, brilliant glint."
        ja = "磨き上げた黄金の意匠が光を受けて鋭く鮮烈にきらめく、極上の円錐兜。"
    }
    {
        en = "A conical helm with a nasal guard from a bygone era, its ragged leather lining barely hanging from the weathered shell."
        ja = "鼻当てを備えた過ぎ去りし時代の円錐兜。風雨にさらされた鉢から、ぼろぼろの革張りが辛うじて垂れ下がっている。"
    }
    {
        en = "A corpse in varying forms of decay. While slow on the uptake, it makes for a frightening opponent to most. You can also pick any name you like!"
        ja = "腐敗の度合いもさまざまな死体。飲み込みは遅いが、たいていの相手には恐ろしい敵となる。好きな名前を何でも付けられるぞ！"
    }
    {
        en = "A crazed looking prisoner, feet bound in chains, comes galloping out of the camp yelling something about divine retribution, and how the old gods were looking out for the faithful. The slave starts kicking at a nomad's corpse and you quickly move to calm things down before it get out of hand. After you explain the situation, the slave delivers a final kick to the nearest body and explains being taken prisoner by the nomads and forced into slavery. Perhaps with captors gone, the righteous might find a place in the %companyname%?"
        ja = "鎖で足を縛られた狂気じみた囚人が野営地から飛び出し、神罰や、古き神々が信徒を見守ったのだと叫ぶ。奴隷は遊牧民の死体を蹴り始め、手に負えなくなる前に急いで宥める。事情を説明すると、奴隷は最寄りの死体へ最後の一蹴りを入れ、遊牧民に捕らえられ、奴隷にされたと語る。捕らえた者が死んだ今、この義に篤い者にも%companyname%で居場所があるかもしれない。"
    }
    {
        en = "A creature of nightmare and legend, the Lindwurm is a massive serpent with razor-sharp fangs and venom that burns like fire."
        ja = "悪夢と伝説の怪物リントヴルム。剃刀のような牙を備え、炎のように焼ける毒を持つ巨大な蛇だ。"
    }
    {
        en = "A crested ornament of a noble house tarnished by time and rot, a grim reminder that even the highborn are not exempt from the common fate of all mortals."
        ja = "時と腐敗にくすんだ貴族家の兜飾り。高貴な生まれであろうと、あらゆる定命の者に共通する末路からは逃れられないと告げる陰鬱な遺物だ。"
    }
    {
        en = "A cross between a spear and a sword, making for a good dueling weapon. Used for attacking at range and closing the gap."
        ja = "槍と剣を掛け合わせたような、決闘に適した武器。離れた敵を攻撃しつつ、間合いを詰めるのに使われる。"
    }
    {
        en = "A crude and heavy sling, for hurling rocks at your rivals. With stones abundant everywhere, it will never run out of ammunition."
        ja = "敵へ石を放つための粗末で重い投石紐。石はどこにでも転がっているため、矢弾が尽きることはない。"
    }
    {
        en = "A crude cap made from overlapping scraps of leather stitched together with thick twine to provide basic, rigid protection for the crown of the head."
        ja = "革の端切れを重ね、太い麻紐で縫い合わせた粗末な帽子。頭頂部に最低限の硬い防護を与える。"
    }
    {
        en = "A crudely forged, heavy plate of iron designed to shield the throat and the jaw."
        ja = "喉と顎を守るため、粗雑に鍛えられた重い鉄板。"
    }
    {
        en = "A cursed pack of fell beasts appear to have developed a taste for human flesh."
        ja = "呪われた凶獣の群れが、人肉の味を覚えたらしい。"
    }
    {
        en = "A curtain of mail designed to be hanged over the mouth."
        ja = "口元を覆うよう垂らす鎖帷子。"
    }
    {
        en = "A dagger made from the fang and poison gland of a redback spider, it can inject redback poison into a target"
        ja = "レッドバック蜘蛛の牙と毒腺で作られた短剣。標的へレッドバックの毒を注入できる。"
    }
    {
        en = "A dark hood covering a helmet, carved from the bones of a foul man"
        ja = "邪悪な男の骨から削り出し、兜の上を覆う暗色の頭巾。"
    }
    {
        en = "A dark hood with reinforced edges popular with those working with filth and entrails."
        ja = "縁を補強した暗色の頭巾。汚物や臓物を扱う者たちに好まれる。"
    }
    {
        en = "A dark robe and gloves worn by those who tinker with flesh and filth."
        ja = "肉や汚物をいじくり回す者たちが着る、暗色の長衣と手袋。"
    }
    {
        en = "A dark, heavy cloth tunic. Bulky, but offering additional protection."
        ja = "暗色の厚手布で作られたチュニック。かさばるが、その分だけ防護に優れる。"
    }
    {
        en = "A dead man's skull hanging on a heavy chain. An unmistakable mark of a headhunter."
        ja = "太い鎖に吊るされた死人の頭蓋骨。首狩り人であることを疑いようもなく示す印だ。"
    }
    {
        en = "A decayed flat-topped helm with a pitted faceplate, now little more than a crumbling shell of its former self."
        ja = "腐朽し、穴だらけの面頬が付いた平頂兜。かつての姿を失い、今や崩れかけた殻にすぎない。"
    }
    {
        en = "A decaying chain mail neck guard. The metal is brittle and structurally compromised by deep corrosion."
        ja = "朽ちつつある鎖帷子の首当て。金属は深い腐食で脆くなり、構造そのものが損なわれている。"
    }
    {
        en = "A decorated closed metal helm with a breathing hole in the shape of a frog mouth. Great in the way of protection but hard to breathe in and limiting the field of view."
        ja = "装飾を施し、蛙の口を模した呼吸孔を持つ金属製の閉鎖兜。防護には優れるが、息苦しく視野も狭まる。"
    }
    {
        en = "A decorated deep cervelliere with bolted cheek guards. It bears a gilded trim with decorative leaf plates pinned to the front ridge."
        ja = "頬当てを鋲留めした、装飾入りの深鉢セルヴェリエール。金箔の縁取りが施され、前縁には葉形の飾り板が留められている。"
    }
    {
        en = "A decorated sash and belt previously worn by the Diviner."
        ja = "かつて占術師が身につけていた、装飾入りの肩帯と腰帯。"
    }
    {
        en = "A decorative feather clasped on hats."
        ja = "帽子に留める装飾用の羽根。"
    }
    {
        en = "A decorative plait used to adorn helms."
        ja = "兜を飾るための組み紐。"
    }
    {
        en = "A decorative tail made of desert animal hair."
        ja = "砂漠の獣の毛で作られた飾り尾。"
    }
    {
        en = "A deep tusk gore performed with full force to smash a target to bits. Anyone hit will be staggered and lose initiative."
        ja = "全力で深々と牙を突き立て、標的を粉砕する。命中した者はよろめき、先制値が低下する。"
    }
    {
        en = "A delightful group of companions have set-up in a nearby ruin. They attack all who travel the road."
        ja = "実に愉快な御一行が、近くの廃墟に居を構えた。街道を通る者は誰であろうと襲っている。"
    }
    {
        en = "A dense wool wrap to protect against blunt hits."
        ja = "鈍器の打撃から身を守る、目の詰まった羊毛の巻き布。"
    }
    {
        en = "A disgusting Hexen brew, will heal and remove fatigue for 8 turns, but poison for 3 turns."
        ja = "おぞましいヘクセンの醸造薬。8ターンにわたり体力を回復して疲労を取り除くが、3ターンのあいだ毒に冒される。"
    }
    {
        en = "A disgusting design made by nailing metal pieces to layers of flesh taken from skin ghouls. It smells awful, is quite heavy, and feels as if it is healing itself on to your body."
        ja = "スキングールから剥いだ何層もの肉に金属片を打ち付けた、おぞましい代物。ひどい悪臭を放ち、かなり重いうえ、まるで自ら着用者の身体へ癒着していくように感じられる。"
    }
    {
        en = "A dislike of the dark can be a childish fear for some, but with what's been running around in the wilds lately, maybe it isn't as odd anymore..."
        ja = "闇を嫌うのは子供じみた恐怖かもしれない。だが近頃、荒野を徘徊しているものを思えば、そうおかしなことでもない……。"
    }
    {
        en = "A distinctive, bird-like mask. The beak acts as a ventilator, containing sweet-smelling herbs to ward away sickness and disease."
        ja = "特徴的な鳥のような仮面。嘴は換気口となっており、病や疫病を遠ざける甘い香りの薬草が詰められている。"
    }
    {
        en = "A dome helm with heavy riveted bands that has once been in possession of an ancient household guard."
        ja = "太い鋲留め帯で補強された丸鉢兜。かつて古代の近衛兵が所有していた。"
    }
    {
        en = "A donkey. Smelly, stubborn, drooling and eating your shirt right now."
        ja = "ロバ。臭く、頑固で、よだれを垂らし、今まさにお前の上着をかじっている。"
    }
    {
        en = "A double edged spear with a sleek yet wide profile compared to other spears, it excels at penetrating armour whilst remaining light enough for skirmishing."
        ja = "ほかの槍と比べて流麗でありながら幅広い輪郭を持つ、両刃の槍。軽さを保ったまま装甲を貫くことに長け、小競り合いにも向く。"
    }
    {
        en = "A durable cloth robe designed to shield the wearer from the sun's heat and the sting of minor cuts."
        ja = "陽光の熱と軽い切り傷から着用者を守る、丈夫な布製の長衣。"
    }
    {
        en = "A dyed cloth piece of storied headwear adorning a questing knight on their path of atonement."
        ja = "贖罪の旅を続ける遍歴騎士の頭を飾る、由緒ある染め布の被り物。"
    }
    {
        en = "A fake leg of wood and metal. Not much to run on, but at least it'll let a man hobble. While it makes the most annoying clanking noise you've ever heard, it'll ensure a mercenary is able to walk."
        ja = "木と金属で作られた義足。走るには向かないが、少なくとも足を引きずって歩くことはできる。聞いたこともないほど耳障りな金属音を立てるが、傭兵が歩けるようになることは確かだ。"
    }
    {
        en = "A fan of large feathers to be displayed behind a helm."
        ja = "兜の後ろに広げて飾る、大羽根の扇飾り。"
    }
    {
        en = "A fancy hat decorated with a pair of vibrant feathers usually worn by minstrels or nobles."
        ja = "吟遊詩人や貴族がよくかぶる、鮮やかな二枚の羽根で飾られた華美な帽子。"
    }
    {
        en = "A farmer's flail that has been bolstered with thicker sections of wood and bound with iron. Sharp spikes protrude from its frame, as if to mockingly imitate it's military counterpart."
        ja = "太い木材で補強し、鉄で縛った農具の殻竿。打ち棒から鋭い棘が突き出し、軍用フレイルを嘲るかのように真似ている。"
    }
    {
        en = "A fashionable fabric hat with a golden band, usually worn by the aristocrats."
        ja = "金の帯をあしらった流行の布帽子。主に貴族が身につける。"
    }
    {
        en = "A fashionable southern headdress made of soft fabrics, effectively mimicking the finery of the high courts."
        ja = "柔らかな布で作られた流行の南方風頭飾り。上流宮廷の華美を巧みに模している。"
    }
    {
        en = "A few bones from a Höllenhund; they still have a faint, eerie glow about them."
        ja = "ヘレンフントの骨が数本。今もかすかな不気味な光を帯びている。"
    }
    {
        en = "A fierce pack of sand beasts appear to have developed quite a taste for human flesh."
        ja = "獰猛な砂漠の獣の群れが、すっかり人肉の味を覚えたらしい。"
    }
    {
        en = "A figure runs out from behind a gravestone yelling and raving madly. You almost cut it down in surprise, but the person gets near and throws themself at your feet and starts sobbing out thanks. It takes several minutes for the pitiful moans to calm down enough to form coherent sentences. The words speak of dark things, of profane experiments performed on both the living and the dead by a man in black. The captive before you is the sole survivor, escaping the fate of the others by hiding under a pile of corpses deemed too rotten to be of use. That part of the tale, at least, is lent credence by appearance.\n\nWhile the survivor is thoroughly wretched and obviously abused, they clearly have resourcefulness and tenacity that would serve well in a mercenary outfit. Perhaps there is a place in the %companyname%?"
        ja = "墓石の陰から人影が飛び出し、狂ったように叫ぶ。驚いて斬りかけるが、その者は近づくと足元へ身を投げ、泣きながら感謝を述べる。哀れな呻きが意味ある言葉になるまで数分かかる。黒衣の男が生者と死者の両方に行った冒涜的な実験という、暗い話だ。目の前の囚人は唯一の生存者で、使えないほど腐った死体の山に隠れ、他の者の運命を免れた。少なくとも外見を見れば、その部分には信憑性がある。\n\n生存者はひどく惨めで、明らかに虐待されているが、傭兵団で役立つ機転と執念を備えている。%companyname%に居場所があるかもしれない。"
    }
    {
        en = "A fine cloth hat typically worn by the nobles."
        ja = "貴族がよくかぶる、上質な布帽子。"
    }
    {
        en = "A fine crown made of excellent materials"
        ja = "極上の素材で作られた、上品な冠。"
    }
    {
        en = "A fine crown made of metal."
        ja = "金属で作られた、上品な冠。"
    }
    {
        en = "A fine floppy hat made of excellent materials"
        ja = "極上の素材で作られた、上品な垂れ帽子。"
    }
    {
        en = "A fine hat made of excellent materials"
        ja = "極上の素材で作られた、上品な帽子。"
    }
    {
        en = "A fine hat made of exotic materials."
        ja = "異国の素材で作られた、上品な帽子。"
    }
    {
        en = "A fine hood made of excellent materials"
        ja = "極上の素材で作られた、上品な頭巾。"
    }
    {
        en = "A fine, flowing cloak made of light foreign silk that provides protection while looking exceptionally grand."
        ja = "異国の軽い絹で作られた、上質でたなびく外套。ひときわ豪奢に見せながら、防護ももたらす。"
    }
    {
        en = "A fine, flowing cloth covering for armor that displays noble colors or heraldry. It provides a layer of protection and a sense of belonging."
        ja = "貴族家の色や紋章を示す、上質でたなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A fine, linen tunic of exquisite material, embroidered with pleasing patterns. Light and sturdy."
        ja = "精緻な模様を刺繍した、極上素材の美しい亜麻布チュニック。軽く、丈夫である。"
    }
    {
        en = "A finely wrought golden buckle used to adorn noble headwear."
        ja = "貴族の帽子を飾るため、精巧に作られた金の留め金。"
    }
    {
        en = "A flashy harness commonly worn by pit fighters in arenas of the southern city states."
        ja = "南方都市国家の闘技場で、剣闘士がよく身につける派手な胴具。"
    }
    {
        en = "A flat metal helm with a bolted face plate with a perforated breath."
        ja = "鋲留めした面頬と、穴を開けた呼吸口を備える平らな金属兜。"
    }
    {
        en = "A flat metal helm with a nose guard, popular among the soldiers."
        ja = "鼻当てを備えた平らな金属兜。兵士の間で広く使われている。"
    }
    {
        en = "A floppy cloth hat of a southern vizier."
        ja = "南方の宰相がかぶる、垂れた布帽子。"
    }
    {
        en = "A floppy hat."
        ja = "垂れた帽子。"
    }
    {
        en = "A flowing cloth covering for armor that displays some colors or heraldry cut in the southern style. It provides a layer of protection and a sense of belonging."
        ja = "南方風に裁ち、色や紋章を示す、たなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A flowing cloth covering for armor that displays some colors or heraldry. It provides a layer of protection and a sense of belonging."
        ja = "色や紋章を示す、たなびく防具用の布覆い。防護を一層加え、一体感をもたらす。"
    }
    {
        en = "A flowing cloth covering for armor, to show your allegiance. Offers minimal protection and small boost to morale."
        ja = "忠誠の相手を示す、たなびく防具用の布覆い。防護はごくわずかだが、士気を少し高める。"
    }
    {
        en = "A flowing cloth sash that adds a vibrant splash of color to any attire."
        ja = "どんな装いにも鮮やかな彩りを添える、たなびく布の肩帯。"
    }
    {
        en = "A former militia recruit such as %name% eventually left the %companyname%. Traveling the lands, visiting villages and helping %them% establish credible militias with which to defend %themselves%. Finding success in an increasingly dangerous world, %name% eventually came to be a known name, called upon as a sort of 'fixer' to come and ensure these villages would remain safe. Last you heard, %name% had purchased a plot of land and was raising a family far from the strife of the world."
        ja = "%name%のような元民兵は、やがて%companyname%を去った。各地を巡り、村々を訪れ、%them%が%themselves%を守れるだけの民兵組織を整える手助けをした。危険を増す世界で成果を上げた%name%の名は次第に知られ、村の安全を確かなものにする「立て直し屋」として呼ばれるようになった。最後に聞いた話では、%name%は土地を買い、世の争いから遠く離れて家族を育てているという。"
    }
    {
        en = "A foul concoction that blends the essences of beasts with that of men. Drink at your own peril."
        ja = "獣と人の精髄を混ぜ合わせた、禍々しい調合薬。飲むなら覚悟せよ。"
    }
    {
        en = "A freshly minted scroll. Could be a masterpiece used to train your mercenaries or gibberish that will be of interest to local scribes."
        ja = "書き上げられたばかりの巻物。傭兵の訓練に使える傑作かもしれないし、地元の書記くらいしか興味を示さない戯言かもしれない。"
    }
    {
        en = "A full cloth head and face wrap that conceals the wearer's features entirely, leaving only a narrow opening for the eyes."
        ja = "頭と顔を布で完全に覆い、着用者の人相をすべて隠す被り物。目元に細い隙間だけが残されている。"
    }
    {
        en = "A full forced thrust attack meant to pierce two targets in a straight line."
        ja = "一直線上の2体を貫くため、全力で繰り出す刺突攻撃。"
    }
    {
        en = "A full helm crafted from overlapping long metal splints in the shape of a traditional southern head wrap."
        ja = "南方の伝統的な頭巻きを模し、長い金属片を重ねて作られた、頭全体を覆う兜。"
    }
    {
        en = "A full mail hood with an integrated neck guard."
        ja = "首当てと一体になった鎖帷子の頭巾。"
    }
    {
        en = "A full set of solid, plated steel armor."
        ja = "堅牢な鋼板製の全身甲冑一式。"
    }
    {
        en = "A fur covering fashioned from of a dangerous beast. It serves as a grim trophy that unnerves adversaries."
        ja = "危険な獣の毛皮を仕立てた被り物。敵を怯ませる陰惨な戦利品でもある。"
    }
    {
        en = "A gathering of absolutely correct occult readings that give insight into developing new traits. Will teach the relevant [color=%negative%]Trait[/color] perk group to the character that uses it. Can only read one skill book per brother so choose wisely. You can still read Ancient Scrolls if permitted."
        ja = "新たな特性を伸ばす手掛かりを与える、絶対に正しいオカルト文献の寄せ集め。使用した人物に、対応する[color=%negative%]特性[/color]パークグループを習得させる。技能書を読めるのは団員1人につき1冊だけなので、慎重に選ぶこと。許可されている場合は、古代の巻物を読むこともできる。"
    }
    {
        en = "A gilded visor with a pointed snout and plenty of holes to breathe through, providing great protection for a knight of high standing."
        ja = "尖った口先と多数の呼吸孔を備えた金箔の面頬。高位の騎士にふさわしい、優れた防護をもたらす。"
    }
    {
        en = "A gnarled staff no more, the twisted roots reformed into a beautiful pattern that only the Vala can create."
        ja = "もはや節くれだっただけの杖ではない。ねじれた根は、ヴァラにしか作れない美しい模様へと生まれ変わっている。"
    }
    {
        en = "A gnarly staff carved from old and hard wood, decorated with a menacing skull, feathers and small bones. The runes on the head are intricate and tell a story that only the goblins can read."
        ja = "古く硬い木から削り出した節くれだった杖。恐ろしい頭蓋骨、羽根、小骨で飾られている。先端の精緻なルーンは、ゴブリンだけが読める物語を記している。"
    }
    {
        en = "A golden helm and facemask, showing the visage of an emperor from an age long past, imbued with mystical energies. When you hold it into the light, it almost looks as if the face were moving and making expressions of disgust."
        ja = "遥か昔の皇帝の顔をかたどった、神秘的な力を宿す黄金の兜と仮面。光にかざすと、顔が動いて嫌悪の表情を浮かべているようにさえ見える。"
    }
    {
        en = "A good marching melody uplifts the company, granting them temporary AP. Targets can only be inspired once per turn."
        ja = "威勢のよい行進曲で傭兵団を奮い立たせ、一時的に行動力を与える。対象が鼓舞されるのは1ターンにつき1回だけ。"
    }
    {
        en = "A good sword doesn't come cheap."
        ja = "良い剣は安くない。"
    }
    {
        en = "A gracefully curved iron visor, featuring two eye-slits and a few breaths in the center."
        ja = "優美に湾曲した鉄製の面頬。二つの覗き穴と、中央にいくつかの呼吸孔がある。"
    }
    {
        en = "A grand tournament to the death, a celebration of slaughter. Eternal glory and prized items await."
        ja = "死ぬまで続く大試合、殺戮の祭典。永遠の栄光と価値ある品が待っている。"
    }
    {
        en = "A great bascinet that is formed of a single encompassing plate, covering the head completely, aswell as the neck and a bit of the shoulders too. Excellent protection."
        ja = "一枚の鋼板で頭部全体を包み、首と肩の一部まで覆うグレート・バシネット。優れた防護をもたらす。"
    }
    {
        en = "A great bascinet that is formed of a single encompassing plate, covering the head completely, aswell as the neck and a bit of the shoulders too. Includes a pig-faced visor for added face-protection."
        ja = "一枚の鋼板で頭部全体を包み、首と肩の一部まで覆うグレート・バシネット。顔をさらに守る豚面型の面頬も備える。"
    }
    {
        en = "A great, curved claw used to pin down or disembowel prey. Many would pay well for such a curiosity."
        ja = "獲物を押さえつけ、はらわたを裂くための大きく湾曲した鉤爪。この珍品なら、高値を払う者も多いだろう。"
    }
    {
        en = "A group of armed men step out onto the road.%SPEECH_ON%Sorry to do this to ya, friend. Us bounty hunters usually leave slave hunting to the southerners, but the vizier said he didn't care if you was dead or alive, and we need that money.%SPEECH_OFF%The man who spoke looks almost apologetic as he draws his weapon."
        ja = "武装した男たちが街道へ出てくる。%SPEECH_ON%悪く思うなよ。賞金稼ぎは奴隷狩りを南方人に任せるのが普通だ。だが宰相は死体でも生け捕りでも構わないと言った。俺たちには金が要る。%SPEECH_OFF%話した男は申し訳なさそうに武器を抜く。"
    }
    {
        en = "A group of brigands, more coordinated than usual."
        ja = "普段より統制の取れた盗賊の一団。"
    }
    {
        en = "A group of mean looking men filter out into the path in front of you. You glance over your shoulder and see more of them there, too.%SPEECH_ON%%nemesisviziername% sends his regards, slave.%SPEECH_OFF%One of the men in front of you spits out. Manhunters, then. You order the company to defend themselves as the hunters close in..."
        ja = "意地の悪そうな男たちが目の前の道へ次々現れる。肩越しに見ると、後ろにもいる。%SPEECH_ON%%nemesisviziername%からの挨拶だ、奴隷。%SPEECH_OFF%前の男の一人が吐き捨てる。人狩りか。狩人たちが迫り、あなたは傭兵団へ迎撃を命じる……。"
    }
    {
        en = "A gruesome sight"
        ja = "むごたらしい光景"
    }
    {
        en = "A hardened nasal helm with a cloth band and a tail."
        ja = "布帯と尾飾りを備えた、頑丈な鼻当て付き兜。"
    }
    {
        en = "A haunting, weathered faceplate featuring a hollow, open-mouthed expression typical of the funerary masks of the ancients."
        ja = "古代の葬送仮面に典型的な、口をぽっかり開けた虚ろな表情を刻む、風雨にさらされた不気味な面頬。"
    }
    {
        en = "A head covering made of wrapped cloth layers. Its thick folds help insulate the head against heat and dust."
        ja = "何層もの巻き布で作られた被り物。厚いひだが頭を暑さと埃から守る。"
    }
    {
        en = "A headdress adorned with a idol resembling the sun, looted from a tomb of a long dead civilization."
        ja = "遥か昔に滅びた文明の墓から略奪された、太陽を模した偶像を飾る頭飾り。"
    }
    {
        en = "A headscarf made of breathable silk, offering comfort to a desert traveler."
        ja = "通気性のよい絹で作られた頭巾。砂漠を旅する者に快適さを与える。"
    }
    {
        en = "A heap of human offal; limbs, skin, and gore, all salvaged from your fellow man, the perfect medium for your grim work. Requires constant preservation as the encroaching rot threatens to stall your efforts."
        ja = "人の臓物、手足、皮、血肉の山。同胞から集めた、陰惨な仕事にうってつけの素材だ。迫る腐敗に作業を止められぬよう、絶えず保存処置を施さねばならない。"
    }
    {
        en = "A heavy ancient helm with a once prominent side crest that has since deteriorated into a set of tattered plumes."
        ja = "かつては目立つ側面飾りを備えていた古代の重兜。今では朽ちた羽根飾りが残るだけだ。"
    }
    {
        en = "A heavy body vest of solid, plated steel designed for protecting the vitals."
        ja = "急所を守るよう設計された、堅牢な鋼板製の重い胴鎧。"
    }
    {
        en = "A heavy breastplate made of solid, plated steel, offering formidable protection at the cost of significant weight."
        ja = "堅牢な鋼板製の重い胸甲。相当な重量と引き換えに、強力な防護をもたらす。"
    }
    {
        en = "A heavy cleaver blade on top of a long shaft, used to deliver deep sweeping strikes over some distance. It might be confused for a simple and crude from weapon a layman, but the artisan who crafted this knew how to balance it perfectly."
        ja = "長柄の先に重い切断刃を取り付け、離れたところから深い薙ぎ払いを繰り出す武器。素人には単純で粗末な武器に見えるかもしれないが、これを作った職人は完璧な重量配分を心得ていた。"
    }
    {
        en = "A heavy cloth overcloak cinched with a buckled leather strap."
        ja = "革紐と留め金で締める、厚手布の上掛け。"
    }
    {
        en = "A heavy coat of small, interlocking metal scales that cover most of the body. The style and craftsmanship hint at the armor coming from a far-away region."
        ja = "小さな金属鱗を隙間なく連ね、身体の大半を覆う重い鱗鎧。その様式と出来栄えは、遥か遠方の地で作られたことを物語る。"
    }
    {
        en = "A heavy coat of thick, overlapping metal scales that are worn and missing in places, offering questionable protection for its weight."
        ja = "厚い金属鱗を重ねた重い上着。擦り減って欠けた箇所もあり、その重量に見合う防護かは疑わしい。"
    }
    {
        en = "A heavy coat of thick, overlapping metal scales, which cover most of the body."
        ja = "身体の大半を覆う、厚い金属鱗を重ねた重い上着。"
    }
    {
        en = "A heavy dome helm topped with a tail, on which the time has left its distinctive mark."
        ja = "歳月の跡が色濃く残る、尾飾り付きの重い丸鉢兜。"
    }
    {
        en = "A heavy helm made from overlapping metal plates, featuring an ornate nasal guard."
        ja = "金属板を重ねて作り、華美な鼻当てを備えた重兜。"
    }
    {
        en = "A heavy helm typical of the northern barbarians with a skull-like face mask. This piece is as massive as it is impressive."
        ja = "頭蓋骨を模した仮面を持つ、北方蛮族特有の重兜。その姿は巨大で、見る者を圧倒する。"
    }
    {
        en = "A heavy helm with a tall, bladed crest and a perforated faceplate. A battered echo of past glories of those who once bled for the entertainment of a dead empire."
        ja = "高い刃状の兜飾りと、穴を開けた面頬を備える重兜。滅びた帝国で見世物のため血を流した者たちの、色褪せ傷ついた栄光の残響である。"
    }
    {
        en = "A heavy helm with a tattered horsehair plume and dulled finish, once a symbol of a legion's iron discipline."
        ja = "擦り切れた馬毛の羽根飾りと鈍い表面を持つ重兜。かつては軍団の鉄の規律を象徴していた。"
    }
    {
        en = "A heavy lamellar harness of metal plates that provides good protection, but is very fatiguing to wear."
        ja = "金属板を連ねた重いラメラー胴具。優れた防護を得られるが、着用による疲労が非常に大きい。"
    }
    {
        en = "A heavy leather apron designed to protect the wearer's clothing from stains and fluids. Usually worn by those who tend to the dead."
        ja = "染みや体液から衣服を守るための重い革前掛け。死者の世話をする者がよく身につける。"
    }
    {
        en = "A heavy leather apron of withstanding intense heat and stray sparks. Favored by blacksmiths."
        ja = "強烈な熱と飛び散る火花に耐える重い革前掛け。鍛冶屋に好まれる。"
    }
    {
        en = "A heavy linen jacket worn by fault finders."
        ja = "咎探したちが着る、厚手の亜麻布の上着。"
    }
    {
        en = "A heavy mail hood. It features extra leather layering to help prevent chafing."
        ja = "重い鎖帷子の頭巾。革を重ね、擦れを防ぐ工夫が施されている。"
    }
    {
        en = "A heavy shirt of interlapping metal plates worn over mail."
        ja = "鎖帷子の上に着る、金属板を重ねた重い胴衣。"
    }
    {
        en = "A heavy steel helm with added bolted cheek guards that offers extensive coverage for the jaw and the temples."
        ja = "顎とこめかみを広く覆う、鋲留めの頬当てを追加した重い鋼鉄兜。"
    }
    {
        en = "A heavy tarnished thick breastplate of ancient origin that offers some protection."
        ja = "古代に作られた、分厚く重い変色した胸甲。ある程度の防護は残っている。"
    }
    {
        en = "A heavy tunic lined with a thick wolf pelt that offers decent protection."
        ja = "厚い狼皮を裏地にした重いチュニック。十分な防護を得られる。"
    }
    {
        en = "A heavy winged mace from the south. The smith who forged this weapon certainly knew what he was doing."
        ja = "南方の重いウィングド・メイス。これを鍛えた職人が確かな腕を持っていたことは疑いない。"
    }
    {
        en = "A heavy, cylindrical helm choked with rust and mold, marred by deep corrosion."
        ja = "錆と黴に覆われ、深く腐食した、重い円筒形の兜。"
    }
    {
        en = "A heavy, cylindrical helm reinforced with a cross-plate and a perforated breath, offering near-total head protection at the cost of peripheral vision."
        ja = "十字の補強板と穴を開けた呼吸口を備える、重い円筒形の兜。周辺視野と引き換えに、頭部をほぼ完全に守る。"
    }
    {
        en = "A heavy, cylindrical helm, which once belonged to a decorated knight. Incrusted with gold and precious gems, it betrays a craftsmanship which years of neglect could not diminish."
        ja = "かつて勲功ある騎士が所有していた、重い円筒形の兜。金と宝石を散りばめた造りは、長年放置されてもなお損なわれぬ職人技を示している。"
    }
    {
        en = "A heavy, deep cowl designed to hide the identity of the executioner from the vengeance of those sympathetic to the condemned. Counts as a cultist item."
        ja = "処刑された者へ同情する者の報復から、処刑人の素性を隠すための、深く垂れた重い頭巾。教団員の装備として扱われる。"
    }
    {
        en = "A heavy, dilapidated plate helm with a faceplate and a tail, belonging to a legionary of yore."
        ja = "古の軍団兵が使っていた、面頬と尾飾り付きの朽ちた重い板金兜。"
    }
    {
        en = "A heavy, exquisite metal faceplate in the shape of a face frozen in a mocking smile."
        ja = "嘲るような笑顔のまま凍りついた人面をかたどる、重く精美な金属製面頬。"
    }
    {
        en = "A heavy, padded tunic that offers decent protection."
        ja = "十分な防護を得られる、厚手の詰め物入りチュニック。"
    }
    {
        en = "A heavy, perforated metal faceplate."
        ja = "穴を開けた重い金属製面頬。"
    }
    {
        en = "A heavy, reinforced faceplate raised up to allow the user to breathe freely without obscuring his face."
        ja = "顔を隠さず自由に呼吸できるよう、上方へ持ち上げた重い補強面頬。"
    }
    {
        en = "A heavy, tarnished scale coat of ancient design, which belongs in a collection rather than on the battlefield."
        ja = "古代様式の重く変色した鱗鎧。戦場よりも収集品の棚に置くべき代物だ。"
    }
    {
        en = "A heavy, weathered faceplate depicting a stern, bearded visage from another time."
        ja = "遠い昔の厳めしい髭面を刻んだ、重く風雨にさらされた面頬。"
    }
    {
        en = "A helm with a heavy crest and jutting cheek guards, its glory faded by the passage of time."
        ja = "重い兜飾りと突き出た頬当てを備える兜。その栄華は歳月に色褪せている。"
    }
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, the beast may be dead, but it continues to mend itself even after death"
        ja = "強大な岩のウンホルトの皮と頭蓋骨で作られた兜。獣は死んだが、今なお自らを修復し続ける。"
    }
    {
        en = "A helmet crafted from the skin and skull of a mighty rock unhold, which continues to mend itself even after the beast's death."
        ja = "強大な岩のウンホルトの皮と頭蓋骨で作られた兜。獣が死んだ後も、自らを修復し続けている。"
    }
    {
        en = "A helmet fashioned made from the face and horns of a skin ghoul."
        ja = "スキングールの顔皮と角で作られた兜。"
    }
    {
        en = "A hollowed out reed used to shoot (toxic) darts. "
        ja = "（毒）矢を吹き出すため、中をくり抜いた葦。"
    }
    {
        en = "A holy cloak of thick, layered, warm wool that provides some protection, but is quite hefty."
        ja = "厚く重ねた暖かな羊毛で作られた聖なる外套。ある程度の防護を得られるが、かなり重い。"
    }
    {
        en = "A holy relic shield to be strapped to the shoulder, it protects the wearer both physically and spiritually. Primarily of benefit to the strong of mind."
        ja = "肩に括り付ける聖遺物の盾。肉体と魂の双方を守り、特に精神力の高い者へ恩恵をもたらす。"
    }
    {
        en = "A hood made of chain mail of southern design. Offers good protection and while leaving the face unobstructed."
        ja = "南方様式の鎖帷子で作られた頭巾。顔を遮らず、優れた防護を得られる。"
    }
    {
        en = "A hood made of chain mail with a leather brim and a cloth mask. Keeps the wearer's face obstructed while being surprisingly comfortable to wear."
        ja = "革の縁と布の覆面を備えた鎖帷子の頭巾。顔を隠しながらも、驚くほど快適に着用できる。"
    }
    {
        en = "A hood made of chain mail with a leather brim. Offers good protection and while leaving the face unobstructed."
        ja = "革の縁を備えた鎖帷子の頭巾。顔を遮らず、優れた防護を得られる。"
    }
    {
        en = "A hood made of interlocking bronze rings. Very heavy, but offers excellent protection."
        ja = "青銅の輪を組み合わせた頭巾。非常に重いが、優れた防護をもたらす。"
    }
    {
        en = "A hood of fine cloth decorated with gilded bosses."
        ja = "金箔の鋲飾りをあしらった、上質な布の頭巾。"
    }
    {
        en = "A hood worn by executioners to protect their identity and prevent retaliation. Counts as a cultist item."
        ja = "素性を隠し、報復を防ぐために処刑人がかぶる頭巾。教団員の装備として扱われる。"
    }
    {
        en = "A hooded cowl with decorated, scalloped edges that provides a quite dashing appearance."
        ja = "波形の縁飾りを施した頭巾付き肩掛け。実に洒落た姿を演出する。"
    }
    {
        en = "A hooded cowl with dour, tabbed edges that helps one stay unremarkable and unassuming."
        ja = "陰気な垂れ飾りの縁を持つ頭巾付き肩掛け。目立たず、控えめな姿を保つのに役立つ。"
    }
    {
        en = "A horde of terrorizing skin ghouls."
        ja = "人々を恐怖に陥れるスキングールの大群。"
    }
    {
        en = "A horse eats more than humans, can't wear human armor, moves much better on flat terrain, but worse on rough terrain"
        ja = "馬は人間より多く食べ、人間用の防具を着られない。平坦な地形でははるかによく動けるが、険しい地形では動きが悪くなる。"
    }
    {
        en = "A horse moves much better on flat terrain, but worse on rough terrain"
        ja = "馬は平坦な地形でははるかによく動けるが、険しい地形では動きが悪くなる。"
    }
    {
        en = "A huge and sturdy double headed battleaxe too heavy to be used effectively by the average human."
        ja = "並の人間にはまともに扱えないほど重い、巨大で頑丈な双頭戦斧。"
    }
    {
        en = "A huge club decorated with skulls and horns, woven in patterns that betray strange meaning. For the average mercenary you just need to know that a blow will leave a person reeling and struggling for breath."
        ja = "頭蓋骨と角で飾られ、奇妙な意味を秘めた模様を編み込んだ巨大な棍棒。普通の傭兵が知っておくべきことはただ一つ――これで殴られれば、よろめき、息もできなくなる。"
    }
    {
        en = "A huge crest of colorful feathers arrayed behind a helm."
        ja = "兜の後ろへ大きく広がる、色鮮やかな巨大羽根の兜飾り。"
    }
    {
        en = "A huge quiver of arrows, required to use bows of all kinds. Is automatically refilled after each battle if you have enough ammunition."
        ja = "あらゆる弓を使うために必要な、巨大な矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A huge quiver of bolts, required to use crossbows. Is automatically refilled after each battle if you have enough ammunition."
        ja = "クロスボウを使うために必要な、巨大なボルト用矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。"
    }
    {
        en = "A jacket of patched southern leather that is light enough for long journeys through the desert."
        ja = "南方の革を継ぎ合わせた上着。砂漠を長く旅できるほど軽い。"
    }
    {
        en = "A jagged harpoon, that flies true despite it's weight and size. Harder to throw and hit with, but more impactful."
        ja = "重さと大きさにもかかわらず、狙いどおり飛ぶ鋸歯付きの銛。投げにくく命中させづらいが、その一撃はより強烈だ。"
    }
    {
        en = "A jagged, intimidating arrangement of bones, fashioned by orcs into a grisly trophy."
        ja = "オークが陰惨な戦利品として組み上げた、ぎざぎざで威圧的な骨飾り。"
    }
    {
        en = "A jump forward and attack combined into a single move."
        ja = "前方へ跳び込み、移動と攻撃を一度に行う。"
    }
    {
        en = "A knotted pony tail. A sign of prowess in some of the lands."
        ja = "結び目を作った馬の尾。ある土地では武勇の印とされる。"
    }
    {
        en = "A large and heavy crossbow with menacing spikes in front. It's a mystery how goblins could improve upon a miniature ballista, but here we are. It shoots stakes with enough force to knock back a target hit. Very effective against vampires."
        ja = "正面に凶悪な棘を備えた、大きく重いクロスボウ。ゴブリンが小型バリスタをどう改良したのかは謎だが、現物がここにある。杭を撃ち出し、命中した標的をノックバックさせるほどの威力を持つ。吸血鬼に非常に有効。"
    }
    {
        en = "A large bascinet covering the entirety of the head as well as the neck with plates. Offers great protection but makes it quite difficult to turn one's neck."
        ja = "頭部全体と首を板金で覆う大型のバシネット。優れた防護を得られるが、首を回すのがかなり難しくなる。"
    }
    {
        en = "A large branch whittled to a fine point. It's so unbalanced and irregular you need to use two hands just to keep it steady. Liable to snap at any moment. Deals additional damage to vampires"
        ja = "大枝の先端を鋭く削ったもの。あまりに不均衡でいびつなため、安定させるだけでも両手を使わねばならない。今にも折れそうだ。吸血鬼に追加ダメージを与える。"
    }
    {
        en = "A large cart and donkey, excellent for carrying many things, but must be protected in battle."
        ja = "大量の荷物を運べる大型の荷車とロバ。戦闘では守らなければならない。"
    }
    {
        en = "A large force hunting you down."
        ja = "あなたを追い詰めようとする大軍。"
    }
    {
        en = "A large linen turban, worn to protect the head from the overbearing sun."
        ja = "容赦ない陽光から頭を守る、大きな亜麻布のターバン。"
    }
    {
        en = "A large patch of mail that can be added to any armor to protect the arms and the shoulders."
        ja = "どの防具にも取り付けられ、腕と肩を守る大きな鎖帷子の継ぎ当て。"
    }
    {
        en = "A large pie made from freshly sourced ingredients. Can be eaten in battle to provide up to 4 healing and fatigue recovery each turn for five turns, based on the amount remaining. Will be used as provisions if left in the company stash."
        ja = "新鮮な材料で作った大きなパイ。戦闘中に食べると、残量に応じて5ターンのあいだ毎ターン最大4の体力と疲労を回復する。傭兵団の保管庫に残しておくと食糧として消費される。"
    }
    {
        en = "A large quiver of arrows with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a bow."
        ja = "肉を裂くための幅広い鏃を付けた大型の矢筒。ただし装甲には阻まれやすい。十分な共通矢弾があれば、戦闘終了後に自動で補充される。弓の使用中はダメージが10%増加する一方、装甲を無視するダメージが10%減少する。"
    }
    {
        en = "A large quiver of arrows with piercing tips, designed for punching through thick armor. Is automatically refilled after each battle if you have enough ammunition. Grants 30% more armor piercing, but 10% less damage while wielding a bow."
        ja = "厚い装甲を撃ち抜くための貫通鏃を付けた大型の矢筒。十分な矢弾があれば、戦闘終了後に自動で補充される。弓の使用中は装甲を無視するダメージが30%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with broad tips, designed for tearing flesh, but easily stopped by armor. Is automatically refilled after each battle if you have enough global ammunition. Grants 10% more damage, but 10% less armor piercing damage while wielding a crossbow."
        ja = "肉を裂く幅広い鏃のボルトを収めた大型矢筒。ただし装甲には阻まれやすい。十分な共通矢弾があれば、戦闘終了後に自動で補充される。クロスボウの使用中はダメージが10%増加する一方、装甲を無視するダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage"
        ja = "装甲を貫く細い鏃のボルトを収めた大型矢筒。ただし肉体へのダメージは低い。十分な共通矢弾があれば、戦闘終了後に自動で補充される。装甲を無視するダメージが20%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large quiver of bolts with thin piercing tips, designed for piercing armor, but doing less damage to flesh. Is automatically refilled after each battle if you have enough global ammunition. Grants 20% more armor piercing damage, but 10% less damage, while wielding a crossbow."
        ja = "装甲を貫く細い鏃のボルトを収めた大型矢筒。ただし肉体へのダメージは低い。十分な共通矢弾があれば、戦闘終了後に自動で補充される。クロスボウの使用中は装甲を無視するダメージが20%増加する一方、ダメージが10%減少する。"
    }
    {
        en = "A large rusty patch of mail that can be added to any armor to protect the arms and the shoulders."
        ja = "どの防具にも取り付けられ、腕と肩を守る大きな錆びた鎖帷子の継ぎ当て。"
    }
    {
        en = "A large square shield that offers excellent protection for yourself and others, very heavy and hard to maneuver"
        ja = "自分と周囲の者へ優れた防護をもたらす大きな方形盾。非常に重く、取り回しにくい。"
    }
    {
        en = "A large square shield that offers excellent protection for yourself and others. It is stout, heavy and broad - offering excellent protection from attacks aimed at the sides."
        ja = "自分と周囲の者へ優れた防護をもたらす大きな方形盾。堅牢で重く幅広く、側面から狙われた攻撃に対しても優れた防護を発揮する。"
    }
    {
        en = "A large stick attached with a short chain to a long pole, the Peasant Flail is an agricultural tool used to strike piles of grain to loosen the husks. As an improvised weapon it's rather unpredictable but useful to strike over or around shield cover."
        ja = "長い柄に短い鎖で大きな打ち棒をつないだ農民用フレイル。本来は穀物の山を打って殻を外す農具である。即席武器としては予測しづらいが、盾越しや盾の回りから打ち込むのに役立つ。"
    }
    {
        en = "A larger, broader ancient spear with a leaf-shaped head. It is much heavier than it's counterparts, but leaves a significantly larger wound at the cost of penetrating power."
        ja = "葉形の穂先を備えた、より大きく幅広い古代の槍。同類よりはるかに重く、貫通力を犠牲にして大きな傷を残す。"
    }
    {
        en = "A lavish crested heraldic ornament of a noble house, leaving no doubt as to the wearer's allegiance."
        ja = "貴族家の紋章をあしらった豪奢な兜飾り。着用者がどの家に属するか、一目で分かる。"
    }
    {
        en = "A leader of many, a slave to a few."
        ja = "多くを率い、少数に仕える奴隷。"
    }
    {
        en = "A leader to few, a slave of many."
        ja = "少数を率い、多くに仕える奴隷。"
    }
    {
        en = "A learned surgeon from the south, their knowledge of medicine outstrips those of the oldest monks and witches."
        ja = "南方で学を修めた外科医。医学の知識は最古参の修道士や魔女すら凌ぐ。"
    }
    {
        en = "A leather armor reinforced with metal rivets. Fatiguing to wear."
        ja = "金属鋲で補強した革鎧。着用による疲労が大きい。"
    }
    {
        en = "A leather jacket that offers modest protection against the elements and light physical harm."
        ja = "風雨と軽い怪我からそこそこ身を守る革の上着。"
    }
    {
        en = "A leather tunic caked and crusted with dried remnants of past executions."
        ja = "過去の処刑で飛び散ったものが乾き、こびりついた革のチュニック。"
    }
    {
        en = "A legendary white wolf, tamed to be a loyal companion in battle. Can be unleashed in battle."
        ja = "戦闘で忠実に付き従うよう飼い慣らされた、伝説的な白狼。戦闘中に解き放てる。"
    }
    {
        en = "A length of intertwined metal links. As a weapon it's ungainly and rather unpredictable but useful to spin, strike around shield cover and pull in enemies."
        ja = "金属の輪を絡み合わせた一本の鎖。武器としては扱いづらく予測しにくいが、振り回して盾の回りから打ち込み、敵を引き寄せるのに役立つ。"
    }
    {
        en = "A light and well made checkered tunic of southern origin."
        ja = "南方由来の、軽く仕立てのよい市松模様のチュニック。"
    }
    {
        en = "A light armet without a visor."
        ja = "面頬のない軽いアーメット。"
    }
    {
        en = "A light cap of quilted linen, providing a layer of padding for the head and the neck."
        ja = "キルティングした亜麻布の軽い帽子。頭と首を守る緩衝層となる。"
    }
    {
        en = "A light cap of quilted linen, providing a layer of padding for the head."
        ja = "キルティングした亜麻布の軽い帽子。頭を守る緩衝層となる。"
    }
    {
        en = "A light cloth wrap for the head. A practical choice for shielding oneself from the sun and dust."
        ja = "頭を覆う軽い巻き布。陽光と埃から身を守る実用品。"
    }
    {
        en = "A light helmet made from the carapace of a redback spider."
        ja = "レッドバック蜘蛛の甲殻で作られた軽兜。"
    }
    {
        en = "A light metal helm with a nose guard."
        ja = "鼻当てを備えた軽い金属兜。"
    }
    {
        en = "A light tailed cloth head wrap bound by a gilded band."
        ja = "金箔の帯で留めた、尾のように垂れる軽い布の頭巻き。"
    }
    {
        en = "A light yet durable replacement padding crafted from exotic materials."
        ja = "異国の素材で作られた、軽く丈夫な交換用の詰め物。"
    }
    {
        en = "A light, ceremonial version of a two-handed cleaver with a curved end, adorned with gold inlay and odd motifs."
        ja = "湾曲した先端を持つ両手持ちクリーバーの軽量な儀礼用モデル。金象嵌と奇妙な文様で飾られている。"
    }
    {
        en = "A light, feathered cloth with featuring a thin face mask."
        ja = "薄い覆面を備えた、羽根飾り付きの軽い布製被り物。"
    }
    {
        en = "A lightweight, curved sword good at piercing armor and delivering wicked strikes."
        ja = "軽く湾曲し、装甲を貫いて凶悪な一撃を与えるのに適した剣。"
    }
    {
        en = "A lightweight, flowing cloak of spider silk. It offers excellent protection against poison and ranged attacks."
        ja = "蜘蛛の糸で作られた、軽くたなびく外套。毒と遠隔攻撃に対し、優れた防護をもたらす。"
    }
    {
        en = "A linen sash and belt previously worn by followers of the Diviner."
        ja = "占術師の信奉者がかつて身につけていた、亜麻布の肩帯と腰帯。"
    }
    {
        en = "A lion crested crown belonging to a king of a long dead civilization."
        ja = "遥か昔に滅びた文明の王が所有していた、獅子の意匠を頂く冠。"
    }
    {
        en = "A little hatred can be a powerful thing."
        ja = "少しの憎しみが大きな力になることもある。"
    }
    {
        en = "A long and heavy mail shirt of southern design made with slightly thinner and lighter metal rings than those used in the north"
        ja = "北方で使われるものよりやや細く軽い金属環で作られた、南方様式の長く重い鎖帷子。"
    }
    {
        en = "A long and sturdy glaive built for heavy combat, used to thrust, deal sweeping strikes over some distance and slashes in close range."
        ja = "激しい戦闘向けに作られた、長く頑丈なグレイヴ。離れたところからの刺突と薙ぎ払い、近距離での斬撃に用いられる。"
    }
    {
        en = "A long curved blade adorned with gold inlays depicting a variety of subjects from harvests to battles. It is a much lighter weapon than expected and clearly served a ceremonial purpose."
        ja = "収穫から戦争まで、さまざまな題材を描く金象嵌を施した長い湾曲刀。見た目よりはるかに軽く、明らかに儀礼用として作られている。"
    }
    {
        en = "A long leather coat reinforced with large metal rivets offering good protection, but very fatiguing to wear."
        ja = "大きな金属鋲で補強した長い革外套。優れた防護をもたらすが、着用による疲労が非常に大きい。"
    }
    {
        en = "A long nosed iron faceplate assuring great ventilation."
        ja = "通気性に優れた、長い鼻先を持つ鉄製の面頬。"
    }
    {
        en = "A long shard of sharpened rock firmly wedged into a massive bone. Not well suited for human hands. "
        ja = "巨大な骨に、鋭く尖らせた長い岩片をしっかり打ち込んだもの。人間の手には向かない。"
    }
    {
        en = "A long tail of horsehair used to crest helms."
        ja = "兜飾りに使う、長い馬毛の尾。"
    }
    {
        en = "A long, exceptionally well crafted two-handed axe used by footmen in the noble wars"
        ja = "貴族戦争で歩兵が使った、長く並外れて出来のよい両手斧。"
    }
    {
        en = "A long, oversized hood that keeps the rain off the neck."
        ja = "首筋を雨から守る、長く大きすぎる頭巾。"
    }
    {
        en = "A long, sturdy and tunic of southern origin that offers decent protection."
        ja = "南方由来の、長く頑丈で十分な防護を得られるチュニック。"
    }
    {
        en = "A long, sturdy coat reinforced with metal studs that offers good protection."
        ja = "金属鋲で補強した、長く頑丈な上着。優れた防護をもたらす。"
    }
    {
        en = "A long, sturdy tunic of southern origin that is split at the bottom."
        ja = "裾に切れ込みを入れた、南方由来の長く頑丈なチュニック。"
    }
    {
        en = "A long, two-handed axe that doubles as a very heavy fan"
        ja = "極めて重い扇としても使える、長い両手斧。"
    }
    {
        en = "A long, two-handed axe used by footmen in the noble wars"
        ja = "貴族戦争で歩兵が使った、長い両手斧。"
    }
    {
        en = "A longsword and medium armour has never failed me."
        ja = "長剣と中装鎧は、これまで一度も裏切らなかった。"
    }
    {
        en = "A lover of the sale, %name% the trader couldn't stay fighting for long. They eventually left the %companyname% to go out and start their own business. Recently, you got word that they were selling trinkets with the company's sigil on them. You specifically told them to do whatever they wanted except just this one thing, but apparently your warning merely fostered the idea. When you went to tell them to stop, they slammed a crown-bulging satchel on a rather ornate table, saying it was your 'cut.' They sell those trinkets to this day."
        ja = "商売を愛する交易商の%name%は、長く戦い続けることができなかった。やがて%companyname%を去り、自ら商いを始めた。最近、傭兵団の紋章入りの装身具を売っているという知らせが届いた。好きにしていいが、それだけはするなと念を押したのに、どうやら警告でかえって思いつかせてしまったらしい。やめさせに出向くと、その交易商はクラウンで膨らんだ袋を豪奢な机へ叩きつけ、あなたの「取り分」だと言った。その装身具は今も売られ続けている。"
    }
    {
        en = "A low, broad-rimmed metal helm, rusted and dented."
        ja = "低く広い縁を持つ、錆びてへこんだ金属兜。"
    }
    {
        en = "A luxurious pelt of a rare beast, turned by a taxidermist into a regal head covering."
        ja = "希少な獣の豪奢な毛皮を、剥製師が威厳ある被り物へ仕立てたもの。"
    }
    {
        en = "A luxurious striped tabard made of a sturdy material, reinforced at seams with pure gold."
        ja = "丈夫な素材で作り、縫い目を純金で補強した豪奢な縞模様のタバード。"
    }
    {
        en = "A magic circle that protects all allies within when cast. Leaving the circle breaks the protection."
        ja = "魔法陣を展開し、その内側にいる味方全員を守る。陣の外へ出ると加護は失われる。"
    }
    {
        en = "A mail aventail that extends from below the eyeline to cover the neck and lower face."
        ja = "目の下から首と顔の下半分まで覆う、鎖帷子のアヴェンテイル。"
    }
    {
        en = "A mail hood covered in a layer of rust. Offers good protection, but leaves horrible stains."
        ja = "錆に覆われた鎖帷子の頭巾。優れた防護をもたらすが、ひどい染みが付く。"
    }
    {
        en = "A mail hood of southern design with a reinforced circular face opening."
        ja = "顔周りの円形開口部を補強した、南方様式の鎖帷子の頭巾。"
    }
    {
        en = "A makeshift weapon fashioned from a rusty metal scrap wrapped in cloth. Fit only for the desperate or deranged."
        ja = "錆びた金属片を布で巻いて作った間に合わせの武器。自暴自棄か正気を失った者にしかふさわしくない。"
    }
    {
        en = "A malevolent presence lurks in the heart of the forest, its dark aura spreading like a poison through the trees and soil."
        ja = "森の奥に邪悪な存在が潜み、その暗い気配が毒のように木々と土へ広がっている。"
    }
    {
        en = "A marvel of a fighting horse, %name% the Destrier was retired to horse breeder, where he was treated lavishly as he helped father the next generation of living engines-of-war"
        ja = "見事な軍馬だったデストリアの%name%は種馬として牧場へ引退し、次代の生きた戦争機械を生み出す父馬として、贅沢な扱いを受けた。"
    }
    {
        en = "A massive ancient hammer with two ram heads making up both faces of the weapon. It is deceptively heavy and somehow increases in weight between each swing."
        ja = "両方の打面を雄羊の頭が形作る、巨大な古代の鎚。見た目以上に重く、振るたびになぜか重さを増していく。"
    }
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Not well suited for human hands."
        ja = "無垢の鉄塊を頭部にした、巨大で粗末な鎚。人間の手には向かない。"
    }
    {
        en = "A massive crude hammer with a head fashioned from a chunk of solid iron. Too heavy to be used effectively by the average human."
        ja = "無垢の鉄塊を頭部にした、巨大で粗末な鎚。重すぎて、並の人間にはまともに扱えない。"
    }
    {
        en = "A massive iron chain with a heavy piece at the end. Too heavy to be used effectively by the average human."
        ja = "先端に重い錘を付けた巨大な鉄鎖。重すぎて、並の人間にはまともに扱えない。"
    }
    {
        en = "A massive two-handed blade as good for carving swathes through the enemy as for battering them into submission."
        ja = "敵陣を薙ぎ払うにも、殴り伏せて降伏させるにも適した巨大な両手剣。"
    }
    {
        en = "A massive wooden club with a spiked head. Receiving a blow from this weapon will leave anyone dazed and gasping for air."
        ja = "棘付きの頭部を持つ巨大な木製棍棒。この武器の一撃を受ければ、誰であれ朦朧とし、息を切らすことになる。"
    }
    {
        en = "A massive, crudely sharpened shard of metal that makes up for its stunted length through sheer weight. So heavy no average human can use it effectively."
        ja = "短さを純粋な重量で補う、巨大で粗く研がれた金属片。あまりに重く、並の人間にはまともに扱えない。"
    }
    {
        en = "A mastercrafted heavy padded tunic that offers excellent protection."
        ja = "名匠が仕立てた、優れた防護をもたらす重い詰め物入りチュニック。"
    }
    {
        en = "A mastercrafted two-piece barbute helm, meticulously joined and well-maintained."
        ja = "二枚を丹念につなぎ合わせ、手入れも行き届いた、名匠作のバルビュート兜。"
    }
    {
        en = "A masterfully crafted glaive that feels surprisingly light, yet sturdy."
        ja = "驚くほど軽く、それでいて頑丈な、名匠作のグレイヴ。"
    }
    {
        en = "A masterfully crafted harness of solid, plated steel, finished with a layer of decorative paint."
        ja = "名匠が仕立てた、堅牢な鋼板製の全身甲冑。装飾塗装で仕上げられている。"
    }
    {
        en = "A masterfully crafted harness of solid, plated steel."
        ja = "名匠が仕立てた、堅牢な鋼板製の全身甲冑。"
    }
    {
        en = "A masterwork leather armor made from overlapping lindwurm scales. Not only do the scales deflect blows and hits, but they also remain unscathed by the acidic Lindwurm blood."
        ja = "リントヴルムの鱗を重ねて作られた名匠作の革鎧。鱗は打撃を逸らすだけでなく、リントヴルムの酸性の血を浴びても傷ひとつ付かない。"
    }
    {
        en = "A masterwork metal helm with a spiked conical crown and a reinforced nasal guard, crested by twin feathers. Light yet sturdy."
        ja = "棘のある円錐形の鉢、補強した鼻当て、二枚の羽根飾りを備えた名匠作の金属兜。軽く、しかも頑丈である。"
    }
    {
        en = "A masterwork prosthetic hand which articulates joints without resistance. The fingers grip whatever they are holding very tightly, making it near impossible to knock a weapon from this hand. Spikes were added to make punches hurt even more."
        ja = "関節を抵抗なく動かせる、名工の義手。指は持った物を非常に強く握り、武器をこの手から叩き落とすのはほぼ不可能となる。拳で殴った時の威力をさらに増すため、棘も取り付けられている。"
    }
    {
        en = "A melee hit on the hyena frees the victim"
        ja = "ハイエナに近接攻撃を命中させると、犠牲者が解放される。"
    }
    {
        en = "A metal armguard that provides additional protection, used by gladiators in fighting pits."
        ja = "闘技場の剣闘士が使う、追加の防護をもたらす金属製の腕当て。"
    }
    {
        en = "A metal cervelliere with a deep, rounded bowl and bolted cheek guards, providing good protection."
        ja = "深く丸い鉢と鋲留めの頬当てを備え、優れた防護をもたらす金属製セルヴェリエール。"
    }
    {
        en = "A metal faceplate in the shape of a human face."
        ja = "人の顔をかたどった金属製の面頬。"
    }
    {
        en = "A metal faceplate with an aggressive profile designed to deflect blows away from the wearer's face."
        ja = "攻撃を着用者の顔から逸らすよう、威圧的な輪郭に作られた金属製面頬。"
    }
    {
        en = "A metal helm with a broad rim, popular among the soldiers."
        ja = "幅広い縁を持つ金属兜。兵士の間で広く使われている。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a faceplate and a neck guard."
        ja = "翼をかたどった金属製の顎当て。面頬と首当ても備える。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a faceplate."
        ja = "翼をかたどった金属製の顎当て。面頬も備える。"
    }
    {
        en = "A metal jaw guard formed into the shape of wings with a neck guard."
        ja = "翼をかたどった金属製の顎当て。首当ても備える。"
    }
    {
        en = "A metal mask covering the eyes and nose from blows."
        ja = "目と鼻を打撃から守る金属製の仮面。"
    }
    {
        en = "A metal sallet helm with an extended neck guard, a design uncommon in these lands. Well crafted to offer maximum protection with minimum weight, and without impairing vision."
        ja = "この地では珍しい、長い首当てを備えた金属製サレット。視界を妨げず、最小限の重量で最大限の防護を得られるよう、巧みに作られている。"
    }
    {
        en = "A metal skull cap topped with a fashionable spike."
        ja = "流行の棘飾りを頂いた、金属製の鉢金。"
    }
    {
        en = "A metal weight attached with a short chain to a long pole, the War Flail is a brutal weapon. Deadly enough to fell most men with a good hit to the head, and useful to strike over or around shield cover."
        ja = "長い柄に短い鎖で金属錘をつないだ、残忍な軍用フレイル。頭へまともに当たれば大抵の者を倒せるほど致命的で、盾越しや盾の回りから打ち込むのにも役立つ。"
    }
    {
        en = "A mighty barbarian king claims his throne in the frozen north, his rule marked by fire and steel."
        ja = "強大な蛮族王が凍てつく北方で王を名乗っている。その支配は炎と鋼に彩られている。"
    }
    {
        en = "A military figure of great experience and prowess"
        ja = "経験も武勇も卓越した軍人。"
    }
    {
        en = "A military grade metal-reinforced club with a spike at the top. Can be used to thrust at the enemy, or pummel them into submission."
        ja = "軍用に作られた、金属補強と頂部の棘を持つ棍棒。敵を突くことも、殴り伏せて降伏させることもできる。"
    }
    {
        en = "A miniature pull-lever crossbow that can propel bolts over medium distances attached to the wrist. The small size reduces power, but doesn't impede the hands so a melee weapon can be held in both hands. Requires almost a full turn to reload."
        ja = "手首に装着し、中距離までボルトを飛ばせる小型のレバー式クロスボウ。小さいため威力は劣るが、両手を妨げず、近接武器を両手で握れる。再装填にはほぼ1ターンを要する。"
    }
    {
        en = "A modest head covering of the women of the cloth, its white lining symboling purity and innocence."
        ja = "聖職に就く女性の慎ましい被り物。白い裏地は純潔と無垢を象徴する。"
    }
    {
        en = "A monstrous serpent with a hunger that knows no bounds is terrorising the area. None dare face it."
        ja = "飽くなき飢えを抱く巨大な蛇が一帯を恐怖に陥れている。立ち向かおうとする者はいない。"
    }
    {
        en = "A more reliable sellsword than most, %name%'s background as an ironmonger helped %them% to keep the %companyname%'s equipment functioning. Having saved more than enough crowns, %name% retired and returned to blacksmithing, learning from a true master and becoming a paragon of the craft. Last you heard of %them% %they% was living in luxury, making custom weapons and armor for nobles."
        ja = "並の者より頼りになる傭兵で、金物商だった%name%の経験は、%them%が%companyname%の装備を使える状態に保つ助けとなった。十分すぎるほどクラウンを蓄えた%name%は引退して鍛冶仕事へ戻り、真の名匠に学んで、その技の鑑となった。最後に%them%の消息を聞いた時、%they%は貴族のために特注の武器と防具を作り、贅沢に暮らしていた。"
    }
    {
        en = "A most urgent matter concerning his lordships private collection has arisen..."
        ja = "領主閣下の個人的な収蔵品をめぐり、火急の事態が生じた……。"
    }
    {
        en = "A muladi is accustomed to the south, although not entirely accepted by the locals."
        ja = "ムラディは南方に慣れ親しんでいるが、現地の人々に完全に受け入れられているわけではない。"
    }
    {
        en = "A musical instrument, can produce inspiring rythms, if you have the skill. The drum sticks make weak maces in a pinch."
        ja = "腕さえあれば、仲間を奮い立たせるリズムを奏でられる楽器。いざというときには、撥を弱いメイスとして使える。"
    }
    {
        en = "A mysterious cat that seems all too intelligent"
        ja = "不自然なほど知性が高そうな、謎めいた猫。"
    }
    {
        en = "A nasal helm with an attached tail fashioned in the way of the steppe folks."
        ja = "草原の民の様式で作られた尾飾り付きの鼻当て兜。"
    }
    {
        en = "A neckguard of cured leather capable of softening a blow that could otherwise prove lethal."
        ja = "本来なら致命傷となる一撃を和らげられる、なめし革の首当て。"
    }
    {
        en = "A net provided by barbarian tribe, used to bind unholds. Tainted with secret poison, it makes [color=%negative%]dazed[/color], [color=%negative%]baffled[/color] or with less than 25% Healthpoints Unholds docile when trapped."
        ja = "蛮族の部族から提供された、ウンホルトを拘束するための網。秘密の毒が塗られており、[color=%negative%]朦朧[/color]、[color=%negative%]困惑[/color]状態、または体力が25%未満のウンホルトを捕らえると従順にする。"
    }
    {
        en = "A new era dawns as brigand gangs across the land swear fealty to the banner of the underworld king, their unified front heralding a dark chapter in the history of the realm."
        ja = "各地の盗賊団が裏社会の王の旗に忠誠を誓い、新たな時代が幕を開ける。その統一戦線は、領内史に暗い一章が始まることを告げている。"
    }
    {
        en = "A new pet, with many more on the way..."
        ja = "新しいペットだ。これからもっと増える……。"
    }
    {
        en = "A noble of the realm, practiced in fencing but quite unfit"
        ja = "王国の貴族。剣術を修めているが、ひどく体が鈍っている。"
    }
    {
        en = "A noble with a birthright claim to authority"
        ja = "生まれながらに権威を主張する権利を持つ貴族。"
    }
    {
        en = "A noisy spiked mail collar offering a modicum of defense."
        ja = "わずかな防護をもたらす、じゃらじゃらとうるさい棘付き鎖帷子の首輪。"
    }
    {
        en = "A nordic helm guarding face and neck with additional metal plates."
        ja = "顔と首を追加の金属板で守る北方風の兜。"
    }
    {
        en = "A nordic helm with a metal face mask and cheek guards."
        ja = "金属製の仮面と頬当てを備えた北方風の兜。"
    }
    {
        en = "A northern ice tribe has settled nearby. These barbarians and their savage pagan ways are not welcome here."
        ja = "北方の氷の部族が近くに住み着いた。蛮族も、その野蛮な異教の風習も、この地では歓迎されない。"
    }
    {
        en = "A party of graberobbers and pillagers."
        ja = "墓荒らしと略奪者の一団。"
    }
    {
        en = "A pauper is no cousin of mine"
        ja = "貧乏人など私の従兄ではない"
    }
    {
        en = "A person steps into open practically wearing the surrounding graveyard. All of manner of dirt, grime, and gore cling to the figure - a forearm gripped ankle, a nachzehrer horn held loosely in hands dripping with blackened blood, and you swear you can see a faint blue shimmer. The freed one slowly approaches and politely greets you, calmly explaining they were held captive for some time. Hours ago, captors decided usefulness was outlived and left their slave here to die. The captive held out against the graveyard's inhabitants as best as possible, then you showed up.\n\nYou're not sure you buy that story, but the clinging viscera does give a hint of credibility, and if nothing else points to remarkable resilience. Maybe this survivor would be a useful addition to the %companyname%?"
        ja = "周囲の墓地を着込んだような者が開けた場所へ現れる。土、垢、血肉が全身にまとわりつく――足首を掴む前腕、黒い血が滴る手に緩く握られたナハツェーラーの角、そしてかすかな青い煌めき。解放された者はゆっくり近づき、丁寧に挨拶し、しばらく囚われていたと静かに語る。数時間前、捕らえた者たちはもう役に立たないと判断し、死ぬよう置き去りにした。囚人は墓地の住人へ可能な限り抵抗し、そこへあなたが現れた。\n\n話を信じきれないが、こびりつく臓物が多少の信憑性を与え、少なくとも驚異的な頑健さを示している。この生存者は%companyname%の役に立つかもしれない。"
    }
    {
        en = "A pitch black mist lingers here, eminating a bone chilling air from within"
        ja = "漆黒の霧がここに立ち込め、その内から骨まで凍るような空気が漂っている。"
    }
    {
        en = "A pitiful looking northerner hobbles out of one of the nomad's tents.%SPEECH_ON%Did you kill them? The desert people, I mean. If so, you have my thanks. Those bastards killed my comrades and took me prisoner. Said I owed some kind of debt to that devil they worship, the 'guilter' or whatever stupid name they gave it. Farkin' southerners...%SPEECH_OFF% The swearing trails off, cold eyes taking in the carnage of the battle with an unusual calm. If someone can keep that cool in front of living enemies as well as dead ones, they might just have a successful career as a sellsword. Perhaps you should take this one into the %companyname%?"
        ja = "哀れな北方人が遊牧民の天幕からよろめき出る。%SPEECH_ON%連中を殺したのか？　砂漠の民のことだ。なら感謝する。クソどもは仲間を殺し、俺を捕らえた。崇めてる悪魔への借りがあるとか言った。「ギルター」だか何だか馬鹿な名だった。クソ南方人め……。%SPEECH_OFF%罵りは途切れ、冷たい目が異様な落ち着きで戦場の惨状を見渡す。生きた敵の前でも死体の前と同じ冷静さを保てるなら、売剣として成功できるかもしれない。%companyname%へ迎えるべきだろうか？"
    }
    {
        en = "A quick and fast stab with the wooden shaft. Very effective against vampires."
        ja = "木の柄で素早く刺す。吸血鬼に極めて有効。"
    }
    {
        en = "A quick puff of air to propel a dart. A hit to the head will put the target to sleep, a hit to the body has a 50% chance to daze the target."
        ja = "ひと吹きの空気で吹き矢を飛ばす。頭部に命中すれば対象を眠らせ、胴体に命中すれば50%の確率で対象を朦朧状態にする。"
    }
    {
        en = "A quick punch forward with a solid buckler. Anyone hit with a blow like this will be dazed and gasping for air, unable to put full force behind their blows for two turns."
        ja = "頑丈なバックラーを前へ突き出して殴る。この一撃を受けた者は朦朧とし、息を切らし、2ターンの間、攻撃に全力を込められなくなる。"
    }
    {
        en = "A real surgeon? Not likely."
        ja = "本物の外科医？　ありえない。"
    }
    {
        en = "A relic for that much? I'll bite."
        ja = "その値段で聖遺物？　買おう。"
    }
    {
        en = "A right jester you are."
        ja = "まったく道化だな。"
    }
    {
        en = "A roughly made fake nose that does more to ensure the wearer can actually breath than actually make them look nice. Try not to lie."
        ja = "装着者を美しく見せるより、実際に呼吸できるようにすることを重視した粗末な付け鼻。嘘はつかない方がいい。"
    }
    {
        en = "A shame."
        ja = "残念だ。"
    }
    {
        en = "A shepard claims to have found the burial site of a holy relic. Sounds like a load of hogwash, but you will be paid to investigate."
        ja = "羊飼いが聖遺物の埋葬地を見つけたという。法螺話にしか聞こえないが、調べれば報酬は出る。"
    }
    {
        en = "A shot with so much force that it passes straight through the target to whoever is behind them."
        ja = "対象を貫通し、その背後にいる者まで届くほど強力な射撃。"
    }
    {
        en = "A skilled nomadic fighter of the south who prefers speed and reach over raw power."
        ja = "力任せの一撃よりも速さと間合いを好む、南方の熟練した遊牧戦士。"
    }
    {
        en = "A slave, naked save for a few rags, walks up to you.%SPEECH_ON%You slew these men, yes? You have my thanks. I was unjustly captured by them and forced into slavery, but with their deaths I am finally free. I admit I am not sure where to go now, but the fact that I may walk there on unfettered feet is joyous enough.%SPEECH_OFF%As the slave turns to leave, you wonder if they might prefer life in the %companyname% to braving the deserts alone."
        ja = "ぼろ布をわずかにまとっただけの裸同然の奴隷が近づく。%SPEECH_ON%この者たちを殺したのですね？　感謝します。不当に捕らえられ、奴隷にされましたが、死んだ今、ようやく自由です。これからどこへ行くかは分かりません。それでも、行き先がどこであれ、足枷のない足で歩けるだけで十分に喜ばしい。%SPEECH_OFF%奴隷が去ろうとすると、独りで砂漠へ挑むより%companyname%で暮らすことを望むかもしれないと思う。"
    }
    {
        en = "A slow overhead strike performed with full force to smash a target to bits."
        ja = "全力で頭上から大きく振り下ろし、標的を粉砕する。"
    }
    {
        en = "A small scouting party of a Noble house."
        ja = "貴族家の小規模な斥候隊。"
    }
    {
        en = "A southerner comes running at you from out of nowhere and prostrates before you. Before you can say a word the stranger begins thanking you profusely and proclaiming your arrival to be a work of the Gilder. You manage to glean from this babbling that the stranger was held by the brigands as a prisoner and forced to do their nasty duties around camp against. As you calm the situation down, you wonder if there is thanks enough to fight for the %companyname%."
        ja = "南方人が突然駆け寄り、目の前に平伏する。言葉を発する前に、しきりに感謝し、あなたの到来はギルダーの御業だと宣言する。その喋りから、盗賊に囚われ、野営地の汚れ仕事を無理やりさせられていたと読み取る。落ち着かせながら、この感謝は%companyname%のため戦うほどだろうかと思う。"
    }
    {
        en = "A spider"
        ja = "蜘蛛"
    }
    {
        en = "A stampede of basilisks hunting for food"
        ja = "餌を求めて殺到するバシリスクの群れ。"
    }
    {
        en = "A strong hammer, a sturdy shield and medium armour can weather anything."
        ja = "強力な槌、頑丈な盾、中装鎧があれば何にでも耐えられる。"
    }
    {
        en = "A supporter from the start, %name% was as loyal as he was talented. He stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that he had started his own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of his company, you learned that it had been completely annihilated in a battle between nobles."
        ja = "初めから支持者だった%name%は、才能に劣らず忠実だった。しばらく傭兵団に残った後、自らの道を切り拓くため去った。先日、その傭兵から、自分の傭兵団を立ち上げたものの窮地に陥り、助けを切実に求めているという手紙が届いた。だが残念なことに、日付はほぼ丸一年前だった。彼の傭兵団について調べると、貴族同士の戦いで全滅していたことが分かった。"
    }
    {
        en = "A supporter of your cause from the start, %name% was as loyal as she was talented. She stayed with the company for a time before eventually leaving to forge out a path for himself. The other day, you received a letter from the mercenary stating that she had started her own company and was in dire need of help. Unfortunately, the message was dated to nearly a full year ago. When you investigated the existence of her company, you learned that it had been completely annihilated in a battle between nobles."
        ja = "初めからあなたの大義を支持していた%name%は、才能に劣らず忠実だった。しばらく傭兵団に残った後、自らの道を切り拓くため去った。先日、その傭兵から、自分の傭兵団を立ち上げたものの窮地に陥り、助けを切実に求めているという手紙が届いた。だが残念なことに、日付はほぼ丸一年前だった。彼女の傭兵団について調べると、貴族同士の戦いで全滅していたことが分かった。"
    }
    {
        en = "A swarm of redback webknechts skittering about."
        ja = "レッドバック・ウェブクネヒトの群れが、かさかさと這い回っている。"
    }
    {
        en = "A sweeping cleave that can be used from behind the frontline and can inflict bleeding wounds if there is no armor absorbing the blow and if the target is able to bleed at all."
        ja = "前衛の後方からも繰り出せる薙ぎ払い。攻撃を装甲に阻まれず、かつ対象が出血しうる場合、出血性の傷を与えることがある。"
    }
    {
        en = "A swift strike with the weapon's haft. Not particularly effective, but offers versatility on heavy weapons. Becomes easier to use after successful hits from other skills in the same turn."
        ja = "武器の柄で素早く打つ。それほど効果的ではないが、重い武器に柔軟な選択肢を与える。同じターン中に別のスキルを命中させると、扱いやすくなる。"
    }
    {
        en = "A talented ranger has granted this character the skills of a pathfinder."
        ja = "才ある野伏から、斥候の技を授けられている。"
    }
    {
        en = "A taxidermist at heart, it didn't take much to compel %name% to bail from the quickly sinking company. He left to go start a business, but was kidnapped along the way by a group of brigands. When they threatened to kill him, he pretended to be a simple and weak taxidermist and showed his talents in creating trinkets. Impressed, the superstitious outlaws took him into their band. A few days later they were all dead and this 'meek' man walked out of their camp with a bit of red on him. He started his business a week later and is doing well to this day."
        ja = "根っからの剥製師だったため、沈みかけた傭兵団から逃げ出すよう%name%を説得するのに大した労はいらなかった。商売を始めるため去ったが、道中で盗賊の一団にさらわれた。殺すと脅されると、ひ弱で無害な剥製師を装い、装身具を作る腕を見せた。感心した迷信深い無法者たちは彼を一味に加えた。数日後、彼らは全員死に、この「おとなしい」男は少しばかり赤く染まって野営地から歩み出た。一週間後に店を開き、今も繁盛している。"
    }
    {
        en = "A valuable cargo requires express, armed delivery. Discretion preferred."
        ja = "高価な積荷を、武装して至急配送する必要がある。目立たぬことが望ましい。"
    }
    {
        en = "A very disagreeable and cacophonous chant can makes it almost impossible for enemies to focus and concentrate properly."
        ja = "耳障りな不協和音の詠唱により、敵はまともに集中することがほぼ不可能になる。"
    }
    {
        en = "A veteran of hundreds of battles, the honour guard is rewarded for their prowess with ever increasing danger."
        ja = "幾百もの戦いを生き抜いた古参兵。親衛兵はその武勇への褒賞として、ますます大きな危険を与えられる。"
    }
    {
        en = "A vicious bite with a 15% increased chance to hit the head and 100% chance to infect."
        ja = "頭部への命中率が15%高く、必ず感染させる凶悪な噛みつき。"
    }
    {
        en = "A vicious leaping bite usable up to two tiles between the hyena and its prey. The hyena leaps into the gap to bite; on a hit it instantly retreats to its original position while dragging the victim, locking them adjacent and immobilized until the hyena is struck in melee."
        ja = "ハイエナと獲物の間が最大2マスまでなら使える、凶暴な飛びかかり噛み。ハイエナは間へ跳び込んで噛みつき、命中すると直ちに元の位置へ戻りながら犠牲者を引きずる。犠牲者はハイエナの隣に固定され、ハイエナが近接攻撃を受けるまで移動不能になる。"
    }
    {
        en = "A voice from the brush hails you.%SPEECH_ON%What could a bunch of sorry wenches like you do to piss off the %nemesiscityname% so bad they put a bounty on your head, anyway?%SPEECH_OFF%The voice is followed by a group of nasty looking men who spill out onto the path before you. The leader levels his weapon at you and spits.%SPEECH_ON%They don't care if we bring you in dead or alive, though, so I guess I'll just hafta keep on wondering.%SPEECH_OFF%"
        ja = "茂みから声がかかる。%SPEECH_ON%お前らみたいな哀れな女どもが何をして、%nemesiscityname%をそこまで怒らせ、首に賞金を懸けられたんだ？%SPEECH_OFF%声に続き、凶悪そうな男たちが道へ溢れ出す。頭目は武器を向け、唾を吐く。%SPEECH_ON%死体でも生け捕りでも構わないらしい。だから謎のままにしておくか。%SPEECH_OFF%"
    }
    {
        en = "A warband of your barbarian employer."
        ja = "蛮族の依頼主が差し向けた戦士団。"
    }
    {
        en = "A wax ear stitched into one's head. Hardly a proper replacement, but some sense of balance is returned and very faint noises can be heard."
        ja = "頭に縫い付けた蝋製の耳。まともな代用品とは言い難いが、いくらか平衡感覚が戻り、ごくかすかな音なら聞こえる。"
    }
    {
        en = "A well-placed attack at an opponent's neck. Ignores all armor but is harder to hit with. Hit chance is based on target's fatigue. Damage is based on the difference in fatigue. Deals 50% damage against grappled or choked enemies. Hit chance is increased against grappled, stunned, netted, dazed, parried or sleeping enemies. Requires both hands to be free."
        ja = "相手の首を的確に狙う攻撃。装甲をすべて無視するが、命中させにくい。命中率は対象の疲労に、ダメージは両者の疲労差に基づく。組み伏せまたは首を絞められた敵に対してはダメージが50%増加する。組み伏せ、気絶、網、朦朧、受け流し、睡眠状態の敵には命中率が上がる。両手が空いている必要がある。"
    }
    {
        en = "A well-placed attack at the opponent armor's weakspots with redback poison. Ignores all armor and injects the target with poison but is harder to hit with and can not land critical hits for additional damage, nor inflict additional damage with double grip. Poison does not work on undead and you must deal enough damage for the poison to enter the system."
        ja = "レッドバック毒を塗り、相手の防具の弱点を的確に突く。装甲をすべて無視して対象へ毒を注入するが、命中させにくく、クリティカルによる追加ダメージも両手持ちによる追加ダメージも与えられない。毒は不死者には効かず、体内へ毒を入れるには十分なダメージを与える必要がある。"
    }
    {
        en = "A wide eyed and exceptionally disheveled human hides in the corner of the camp. Seeing you, the form cowers and makes a series of whooping sounds and grunts. Clearly a prisoner, but judging by that physique, perhaps a warrior hides within. Should you take the wildling into the company, or free them back to the wilds?"
        ja = "目を見開き、ひどく薄汚れた人間が野営地の隅に隠れている。あなたを見ると縮こまり、甲高い声や唸り声を上げる。明らかに囚人だが、その体格を見る限り、内には戦士が潜んでいるかもしれない。野人を傭兵団へ迎えるか、それとも野へ返すか？"
    }
    {
        en = "A wolf"
        ja = "狼"
    }
    {
        en = "A wooden finger with a joint for the user to force it into whatever position they need. Perfect for pointing fingers at people, but not too much else."
        ja = "必要な位置へ使用者が押し曲げられる関節付きの木の指。人を指差すにはうってつけだが、ほかにはほとんど役に立たない。"
    }
    {
        en = "A wyrm"
        ja = "シュトルヴルム"
    }
    {
        en = "Abducted Villager"
        ja = "連れ去られた村人"
    }
    {
        en = "Absolutely disgusting. It's perfect."
        ja = "まったく胸糞が悪い。完璧だ。"
    }
    {
        en = "Accept the kid."
        ja = "若者を迎え入れる。"
    }
    {
        en = "Accidentally injured himself"
        ja = "不注意で自分を傷つけた"
    }
    {
        en = "Accompanied by a formidable escort, this wealthy merchant/'s travels will be safeguarded."
        ja = "手強い護衛が同行し、この裕福な商人の旅路を守る。"
    }
    {
        en = "Accuracy based on ranged skill, damage based on current initiative. requires a magic staff"
        ja = "命中精度は射撃技能、ダメージは現在の先制値に基づく。魔法の杖が必要。"
    }
    {
        en = "Accuracy based on ranged skill, damage based on current resolve. Requires a magic staff"
        ja = "命中精度は射撃技能、ダメージは現在の精神力に基づく。魔法の杖が必要。"
    }
    {
        en = "Accuracy based on ranged skill, damage based on resolve. Requires a magic staff"
        ja = "命中精度は射撃技能、ダメージは精神力に基づく。魔法の杖が必要。"
    }
    {
        en = "Activating this Perk will grant the following Perk Group:\n"
        ja = "このパークを有効化すると、以下のパークグループを獲得する：\n"
    }
    {
        en = "Activating this Perk will randomly grant one of the following Perk Groups:\n"
        ja = "このパークを有効化すると、以下のパークグループからランダムに1つ獲得する：\n"
    }
    {
        en = "Actually, I'm not..."
        ja = "実は、そうではない……"
    }
    {
        en = "Actually, I'm not...."
        ja = "実は、そうではない……"
    }
    {
        en = "Adds the Choked effect which reduces enemy fatigue recovery by [color=%negative%]15[/color]"
        ja = "敵の疲労回復量を[color=%negative%]15[/color]減少させる「首絞め」効果を付与する。"
    }
    {
        en = "Advance as one, increasing melee effectiveness of allies nearby."
        ja = "一丸となって前進し、付近の味方の近接戦闘能力を高める。"
    }
    {
        en = "Adventurousness never leaves the soul of a man like %name%. {Instead of returning to the armed services, he left the %companyname% and headed east in search of rare beasts. Word has it he returned to town with the head of what looked like a giant lizard, but you don't believe such fantastical tripe. | He departed the %companyname% and ventured west, sailing across the oceans to unseen lands. There's no telling where he is these days, but you've little doubt that he'll be coming back with stories to tell. | He retired from the %companyname% and, instead of returning to his noble family, headed south. Word has it he fought in a great noble civil war, killed an orc warlord, climbed the highest mountain in the land, and is currently writing an epic about his travels. | The nobleman left the %companyname% and, preferring the life of adventure to noble boredom, he headed north. Word has it that he's currently marching a troop of explorers to the furthest reaches of the world.}"
        ja = "%name%のような男の魂から、冒険心が消えることはない。{軍務へ戻る代わりに、彼は%companyname%を去り、珍しい獣を求めて東へ向かった。巨大なトカゲらしきものの頭を持って町へ戻ったとの噂だが、そんな荒唐無稽な話をあなたは信じていない。 | 彼は%companyname%を去って西へ旅立ち、海を渡って見知らぬ土地へ向かった。今どこにいるか知るすべはないが、語るべき物語を携えて戻るだろうと、あなたはほとんど疑っていない。 | 彼は%companyname%を引退し、貴族の一族へ戻る代わりに南へ向かった。大規模な貴族の内戦で戦い、オークの軍閥を討ち、この地で最も高い山へ登り、今は旅の叙事詩を書いているとの噂だ。 | この貴族の男は%companyname%を去り、貴族暮らしの退屈より冒険を選んで北へ向かった。今は探検隊を率い、世界の果てを目指して行軍しているという。}"
    }
    {
        en = "Adventurousness never leaves the soul of a woman like %name%. {Instead of returning to the armed services, she left the %companyname% and headed east in search of rare beasts. Word has it she returned to town with the head of what looked like a giant lizard, but you don't believe such fantastical tripe. | She departed the %companyname% and ventured west, sailing across the oceans to unseen lands. There's no telling where she is these days, but you've little doubt that she'll be coming back with stories to tell. | She retired from the %companyname% and, instead of returning to her noble family, headed south. Word has it she fought in a great noble civil war, killed an orc warlord, climbed the highest mountain in the land, and is currently writing an epic about his travels. | The noblewoman left the %companyname% and, preferring the life of adventure to noble boredom, she headed north. Word has it that she's currently marching a troop of explorers to the furthest reaches of the world.}"
        ja = "%name%のような女の魂から、冒険心が消えることはない。{軍務へ戻る代わりに、彼女は%companyname%を去り、珍しい獣を求めて東へ向かった。巨大なトカゲらしきものの頭を持って町へ戻ったとの噂だが、そんな荒唐無稽な話をあなたは信じていない。 | 彼女は%companyname%を去って西へ旅立ち、海を渡って見知らぬ土地へ向かった。今どこにいるか知るすべはないが、語るべき物語を携えて戻るだろうと、あなたはほとんど疑っていない。 | 彼女は%companyname%を引退し、貴族の一族へ戻る代わりに南へ向かった。大規模な貴族の内戦で戦い、オークの軍閥を討ち、この地で最も高い山へ登り、今は旅の叙事詩を書いているとの噂だ。 | この貴族の女は%companyname%を去り、貴族暮らしの退屈より冒険を選んで北へ向かった。今は探検隊を率い、世界の果てを目指して行軍しているという。}"
    }
    {
        en = "After all that, they can't be that bad of a fighter."
        ja = "あれを生き延びたなら、戦士としてそう悪くはないだろう。"
    }
    {
        en = "After finding near limitless work with %companyname%, %name% managed to hone their craft with every battle that passed. Their experience on the battlefield and cutting open more 'animated' subjects left them with new ideas, which culminated in a book that was printed and reprinted for many years after %their% passing."
        ja = "%companyname%でほとんど尽きることのない仕事を得た%name%は、戦いを重ねるたびに腕を磨いた。戦場での経験と、より「活発に動く」対象を切り開いた経験から新たな着想を得て、一冊の本にまとめた。その本は%their%の死後も長年にわたり版を重ねた。"
    }
    {
        en = "After leaving %companyname%, %name% was never heard from again. %name%'s calling card has been found near a few accidents, so you believe the assassin is doing well."
        ja = "%companyname%を去った後、%name%の消息を聞いた者はいない。いくつかの「事故」現場の近くで%name%の名刺代わりの印が見つかっているので、暗殺者はうまくやっているのだろう。"
    }
    {
        en = "After leaving %companyname%, %name% was never heard from again. There are rumours that a rival assassin was hunting %name%, but no one has heard anything from either of them."
        ja = "%companyname%を去った後、%name%の消息を聞いた者はいない。敵対する暗殺者が%name%を狙っていたとの噂もあるが、どちらについてもその後は何も聞かれていない。"
    }
    {
        en = "After leaving the %companyname%, %name% retired from beast slaying altogether and last you heard she was mother of an albino daughter. Unfortunately, rumors spread quickly about the girl having supernatural powers and her father was executed by fire. The mother and child were never caught nor seen again."
        ja = "%companyname%を去った後、%name%は獣狩りを完全に引退した。最後に聞いた話では、白皮症の娘の母になっていたという。だが不幸にも、少女には超自然の力があるとの噂がたちまち広まり、父親は火刑に処された。母子は捕まることも、再び目撃されることもなかった。"
    }
    {
        en = "After many sleepless nights, remembering the horrors they faced within the company, %Name% returned to their village and became a night watchman once more. Unfortunately, a few days later they were found dead at their post. Their eyes shut, yet face contorted into a look of horror. Not a single villager heard any commotion during the night, but one reported seeing a pale figure stalking off in the moonlight."
        ja = "傭兵団で味わった恐怖を思い返し、眠れぬ夜を幾度も過ごした後、%Name%は村へ戻り、再び夜警となった。だが数日後、持ち場で死んでいるところを発見された。目は閉じていたものの、顔は恐怖に歪んでいた。その夜、物音を聞いた村人は一人もいなかったが、月明かりの中を青白い人影が立ち去るのを見た者がいた。"
    }
    {
        en = "After the massacre..."
        ja = "虐殺の後……"
    }
    {
        en = "After years of cruelty, some of the slaves are rebelling. Help crush this uprising before it spreads."
        ja = "長年の虐待に耐えかね、一部の奴隷が反乱を起こした。広がる前に鎮圧せよ。"
    }
    {
        en = "After {not much  more time | much more time later | a lifetime adrift | a short while | a few more months} after your retirement, %name% found {interest | their calling with | some hope with | work with} a {preacher | thief | vagabond | wildman | wise woman | crusader | odd trio of kids | haughty nobleman | ranger | people's militia | cultist band | northern raiding party | group of escaped slaves | hunting party of manhunters}, their time with you taught them {everything | most of what | all | a bit of what} they needed to survive in their new employment. They never spoke your name, but {their memory of you never faded | they go on to greater things in your memory}."
        ja = "あなたの引退から{さほど経たないうちに | さらに長い時を経て | 生涯を漂流した末に | しばらくして | さらに数か月後}、%name%は{関心 | 天職 | いくらかの希望 | 仕事}を{説教師 | 盗人 | 放浪者 | 野生の男 | 賢女 | 十字軍戦士 | 風変わりな三人組の子供 | 尊大な貴族 | 野伏 | 民衆の民兵団 | 教団員の一団 | 北方の略奪隊 | 逃亡奴隷の一団 | 人狩りの狩猟隊}のもとに見いだした。あなたと過ごした時間から、生き延びるために必要なことの{すべて | 大半 | 何もかも | いくらか}を学んでいた。あなたの名を口にすることはなかったが、{あなたの記憶が薄れることはなかった | あなたの思い出を胸に、さらに大きなことを成し遂げていった}。"
    }
    {
        en = "Aggressive"
        ja = "攻撃的"
    }
    {
        en = "All those tomes, yet so few answers..."
        ja = "あれほどの書物がありながら、答えはほとんどない……"
    }
    {
        en = "Allies gain the Sanctified effect, becoming immune to injuries, bleeding, poison, and morale checks when taking damage"
        ja = "味方は「聖別」効果を得て、負傷、出血、毒、およびダメージを受けた際の士気判定を無効化する。"
    }
    {
        en = "Allows you to move up or down levels. Does not trigger attacks of opportunity. Can not be used on flat ground."
        ja = "高低差のあるマスへ上り下りできる。機会攻撃を誘発しない。平地では使用できない。"
    }
    {
        en = "Allows you to use throwing weapons in melee"
        ja = "近接戦闘中でも投擲武器を使用できる"
    }
    {
        en = "Almost consumed alive by basilisks"
        ja = "バシリスクに生きたまま喰われかけた"
    }
    {
        en = "Alp Slayer"
        ja = "アルプ殺し"
    }
    {
        en = "Alps are nightmares made flesh, yet they can be beaten. These reports though... sound downright demonic."
        ja = "アルプは悪夢が肉体を得た存在だが、倒すことはできる。だが今回の報告は……まさに悪魔じみている。"
    }
    {
        en = "Alright, I can spare a hand or few."
        ja = "分かった。何人か手を貸そう。"
    }
    {
        en = "Alright, let her out for a bit."
        ja = "分かった。しばらく彼女を外へ出してやれ。"
    }
    {
        en = "Alright, we'll take %them_dude%."
        ja = "分かった、%them_dude%を引き取ろう。"
    }
    {
        en = "Alright. Here's 1000 crowns. Make sure to take 10 tools from the camp."
        ja = "分かった。クラウン1000枚だ。野営地から工具を10個持っていけ。"
    }
    {
        en = "Alright. Here's 1400 crowns. Take 15 tools from the company cart."
        ja = "分かった。クラウン1400枚だ。傭兵団の荷車から工具を15個持っていけ。"
    }
    {
        en = "Alright. Here's 2000 crowns. Take 20 tools from around the camp."
        ja = "分かった。クラウン2000枚だ。野営地から工具を20個持っていけ。"
    }
    {
        en = "Alright. Here's 225 crowns. Take 5 tools from the cart."
        ja = "分かった。クラウン225枚だ。荷車から工具を5個持っていけ。"
    }
    {
        en = "Alright. Here's 350 crowns — and take 5 tools from the cart."
        ja = "分かった。クラウン350枚だ――それと荷車から工具を5個持っていけ。"
    }
    {
        en = "Alright. Here's 800 crowns. Take 10 tools from the tents."
        ja = "分かった。クラウン800枚だ。天幕から工具を10個持っていけ。"
    }
    {
        en = "Although many things can be taken at the point of a sword, some things will always be more potent than cold steel; the flash of an eyelash, the locking of a gaze..."
        ja = "剣先で奪えるものは多い。だが、冷たい鋼よりも常に強いものがある。まつ毛のきらめき、絡み合う視線……。"
    }
    {
        en = "Although the life of excess was not the way of the dervish, %name% took the money given to them and set it aside, accumulating a Vizier's fortune of crowns. %name% donated this money to local widows and shelters for the poor before selling what they were wearing and wandering back into the streets, just as they were found."
        ja = "過剰な暮らしはダルヴィーシュの道ではなかったが、%name%は受け取った金を蓄え、宰相に匹敵する額のクラウンを築いた。%name%はその金を地元の寡婦や貧者の救護所へ寄付し、身につけていた物まで売ると、見つかった時と同じように街路へ戻っていった。"
    }
    {
        en = "Although weak with a sword and not an enjoyer of combat, %name% left the company soon after the commander's departure and focused themselves on the curing of disease and sickness they had seen much of across the land. Their knowledge of alchemy was of great value in the north, earning more crowns than they thought possible. %name% set up a shop in a border town with the southern realms, selling remedies to those who needed them for far below normal prices. They died content and of old age, without a regret in their mind."
        ja = "剣に弱く戦いを好まなかった%name%は、指揮官が去ってほどなく傭兵団を離れ、各地で目にしてきた病を治すことへ専念した。錬金術の知識は北方で大きな価値を持ち、想像以上のクラウンをもたらした。%name%は南方諸国との境にある町で店を構え、必要とする者へ治療薬を相場よりはるかに安く売った。心残りもなく、満ち足りて老衰で死んだ。"
    }
    {
        en = "Always evade the next attack made against this character in combat"
        ja = "戦闘中、このキャラクターに対する次の攻撃を必ず回避する。"
    }
    {
        en = "Always the life of the party."
        ja = "いつだって宴の中心だ。"
    }
    {
        en = "Amber Wristguards"
        ja = "琥珀の腕甲"
    }
    {
        en = "Ambitious"
        ja = "野心家"
    }
    {
        en = "Amid the burning sands, the gnawed bones of deceased travelers are starting to pile up."
        ja = "焼けつく砂の中で、旅人たちの齧られた遺骨が積み上がり始めている。"
    }
    {
        en = "Amid the power struggles of nobility, a series of unfortunate events can often lead to a town changing its allegiances."
        ja = "貴族同士の権力争いでは、いくつもの不幸が重なり、町が忠誠先を変えることも珍しくない。"
    }
    {
        en = "Amid the slaughter, a fearsome greenskin Warlord has emerged. Goad him into fighting you and put an end to his carnage."
        ja = "殺戮のさなか、恐るべきグリーンスキンの軍将が台頭した。戦いへ誘き出し、その凶行に終止符を打て。"
    }
    {
        en = "Amidst escalating reports of bandit attacks and caravan ambushes, the imperative to patrol the roads becomes undeniable."
        ja = "盗賊の襲撃や隊商への待ち伏せが相次いで報告され、街道を巡回する必要は誰の目にも明らかだ。"
    }
    {
        en = "Amidst the cheers and jeers, the Arena stands as a testament to the might of the Southern Realms."
        ja = "歓声と罵声の中に立つ闘技場は、南方諸国の威勢を物語る。"
    }
    {
        en = "Amidst the dunes, the sand nomads carve out a life of resilience and adaptability. Do not underestimate them."
        ja = "砂丘の中で、砂漠の遊牧民は強靱さと適応力を頼りに暮らしている。侮ってはならない。"
    }
    {
        en = "Amidst the maelstrom of battle, the destinies of noble houses and mercenary companies alike are forged."
        ja = "戦いの渦中で、貴族家と傭兵団、双方の運命が鍛え上げられる。"
    }
    {
        en = "Amidst the merchant caravan, camaraderie is forged over shared travels and shared burdens."
        ja = "商人隊商では、旅と重荷を分かち合ううちに仲間意識が生まれる。"
    }
    {
        en = "Amidst the rolling hills, fell beasts lurk in the darkness, their eyes glowing like embers in the night."
        ja = "なだらかな丘陵の闇に凶獣が潜む。その目は夜の熾火のように光っている。"
    }
    {
        en = "Among the desert caravans, diversity thrives as cultures blend along the trade routes."
        ja = "砂漠の隊商では、交易路で文化が交わり、多様性が育まれる。"
    }
    {
        en = "Among the desert caravans, fortunes rise and fall just like the shifting sands."
        ja = "砂漠の隊商では、富も移ろう砂のように増えては減る。"
    }
    {
        en = "Among the sand nomads, kinship and tradition are the bedrock of their society. Sounds lovely, but you've seen what they do to unarmed traders on the roads."
        ja = "砂漠の遊牧民にとって、血縁と伝統は社会の礎だ。結構な話だが、武器を持たない交易商に街道で何をするか、あなたは見てきた。"
    }
    {
        en = "Amongst the ruins of a kingdom lies the secret of a relic, said to hold the power to vanquish the undead hordes that threaten the world."
        ja = "滅びた王国の廃墟に、世界を脅かす不死者の大群を打ち滅ぼす力を秘めた聖遺物の秘密が眠っている。"
    }
    {
        en = "Amongst the shifting sands, the embalmed dead wander aimlessly, their mummified forms driven by an insatiable thirst for the life they lost centuries ago."
        ja = "移ろう砂の中を、防腐処理された死者があてもなくさまよう。ミイラとなった身体は、数百年前に失った命への飽くなき渇きに突き動かされている。"
    }
    {
        en = "Amputation is a thing of life, and the wearer of this prosthetic foot was lucky enough to be given a replacement after the removal of their maimed one. It's awful to walk on, but at least you can walk."
        ja = "切断は人生につきものだ。この義足の装着者は、損傷した足を切り落とした後、運よく代用品を与えられた。歩き心地は最悪だが、少なくとも歩ける。"
    }
    {
        en = "Amputation might be a part of mercenary life, but not only can the replacement be comfortable to walk with but also useful."
        ja = "切断は傭兵稼業につきものかもしれない。だが代用品は、快適に歩けるだけでなく役にも立つ。"
    }
    {
        en = "Amused by tales of southern indecision"
        ja = "決断できない南方人の話を面白がった"
    }
    {
        en = "An Identity Affirmed"
        ja = "確かめられた己のあり方"
    }
    {
        en = "An aging master slayer of a local guild, time has taken their youth but their skills still surpass those they train."
        ja = "地元ギルドの老いた討伐師範。時は若さを奪ったが、その技は今も教え子たちを凌ぐ。"
    }
    {
        en = "An axe and buckler with light armour is the best choice."
        ja = "斧とバックラー、それに軽装鎧が最善だ。"
    }
    {
        en = "An enemy divided..."
        ja = "分裂した敵……"
    }
    {
        en = "An impatient student of a Swordmaster, %name% didn't have the mental aptitude to stick with the trials and tribulations of becoming a master of the blade %themselves%. But what %they% lacks in mental fortitude %they% more than makes up for in effort. You 'hired' %them% simply by taking %them% off the old man's hands."
        ja = "剣術の達人のせっかちな弟子だった%name%には、試練に耐え抜き、%themselves%が剣の達人となるだけの精神的な素質がなかった。だが、%they%は精神的な強さに欠ける分を、%they%の努力で十二分に補っている。あなたは老人が持て余していた%them%を引き取り、それだけで%them%を「雇った」。"
    }
    {
        en = "An intriguing chant that stimulates the senses."
        ja = "興味をそそり、感覚を刺激する詠唱。"
    }
    {
        en = "An official or administrator with some standing to someone who's name and title is unknown to you."
        ja = "名も肩書も知らぬ何者かに仕え、それなりの地位を持つ役人または行政官。"
    }
    {
        en = "An old soldier, maimed by some forgettable past conflict, waits for another war that may never come."
        ja = "忘れ去られた昔の戦で体を損なった老兵が、来ないかもしれない次の戦争を待っている。"
    }
    {
        en = "An ominous clucking floats across the fields at dawn. Locals tell tales of a bloodthirsty beast standing taller than a man."
        ja = "夜明けの野に、不吉な鶏めいた鳴き声が漂う。地元民は、人の背丈を超える血に飢えた獣の話をしている。"
    }
    {
        en = "An overhead strike that bears the full force on the targets entire body."
        ja = "標的の全身へ力を叩き込む頭上からの一撃。"
    }
    {
        en = "An unhold"
        ja = "ウンホルト"
    }
    {
        en = "An unnatural quiet takes hold, and the hairs on the back of your neck prick up. It seems %nemesisviziername% has not forgotten about you or your escape. You're surrounded by manhunters!"
        ja = "不自然な静けさが辺りを支配し、首筋の毛が逆立つ。%nemesisviziername%は、あなたも、あなたが逃げたことも忘れてはいないらしい。人狩りどもに包囲された！"
    }
    {
        en = "Analyse the weak points on an opponent and tell your comrades, reducing the target's Defense by 10 and increasing Damage Taken from all sources by 1% of their total Hitpoints for 2 turns."
        ja = "敵の弱点を分析して仲間へ伝え、対象の近接防御と射撃防御を10低下させ、最大体力1ポイントにつき1%（最大20%）、あらゆる攻撃から受けるダメージを増加させる。2ターン持続する。"
    }
    {
        en = "Ancestor's Stone"
        ja = "祖霊の石"
    }
    {
        en = "Ancestral Helm"
        ja = "先祖伝来の兜"
    }
    {
        en = "Ancient Crown"
        ja = "古代の王冠"
    }
    {
        en = "Ancient Legions"
        ja = "古代の軍団"
    }
    {
        en = "Ancient Southern Face Mask"
        ja = "古代南方の仮面"
    }
    {
        en = "Ancient ruins dot the desert landscape, ideal ambush locations for unwary caravans."
        ja = "砂漠には古代遺跡が点在し、警戒を怠る隊商を待ち伏せするには格好の場所となっている。"
    }
    {
        en = "Ancient texts speak of a divine weapon, whispered to have been crafted to cleanse the land of the undead."
        ja = "古文書は、不死者をこの地から一掃するために造られたという神聖な武器について語っている。"
    }
    {
        en = "And what now?"
        ja = "それで、今度は何だ？"
    }
    {
        en = "Angry about you bribing mercenaries to stop their fight"
        ja = "傭兵たちを買収して喧嘩をやめさせたことに腹を立てている"
    }
    {
        en = "Another normal day — let's get out of here."
        ja = "いつもどおりの一日だ――さっさと出よう。"
    }
    {
        en = "Another round"
        ja = "もう一戦"
    }
    {
        en = "Another swing will remove the rest of the reeds."
        ja = "もう一振りすれば、残った葦も刈り取れる。"
    }
    {
        en = "Antique Book of Bloodlines"
        ja = "古の血統譜"
    }
    {
        en = "Anxiety mounts as rumors circulate of a malevolent presence haunting the nearby graveyard."
        ja = "近くの墓地に邪悪な存在が取り憑いているという噂が広まり、不安が募っている。"
    }
    {
        en = "Any attack that inflicts at least 1 point of damage to hitpoints triggers a morale check for the opponent with a penalty equal to [color=%positive%]10%[/color] of your arena wins"
        ja = "体力へ1以上のダメージを与える攻撃は、対戦相手に士気判定を発生させる。そのペナルティは、自身の闘技場での勝利数の[color=%positive%]10%[/color]に等しい。"
    }
    {
        en = "Any minute now..."
        ja = "もう間もなくだ……"
    }
    {
        en = "Aperthrope"
        ja = "アペルスロープ"
    }
    {
        en = "Appetite of a donkey"
        ja = "ロバ並みの食欲"
    }
    {
        en = "Applies Safeguard to someone, and will take the next hit instead of them"
        ja = "対象に「護衛」を付与し、次に対象が受ける攻撃を代わりに引き受ける。"
    }
    {
        en = "Appreciate it."
        ja = "恩に着る。"
    }
    {
        en = "Arborthrope"
        ja = "アーバースロープ"
    }
    {
        en = "Are you both done?"
        ja = "二人とも、もう済んだか？"
    }
    {
        en = "Arena Champion"
        ja = "闘技場の王者"
    }
    {
        en = "Arise!"
        ja = "立ち上がれ！"
    }
    {
        en = "Arriving without the crowns"
        ja = "クラウンを持たずに到着"
    }
    {
        en = "Arrowsplitter"
        ja = "矢裂き"
    }
    {
        en = "As %companyname% declined in strength, %name% was one of the first to take charge. Her defensive nature led to inaction and ended up with most of the company being whittled down by goblin arrows in a swamp, many with their shields still clutched in their hands under the never-ending rain of projectiles."
        ja = "%companyname%が衰えるにつれ、%name%はいち早く指揮を執った。だが防御を重んじる気質は行動の遅れにつながり、傭兵団の大半は沼地でゴブリンの矢に少しずつ削られた。絶え間ない飛び道具の雨の下、多くの者は最後まで盾を握りしめていた。"
    }
    {
        en = "As an institution, slavery holds little grip outside of the southern deserts, but as a practice it knows few borders. The southerner before you clearly learned that lesson the hard way. It seems the lure of free labor to handle camp duties was enough for the brigands to set aside more northern sensibilities. Now that the captors are dead, you wonder if the slave would find life as a sellsword more suitable than menial labor."
        ja = "制度としての奴隷制は南方の砂漠を出ればほとんど根づいていないが、行いとしての奴隷使役に境界などほぼない。目の前の南方人は、その事実を嫌というほど思い知ったのだろう。野営地の雑用をただでこなす労働力には、盗賊たちも北方人なりの良識を捨てるだけの魅力があったらしい。捕らえていた者たちが死んだ今、この奴隷には下働きより売剣の暮らしが向いているのではないかと考える。"
    }
    {
        en = "As dawn breaks each morning, the townsfolk awaken with a sense of dread, knowing that the nightmares that haunted their sleep will return with the setting sun."
        ja = "毎朝、夜が明けると町の人々は怯えながら目を覚ます。眠りを苛んだ悪夢が、日が沈めば戻ってくると知っているからだ。"
    }
    {
        en = "As long as you are faster than the target, any attack that inflicts at least [color=%positive%]1[/color] point of damage to Hitpoints triggers a morale check for the opponent with a penalty equal to [color=%negative%]20%[/color] of the Initiative difference between you and the target"
        ja = "対象より先制値が高い限り、体力へ少なくとも[color=%positive%]1[/color]のダメージを与える攻撃はすべて、相手に士気判定を発生させる。そのペナルティは、自身と対象の先制値の差の[color=%negative%]20%[/color]に等しい。"
    }
    {
        en = "As night falls the townsfolk huddle in fear, haunted by the nameless dread that lurks in the shadows."
        ja = "夜になると町の人々は恐怖に身を寄せ合い、闇に潜む名状しがたい不安に苛まれる。"
    }
    {
        en = "As night falls the townsfolk toss and turn in their beds, haunted by nightmares that refuse to release their grip."
        ja = "夜になると町の人々は寝床で身をよじり、決して手放そうとしない悪夢に苛まれる。"
    }
    {
        en = "As the undead march ever closer, rival factions race uncover a relic that could spell the difference between life and death."
        ja = "不死者が刻一刻と迫る中、敵対する諸勢力は、生死を分けかねない聖遺物を求めて先を争っている。"
    }
    {
        en = "As time went on, %name% found work not too far from where they once grew up. The local village needed a new herbalist to heal the sick and tend to the wounded coming back from the wars. %name% occasionally recognised some of the casualties that ended up in her hut as a few of those who got away in the past. Thankfully they did not have the same attention to detail."
        ja = "時が経ち、%name%はかつて育った場所からさほど遠くない土地で仕事を得た。地元の村は、病人を癒し、戦から戻る負傷者を手当てする新たな薬草師を必要としていた。%name%は時折、過去に取り逃がした者の一部が患者として小屋へ運ばれてくるのを見覚えていた。幸い、彼らはそれほど細かく人の顔を覚えてはいなかった。"
    }
    {
        en = "Assault the senses of your target with a conjured flurry of colorful sparks, whirs, and pops. Such an astonishing display is sure to leave anyone too bewildered to fight effectively. Does no damage. Requires a staff."
        ja = "色鮮やかな火花、唸り、破裂音を魔法で次々と生み出し、対象の感覚を襲う。これほど驚異的な見世物を浴びれば、誰であれ混乱してまともに戦えなくなるだろう。ダメージは与えない。杖が必要。"
    }
    {
        en = "Assault the senses of your target with a flurry of colorful sparks, whirs, and pops. Such an astonishing display is sure to leave anyone too bewildered to fight effectively. Does no damage."
        ja = "色鮮やかな火花、唸り、破裂音を次々と浴びせ、対象の感覚を襲う。これほど驚異的な見世物を浴びれば、誰であれ混乱してまともに戦えなくなるだろう。ダメージは与えない。"
    }
    {
        en = "Astrologist"
        ja = "占星術師"
    }
    {
        en = "At %Home%..."
        ja = "%Home%にて……"
    }
    {
        en = "At Camp..."
        ja = "野営地にて……"
    }
    {
        en = "At bandit camp..."
        ja = "盗賊の野営地にて……"
    }
    {
        en = "At camp..."
        ja = "野営地にて……"
    }
    {
        en = "At least %they_clumsyguy% didn't kill %themselves_clumsyguy%"
        ja = "少なくとも%they_clumsyguy%は%themselves_clumsyguy%を殺さずに済んだ"
    }
    {
        en = "At least they are motivated."
        ja = "少なくとも、やる気はある。"
    }
    {
        en = "At least we avoided a fight..."
        ja = "少なくとも戦いは避けられた……"
    }
    {
        en = "At least we got some of them."
        ja = "少なくとも、何人かは仕留めた。"
    }
    {
        en = "At meal time.."
        ja = "食事時に……"
    }
    {
        en = "At night brigands roam freely, posing a serious threat to the safety and security of the town."
        ja = "夜になると盗賊が我が物顔でうろつき、町の安全と治安を深刻に脅かしている。"
    }
    {
        en = "At night..."
        ja = "夜に……"
    }
    {
        en = "At the Webknecht Nest..."
        ja = "ウェブクネヒトの巣にて……"
    }
    {
        en = "Ate pie"
        ja = "パイを食べた"
    }
    {
        en = "Ate pudding"
        ja = "プディングを食べた"
    }
    {
        en = "Attacking an army of relentless greenskin besiegers is a task nobody wants."
        ja = "執拗なグリーンスキンの包囲軍を攻めるなど、誰も引き受けたくない仕事だ。"
    }
    {
        en = "Automatically performs ranged attack against any enemy walks into your overwatch zone but that attack deals [color=%negative%]25%[/color] less Damage"
        ja = "敵が監視射撃範囲へ入ると自動的に遠隔攻撃を行うが、その攻撃が与えるダメージは[color=%negative%]25%[/color]減少する。"
    }
    {
        en = "Auxiliary"
        ja = "補助兵"
    }
    {
        en = "Avaricious or ambitious nobles are a far greater threat to merchant safety then mere brigands."
        ja = "強欲な、あるいは野心的な貴族は、ただの盗賊よりも商人の安全をはるかに脅かす。"
    }
    {
        en = "Back at camp..."
        ja = "野営地へ戻ると……"
    }
    {
        en = "Back to the cage! (Increase Moral Reputation)"
        ja = "檻へ戻せ！（道義的評判上昇）"
    }
    {
        en = "Back to the knife..."
        ja = "またナイフか……"
    }
    {
        en = "Bad Tempered Parrot"
        ja = "気性の荒いオウム"
    }
    {
        en = "Bamboozled some poachers"
        ja = "密猟者たちをまんまと欺いた"
    }
    {
        en = "Bandit army of your employer."
        ja = "依頼主の盗賊軍。"
    }
    {
        en = "Banditry and highway robbery in their lands makes the nobility look weak, thus making fighting patrols a reliable repeat contract."
        ja = "領内での盗賊行為や街道強盗は貴族を弱く見せる。そのため巡回任務は繰り返し請けやすい依頼となる。"
    }
    {
        en = "Bandits want to procure an item, but as outlaws they cannot enter town."
        ja = "盗賊たちはある品を手に入れたがっているが、無法者ゆえ町へ入れない。"
    }
    {
        en = "Barbarian Retaliation"
        ja = "蛮族の報復隊"
    }
    {
        en = "Barbarians live by their own code of honor, much like sellswords, whose code can be changed for the right price."
        ja = "蛮族は傭兵とよく似て、独自の名誉の掟に従って生きている。もっとも、傭兵の掟は十分な金を積めば変わるが。"
    }
    {
        en = "Bashed"
        ja = "殴殺"
    }
    {
        en = "Bashed to death"
        ja = "殴り殺された"
    }
    {
        en = "Basilisk Infestation"
        ja = "バシリスクの蔓延"
    }
    {
        en = "Basilisks"
        ja = "バシリスク"
    }
    {
        en = "Bathed in the Gilder's resplendent light"
        ja = "ギルダーのまばゆい光を浴びた"
    }
    {
        en = "Battle Sister"
        ja = "戦闘修道女"
    }
    {
        en = "Battle Sisters are warrior women trained by the inquisition to fight and destroy evil."
        ja = "戦闘修道女は、邪悪と戦い、滅ぼすために異端審問所で鍛えられた女戦士である。"
    }
    {
        en = "Be careful with the cursor!"
        ja = "カーソルには気をつけろ！"
    }
    {
        en = "Be free, friend."
        ja = "自由になれ、友よ。"
    }
    {
        en = "Be seeing you..."
        ja = "またどこかで……"
    }
    {
        en = "Beads of Fortune"
        ja = "幸運の珠飾り"
    }
    {
        en = "Bear"
        ja = "熊"
    }
    {
        en = "Bear Form"
        ja = "熊形態"
    }
    {
        en = "Beastfolk"
        ja = "獣人"
    }
    {
        en = "Beastfriend"
        ja = "獣の友"
    }
    {
        en = "Beasts"
        ja = "獣"
    }
    {
        en = "Become [color=%negative%]poisoned[/color]"
        ja = "[color=%negative%]毒[/color]状態になる。"
    }
    {
        en = "Before damage is applied, the target has a [color=%damage%]30%[/color] chance to break the effect."
        ja = "ダメージが適用される前に、対象は[color=%damage%]30%[/color]の確率で効果を解除する。"
    }
    {
        en = "Behold, the rise of a barbarian king in the north, his might unmatched, his fury unstoppable!"
        ja = "見よ、北方に蛮族王が立つ！　比類なき力と止めようのない怒りを携えて！"
    }
    {
        en = "Being devoured by a pack of savage beasts was not high on your list of things to do today."
        ja = "獰猛な獣の群れに喰われる予定は、今日の用事には入っていなかった。"
    }
    {
        en = "Being devoured by ferocious desert beasts was not high on your list of things to do today."
        ja = "凶暴な砂漠の獣に喰われる予定は、今日の用事には入っていなかった。"
    }
    {
        en = "Being exceptionally light, this character's strikes don't really hurt, however they're also extremely fast."
        ja = "ひときわ軽いこのキャラクターの攻撃は大して痛くないが、動きは極めて速い。"
    }
    {
        en = "Being exceptionally purposeful, this character's strikes hurt plenty, but they're also slower."
        ja = "ひときわ力強いこのキャラクターの攻撃は十分に痛いが、動きは遅い。"
    }
    {
        en = "Beneath her seductive guise lies a heart as black as pitch."
        ja = "その蠱惑的な外見の下には、瀝青のように黒い心が隠れている。"
    }
    {
        en = "Beneath the burning sun, the embalmed dead roam the desert wastes, their empty eyes fixed on the horizon as they obey a long-forgotten command."
        ja = "灼熱の太陽の下、防腐処理された死者が砂漠の荒野をさまよう。虚ろな目を地平線へ向け、とうに忘れられた命令に従っている。"
    }
    {
        en = "Berserker"
        ja = "狂戦士"
    }
    {
        en = "Berserkers"
        ja = "狂戦士"
    }
    {
        en = "Best all of you check yourselves before we get going..."
        ja = "出発する前に、全員自分の身を確かめておけ……"
    }
    {
        en = "Better not shake a hand with this one."
        ja = "こいつとは握手しない方がいい。"
    }
    {
        en = "Better to leave the wildling crowns alone."
        ja = "野人のクラウンには手を出さない方がいい。"
    }
    {
        en = "Better trained and equipped than northern militia, conscripts are the rank and file of the southern military."
        ja = "北方の民兵よりもよく訓練され、装備も整った徴募兵は、南方軍の主力をなす一般兵である。"
    }
    {
        en = "Beware the deadly serpents, whose sleek bodies glide effortlessly through the desert, hunting for prey."
        ja = "死を招く蛇に気をつけろ。滑らかな身体で砂漠を易々と進み、獲物を狩る。"
    }
    {
        en = "Beware the deceptively agile movements, for its powerful talons can shred armor and flesh alike with ease."
        ja = "見かけによらぬ俊敏な動きに注意せよ。強靱な鉤爪は鎧も肉も容易く引き裂く。"
    }
    {
        en = "Beware the desert's haunted wastelands, for the spirits of the ancients are said to linger there, twisted by centuries of anger and resentment."
        ja = "砂漠の呪われた荒野に気をつけろ。古代人の霊が、幾世紀もの怒りと怨念に歪められ、今もそこに留まっているという。"
    }
    {
        en = "Beware the desert's silent guardians: the sand golems, whose massive forms emerge from the sands to block the path of any travelers who dare to cross their domain."
        ja = "砂漠の寡黙な守護者、砂のゴーレムに気をつけろ。その巨体は砂中から現れ、領域を横切ろうとする旅人の道を塞ぐ。"
    }
    {
        en = "Beware the forest's haunted groves, where gnarled limbs and grasping roots hunger for the flesh of the living."
        ja = "森の呪われた木立に気をつけろ。節くれ立った枝と絡みつく根が、生者の肉に飢えている。"
    }
    {
        en = "Beware the hexen, for she is a creature of unfathomable malice, whose thirst for power knows no bounds."
        ja = "ヘクセンに気をつけろ。その悪意は測り知れず、力への渇望に際限がない。"
    }
    {
        en = "Beware the witch's beauty, for behind her beguiling facade lies a heart as cold and merciless as winter's frost."
        ja = "魔女の美貌に気をつけろ。その魅惑的な仮面の裏には、冬の霜のように冷酷な心がある。"
    }
    {
        en = "Beware these souldrinkers, for they are cunning and elusive, wreathed in the flames of hell."
        ja = "魂を啜る者どもに気をつけろ。狡猾で捉えどころがなく、地獄の炎を身にまとっている。"
    }
    {
        en = "Bind your opponent with web."
        ja = "敵を蜘蛛の糸で拘束する。"
    }
    {
        en = "Birdsong"
        ja = "鳥の歌"
    }
    {
        en = "Black Book of Magick"
        ja = "黒き魔術書"
    }
    {
        en = "Blacksmith"
        ja = "鍛冶屋"
    }
    {
        en = "Blacksmiths tend to be strong and are skilled at repairing equipment."
        ja = "鍛冶屋はたいてい力が強く、装備の修理に長けている。"
    }
    {
        en = "Blare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it within 4 tiles. Uses ranged skill."
        ja = "耳をつんざく、この世ならざる叫び声を上げ、4マス以内で不運にも耳にした者を高い確率で動揺させる。射撃技能を使用する。"
    }
    {
        en = "Blare out a piercing, unworldly sound that is more than likely to distress anyone unfortunate enough to hear it."
        ja = "耳をつんざく、この世ならざる叫び声を上げ、不運にも耳にした者を高い確率で動揺させる。"
    }
    {
        en = "Blend into the terrain and remain unseen until attacking or moving adjacent to an enemy."
        ja = "地形に溶け込み、攻撃するか、敵に隣接するマスへ移動するまで見つからない。"
    }
    {
        en = "Blessed are the maker stollwurms, whose passage cleanses the world. You don't believe that farkin' nonsense of course."
        ja = "造物主のシュトルヴルムは祝福され、その通るところで世界は清められる――むろん、そんなクソったれた戯言を信じちゃいない。"
    }
    {
        en = "Blinded"
        ja = "盲目"
    }
    {
        en = "Bloated red bodies and gaping maws skitter through the darkness, hungry for blood."
        ja = "膨れた赤い胴と大きく開いた顎が、血に飢えて闇の中を走り回る。"
    }
    {
        en = "Block your enemy's weapons in a way that leaves them open to counter attack. Applies the Vulnerable effect to an enemy, lowering their melee and ranged defenses by 10."
        ja = "敵の武器を封じて反撃の隙を作る。「無防備」効果を付与し、敵の近接防御と射撃防御を10低下させる。"
    }
    {
        en = "Blood Chalice"
        ja = "血の杯"
    }
    {
        en = "Blood soaks the sand, yet the crowd always screams for more. A grand tournament has been announced!"
        ja = "血が砂を濡らしても、群衆はなお次を求めて叫ぶ。大闘技大会が布告された！"
    }
    {
        en = "Blue Crystal Staff"
        ja = "青水晶の杖"
    }
    {
        en = "Blundering mountains of hatred and rage are devastating the area. These are the largest Unholds you have ever seen."
        ja = "憎悪と怒りの山塊が、この一帯を踏み荒らしている。これほど巨大なウンホルトは見たことがない。"
    }
    {
        en = "Boar Form"
        ja = "猪形態"
    }
    {
        en = "Bounty Hunters are solitary in nature who prefer more direct means to that of assassins. Anyone who is brave enough to walk the roads and take coin alone is either a fool or has more than meets the eye to them"
        ja = "賞金稼ぎは孤独を好み、暗殺者よりも直接的な手段を選ぶ。街道を一人で歩き、単身で報酬を得ようとするほど大胆な者は、愚か者か、見た目以上の何かを持つ者のどちらかだ。"
    }
    {
        en = "Break the Siege"
        ja = "包囲を破れ"
    }
    {
        en = "Bribed Raiders"
        ja = "買収された略奪者たち"
    }
    {
        en = "Brigand Stronghold"
        ja = "盗賊の砦"
    }
    {
        en = "Brigand raiders have been humiliating the region. You are being hired to eradicate them."
        ja = "盗賊どもが一帯を蹂躙している。根絶やしにするため、あなたが雇われた。"
    }
    {
        en = "Bronze Bust"
        ja = "青銅の胸像"
    }
    {
        en = "Brooding and at times suicidal, it's no surprise that %name% is frequently found diving into battle with nothing more than a large two-hander. {Clothed in murderous intent, you once saw her cleave a man in two - top to bottom. | It is said that she once cleaved a warrior orc in two, leaving the trunk of its legs still standing. | The woman is known to ignore the fragility of her own mortality just to end the life of another. | She thrives being in the thick of battle where she can swing her weapons with little regard for safety or accuracy. | Supposedly, she once won a jousting tournament, but had to flee after bedding a watching nobleman's wife. | The woman is not a murderer, but she would have made a fine one. | Seemingly unstoppable at times, you are glad to have the woman on your side. | In a fit of bloodthirsty rage she once impaled two goblins on one pike. | A strong brute, you once saw %name% kill someone just on her backswing.} She'll use any weapon you give her, but %name% has a proclivity towards those that can make calamitous ruin out of a man's body."
        ja = "陰気で、時に自暴自棄な%name%が、大型の両手武器だけを手に戦いへ飛び込む姿をたびたび見かけるのも不思議ではない。{殺意をまとい、男を頭から股まで真っ二つにするところを見たことがある。 | 戦士オークを真っ二つにし、脚の付け根から下だけが立ったまま残ったという。 | この女は、他者の命を絶つためなら自らの命の脆さを顧みないことで知られる。 | 戦いの只中でこそ力を発揮し、安全も精度もほとんど気にせず武器を振るう。 | かつて馬上槍試合で優勝したものの、見物していた貴族の妻と寝て逃げる羽目になったという。 | この女は人殺しではないが、なっていれば一流だっただろう。 | 時に止めようがなく見えるため、味方でいてくれることをありがたく思う。 | 血に飢えた怒りに駆られ、一本の長槍でゴブリン二体を串刺しにしたことがある。 | 屈強な荒くれ者で、%name%が返す刃だけで人を殺すのを見たことがある。}どんな武器を渡しても使うが、%name%は人の体を破滅的に壊せる武器をとりわけ好む。"
    }
    {
        en = "Build me a quiver of legends!"
        ja = "伝説の矢筒を作ってくれ！"
    }
    {
        en = "Burned"
        ja = "焼死"
    }
    {
        en = "But the search turned up something more sinister than expected - a necromancer performing profane experiments on both living and dead. %name% tried to run, but grasping hands and rotting bodies blocked the path, and %name% was knocked out and taken prisoner."
        ja = "しかし捜索によって、予想以上に邪悪なものが見つかった――生者と死者の双方を使って冒涜的な実験を行う死霊術師だ。%name%は逃げようとしたが、掴みかかる手と腐った死体に道を塞がれ、%name%は殴り倒されて囚われの身となった。"
    }
    {
        en = "Butcher of %townname%"
        ja = "%townname%の屠殺者"
    }
    {
        en = "Call down bolts of lightning randomly within four tiles."
        ja = "4マス以内へ無作為に稲妻を落とす。"
    }
    {
        en = "Calling all warriors! The Imperial Arena grand tournament beckons!"
        ja = "戦士よ集え！　帝国闘技場の大試合が呼んでいる！"
    }
    {
        en = "Can be removed by attacking the hyena or by disengaging"
        ja = "ハイエナを攻撃するか、接触を断つと解除できる。"
    }
    {
        en = "Can change trained trait in settlements."
        ja = "集落で訓練済み特性を変更できる。"
    }
    {
        en = "Can directly command a single unit that is not another Legate"
        ja = "レガトゥス以外の兵1体を直接指揮できる。"
    }
    {
        en = "Can evolve by defeating strong enemies."
        ja = "強敵を倒すことで成長できる。"
    }
    {
        en = "Can inscribe weapons, shields, helmets and armor provided the company has Uncut Gems."
        ja = "傭兵団が未加工の宝石を所持していれば、武器、盾、兜、胴防具へルーンを刻める。"
    }
    {
        en = "Can someone kill this fool already?"
        ja = "誰か、もうこの馬鹿を殺してくれないか？"
    }
    {
        en = "Can tell me what this relic does?"
        ja = "この聖遺物にどんな力があるか教えてくれるか？"
    }
    {
        en = "Can train in settlements."
        ja = "集落で訓練できる。"
    }
    {
        en = "Can't trust anyone out here."
        ja = "ここでは誰も信用できない。"
    }
    {
        en = "Can't use weapons, shields, ammunition or armor. The donkey does not seem bothered by these limitations."
        ja = "武器、盾、矢弾、防具を使用できない。ロバはこうした制限を気にしていないようだ。"
    }
    {
        en = "Cannibal"
        ja = "人食い"
    }
    {
        en = "Cannibalistic"
        ja = "食人嗜好"
    }
    {
        en = "Cannibals have a thing for human flesh."
        ja = "人食いは人肉に目がない。"
    }
    {
        en = "Cannibals provide Human Parts after a fight, likes hanging out with butchers, may try to eat others. Increased results when assigned to hunting in camp."
        ja = "人食いは戦闘後に「人間の部位」をもたらし、屠殺人と一緒にいることを好むが、ほかの者を食べようとする場合がある。野営地で狩猟を担当させると成果が増える。"
    }
    {
        en = "Cannot train in settlements anymore."
        ja = "集落ではこれ以上訓練できない。"
    }
    {
        en = "Capture Unhold"
        ja = "ウンホルトを捕らえよ"
    }
    {
        en = "Cause infighting between the Noble houses by murdering one of their patrols."
        ja = "貴族家の巡回隊を一つ皆殺しにし、貴族家同士の内紛を引き起こせ。"
    }
    {
        en = "Centurion"
        ja = "ケントゥリオ"
    }
    {
        en = "Chains up to 3 more additional targets"
        ja = "さらに最大3体の対象へ連鎖する。"
    }
    {
        en = "Champions, assemble! The Imperial Arena tournament awaits your valor!"
        ja = "勇士よ、集え！　帝国闘技場の大会が、その武勇を待っている！"
    }
    {
        en = "Chance on each attack to ignore armor completely, the chance is [color=%positive%]50%[/color] of the Initiative difference between you and the target as long as you are faster"
        ja = "自身の方が速い限り、各攻撃が装甲を完全に無視する確率は、自身と対象の先制値の差の[color=%positive%]50%[/color]となる。"
    }
    {
        en = "Chance to apply to all enemies within 1 range of target tile."
        ja = "対象マスから1マス以内のすべての敵にも付与される可能性がある。"
    }
    {
        en = "Chaos Emerald"
        ja = "カオスエメラルド"
    }
    {
        en = "Charge at an enemy up to 2 tiles away, attacking them in the process."
        ja = "2マス先までの敵へ突撃し、そのまま攻撃する。"
    }
    {
        en = "Charming"
        ja = "魅力的"
    }
    {
        en = "Choked"
        ja = "絞殺"
    }
    {
        en = "Chop down any bush with a 50% percent chance to harvest fruit"
        ja = "茂みを伐採し、50%の確率で果実を採取する。"
    }
    {
        en = "Chop down any tree. The first strike will leave a pile of sticks. The second strike will clear the sticks. Causes significant wear and tear"
        ja = "木を伐採する。最初の一撃で枝の山が残り、二撃目で枝を片づける。装備を著しく消耗させる。"
    }
    {
        en = "Chopped"
        ja = "斬殺"
    }
    {
        en = "Circle around! Take what you can!"
        ja = "回り込め！　持てるだけ奪え！"
    }
    {
        en = "Civilised folk"
        ja = "文明人"
    }
    {
        en = "Cleo"
        ja = "クレオ"
    }
    {
        en = "Closing in..."
        ja = "追い詰めつつある……"
    }
    {
        en = "Clothed in the un-reality of your life's work, manipulating the undead is second nature. With nothing to fear, manipulating people was not much more difficult. Despite the pacts you have made and the enemies bested along the way, you feel age catching up to you. How long has it been — how much longer is there to go?"
        ja = "生涯をかけた仕事が生む非現実をまとえば、不死者を操ることなど息をするようなものだ。恐れるものがない以上、人を操ることも大して難しくはなかった。結んだ契約や打ち倒した敵がいかほどであろうと、老いが追いついてくるのを感じる。どれほどの時が過ぎたのか――あとどれほど残されているのか？"
    }
    {
        en = "Coat your weapons and arrowtips with poison. Can not be used while engaged in melee. Costs 0 Action Points during the first round of combat."
        ja = "武器と矢尻へ毒を塗る。近接戦闘に拘束されている間は使用できない。戦闘の第1ラウンド中は行動力を消費しない。"
    }
    {
        en = "Cold winds rise in the north. A terrible Barbarian King has emerged, dealing death and destruction to all in his path."
        ja = "北方に冷たい風が吹く。恐るべき蛮族王が現れ、行く手のすべてに死と破壊をもたらしている。"
    }
    {
        en = "Colossal footsteps shake the earth. Buildings have been shattered, the very landscape torn apart by primal fury."
        ja = "途方もない足音が大地を揺らす。建物は砕け、原始の怒りが地形そのものを引き裂いた。"
    }
    {
        en = "Colossal serpents with scales as hard as iron, few would ever dare to hunt such a creature."
        ja = "鉄のように硬い鱗を持つ巨大な蛇。これを狩ろうとする者など滅多にいない。"
    }
    {
        en = "Command a fighter of Centurion rank or lower to do your bidding. Targets can only be inspired once per turn. Does not work on Legates."
        ja = "ケントゥリオ以下の階級にある戦士へ命令を下す。対象が鼓舞されるのは1ターンにつき1回だけ。レガトゥスには効果がない。"
    }
    {
        en = "Complete the delivery, claim your payment. Sounds so simple."
        ja = "品を届け、報酬を受け取る。実に簡単そうだ。"
    }
    {
        en = "Completely absorbs the first hit which doesn't ignore armor."
        ja = "装甲を無視しない最初の一撃を完全に吸収する。"
    }
    {
        en = "Completely ignores armor and applies redback poison, dealing 55 damage over 10 turns. Damage doubled vs targets in a web "
        ja = "装甲を完全に無視し、レッドバック毒を付与して10ターンかけて55ダメージを与える。蜘蛛の巣にかかった対象にはダメージが2倍になる。"
    }
    {
        en = "Comrades, we've got to help that dog!"
        ja = "仲間たちよ、あの犬を助けねば！"
    }
    {
        en = "Concerned about you bribing mercenaries to stop their fight"
        ja = "傭兵たちを買収して喧嘩をやめさせたことを案じている"
    }
    {
        en = "Concerned more with matters of fact than with what could or should be."
        ja = "あり得ることや、あるべきことよりも、事実を重んじる。"
    }
    {
        en = "Concoct a mixture of smells so fetid and noxious, you force your target to retreat just so they can breathe. Targets hit will receive fatigue and may take damage if they are pushed down several levels of height. Shieldwall, Spearwall and Riposte will be canceled for a target that is successfully knocked back. A rooted target can not be knocked back. Uses Ranged Skill."
        ja = "耐え難い悪臭を放つ混合物を調合し、息をするために対象を後退させる。命中した対象には疲労が蓄積し、高低差のある場所から数段突き落とされた場合はダメージを受けることがある。ノックバックに成功すると、対象の盾壁、槍衾、応酬を解除する。移動不能の対象はノックバックできない。射撃技能を使用する。"
    }
    {
        en = "Confront the Orc Warlord"
        ja = "オークの軍将と対決せよ"
    }
    {
        en = "Conjure a heavy ball of ice to crush your enemies."
        ja = "重い氷塊を召喚し、敵を押し潰す。"
    }
    {
        en = "Conjurer"
        ja = "召喚術師"
    }
    {
        en = "Conscript Gunner"
        ja = "徴募銃兵"
    }
    {
        en = "Considers death unavoidable, experiences no morale check when allies die"
        ja = "死は避けられないものと考えており、味方が死亡しても士気判定を行わない。"
    }
    {
        en = "Corpse-eaters... always wretched, malevolent, yet predictable. However there is an intelligence being hinted in these disturbing reports that gives you pause."
        ja = "屍肉喰らい……いつも惨めで邪悪だが、行動は読みやすい。ところが今回の不穏な報告からは知性の存在が仄めかされ、思わず警戒してしまう。"
    }
    {
        en = "Corrupt officials often extort merchants, demanding tolls or else facing dire consequences."
        ja = "腐敗した役人はしばしば商人を脅し、通行料を出さなければ悲惨な目に遭わせると迫る。"
    }
    {
        en = "Corrupt the force sustaining one of your thralls, causing them to detonate destructively after the corruption has time to build. Affected dead explode at the end of their turn next round, dealing damage in a 1 tile radius. The less HP they have, the more damage the explosion inflicts. If they are killed before they explode, the effect no longer triggers."
        ja = "配下の死者1体を支える力を腐敗させ、腐敗が広がった後に破壊的な爆発を起こさせる。影響を受けた死者は次のラウンド、自身のターン終了時に爆発し、半径1マスへダメージを与える。残り体力が少ないほど爆発のダメージは大きくなる。爆発前に倒されると、効果は発動しない。"
    }
    {
        en = "Costs [color=%positive%]-1[/color] Action Point due to Tumble"
        ja = "タンブルにより行動力コストが[color=%positive%]-1[/color]される。"
    }
    {
        en = "Costs [color=%positive%]-1[/color] Action Point due to unarmed training"
        ja = "素手訓練により行動力コストが[color=%positive%]-1[/color]される。"
    }
    {
        en = "Courser"
        ja = "コーサー"
    }
    {
        en = "Coursers are swift and strong horses well-suited for war, hunting and transportation."
        ja = "コーサーは足が速く力も強い馬で、戦争、狩猟、移動によく適している。"
    }
    {
        en = "Covers [color=%damage%]7[/color] tiles in smoke for one round, allowing anyone inside to move freely and ignore zones of control"
        ja = "[color=%damage%]7[/color]マスを1ラウンドの間煙で覆い、中にいる者が自由に移動して支配領域を無視できるようにする。"
    }
    {
        en = "Crafting"
        ja = "製作"
    }
    {
        en = "Created a legendary sword"
        ja = "伝説級の剣を作り上げた"
    }
    {
        en = "Created a masterwork Armor"
        ja = "傑作の鎧を作り上げた"
    }
    {
        en = "Crested Signet Ring"
        ja = "紋章入りの印章指輪"
    }
    {
        en = "Crush any rock with a 10% percent chance to harvest valuable gems"
        ja = "岩を砕き、10%の確率で価値ある宝石を採取する。"
    }
    {
        en = "Crush any rock with a chance of harvesting it."
        ja = "岩を砕き、素材を採取できることがある。"
    }
    {
        en = "Crush the stronghold, claim your bounty. What could go wrong?"
        ja = "砦を潰し、賞金を受け取る。いったい何がまずいというのか？"
    }
    {
        en = "Crushed under ice"
        ja = "氷に押し潰された"
    }
    {
        en = "Crystal Singer"
        ja = "水晶の歌い手"
    }
    {
        en = "Cunning Disguise"
        ja = "巧妙な擬態"
    }
    {
        en = "Cunning, sneaky and treacherous little creatures, goblins and sellswords apparently have much in common."
        ja = "狡猾で、こそこそと動き、裏切りも辞さない小柄な生き物。どうやらゴブリンと傭兵には共通点が多い。"
    }
    {
        en = "Cut down any bush with a chance of harvesting it."
        ja = "茂みを切り倒し、素材を採取できることがある。"
    }
    {
        en = "Cut down any tree with a chance of harvesting it."
        ja = "木を切り倒し、素材を採取できることがある。"
    }
    {
        en = "Damage absorbed by Bone Plating"
        ja = "骨板がダメージを吸収した。"
    }
    {
        en = "Damage halved due to holding something in your off hand"
        ja = "逆手枠に何かを装備しているため、ダメージが半減する。"
    }
    {
        en = "Damage scales with current initiative and ignores armour."
        ja = "ダメージは現在の先制値に応じて変動し、装甲を無視する。"
    }
    {
        en = "Damn beast."
        ja = "忌々しい獣め。"
    }
    {
        en = "Damn. I was sure something important was about to happen."
        ja = "くそ。何か重大なことが起きると確信していたのに。"
    }
    {
        en = "Dark forests border the roads, where malicious creatures often ambush passing caravans."
        ja = "街道沿いには暗い森が広がり、悪意ある怪物が通りかかる隊商を待ち伏せすることが多い。"
    }
    {
        en = "Dark rituals, flawless beauty, a nobleman's ardor. Twisted and maniacal, you must face the coven of witches."
        ja = "闇の儀式、完璧な美貌、貴族の情欲。歪んだ狂気に満ちる魔女の集会と対峙せよ。"
    }
    {
        en = "Darted"
        ja = "吹き矢に倒れた"
    }
    {
        en = "Dawn approaches, and the first hints of sunlight warm the cold sand. Your body shivers, begging to rest and bask in the warmth, but you dare not stop. Not yet. You glance over your shoulders, half expecting manhunters to already be upon you, but you only see a ragged %bro% breathing heavily as he tries to keep pace."
        ja = "夜明けが近づき、差し始めた朝日が冷たい砂を温める。身体は震え、足を止めてその温もりの中で休めと訴えている。それでも止まるわけにはいかない。まだだ。人狩りどもがもう迫っているのではないかと、あなたは肩越しに振り返る。だが目に入るのは、歩調を保とうと荒い息をつく、ぼろぼろの%bro%だけだ。"
    }
    {
        en = "Deals 5-10 damage per turn over four turns"
        ja = "4ターンの間、ターンごとに5～10ダメージを与える。"
    }
    {
        en = "Deals extra damage to vampires"
        ja = "吸血鬼に追加ダメージを与える。"
    }
    {
        en = "Dealt with an Alp"
        ja = "アルプを退治した"
    }
    {
        en = "Death Denied"
        ja = "死を退ける"
    }
    {
        en = "Death Speaker"
        ja = "死を語る者"
    }
    {
        en = "Death cannot be escaped. But with the right actions, it can be postponed."
        ja = "死から逃れることはできない。だが正しく動けば、先延ばしにはできる。"
    }
    {
        en = "Deathly spectre"
        ja = "死の亡霊"
    }
    {
        en = "Decrepify has a cooldown of [color=%damage%]4[/color] turns."
        ja = "「衰弱」のクールダウンは[color=%damage%]4[/color]ターン。"
    }
    {
        en = "Deep in the forest..."
        ja = "森の奥深く……"
    }
    {
        en = "Defend burial site"
        ja = "埋葬地を守れ"
    }
    {
        en = "Deliver a large shipment of coin to another settlement, with maximum security."
        ja = "大量のクラウンを最大限の警備で別の集落へ届けよ。"
    }
    {
        en = "Deliver a secret envoy through enemy territory, then somehow get them out again."
        ja = "秘密の使節を敵地の奥まで送り届け、その後どうにか連れ戻せ。"
    }
    {
        en = "Deliver coins to %recipient% in %objective% about %days% to the %direction% by road. Do not spend it on the way."
        ja = "%recipient%へクラウンを届けよ。%objective%までは街道沿いに約%days%、%direction%の方角にある。途中で使い込むな。"
    }
    {
