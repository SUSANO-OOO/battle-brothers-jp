::BattleBrothersJP <- { Author = "SUSANO-OOO" };
dofile(getenv("BBJP_ROOT") + "src/battle_brothers_jp/runtime/core.nut", true);
dofile(getenv("BBJP_ROOT") + "src/battle_brothers_jp/translations/reviewed_literals.nut", true);

function assertPattern(_actual, _expected, _unit) {
    if (_actual != _expected) throw "Pattern " + _unit + " expected '" + _expected + "', got '" + _actual + "'";
}

assertPattern(::BattleBrothersJP.Runtime.translate("A noble lord is flabbergasted to find his cherished %s missing. He wants it found."), "大切な%sが消え、ある貴族は仰天している。どうにか見つけ出してほしいという。", "unit:0022E7B98CD90477981CBD24");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] has disarmed [color=#8f1e1e]Orc Warrior[/color] for one turn"), "[color=#1e468f]Alrik[/color]が[color=#8f1e1e]Orc Warrior[/color]を1ターンの間、武装解除した", "unit:02067A8ECCFD1ACDB1D151C9");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50%[/color] Melee Skill"), "近接技能 [color=#8f1e1e]-50%[/color]", "unit:030B6B11AD944CB2654E1570");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+1[/color] Initiative"), "先制値 [color=%positive%]+1[/color]", "unit:0391B6DA855E7A3B59B4E815");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]2[/color] Additional Action Point per tile moved"), "1マス移動するごとに追加で行動力を[color=#8f1e1e]2[/color]消費", "unit:03BEFAE2DC0A3E1A91A42D86");
assertPattern(::BattleBrothersJP.Runtime.translate("Reclaim the stolen %s before it falls into the wrong hands."), "盗まれた%sが悪しき者の手に渡る前に取り戻せ。", "unit:0522A447BDE3618FF65BA727");
assertPattern(::BattleBrothersJP.Runtime.translate("You are gaining [color=%positive%]3[/color] ranged skill due to wind reading"), "風を読むことで、射撃技能が[color=%positive%]3[/color]増加する。", "unit:064723D2B9F0F6CCF6DD6126");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#135213]+1[/color] Fatigue"), "[color=#135213]+1[/color] 最大疲労値", "unit:07B5A36013E52DDE9FC83596");
assertPattern(::BattleBrothersJP.Runtime.translate("Gain an additional [color=%positive%]+2%[/color] Melee Skill"), "近接技能がさらに[color=%positive%]+2%[/color]増加する", "unit:0B28DF19EA33E90C9F3ACC2A");
assertPattern(::BattleBrothersJP.Runtime.translate("All your fatigue costs are reduced by [color=%positive%]29%[/color]"), "すべての疲労コストが[color=%positive%]29%[/color]減少する", "unit:0D95C8CDA702F76F38CB5AA3");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#135213]+1[/color] Hitpoints"), "[color=#135213]+1[/color] 体力", "unit:0E36CB550C64BEC7E3576F5A");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] is charmed"), "[color=#1e468f]Alrik[/color]は魅了された", "unit:11B1CF7D33E5B7DC01834F47");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Initiative"), "先制値 [color=#8f1e1e]-25%[/color]", "unit:11E4333A3C261C2CA73DF991");
assertPattern(::BattleBrothersJP.Runtime.translate("Makes enemies less likely to attack you instead of an ally by [color=%negative%]11%[/color]"), "敵が味方ではなくこの人物を攻撃対象に選ぶ可能性が[color=%negative%]11%[/color]低下する", "unit:120ABAE822F08D674D9E979B");
assertPattern(::BattleBrothersJP.Runtime.translate("Some thieves have stolen the %s from a noble lord, who is frankly astonished at their audacity."), "盗賊どもがある貴族から%sを盗み出した。その大胆不敵さに、当の貴族は呆気に取られている。", "unit:196575CDAEAEF39244D708F9");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-15[/color] Melee Defense"), "近接防御 [color=#8f1e1e]-15[/color]", "unit:1D95A5DAD32BD9BAC12E6AC7");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+1[/color] Melee Skill"), "近接技能 [color=%positive%]+1[/color]", "unit:1DBCADEE668AC4D845EE167C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]20%[/color] of head armor is lost each turn"), "毎ターン、頭部の装甲を[color=#8f1e1e]20%[/color]失う", "unit:1FFC64E64E11889FD4A81B85");
assertPattern(::BattleBrothersJP.Runtime.translate("A local lord woke up to find his %s display case was emptier than a bard's promise."), "地元の領主が目を覚ますと、%sを収めていた飾り棚は吟遊詩人の約束よりも空っぽだった。", "unit:20079A8815A1E6081617E92C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Melee Defense"), "近接防御 [color=#8f1e1e]-25%[/color]", "unit:202C76F633469A8A0DE7A518");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+2%[/color] Fatigue Recovery per turn"), "毎ターンの疲労回復量 [color=%positive%]+2%[/color]", "unit:26E284D11CAC35C8320F9EBA");
assertPattern(::BattleBrothersJP.Runtime.translate("The prized %s has been stolen from his lordship by moonlight. Track down the thief for a reward."), "領主が大切にしていた%sが、月明かりの下で盗み出された。賊を追えば報酬が出る。", "unit:273C978C9CA4A0489681FA0F");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] quickly recovers from being disarmed thanks to his unnatural physiology"), "[color=#1e468f]Alrik[/color]は異常な生理機能により、武装解除から素早く立ち直った", "unit:28F66523A116C6C0048BC423");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] gains rage!"), "[color=#1e468f]Alrik[/color]の怒りが増した！", "unit:29AA567167444AAE50CDCBAF");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] shook off being dazed thanks to his unnatural physiology"), "[color=#1e468f]Alrik[/color]は異常な生理機能により、朦朧状態を振り払った", "unit:2A483646190A6DC33B59FA18");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50%[/color] Damage inflicted by target hit for one turn"), "命中した対象の与えるダメージが、1ターンの間[color=#8f1e1e]-50%[/color]", "unit:2A7BA3923FE8AC3B59143626");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]2[/color] instances of auto shieldwall on turn end left"), "ターン終了時に盾壁（または要塞化）を自動発動する残り回数：[color=%positive%]2[/color]", "unit:2B600D69486B6BED9AA429EB");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]Orc Warrior[/color] charges"), "[color=#8f1e1e]Orc Warrior[/color]が突進した", "unit:2CCD3312FC0C02165874BC3A");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50%[/color] Damage Inflicted"), "与えるダメージ[color=#8f1e1e]-50%[/color]", "unit:341C3181363346851EC89106");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Melee Skill"), "近接技能 [color=#8f1e1e]-25%[/color]", "unit:34C6D5A55ADA2A36D7691CED");
assertPattern(::BattleBrothersJP.Runtime.translate("Attacks that miss have [color=#135213]50%[/color] of their Fatigue cost refunded"), "攻撃を外した場合、消費した疲労の[color=#135213]50%[/color]が回復する", "unit:398C6B8F9F69E63FCF0E7876");
assertPattern(::BattleBrothersJP.Runtime.translate("A local lord discovered his cherished %s has vanished after hosting a banquet."), "地元の領主が宴を催した後、大切な%sが消えていたことに気づいた。", "unit:3E04900DCCDC8760FF198C56");
assertPattern(::BattleBrothersJP.Runtime.translate("Fatigue cost of skills reduced by [color=%positive%]15%[/color]"), "スキルの疲労コストが[color=%positive%]15%[/color]減少する", "unit:3E711C626C90967AFB5B2456");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-40%[/color] Max Fatigue"), "[color=#8f1e1e]-40%[/color] 最大疲労値", "unit:4017CC56F0FFAE2DF2A1CC4D");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-2[/color] Vision"), "[color=#8f1e1e]-2[/color] 視界", "unit:40626B65F1B9F8EA03796448");
assertPattern(::BattleBrothersJP.Runtime.translate("This character gains [color=%positive%]5%[/color] damage reduction because of adjacent opponents."), "隣接する敵により、受けるダメージが[color=%positive%]5%[/color]軽減される。", "unit:40F22CDBACD8A99BE164DA2F");
assertPattern(::BattleBrothersJP.Runtime.translate("Has [color=#8f1e1e]-15%[/color] chance to hit targets directly adjacent because the weapon is too unwieldy"), "武器が扱いにくいため、直接隣接する対象への命中率が[color=#8f1e1e]-15%[/color]低下する", "unit:44B2B81884575F4EA73A6C72");
assertPattern(::BattleBrothersJP.Runtime.translate("Has a range of [color=#135213]7[/color] tiles on even ground, more if shooting downhill"), "平地では射程[color=#135213]7[/color]マス。低所へ撃ち下ろす場合はさらに長くなる", "unit:45770FF987EE44C0C37F4C9C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-30%[/color] Initiative"), "先制値 [color=#8f1e1e]-30%[/color]", "unit:48B20E6D9A47186361A1D4D1");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-10[/color] Fatigue Recovery per turn"), "毎ターンの疲労回復量 [color=#8f1e1e]-10[/color]", "unit:48FB3C87ED597F70F64278E1");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Hilde[/color] returns to this realm."), "[color=#1e468f]Hilde[/color]はこの世へ帰還した。", "unit:4FB00811A9747389A89F1969");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] resists being charmed thanks to his resolve"), "[color=#1e468f]Alrik[/color]は精神力によって魅了に抵抗した", "unit:51CF2691C872255EA0DF0524");
assertPattern(::BattleBrothersJP.Runtime.translate("Inflicts [color=#8f1e1e]10[/color] extra fatigue"), "追加で[color=#8f1e1e]10[/color]の疲労を与える", "unit:538436D9D6794BA71720835B");
assertPattern(::BattleBrothersJP.Runtime.translate("[i]Costs [b][color=%negative%]all (at least 6) AP[/color][/b] to use and builds up [b][color=%positive%]30 Fatigue[/color][/b][/i]\n"), "[i]使用時に[b][color=%negative%]全行動力（最低6 AP）[/color][/b]を消費し、[b][color=%positive%]30疲労[/color][/b]が蓄積する[/i]\n", "unit:54AA7A755744F42C37518232");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-15[/color] Ranged Defense"), "射撃防御 [color=#8f1e1e]-15[/color]", "unit:58CB43DCC5FA54105C72EC82");
assertPattern(::BattleBrothersJP.Runtime.translate("Your melee and ranged defense are increased by [color=%positive%]8[/color]."), "近接防御と射撃防御が[color=%positive%]8[/color]増加する。", "unit:5A4028DE249F1A233C9E0818");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] eats  Strange Mushrooms"), "[color=#1e468f]Alrik[/color]が奇妙なキノコを食べた", "unit:5B88F22B964B6B75CC23AE33");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] breaks free (Chance: 50, Rolled: 40)"), "[color=#1e468f]Alrik[/color]が脱出した（成功率: 50、出目: 40）", "unit:5C94D823E06DABF003F89EAA");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+15[/color] Ranged Defense"), "射撃防御 [color=%positive%]+15[/color]", "unit:5CB9BAF9267031836504A27C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-3[/color] Action Points"), "[color=#8f1e1e]-3[/color] 行動力", "unit:5CC955F040B55E5CCA77EC60");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] has dazed [color=#8f1e1e]Orc Warrior[/color] for two turns"), "[color=#1e468f]Alrik[/color]が[color=#8f1e1e]Orc Warrior[/color]を2ターンの間、朦朧状態にした", "unit:60E713AD145BB31F48C82CCC");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-5%[/color] Melee Skill"), "近接技能 [color=#8f1e1e]-5%[/color]", "unit:60E7BE183607DC6A41EC62BD");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-20%[/color] Initiative"), "先制値 [color=#8f1e1e]-20%[/color]", "unit:613FC920539EA8313AFB06A6");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] resists being charmed thanks to his unnatural physiology"), "[color=#1e468f]Alrik[/color]は異常な生理機能によって魅了に抵抗した", "unit:61A531DC1C2977B490D3E9CE");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+1[/color] Ranged Skill"), "射撃技能 [color=%positive%]+1[/color]", "unit:62A7DCEABED543FC34165393");
assertPattern(::BattleBrothersJP.Runtime.translate("Recover the stolen %s for his lordship and you may earn his gratitude."), "領主のために盗まれた%sを取り戻せば、感謝も得られるだろう。", "unit:63D4335DCF71525A9BB3DC9E");
assertPattern(::BattleBrothersJP.Runtime.translate("This character has been chilled to the bone by cold. With their limbs frozen stiff, it takes a great deal of effort to move in a coordinated fashion. The effect will slowly wear off over [color=#8f1e1e]2[/color] more turn(s)."), "この団員は冷気に骨の髄まで凍え、四肢がこわばっているため、思うように体を動かすにも大きな労力を要する。効果はあと[color=#8f1e1e]2[/color]ターンかけて徐々に薄れる。", "unit:65AFD68FFAFC020AEBDAF209");
assertPattern(::BattleBrothersJP.Runtime.translate("This character is adapting fast to their opponent's moves and gains an additional [color=#135213]+10%[/color] chance to hit with any attack."), "敵の動きに素早く適応しており、あらゆる攻撃の命中率がさらに[color=#135213]+10%[/color]上昇する。", "unit:694283EC07524071AC3AE4DB");
assertPattern(::BattleBrothersJP.Runtime.translate("This character's armor has been sprayed with a Lindwurm's acidic blood, which is now slowly eating away at it for another [color=#8f1e1e]3[/color] turn(s)."), "この団員の防具にはリントヴルムの酸性の血が浴びせられ、あと[color=#8f1e1e]3[/color]ターンかけて徐々に侵食される。", "unit:6B1EB958AE4F995CB291B4EB");
assertPattern(::BattleBrothersJP.Runtime.translate("This character is bleeding profusely from a recently received wound and will lose [color=#8f1e1e]5[/color] hitpoints each turn for [color=#8f1e1e]2[/color] more turn(s)."), "この団員は負ったばかりの傷から激しく出血しており、毎ターン体力を[color=#8f1e1e]5[/color]失う。この出血はあと[color=#8f1e1e]2[/color]ターン続く。", "unit:6D68AADE28877F0AD7686398");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] had his bleeding wound quickly close thanks to his unnatural physiology"), "[color=#1e468f]Alrik[/color]の出血していた傷は、異常な生理機能によってたちまち塞がった", "unit:6FE72EA8E55D9FE009340CB0");
assertPattern(::BattleBrothersJP.Runtime.translate("Enterprising thieves have made off with the %s, seeking to make a fortune."), "抜け目ない盗賊どもが、一財産築こうと%sを持ち去った。", "unit:71F8B4723F2594AEAA997636");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] gives Strange Mushrooms to [color=#8f1e1e]Orc Warrior[/color]"), "[color=#1e468f]Alrik[/color]が[color=#8f1e1e]Orc Warrior[/color]に奇妙なキノコを渡した", "unit:7466618BED58321F3CB1A509");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]1[/color] Additional Action Point per tile moved"), "1マス移動するごとに追加で行動力を[color=#8f1e1e]1[/color]消費", "unit:789181D4D5E32812C8FB142B");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#135213]+8.5[/color] Resolve"), "精神力 [color=#135213]+8.5[/color]", "unit:7E43C690D5FECAA8831A59B0");
assertPattern(::BattleBrothersJP.Runtime.translate("Increases your damage done by [color=%positive%]15%[/color] for ranged weapon attacks at a range of 4 tiles or less"), "4マス以内の標的への遠隔武器攻撃は、与ダメージが[color=%positive%]15%[/color]増加する", "unit:81C46481DE6E330C35A73064");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-40%[/color] Initiative"), "先制値 [color=#8f1e1e]-40%[/color]", "unit:86E638CF645C541999D18DE5");
assertPattern(::BattleBrothersJP.Runtime.translate("Pursue the thieves and recover the stolen %s with utmost haste. Their lives matter not."), "盗賊どもを追い、盗まれた%sを一刻も早く取り戻せ。賊の命など知ったことではない。", "unit:8722DAEF5C5D2FFA06834F1F");
assertPattern(::BattleBrothersJP.Runtime.translate("Thieves have made off with the %s!"), "盗賊どもが%sを持ち去った！", "unit:87E5EEE09D7F08F7D2703ED7");
assertPattern(::BattleBrothersJP.Runtime.translate("Crafting [color=#8f1e1e]15%[/color]"), "製作 [color=#8f1e1e]15%[/color]", "unit:884D300DA8A8AD49E51C814D");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] is unaffected by the cold thanks to his unnatural physiology"), "[color=#1e468f]Alrik[/color]は異常な生理機能により、冷気の影響を受けなかった", "unit:8A23FDA6B19355FB80967F0D");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50[/color] Initiative"), "先制値 [color=#8f1e1e]-50[/color]", "unit:8A366A4BE83F9F9CCDF60B4E");
assertPattern(::BattleBrothersJP.Runtime.translate("+[color=%positive%]0.5%[/color] Melee Skill"), "近接技能 +[color=%positive%]0.5%[/color]", "unit:8C244D9ACFB678EF34A58ED6");
assertPattern(::BattleBrothersJP.Runtime.translate("Always inflicts at least [color=#8f1e1e]10[/color] damage to hitpoints, regardless of armor"), "装甲にかかわらず、必ず体力へ最低[color=#8f1e1e]10[/color]ダメージを与える", "unit:8C28CC9F49725A22F771FC21");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50%[/color] Max Fatigue"), "[color=#8f1e1e]-50%[/color] 最大疲労値", "unit:8CB43A3818345F8933F5A872");
assertPattern(::BattleBrothersJP.Runtime.translate("Only receive [color=#135213]40%[/color] of any damage to hitpoints from attacks"), "攻撃による体力ダメージを本来の[color=#135213]40%[/color]だけ受ける", "unit:8CDD2ED2531163D6E09ACF95");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Damage"), "[color=#8f1e1e]-25%[/color] ダメージ", "unit:8DA2E5CDDC56274E06E221E6");
assertPattern(::BattleBrothersJP.Runtime.translate("Brigands have stolen the %s from his lordship. He wants it back."), "盗賊どもが領主から%sを盗み出した。領主は奪還を望んでいる。", "unit:9065EE6E7F4EADD3B3EAC71C");
assertPattern(::BattleBrothersJP.Runtime.translate("This character has been temporarily disarmed for [color=#8f1e1e]1[/color] more turn(s) and is unable to use any weapon skills. Switching to a different weapon will remove this effect immediately."), "この団員はあと[color=#8f1e1e]1[/color]ターンの間、一時的に武装解除され、武器スキルを使用できない。別の武器へ持ち替えると、この効果は即座に解除される。", "unit:9202FFC7EA72DCF8EF588734");
assertPattern(::BattleBrothersJP.Runtime.translate("[i]Costs [b][color=%negative%]all (at least 6) AP[/color][/b] to use and builds up [b][color=%negative%]30 Fatigue[/color][/b][/i]\n"), "[i]使用時に[b][color=%negative%]全行動力（最低6 AP）[/color][/b]を消費し、[b][color=%negative%]30疲労[/color][/b]が蓄積する[/i]\n", "unit:9746ABED3286F4D63D0BD9C3");
assertPattern(::BattleBrothersJP.Runtime.translate("Find the thieves, kill them if you want, just bring back the %s."), "盗賊どもを見つけ出せ。殺すかどうかは好きにしろ。ただし%sだけは持ち帰れ。", "unit:9754DE97FF97750BEB7082FE");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color]'s body has been sprayed with acid"), "[color=#1e468f]Alrik[/color]の身体に酸が浴びせられた", "unit:9814FDD5BC9A81A296419ACB");
assertPattern(::BattleBrothersJP.Runtime.translate("Gaining an additional [color=%positive%]5[/color] melee defense."), "近接防御がさらに[color=%positive%]5[/color]増加する。", "unit:9C769F10F4519A96C74D4FAD");
assertPattern(::BattleBrothersJP.Runtime.translate("Follow the tracks, return the stolen %s."), "足跡を追い、盗まれた%sを取り戻せ。", "unit:9C9AFB24DBEE7A96517FA56F");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#135213]+25%[/color] Damage in Melee"), "[color=#135213]+25%[/color] 近接ダメージ", "unit:9DD46DF9969F38A16BACAB2A");
assertPattern(::BattleBrothersJP.Runtime.translate("Pursue the footpads and bring back the missing %s directly to his lordship. No-one else."), "追いはぎどもを追い、なくなった%sを領主本人のもとへ直接持ち帰れ。ほかの誰にも渡すな。", "unit:9EC02A24F6CD9CF1DA2C1CA6");
assertPattern(::BattleBrothersJP.Runtime.translate("Dame Hildebrand the Bold"), "デイム・Hildebrand the Bold", "unit:9FA590576FBA2E2060AA2649");
assertPattern(::BattleBrothersJP.Runtime.translate("Dame Roderick"), "デイム・Roderick", "unit:9FA590576FBA2E2060AA2649");
assertPattern(::BattleBrothersJP.Runtime.translate("His lordship's honor is at stake! Hunt down the thieves and return the stolen %s swiftly."), "領主の名誉が懸かっている！盗賊どもを追い、盗まれた%sを一刻も早く取り戻せ。", "unit:A5341151D0D93F3E85759AE9");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+15[/color] Melee Defense"), "近接防御 [color=%positive%]+15[/color]", "unit:A725E705129AB6A425657E88");
assertPattern(::BattleBrothersJP.Runtime.translate("Only receive [color=%positive%]70%[/color] of any damage to Armor from attacks"), "攻撃による装甲ダメージを本来の[color=%positive%]70%[/color]だけ受ける", "unit:AD633C465B6244BF2F4F8293");
assertPattern(::BattleBrothersJP.Runtime.translate("Only receive [color=#135213]90%[/color] of any damage to armor from attacks"), "攻撃で受ける装甲ダメージは[color=#135213]90%[/color]のみ", "unit:ADC1EE724BF93BBC36FEF9B2");
assertPattern(::BattleBrothersJP.Runtime.translate("Hitpoints: 125\nMelee skill: 62\nMelee defense: 15\nRanged skill: 52\nRanged defense: 30\nInitiative: 70"), "体力：125\n近接技能：62\n近接防御：15\n射撃技能：52\n射撃防御：30\n先制値：70", "unit:AF74984B9DD01DA688E9911E");
assertPattern(::BattleBrothersJP.Runtime.translate("This character was on the receiving end of a dirty trick. Distracted for [color=#8f1e1e]1[/color] more turn(s), they are slower to react and have a harder time landing clean strikes."), "この団員は卑劣な手口を食らった。あと[color=#8f1e1e]1[/color]ターンの間は注意をそらされ、反応が鈍り、正確な一撃を当てにくくなる。", "unit:B138A8561E6D656DE690C30A");
assertPattern(::BattleBrothersJP.Runtime.translate("Follow-up attack: [color=%positive%]Slash[/color]"), "追撃：[color=%positive%]Slash[/color]", "unit:B1BCE5A1365ED6135A160ACA");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]This character's armor isn't protective enough to grant any benefit from having the Battleforged perk[/color]"), "[color=#8f1e1e]この団員の装甲では、「堅牢な装甲」パークの恩恵を得られるほど十分に身を守れない[/color]", "unit:B58DF245FD171F0497528651");
assertPattern(::BattleBrothersJP.Runtime.translate("Has a [color=#135213]50%[/color] chance to succeed, based on Melee Skill. Each failed attempt will increase the chance to succeed for subsequent attempts."), "近接技能に基づき、成功率は[color=#135213]50%[/color]。失敗するたび、次の試行の成功率が上昇する。", "unit:B64DE4183817507AAD9B7861");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Alrik[/color] fails to break free (Chance: 50, Rolled: 80)"), "[color=#1e468f]Alrik[/color]は脱出に失敗した（成功率: 50、出目: 80）", "unit:B66D29A4115C875795837B99");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+1[/color] Resolve"), "精神力 [color=%positive%]+1[/color]", "unit:B8AC79971E06787FE5609353");
assertPattern(::BattleBrothersJP.Runtime.translate("The strong bond between the Vala and her Warden makes the Warden absorb 25% of the Vala's incoming health damage."), "ヴァラと守護霊の強い絆により、ヴァラが受ける体力ダメージの25%を守護霊が肩代わりする。", "unit:B97ABBA564449B19F12297CF");
assertPattern(::BattleBrothersJP.Runtime.translate("Only receive [color=%positive%]40%[/color] of any damage to hitpoints from attacks"), "攻撃による体力ダメージを本来の[color=%positive%]40%[/color]だけ受ける", "unit:B9AAC1C4D04D2414D288E622");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]Needs a non-empty quiver of arrows equipped[/color]"), "[color=#8f1e1e]矢が残っている矢筒を装備する必要がある[/color]", "unit:BD319A2FB0B7D38D235FCF30");
assertPattern(::BattleBrothersJP.Runtime.translate("A noble lord has what he terms a 'fetch' quest for you to retrieve his missing %s."), "ある貴族が、なくした%sを取り戻す仕事を「お使い」と呼んで持ちかけてきた。", "unit:BFB11C12B0427CF4B71EEC34");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-15%[/color] Melee Skill"), "近接技能 [color=#8f1e1e]-15%[/color]", "unit:BFCBE094258D7A9F496CF2B1");
assertPattern(::BattleBrothersJP.Runtime.translate("Has a range of [color=#135213]2[/color] tiles"), "射程[color=#135213]2[/color]マス", "unit:C33E4B361A28E1E4FA645C6D");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#135213]+20[/color] Initiative"), "先制値 [color=#135213]+20[/color]", "unit:C3DAA95EB193FD781E9ACDAF");
assertPattern(::BattleBrothersJP.Runtime.translate("The %s has been stolen from his lordships chambers!"), "領主の私室から%sが盗まれた！", "unit:C7425E1C2023A1BCE31EC9AB");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]20%[/color] of body armor is lost each turn"), "毎ターン、胴体の装甲を[color=#8f1e1e]20%[/color]失う", "unit:CAF4D9E011EDE4DFB5BF03E4");
assertPattern(::BattleBrothersJP.Runtime.translate("The %s has been stolen from under the nose of this lordship. Venture forth to reclaim it."), "領主の目と鼻の先から%sが盗まれた。取り戻すため、出立せよ。", "unit:CB600788E67DD77448241A63");
assertPattern(::BattleBrothersJP.Runtime.translate("This character has received so heavy a blow that they are dazed, confused and gasping for air. Will wear off in [color=#8f1e1e]2[/color] turn(s)."), "この団員は強烈な一撃を受け、朦朧とし、混乱して息を切らしている。あと[color=#8f1e1e]2[/color]ターンで効果が切れる。", "unit:CB84427F29B10C8E49AA0F7D");
assertPattern(::BattleBrothersJP.Runtime.translate("Gain an additional [color=%positive%]+2%[/color] Ranged Skill"), "射撃技能がさらに[color=%positive%]+2%[/color]増加する", "unit:CC7C0208A5A7C62FA3BDAC15");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]This character's body and head armor are too heavy as to gain any benefit from being nimble[/color]"), "[color=#8f1e1e]この団員の胴防具と兜は重すぎるため、身軽さの恩恵を得られない[/color]", "unit:CE10A2D0324C757541FACFD9");
assertPattern(::BattleBrothersJP.Runtime.translate("Has a [color=#135213]50%[/color] chance to succeed, based on Melee Skill, or higher if there's been attempts to free the ally before."), "近接技能に基づき、成功率は[color=#135213]50%[/color]。それまでにも味方の解放を試みていれば、さらに高くなる。", "unit:D1B8C16E1350B61F3870C737");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Ranged Skill"), "射撃技能 [color=#8f1e1e]-25%[/color]", "unit:D2ED7ACF876AAC76C6EFBA2C");
assertPattern(::BattleBrothersJP.Runtime.translate("Track down the thieves and ensure the stolen %s is returned to its rightful owner."), "盗賊どもを追跡し、盗まれた%sを正当な持ち主へ確実に返せ。", "unit:D3A5191AC9A525A2D6A32CCB");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Ranged Defense"), "射撃防御 [color=#8f1e1e]-25%[/color]", "unit:D437E6DAE42C6012E75E8175");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]25%[/color] Damage based on current Hitpoints and Fatigue"), "現在の体力と疲労に応じて、ダメージが[color=%positive%]25%[/color]増加する", "unit:D92A6342CD6FCE4A2809D9C4");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-40%[/color] Damage inflicted"), "与えるダメージ[color=#8f1e1e]-40%[/color]", "unit:D96A0FA15BDF92CD3DBF694D");
assertPattern(::BattleBrothersJP.Runtime.translate("Has [color=#8f1e1e]-10%[/color] chance to hit, and [color=#8f1e1e]-2%[/color] per tile of distance"), "命中率に[color=#8f1e1e]-10%[/color]、さらに距離1マスごとに[color=#8f1e1e]-2%[/color]の補正", "unit:D9F0F602200062A62627DB0F");
assertPattern(::BattleBrothersJP.Runtime.translate("Grants [color=#135213]+40%[/color] Damage in Melee"), "近接ダメージ[color=#135213]+40%[/color]", "unit:DBFB2D91C7ECBBCFB1449DED");
assertPattern(::BattleBrothersJP.Runtime.translate("Has [color=#135213]+10%[/color] chance to hit, and [color=#8f1e1e]-2%[/color] per tile of distance"), "命中率に[color=#135213]+10%[/color]、さらに距離1マスごとに[color=#8f1e1e]-2%[/color]の補正", "unit:DC470EDB2A5AD5E6163A4899");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+5[/color] Melee Skill, Ranged Skill and Melee Defense"), "近接技能、射撃技能、近接防御 [color=%positive%]+5[/color]", "unit:DEC5C351818881A1D790AA6F");
assertPattern(::BattleBrothersJP.Runtime.translate("+[color=%positive%]1%[/color] Melee Damage"), "近接ダメージ +[color=%positive%]1%[/color]", "unit:DF214C5D9699F13BFFF94189");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-5%[/color] Ranged Skill"), "射撃技能 [color=#8f1e1e]-5%[/color]", "unit:DFA155FCD12DA4C5442D4A15");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-25%[/color] Max Fatigue"), "[color=#8f1e1e]-25%[/color] 最大疲労値", "unit:DFC30424E855DF9000EC4F5C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]Orc Warrior[/color] charges and is repelled"), "[color=#8f1e1e]Orc Warrior[/color]が突進したが、はね返された", "unit:E0B70694991EC34B54B89F18");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=%positive%]+11%[/color] chance to have any attacker require two successful attack rolls in order to hit"), "攻撃者が命中させるために2回の攻撃判定に成功しなければならなくなる確率：[color=%positive%]+11%[/color]", "unit:E0E5241D270DBBF4D6DF652D");
assertPattern(::BattleBrothersJP.Runtime.translate("Grants [color=#8f1e1e]-40%[/color] Melee Defense"), "近接防御[color=#8f1e1e]-40%[/color]", "unit:E313115600D359F0A18120DC");
assertPattern(::BattleBrothersJP.Runtime.translate("This character has taken antidote and is immune to any kind of poison for another [color=#8f1e1e]2[/color] turn(s)."), "この団員は解毒剤を服用しており、あと[color=#8f1e1e]2[/color]ターンはあらゆる毒に免疫を持つ。", "unit:E5FACA37148048E32E15BAFA");
assertPattern(::BattleBrothersJP.Runtime.translate("This character is using the superior reach of their melee weapon to keep opponents at bay, increasing Melee Defense by [color=#135213]+5[/color] until their next turn."), "近接武器の長い間合いで敵を寄せつけず、次の自分のターンまで近接防御が[color=#135213]+5[/color]上昇している。", "unit:E846864F21CCC5C313C766D9");
assertPattern(::BattleBrothersJP.Runtime.translate("The local ruler has taken the theft of his %s rather badly. Find and kill everyone involved."), "地元の領主は%sを盗まれ、ひどく腹を立てている。関わった者を全員見つけ出し、殺せ。", "unit:EC8C279AB3BE0101A186CC30");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#1e468f]Hilde[/color] trembles and hums as they drift into a trance."), "[color=#1e468f]Hilde[/color]は震え、低く声を響かせながらトランスへ沈んでいく。", "unit:ECA7B7D093A6050A605C4DD2");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]Orc Warrior[/color] charges and stuns [color=#1e468f]Alrik[/color]"), "[color=#8f1e1e]Orc Warrior[/color]が突進し、[color=#1e468f]Alrik[/color]を気絶させた", "unit:ECC016616B9BD77C15042AB5");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-5[/color] Fatigue Recovery per turn"), "毎ターンの疲労回復量 [color=#8f1e1e]-5[/color]", "unit:EFDC9C674534BC0B1120B6B6");
assertPattern(::BattleBrothersJP.Runtime.translate("Some dastards have stolen the famed %s!"), "悪党どもが名高い%sを盗み出した！", "unit:F04FD0AAB57672F703FDE93D");
assertPattern(::BattleBrothersJP.Runtime.translate("His wife's cherished %s has been stolen. This nobleman needs you to track it down or he'll never hear the end of it."), "妻が大切にしていた%sが盗まれた。追跡して取り戻さなければ、この貴族は延々と小言を聞かされることになる。", "unit:F6964DCC9C0E45EE2E56064F");
assertPattern(::BattleBrothersJP.Runtime.translate("Has [color=#135213]+10%[/color] chance to hit"), "命中率[color=#135213]+10%[/color]", "unit:F6C81016C73A3B7C3B33CBD8");
assertPattern(::BattleBrothersJP.Runtime.translate("Grants [color=#8f1e1e]-40%[/color] Ranged Defense"), "射撃防御[color=#8f1e1e]-40%[/color]", "unit:F72FBBFBDAA5B64FC1C04052");
assertPattern(::BattleBrothersJP.Runtime.translate("Seek out the knaves and restore the stolen %s to the noble lord's estate."), "悪党どもを探し出し、盗まれた%sを貴族の屋敷へ取り戻せ。", "unit:F794C114625FFF57DBB49ED8");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-15%[/color] Ranged Skill"), "射撃技能 [color=#8f1e1e]-15%[/color]", "unit:F99E08A91AD8448E7FD4E62C");
assertPattern(::BattleBrothersJP.Runtime.translate("This character has been charmed. He no longer has any control over his actions and is a puppet that has no choice but to obey his master. Wears off in [color=#8f1e1e]3[/color] turn(s).\n\nThe higher a character's resolve, the higher the chance to resist being charmed."), "この団員は魅了されている。もはや自分の行動を制御できず、主人の命令に従うほかない操り人形となった。あと[color=#8f1e1e]3[/color]ターンで効果が切れる。\n\n精神力が高いほど、魅了に抵抗できる確率も高くなる。", "unit:FA8CAB417DED92B7E654363E");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]-50%[/color] Ranged Skill"), "射撃技能 [color=#8f1e1e]-50%[/color]", "unit:FBC3499DC2847948CE5CC8AC");
assertPattern(::BattleBrothersJP.Runtime.translate("Only receive [color=%positive%]70%[/color] of any damage to Hitpoints from attacks"), "攻撃による体力ダメージを本来の[color=%positive%]70%[/color]だけ受ける", "unit:FC0CED3C72ACDB45DD3BD87C");
assertPattern(::BattleBrothersJP.Runtime.translate("[color=#8f1e1e]Can not be used because this character is engaged in melee[/color]"), "[color=#8f1e1e]この団員は近接戦闘中のため使用できない[/color]", "unit:FD054E0A432EF8D08F39ACCE");
assertPattern(::BattleBrothersJP.Runtime.translate("Has [color=#135213]20[/color] arrows left"), "矢の残数[color=#135213]20[/color]", "unit:FD8409E8E645435C7DD246CA");
assertPattern(::BattleBrothersJP.Runtime.translate("Specialize in heavy armor! Armor damage taken is reduced by a percentage equal to [color=#135213]5%[/color] of the current total armor value of both body and head armor. The heavier your armor and helmet, the more you benefit."), "重装備を極める！ 攻撃で受ける装甲ダメージを、現在の頭部と胴体の装甲値合計の[color=#135213]5%[/color]に等しい割合だけ軽減する。胴防具と兜の装甲値が高いほど効果は大きい。", "unit:FE31BDCAC575D5E19D34BEE1");
assertPattern(::BattleBrothersJP.Runtime.translate("Hilde's Warden"), "Hildeの守護霊", "unit:FE387AAF0B105DFCCC4C399E");

print("REVIEWED_RUNTIME_PATTERNS_OK\n");
